    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_FLAME_STRIKE)
END

// * CLERIC_POISON {4} [SpPr411 - 1411]
// * -----------------------------------------
// * CS: 4, TGT: LA, RNG: 10', AOE: 1 CRE
// * -----------------------------------------
// * POISON - 60s
// * CL 7-9:    2d8 POISON dmg + 2 POISON dmg/Round - STvD neg
// * CL 10-12:  3d8 POISON dmg + 3 POISON dmg/Round - STvD neg
// * CL 13-14:  4d8 POISON dmg + 4 POISON dmg/ROund - STvD neg
// * CL 15-16:  6d8 POISON dmg + 5 POISON dmg/Round - STvD neg
// * CL 17+:    8d8 POISON dmg + 6 POISON dmg/Round - STvD neg
IF
  HaveSpell(CLERIC_POISON)                                                 // and we have the spell memorised
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !General(LastSeenBy(Myself),UNDEAD)                                      // and they're not undead
  HPGT(LastSeenBy(Myself),35)                                              // and the target has >35hp
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  !StateCheck(LastSeenBy(Myself),STATE_POISONED)                           // and they're not already poisoned
  CheckStatGT(LastSeenBy(Myself),5,SAVEVSDEATH)                            // and our target doesn't have an impossible to beat saving throw vs Poison
  CheckStatLT(LastSeenBy(Myself),51,RESISTPOISON)                          // and they aren't naturally immune
  Range(LastSeenBy(Myself),10)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("IRONGOL",LastSeenBy(Myself))                            // and they don't have the game-item that gives immunity to sleeps and poisons
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_POISON)
END

