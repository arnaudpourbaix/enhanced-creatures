ACTION_IF GAME_IS ~bgee~ BEGIN
    OUTER_SET BG1 = 1
    OUTER_SET EET = 0
END ELSE ACTION_IF GAME_IS ~bg2ee~ BEGIN
    OUTER_SET BG1 = 0
    OUTER_SET EET = 0
END ELSE ACTION_IF GAME_IS ~eet~ BEGIN
    OUTER_SET BG1 = 1
    OUTER_SET EET = 1
END ELSE BEGIN
    FAIL ~Game version not recognised. Halting installation.~
END

OUTER_SPRINT ~State~ ~SpellState~
OUTER_SPRINT ~Num~ ~~
