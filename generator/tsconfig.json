{
    "compilerOptions": {
        "target": "es2024",
        "module": "commonjs",
        "lib": [
            "esnext",
            "dom"
        ],
        "declaration": true,
        "outDir": "dist",
        "rootDir": "lib",
        "strict": true,
        "noImplicitOverride": true,
        "types": [
            "node"
        ],
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "exclude": ["node_modules", "dist", "vitest.config.ts", "lib/**/*.test.ts"]
}