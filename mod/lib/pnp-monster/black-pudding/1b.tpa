// Generated file (don't edit)

// Black Pudding
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/black-pudding/jabm1b00.baf~

// Slime Split
CREATE SPL "jasm1b00"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jasm1b00.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10280)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI212C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10281)
	LPF ADD_SPELL_HEADER INT_VAR type=3 location=4 target=5 STR_VAR icon="SPWI212B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 timing=1 probability1=100 STR_VAR resource="BDGOOYAA" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=67 target=2 power=1 parameter2=3 timing=1 probability1=100 STR_VAR resource="jacm1b01" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=67 target=2 power=1 parameter2=3 timing=1 probability1=100 STR_VAR resource="jacm1b01" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=168 target=2 power=1 timing=1 probability1=100 END
	
// Black Pudding traits
CREATE ITM "jaim1b00"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10987)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10987)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10288)
COPY_EXISTING ~jaim1b00.itm~ ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=29 target=1 global=1 parameter1=90 parameter2=1 timing=2 probability1=100 END
	LPF acid_immunity END
	LPF cold_immunity END
	LPF poison_immunity END

// Pseudopod
CREATE ITM "jaim1b01"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10279)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10279)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IJELLY~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10988)
	WRITE_LONG 0x60 3
COPY_EXISTING ~jaim1b01.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IJELLY~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 5
		WRITE_BYTE 0x84 4
