    GlobalTimerExpired("rest_timer","LOCALS")
THEN
    RESPONSE #100
        SetGlobal("rest_state","LOCALS",0)
        SetGlobal("instantprep","LOCALS",0)
        SetGlobal("chaincontingencyfired","LOCALS",0)
        SetGlobal("contingencyfired","LOCALS",0)
        SetGlobalTimer("redefend","LOCALS",2000)
        ApplySpell(Myself,RESTORE_FULL_HEALTH)  // SPIN746.SPL (No such index)
        Rest()
END

IF
    OR(2)
        INI("DMWW_mage_difficulty",0)
        GlobalGT("DMWW_mage_difficulty","GLOBAL",2)
    OR(2)
        DifficultyGT(EASY)
        GlobalGT("DMWW_mage_difficulty","GLOBAL",2)
    Detect([PC])
    !See([PC])
    !StateCheck(Myself,STATE_INVISIBLE)
    !GlobalTimerNotExpired("detect","LOCALS")
THEN
    RESPONSE #50
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
        SetGlobalTimer("detect","LOCALS",1000)
        DisplayString(Myself,235330)  // Hmmm... what was that?
        SpellNoDec(Myself,WIZARD_ORACLE)  // SPWI515.SPL (Oracle)
    RESPONSE #50
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
        SetGlobalTimer("detect","LOCALS",1000)
        DisplayString(Myself,235331)  // Strange... let's see what a little divination will show.
        SpellNoDec(Myself,WIZARD_ORACLE)  // SPWI515.SPL (Oracle)
    RESPONSE #50
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
        SetGlobalTimer("detect","LOCALS",1000)
        DisplayString(Myself,235332)  // Show yourself! You cannot hide from a mage!
        SpellNoDec(Myself,WIZARD_ORACLE)  // SPWI515.SPL (Oracle)
    RESPONSE #50
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
        SetGlobalTimer("detect","LOCALS",1000)
        DisplayString(Myself,235333)  // Come out, spy... I can sense your presence
        SpellNoDec(Myself,WIZARD_ORACLE)  // SPWI515.SPL (Oracle)
    RESPONSE #600
        SetGlobalTimer("detect","LOCALS",FIVE_ROUNDS)
        Continue()
END

