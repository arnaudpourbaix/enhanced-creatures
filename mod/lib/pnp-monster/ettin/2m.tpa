DEFINE_ACTION_FUNCTION jam2m_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~D0QPSY10~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDETTIN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#ORMETT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHNETTIN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PETTIN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PLSHFG01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PLSHFG02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SAHOTY01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BDRINGGE~
			REMOVE_CRE_ITEM ~B2-16~
			REMOVE_CRE_ITEM ~ETTIN~
			REMOVE_CRE_ITEM ~B1-12M3~
			REMOVE_CRE_ITEM ~B3-12~
			REMOVE_CRE_ITEM ~BDBLUNGH~
			REPLACE_CRE_ITEM ~jaim2m00~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jaim2m01~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_CRE_ITEM ~jaim2m02~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=80
					ac=3
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=10
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=21
					intelligence=7
					wisdom=10
					dexterity=8
					constitution=17
					charisma=8
					morale=14
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~ETTIN~)
					class=IDS_OF_SYMBOL (~class~ ~GIANT~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=10
					enforce=1
					perfect2weapon=1
			END
			// Assigning jabm2m00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BDETTIN L#ORMETT END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm2m00 END
			// Assigning jabm2m02
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN L#ORMETT END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm2m02 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLSHFG01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLSHFG02~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SAHOTY01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D0QPSY10~) BEGIN 
				WRITE_SHORT 0x24 96 // hp
				WRITE_SHORT 0x26 96 // hp
				WRITE_BYTE 0x52 9 // thac0
				WRITE_BYTE 0x54 7 // saveDeath
				WRITE_BYTE 0x55 9 // saveWand
				WRITE_BYTE 0x56 8 // savePolymorph
				WRITE_BYTE 0x57 8 // saveBreath
				WRITE_BYTE 0x58 10 // saveSpell
				WRITE_BYTE 0x234 12 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDETTIN~) BEGIN 
				WRITE_SHORT 0x24 120 // hp
				WRITE_SHORT 0x26 120 // hp
				WRITE_BYTE 0x271 IDS_OF_SYMBOL (~general~ ~UNDEAD~) // general
				ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
				ADD_CRE_ITEM ~jaic000b~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
				LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
				PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
					REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
				END
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#ORMETT~) BEGIN 
				WRITE_SHORT 0x24 120 // hp
				WRITE_SHORT 0x26 120 // hp
				WRITE_BYTE 0x271 IDS_OF_SYMBOL (~general~ ~UNDEAD~) // general
				ADD_CRE_ITEM ~jaik0c00~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
				REPLACE_CRE_ITEM ~jaim2m03~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ EQUIP
				ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
				LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
				PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
					REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
				END
				ADD_MEMORIZED_SPELL ~jask0c00~ #0 ~innate~ (1) // Paralyzing Gaze
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~D0QPSY10~) BEGIN 
				WRITE_LONG 0x14 5000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDETTIN~) BEGIN 
				WRITE_LONG 0x14 7000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#ORMETT~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHNETTIN~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PETTIN~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLSHFG01~) BEGIN 
				WRITE_LONG 0x14 5000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLSHFG02~) BEGIN 
				WRITE_LONG 0x14 5000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SAHOTY01~) BEGIN 
				WRITE_LONG 0x14 5000 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"PETTIN"
BEGIN
	LAF jam2m_patch STR_VAR file END
END
ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BDETTIN"
		"L#ORMETT"
	BEGIN
		LAF jam2m_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"D0QPSY10"
		"OHNETTIN"
		"PLSHFG01"
		"PLSHFG02"
		"SAHOTY01"
	BEGIN
		LAF jam2m_patch STR_VAR file END
	END
END