DEFINE_ACTION_FUNCTION jam22_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~C6GUEN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C6GUEN2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JAGUARSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELP04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CATJAG01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CATJAGWP~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CATPAN01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CB585AN5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9CATJ~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9CATT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHDANIM3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~TRANIM03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~TREVIL05~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~CATJAG~
			REMOVE_CRE_ITEM ~S1-6~
			REPLACE_CRE_ITEM ~jai0m22~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai1m22~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_CRE_ITEM ~jai19~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas0m22~ #0 ~innate~ (1) // Leap
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=420
					hp=33
					ac=7
					thac0=17
					apr=2
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=14
					intelligence=4
					wisdom=14
					dexterity=15
					constitution=10
					charisma=7
					morale=9
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~CAT~)
					class=IDS_OF_SYMBOL (~class~ ~CAT~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=12
					enforce=1
					perfect2weapon=1
			END
			// Assigning jam22
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN C6GUEN JAGUARSU BDHELP04 CATJAGWP END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam22 END
			// Assigning jam22su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
