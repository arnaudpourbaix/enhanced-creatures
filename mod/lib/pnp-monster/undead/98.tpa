					race=IDS_OF_SYMBOL (~race~ ~SKELETON~)
					class=IDS_OF_SYMBOL (~class~ ~SKELETON~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					metalColor=20
					minorColor=67
					majorColor=66
					skinColor=105
					leatherColor=14
					armorColor=20
					hairColor=0
					movement=10
					enforce=1
			END
			// Assigning jam98
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN L#HAUSK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam98 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#NIMF6~) BEGIN 
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~CLERIC~) // class
				ADD_MEMORIZED_SPELL ~SPPR109~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR102~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR121~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR211~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR208~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR213~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR301~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR304~ #2 ~priest~ (1) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#NIMF6~) BEGIN 
				WRITE_LONG 0x14 9500 // xpv
				WRITE_SHORT 0x24 240 // hp
				WRITE_SHORT 0x26 240 // hp
				WRITE_SHORT 0x46 1 // ac
				WRITE_SHORT 0x48 1 // ac
				WRITE_BYTE 0x52 1 // thac0
				WRITE_BYTE 0x53 2 // apr
				WRITE_BYTE 0x54 2 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 8 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 20 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~CLERIC~) // class
				REMOVE_MEMORIZED_SPELLS
				ADD_MEMORIZED_SPELL ~SPPR109~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR102~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR121~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR211~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR208~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR213~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR301~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR304~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR109~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR102~ #0 ~priest~ (2) 
				ADD_MEMORIZED_SPELL ~SPPR121~ #0 ~priest~ (2) 
				ADD_MEMORIZED_SPELL ~SPPR124~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR113~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR125~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR111~ #0 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR211~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR208~ #1 ~priest~ (2) 
				ADD_MEMORIZED_SPELL ~SPPR213~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR214~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR203~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR220~ #1 ~priest~ (2) 
				ADD_MEMORIZED_SPELL ~SPPR201~ #1 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR301~ #2 ~priest~ (2) 
				ADD_MEMORIZED_SPELL ~SPPR304~ #2 ~priest~ (2) 
				ADD_MEMORIZED_SPELL ~SPPR313~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR329~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR320~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR310~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR311~ #2 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR424~ #3 ~priest~ (1) 
