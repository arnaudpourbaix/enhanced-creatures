// Generated file (don't edit)

// Greater Clay Golem
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/jam6e.baf~

// Greater Clay Golem traits
CREATE ITM "jai0m6e"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10753)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10753)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10754)
COPY_EXISTING ~jai0m6e.itm~ ~override~
	LPF magic_immunity END
	LPF nonMagicalWeapons_immunity END
	LPF slashingDamage_immunity END
	LPF piercingDamage_immunity END
	LPF missileDamage_immunity END
	LPF crushingDamageResistance_resistance END

ACTION_FOR_EACH ~file~ IN
	"OHB_T302"
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.bcs~ BEGIN
		COPY_EXISTING ~%file%.bcs~ ~override~
			DECOMPILE_AND_PATCH BEGIN
				REPLACE_TEXTUALLY ~ReallyForceSpell(Myself,GOLEM_HASTE)~ ~Continue()~
			END
		BUT_ONLY
	END
END

DEFINE_ACTION_FUNCTION jam6e_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOL01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~GOLCLA~
			REMOVE_CRE_ITEM ~GOLFLE~
			REMOVE_CRE_ITEM ~GOLIRO~
			REMOVE_CRE_ITEM ~OHBGOL01~
			REMOVE_CRE_ITEM ~B3-30~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~IMMUNE2~
			REMOVE_CRE_ITEM ~IMMUNE3~
			REMOVE_CRE_ITEM ~IRONGOL~
			REMOVE_CRE_ITEM ~D5CLGOL~
			REMOVE_CRE_ITEM ~HELMNOAN~
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOL01~) BEGIN 
				REPLACE_CRE_ITEM ~jai1m18~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			END
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOL01~) BEGIN 
				ADD_CRE_ITEM ~jai2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			END
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOL01~) BEGIN 
				REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOL01~) BEGIN 
				ADD_CRE_ITEM ~jai0m6e~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			END
			ADD_MEMORIZED_SPELL ~jas0m18~ #0 ~innate~ (1) // Haste
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=8000
					hp=226
					ac=7
					thac0=7
					apr=1
					saveDeath=5
					saveWand=7
					savePolymorph=6
					saveBreath=5
					saveSpell=8
					level1=14
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=22
					intelligence=3
					wisdom=8
					dexterity=9
					constitution=18
					charisma=1
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_CLAY~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=6
					enforce=1
			END
			// Assigning jam6e
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLCLY01 BPFHT OHBNONIN O#BrynFi BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam6e END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOL01~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_SHORT 0x24 394 // hp
				WRITE_SHORT 0x26 394 // hp
				WRITE_SHORT 0x46 "-1" // ac
				WRITE_SHORT 0x48 "-1" // ac
				WRITE_BYTE 0x52 "-5" // thac0
				WRITE_BYTE 0x54 3 // saveDeath
				WRITE_BYTE 0x55 5 // saveWand
				WRITE_BYTE 0x56 4 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 6 // saveSpell
				WRITE_BYTE 0x234 26 // level1
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"OHBGOL01"
BEGIN
	LAF jam6e_patch STR_VAR file END
END