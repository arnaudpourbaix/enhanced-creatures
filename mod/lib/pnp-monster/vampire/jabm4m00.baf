// Patriarch Vampire

// Gaseous form: get away from enemies
IF
	CheckSpellState(Myself,JA_GASEOUSFORM)
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),90)
END

// Bat form: get away from enemies while hurt
IF
	CheckSpellState(Myself,JA_ANIMALFORM)
	CheckSpellState(Myself,JA_FLYING)
	HPPercentLT(Myself,65)
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),90)
END

// Init
IF
	Global("JA_INIT","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",0)
		SetGlobal("JA_PRECAST_LONG","LOCALS",0)
		SetGlobal("JA_PRECAST_MID","LOCALS",0)
		SetGlobalTimer("JA_REST","LOCALS",2400)
		SetGlobal("JA_INIT","LOCALS",1)
END

// Disable spellcasting in some areas
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	OR(2)
		AreaCheck("AR3004")
		AreaCheck("AR3008")
THEN
	RESPONSE #100
		SetGlobal("JA_DISABLE_SPELLCASTING","LOCALS",1)
END

// Rest (reset everything and heal if applicable)
IF
	Global("JA_INIT","LOCALS",1)
	GlobalTimerExpired("JA_REST","LOCALS")
	!See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_INIT","LOCALS",0)
		Rest()
		ApplySpell(Myself,RESTORE_FULL_HEALTH)
END

// Turn hostile if attacked
IF
	Allegiance(Myself,NEUTRAL)
	OR(4)
		AttackedBy([GOODCUTOFF],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		TookDamage()
		Heard([EVILCUTOFF.0.VAMPIRE],99)
THEN
	RESPONSE #100
		Enemy()
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,EVILCUTOFF)
	See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,GOODCUTOFF)
	See([EVILCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Shouts every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	!GlobalTimerNotExpired("JA_SHOUT","LOCALS")
THEN
	RESPONSE #100
		Shout(99)
		SetGlobalTimer("JA_SHOUT","LOCALS",18)
END

// React to shouts
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.VAMPIRE],99)
	InMyArea([EVILCUTOFF.0.VAMPIRE])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.VAMPIRE],99)
	InMyArea([EVILCUTOFF.0.VAMPIRE])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

// Help every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("JA_HELP","LOCALS")
THEN
	RESPONSE #100
		Help()
		SetGlobalTimer("JA_HELP","LOCALS",18)
END

// React to help
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		Help()
		MoveToObject(LastHelp(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHelp(Myself))
END

// Do nothing if...
IF
	OR(4)
		Global("JA_COMBAT","LOCALS",0)
		!Allegiance(Myself,EVILCUTOFF)
		StateCheck(Myself,STATE_IMMOBILE)
		StateCheck(Myself,STATE_REALLY_DEAD)
THEN
	RESPONSE #100
		NoAction()
END

IF
	!InActiveArea(Myself)
	!Range(NearestEnemyOf(Myself),30)
THEN
	RESPONSE #100
		NoAction()
END

// Gaseous Form
IF
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	HaveSpellRES("jasm4m00")
	!CheckSpellState(Myself,JA_ANIMALFORM)
	!CheckSpellState(Myself,JA_GASEOUSFORM)
	HPPercentLT(Myself,35)
	Range(NearestEnemyOf(Myself),4)
	TriggerOverride(NearestEnemyOf(Myself),WeaponEffectiveVs(NearestEnemyOf(Myself),MAINHAND))
	TriggerOverride(NearestEnemyOf(Myself),WeaponCanDamage(NearestEnemyOf(Myself),MAINHAND))
	RandomNumGT(800,400)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jasm4m00",Myself)
		RemoveSpellRES("jasm4m00")
END

// Gaseous Form
IF
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	HaveSpellRES("jasm4m00")
	!CheckSpellState(Myself,JA_ANIMALFORM)
	!CheckSpellState(Myself,JA_GASEOUSFORM)
	Range(NearestEnemyOf(Myself),4)
	TriggerOverride(NearestEnemyOf(Myself),WeaponEffectiveVs(NearestEnemyOf(Myself),MAINHAND))
	TriggerOverride(NearestEnemyOf(Myself),WeaponCanDamage(NearestEnemyOf(Myself),MAINHAND))
	Range(SecondNearestEnemyOf(Myself),4)
	TriggerOverride(SecondNearestEnemyOf(Myself),WeaponEffectiveVs(NearestEnemyOf(Myself),MAINHAND))
	TriggerOverride(SecondNearestEnemyOf(Myself),WeaponCanDamage(NearestEnemyOf(Myself),MAINHAND))
	Range(ThirdNearestEnemyOf(Myself),4)
	TriggerOverride(ThirdNearestEnemyOf(Myself),WeaponEffectiveVs(NearestEnemyOf(Myself),MAINHAND))
	TriggerOverride(ThirdNearestEnemyOf(Myself),WeaponCanDamage(NearestEnemyOf(Myself),MAINHAND))
	RandomNumGT(801,401)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jasm4m00",Myself)
		RemoveSpellRES("jasm4m00")
END

// Bat Form
IF
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	HaveSpellRES("jase0707")
	!CheckSpellState(Myself,JA_ANIMALFORM)
	!CheckSpellState(Myself,JA_GASEOUSFORM)
	Detect(NearestEnemyOf(Myself))
	HPPercentLT(Myself,50)
	RandomNumGT(802,401)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jase0707",Myself)
		RemoveSpellRES("jase0707")
END

// Dominating Will
IF
	HaveSpellRES("jase0709")
	!HaveSpell(WIZARD_DOMINATION)
	!HaveSpell(CLERIC_MENTAL_DOMINATION)
	!HaveSpell(WIZARD_DIRE_CHARM)
	!HaveSpell(CLERIC_CHARM_PERSON)
	!CheckSpellState(Myself,JA_ANIMALFORM)
	!CheckSpellState(Myself,JA_GASEOUSFORM)
	RandomNumGT(803,402)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(NearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!Gender(LastSeenBy(Myself),SUMMONED)
	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
	OR(4)
		Class(LastSeenBy(Myself),CLERIC_ALL)
		HasItem("BLUN12",LastSeenBy(Myself))
		HasItem("BLUN25",LastSeenBy(Myself))
		HasItem("AX1H10",LastSeenBy(Myself))
	General(LastSeenBy(Myself),HUMANOID)
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	!CheckSpellState(LastSeenBy(Myself),CHAOTIC_COMMANDS)
	!CheckSpellState(LastSeenBy(Myself),CHARM_IMMUNITY)
	!ImmuneToSpellLevel(LastSeenBy(Myself),5)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TURNING)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TRAP)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_DEFLECTION)
	!CheckStatGT(LastSeenBy(Myself),0,CLERIC_SHIELD_OF_THE_ARCHONS)
	CheckStatGT(LastSeenBy(Myself),-5,SAVEVSSPELL)
	!Race(LastSeenBy(Myself),ELF)
	!CheckStatGT(LastSeenBy(Myself),0,HELD)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_FEEBLEMINDED)
	!StateCheck(LastSeenBy(Myself),STATE_SLEEPING)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jase0709",LastSeenBy(Myself))
END

