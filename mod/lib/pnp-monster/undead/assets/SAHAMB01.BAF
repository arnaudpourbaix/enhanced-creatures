IF
    OR(2)
        GlobalGT("villynatyjob","GLOBAL",0)
        Dead("sahpr2")  // Prince Villynaty
THEN
    RESPONSE #100
        EscapeArea()
END

IF
    Global("rest_state","LOCALS",0)
    Detect(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        SetGlobal("rest_state","LOCALS",1)
        Continue()
END

IF
    Global("rest_state","LOCALS",1)
    !Detect(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        SetGlobal("rest_state","LOCALS",2)
        SetGlobalTimer("rest_timer","LOCALS",EIGHT_HOURS)
        Continue()
END

IF
    Global("rest_state","LOCALS",2)
    Detect(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        SetGlobal("rest_state","LOCALS",1)
        Continue()
END

IF
    Global("rest_state","LOCALS",2)
    GlobalTimerExpired("rest_timer","LOCALS")
THEN
    RESPONSE #100
        SetGlobal("rest_state","LOCALS",0)
        ApplySpell(Myself,RESTORE_FULL_HEALTH)  // SPIN746.SPL (No such index)
        Rest()
END

IF
    !GlobalTimerNotExpired("hatePCs","LOCALS")
    OR(9)
        Allegiance(LastAttackerOf(Myself),GOODCUTOFF)
        HitBy([GOODCUTOFF],CRUSHING)
        AttackedBy([GOODCUTOFF.0.0.0.0.SUMMONED],DEFAULT)
        AttackedBy([PC],DEFAULT)
        AttackedBy([FAMILIAR],DEFAULT)
        AttackedBy([ALLY],DEFAULT)
        AttackedBy([CONTROLLED],DEFAULT)
        AttackedBy([CHARMED],DEFAULT)
        SpellCastOnMe([GOODCUTOFF],0)
THEN
    RESPONSE #100
        SetGlobalTimer("hatePCs","LOCALS",TEN_ROUNDS)
        SetGlobalTimer("DMWWHostileFish","GLOBAL",ONE_ROUND)
        Continue()
END

IF
    !GlobalTimerNotExpired("hatePCs","LOCALS")
    See([PC])
    !See([0.0.0.0.30])
THEN
    RESPONSE #100
        SetGlobalTimer("hatePCs","LOCALS",TEN_ROUNDS)
END

IF
    !GlobalTimerNotExpired("hatePCs","LOCALS")
    GlobalTimerNotExpired("DMWWHostileFish","GLOBAL")
THEN
    RESPONSE #100
        SetGlobalTimer("hatePCs","LOCALS",TEN_ROUNDS)
END

IF
    See([PC])
    Range(LastSeenBy(Myself),12)
    !GlobalTimerNotExpired("Shout","LOCALS")
    !General(Myself,UNDEAD)
    !Gender(Myself,SUMMONED)
    !Gender(Myself,20)
THEN
    RESPONSE #30
        SetGlobalTimer("Shout","LOCALS",TWENTY_MINUTES)
        SetGlobalTimer("hatePCs","LOCALS",TEN_ROUNDS)
        SetGlobalTimer("DMWWHostileFish","GLOBAL",ONE_ROUND)
        DisplayStringHead(Myself,53784)  // Surfacers! Feel our wrath!
        Continue()
    RESPONSE #30
        SetGlobalTimer("Shout","LOCALS",TWENTY_MINUTES)
        SetGlobalTimer("hatePCs","LOCALS",TEN_ROUNDS)
        SetGlobalTimer("DMWWHostileFish","GLOBAL",ONE_ROUND)
        DisplayStringHead(Myself,53785)  // The Shark God take you!
        Continue()
    RESPONSE #30
        SetGlobalTimer("Shout","LOCALS",TWENTY_MINUTES)
        SetGlobalTimer("hatePCs","LOCALS",TEN_ROUNDS)
        SetGlobalTimer("DMWWHostileFish","GLOBAL",ONE_ROUND)
        DisplayStringHead(Myself,53786)  // I shall taste your blood, manlings!
        Continue()
END

