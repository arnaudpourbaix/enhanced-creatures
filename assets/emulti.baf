    SetGlobalTimer("gh_CastingChant","GLOBAL",12)                          // 2 round timer to prevent Multi-Cast
    Spell(Myself,CLERIC_CHANT)                                             // cast Chant centered on them
END

// * CLERIC_BLESS {1} [SpPr101 - 1101] dur: 36s, group effect
// * Requires Mod Stat.IDS File (WIZARD_IMPROVED_ALACRITY)
IF
  HaveSpell(CLERIC_BLESS)                                                  // and we have the spell
  !StateCheck(Myself,STATE_BLESS)                                          // and not already Bless'd
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalTimerNotExpired("gh_BuffTimer","LOCALS")                           // if its less than 3rnds since B was pressed
  !GlobalTimerNotExpired("gh_CastingBless","GLOBAL")                       // and someone else isn't already casting it this round
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobalTimer("gh_CastingBless","GLOBAL",12)                          // 2 round timer to prevent Multi-Cast
    Spell(Myself,CLERIC_BLESS)                                             // cast Bless centered on them
END

