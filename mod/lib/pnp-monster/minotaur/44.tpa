	LPF ADD_EFFECT INT_VAR header=1 opcode=235 target=1 power=1 parameter1=40 parameter2=3 duration=2 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=111 target=1 power=1 parameter1=1 duration=3 probability1=100 STR_VAR resource="jai2m44" END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
// Minotaur traits
