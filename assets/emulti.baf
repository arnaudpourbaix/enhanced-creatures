    SetGlobal("GB_UsedMISC3J","LOCALS",0)                                  // Bronze Horn of Valhalla
    SetGlobal("GB_UsedMISC3I","LOCALS",0)                                  // Silver Horn of Valhalla
    SetGlobal("GB_UsedMISC3E","LOCALS",0)                                  // Black Spider Figurine
    SetGlobal("GB_UsedMISC7T","LOCALS",0)                                  // Moon Dog Figurine
    SetGlobal("GB_UsedMISC3D","LOCALS",0)                                  // Golden Lion Figurine
    SetGlobal("GB_UsedTOME01","LOCALS",0)                                  // Golem Manual
    SetGlobal("GB_UsedTOME02","LOCALS",0)                                  // Clay Golem Manual
    SetGlobal("GB_UsedTOME03","LOCALS",0)                                  // Stone Golem Manual
    SetGlobal("GB_UsedTOME04","LOCALS",0)                                  // Juggernaut Golem Manual
    SetGlobal("GB_UsedRING26","LOCALS",0)                                  // Ring of Djinn Summoning
    SetGlobal("GB_UsedRING33","LOCALS",0)                                  // Ring of the Ram
    SetGlobal("GB_UsedRING20","LOCALS",0)                                  // Ring of Energy
    SetGlobal("GB_UsedHELM32","LOCALS",0)                                  // Helm of the Rock
    SetGlobal("GB_UsedBOOT12","LOCALS",0)                                  // Gargoyle Boots
    SetGlobal("GB_UsedHELM30","LOCALS",0)                                  // Thieves' Hood
    SetGlobal("GB_UsedCHAN20","LOCALS",0)                                  // White Dragon Scale
    SetGlobal("GB_UsedNPSHLD","LOCALS",0)                                  // Delryn Family Shield
    SetGlobal("GB_UsedWA2HELM","LOCALS",0)                                 // Vhailor's Helm
    SetGlobal("GB_UsedMISC3F","LOCALS",0)                                  // Jade Hound
    SetGlobal("GB_UsedNPMISC1","LOCALS",0)                                 // Jansen Spectroscopes
    SetGlobal("EK_Used_JAN_AMMO","LOCALS",0)                               // Create Flash Master Bruiser Mates BOLT07.ITM
    SetGlobal("EK_UsedCLCK25","LOCALS",0)                                  // Create Star Darts STARDART.ITM
    SetGlobal("EK_UsedC2KIT","LOCALS",0)                                   // Improved Kitthix
    SetGlobal("EK_UsedMISC3M","LOCALS",0)                                  // Harp of Discord
    SetGlobal("EK_UsedBRAC16","LOCALS",0)                                  // Bracers of Blinding Strike
    SetGlobal("EK_UsedAMUL26","LOCALS",0)                                  // Amulet of Cheetah Speed
    SetGlobal("EK_UsedWA2HARP","LOCALS",0)                                 // Harp of Pandemonium
    SetGlobal("EK_UsedRING34","LOCALS",0)                                  // Ring of Spell Turning
    SetGlobal("EK_UsedMISC3N","LOCALS",0)                                  // Azlaer's Harp
END

// **********************************************************************
// *           Segment Name: ek_DailyCreation_Items.baf
// **********************************************************************

// * Item Creation

// * JAN_AMMO {1} [SpIn829 - 3829] (Creates 5 Flash Master Bruiser Mates: BOLT07.ITM, 1/day)
IF
  HaveSpell(JAN_AMMO)                                                      // and I have the spell
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !Detect([EVILCUTOFF])
  Global("EK_Used_JAN_AMMO","LOCALS",0)                                    // and I haven't cast the spell once already today
  !InventoryFull(Myself)                                                   // and I have an inventory slot available
  CheckStatLT(Myself,1,ENCUMBERANCE)                                       // and I am not already encumbered because these things are heavy
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,JAN_AMMO)                                                 // cast the spell
    SetGlobal("EK_Used_JAN_AMMO","LOCALS",1)
END

// * CLOAK_OF_THE_STARS [CLCK25] (Creates 6 +5 Darts: STARDART.ITM, 1/day)
IF
  HasItemEquiped("CLCK25",Myself)                                          // and I have the item equipped
  CheckStatGT(Myself,0,PROFICIENCYDART)                                    // and I can hit something with them so I might want to create them
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !Detect([EVILCUTOFF])
  Global("EK_UsedCLCK25","LOCALS",0)                                       // and I haven't cast the spell once already today
  !InventoryFull(Myself)                                                   // and I have an inventory slot available
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("CLCK25",Myself)                                               // use the item
    SetGlobal("EK_UsedCLCK25","LOCALS",1)
    DisplayStringHead(Myself,8063)                                         // "Cloak of the Stars"
END

// **********************************************************************
// *           Segment Name: gs_HelpCall.baf
// **********************************************************************

// * PART OF COORDINATION SCRIPTLETS, SHOUT HELP
// * Requires the usual swag of Custom IDS files, see gs_Credits (gMulti)

// * Shout(HELP) if you need to
IF
  HPPercentLT(Myself,25)                                                   // if hp<25%
  AttackedBy([ANYONE],DEFAULT)                                             // and under any form of attack
  Detect(NearestEnemyOf(Myself))                                           // and opponents are still present
  !GlobalTimerNotExpired("WHINED","LOCALS")                                // one can only whine so often...
THEN
  RESPONSE #100
    SetGlobalTimer("WHINED","LOCALS",3)                                    // but the need is grim, 2/round at least
    GlobalShout(2001)
    Continue()                                                             // make sure we can do more than whine about it
END

// **********************************************************************
// *           Segment Name: gs_MoveToCombat.baf
// **********************************************************************

// * COORDINATION SCRIPT
// * A simple combination of Shout() and Heard() to ensure all PCS fight together, and
// * that damaged pc's opponents are priority targets.
// *
// * [Still in development, unsure of effectiveness, hence the DSH's]

// Call for help if someone is doing nothing
IF
  See([ENEMY])
  Global("CE_WasHelpCaller","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("CE_WasHelpCaller","LOCALS",1)
    GlobalShout(5003)
    Continue()
END

// Clear the help flag
IF
  !See([ENEMY])
  Global("CE_WasHelpCaller","LOCALS",1)
THEN
  RESPONSE #100
    SetGlobal("CE_WasHelpCaller","LOCALS",0)
END

// * Stop Moving when I see an enemy
IF
  OR(2)
     CombatCounter(0)                                                      // if combat hasn't started, yet
     See([ENEMY])                                                          // or I see an Enemy
  Global("move_to_enemy","LOCALS",1)                                       // and I am responding to a help call
THEN
  RESPONSE #100
    SetGlobal("move_to_enemy","LOCALS",0)                                  // clear the variable that lets me know that I am responding to a help call
    ClearActions(Myself)                                                   // Stop
    Continue()                                                             // and replan my thinking, now that an enemy is in sight
END

// Respond to a help call
IF
  ActionListEmpty()
  Heard([PC],5003)                                                         // and I have received a help call
  !Range(LastHeardBy(Myself),0)
  !See([ENEMY])                                                            // I don't see an Enemy
  Global("move_to_enemy","LOCALS",0)                                       // and the variable that lets me know that I am responding to a help call isn't set
THEN
  RESPONSE #100
    SetGlobal("move_to_enemy","LOCALS",1)                                  // set a variable to let me know that I am responding to a help call
    SmallWait(5)
    MoveToObject(LastHeardBy(Myself))                                      // move to the person who shouted for help
END

//Responding to a desperate cry for help, hold my calls!

IF
  Heard([GOODCUTOFF],2001)
  !Range(LastHeardBy(Myself),0)
  OR(2)
    See(LastHeardBy(Myself))                                               // can we see our pal at least?
    See(LastAttackerOf(LastHeardBy(Myself)))                               // or better yet, his attacker?
  Range(LastSeenBy(Myself),15)                                             // are they within a reasonable distance?
  !GlobalTimerNotExpired("RESPOND","LOCALS")                               // are we already busy playing good samaritan?
THEN
  RESPONSE #100
    SetGlobalTimer("RESPOND","LOCALS",12)                                  // we won't hear any more cries for help for a bit, we're busy
    SmallWait(5)
    MoveToObject(LastSeenBy(Myself))                                       // move in to assist
    Continue()                                                             // and let the script do the talking
END

// **********************************************************************
// *           Segment Name: gs_Vocalise.baf
// **********************************************************************

// * WIZARD_VOCALIZE {2} [SpWi219 - 2219]
// * A simple precaution, to ensure we can cast in the first place
// * -----------------------------------------
// * CS: 2, TGT: Caster, RNG: 1', AOE: Caster
// * -----------------------------------------
// * Cancels the effect of silence
// * Immunity to Silence - 60s
IF
  HaveSpell(WIZARD_VOCALIZE)                                               // and we have Vocalise
  StateCheck(Myself,STATE_SILENCED)                                        // If we've been silenced
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_VOCALIZE)                                          // cast it to restore spell casting ability
END

// **********************************************************************
// *           Segment Name: gs_CurePoisonSelf.baf
// **********************************************************************

// * CURE POISON ON SELF
// * This has such a high priority because it saves lives all too often.

// * CLERIC_NEUTRALIZE_POISON {4} [SpPr404 - 1404]
IF
  StateCheck(Myself,STATE_POISONED)                                        // and they're poisoned
  HaveSpell(CLERIC_NEUTRALIZE_POISON)                                      // and I have Neutralise Poison
  HPPercentLT(Myself,40)                                                   // and they have <40% hp
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_NEUTRALIZE_POISON)
END

// * CLERIC_SLOW_POISON {2} [SpPr212 - 1212]
IF
  StateCheck(Myself,STATE_POISONED)                                        // and they're poisoned
  HaveSpell(CLERIC_SLOW_POISON)                                            // and I have the spell
  HPPercentLT(Myself,60)                                                   // and they have <40% hp
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_SLOW_POISON)
END

// * INNATE_SLOW_POISON {1} [SpIn102 - 3102] (Bhaalspawn Innate)
IF
  StateCheck(Myself,STATE_POISONED)                                        // and they're poisoned
  HaveSpell(3102)                                                          // and I have the spell
  HPPercentLT(Myself,60)                                                   // and they have <40% hp
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,3102)
END

// **********************************************************************
// *         Segment Name: gs_Antidote.baf
// **********************************************************************

// * ANTIDOTE USE
// * 3 Parts - Drinking, Requesting, and Giving Antidote Potions

// * Antidote-use [POTN20]
IF
  StateCheck(Myself,STATE_POISONED)                                        // if I'm poisoned
  HasItem("POTN20",Myself)                                                 // and I have an antidote
  HPPercentLT(Myself,50)                                                   // and I'm under 50% hp
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("POTN20",Myself)                                               // drink the antidote
    DisplayStringHead(Myself,7029)                                         // say "Antidote"
END

// * Antidote-request [POTN20]
IF
  StateCheck(Myself,STATE_POISONED)                                        // if I'm poisoned
  HPPercentLT(Myself,50)                                                   // and I'm under 50% hp
  !HasItem("POTN20",Myself)                                                // and I don't have an antidote
  PartyHasItem("POTN20")                                                   // but someone in the party does
THEN
  RESPONSE #100
    Shout(POISONED)                                                        // Triggers "cure-poisons" and "potion-passing"
    DisplayStringHead(Myself,14662)                                        // "Poisoned!"
    Continue()
END

// * Antidote-response [POTN20]
IF
  Heard([PC],POISONED)                                                     // if I heard a PC shout that they're poisoned
  HasItem("POTN20",Myself)                                                 // and I have an antidote
THEN
  RESPONSE #100
    GiveItem("POTN20",LastHeardBy(Myself))                                 // hand over the antidote(s)
    DisplayStringHead(Myself,3675)                                         // say "Give and spend..."
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_RunAwayWolf.baf
// **********************************************************************

// * RUN AWAY WOLF

// * DRUID_SHAPESHIFT_WOLF {1} [SpCl612 - 4612]
// * To allow a Druid to use its faster Wolf form to run away better.
IF
  HPPercentLT(Myself,20)                                                   // if health less than 20%
  HaveSpell(4612)                                                          // and I can turn into a wolf
  OR(2)
     AttackedBy([ANYONE],DEFAULT)                                          // and under attack
     Range(NearestEnemyOf(Myself),6)                                       // or the nearest attacker is in melee range
THEN
  RESPONSE #100
    Spell(Myself,4612)                                                     // turn into a wolf
    // DisplayStringHead(Myself,3786) // scream for help
    RunAwayFrom(NearestEnemyOf(Myself),75)                                 // run for 4 segments, then reevaluate
    // UseItem("POTN52",Myself)                                            // use Potion, Extra Heal (only happens if you have one)
END

// **********************************************************************
// *           Segment Name: gs_RunAwayHide.baf
// **********************************************************************

// * MOBILITY IS LIFE
// * [For Thieves and Rangers, includes Hide() command]

// * Nearly-Dead, ergo Run
IF
  HPPercentLT(Myself,20)                                                   // if mage health less than 20%
  OR(2)
     CLASS(Myself,THIEF_ALL)                                               // or I am a Thief
     CLASS(Myself,RANGER_ALL)                                              // or I am a Ranger
  OR(2)
     AttackedBy([ANYONE],DEFAULT)                                        // and under attack
     Range(NearestEnemyOf(Myself),4)                                       // or the nearest attacker is in melee range
//OR(2)
//CheckStatGT(Myself,HIDEINSHADOWS,35)    
//CheckStatGT(Myself,STEALTH,35)
THEN
  RESPONSE #100
    Shout(HELP)                                                            // Triggers "assists" from other PC's
// DisplayStringHead(Myself,3786) // scream for help, visibly
    RunAwayFrom(NearestEnemyOf(Myself),75)                                 // run for 5 segments, then reevaluate
//    UseItem("POTN52",Myself)                                               // use Potion, Extra Heal (only happens if you have one)
    Wait(2)
    Hide()
END

// **********************************************************************
// *           Segment Name: gs_RunAwayNishruu.baf
// **********************************************************************

// * MOBILITY IS LIFE
// * [For Mages, to save them being wiped out of the game by Nishruu's draining]

// * Run if a Nishruu gets too close
IF
  Class(Myself,MAGE_ALL)
  See(NearestEnemyOfType([EVILCUTOFF.0.0.OGRE_MAGE.0.SUMMONED.0]))
//  Gender(LastSeenBy(Myself),SUMMONED)
  Range(LastSeenBy(Myself),10)
THEN
  RESPONSE #100
    RunAwayFrom(LastSeenBy(Myself),60)
END

// **********************************************************************
// *           Segment Name: gs_RunAwayFriendlyFire.baf
// **********************************************************************

// * RUN AWAY FROM FRIENDLY FIRE
// * Still being tested, I think this isn't working.

// * Attacked-By-Charmed: Run from my own party members attacking me
IF
  OR(7)
     AttackedBy([GOODCUTOFF],DEFAULT)
     AttackedBy(Player1,DEFAULT)
     AttackedBy(Player2,DEFAULT)
     AttackedBy(Player3,DEFAULT)
     AttackedBy(Player4,DEFAULT)
     AttackedBy(Player5,DEFAULT)
     AttackedBy(Player6,DEFAULT)
THEN
  RESPONSE #100
//    DisplayStringHead(Myself,2)                                            // Debug String (to be replaced)
    SetInterrupt(FALSE)
    RunAwayFrom(LastAttackerOf(Myself),45)                                   // Run away for 3 seconds or until something better comes up (such as spellcasting).
    SetInterrupt(TRUE)
END

// **********************************************************************
// *           Segment Name: gs_HealSelf_5th+.baf
// **********************************************************************

// * HEAL SELF ROUTINE: 5TH LEVEL SPELLS AND HIGHER

// * CLERIC_HEAL {6} [SpPr607 - 1607]

// * Heal: 10% of >50hp ( 5/50 hp = 45hp+ to heal)
IF
  HaveSpell(CLERIC_HEAL)                                                   // and I have the spell
  HPPercentLT(Myself,10)
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  CheckStatGT(Myself,50,MAXHITPOINTS)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_HEAL)
END

