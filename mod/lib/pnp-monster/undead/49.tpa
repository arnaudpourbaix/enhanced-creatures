// Generated file (don't edit)

// Banshee
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/undead/jam49.baf~

// Fear Aura
CREATE SPL "jas0m49"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m49.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10360)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPPR416C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10361)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=4 range=30 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~jasight~)) + 1 STR_VAR icon="SPPR416B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=24 target=2 power=1 duration=60 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=36 duration=60 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=1 probability1=100 savingthrow=1 STR_VAR resource="EFF_M07" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=4 duration=60 probability1=100 savingthrow=1 STR_VAR resource="EFF_E07" END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
// Death Wail
CREATE SPL "jas1m49"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas1m49.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10365)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI913C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10366)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=4 range=30 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~jasight~)) + 1 STR_VAR icon="SPWI913B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=55 target=2 power=1 parameter1=IDS_OF_SYMBOL (~EA~ ~ANYONE~) parameter2=2 timing=1 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=141 target=2 power=1 parameter2=39 timing=1 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=1 probability1=100 savingthrow=1 STR_VAR resource="CAS_M07" END
	
// Banshee traits
CREATE ITM "jai0m49"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10893)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10893)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10894)
COPY_EXISTING ~jai0m49.itm~ ~override~
	LPF nonMagicalWeapons_immunity END
	LPF magicResistance_resistance END
	LPF incorporeal_trait END
	LPF cold_immunity END
	LPF lightning_immunity END

// Touch
CREATE ITM "jai1m49"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10357)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10357)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IFIST~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10895)
	WRITE_LONG 0x60 2
COPY_EXISTING ~jai1m49.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IFIST~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 1
		WRITE_BYTE 0x84 3
		WRITE_BYTE 0x88 8
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 2
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

DEFINE_ACTION_FUNCTION jam49_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BANSHE01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BD302BAN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~FIRMON01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~B1-8M2~
			REMOVE_CRE_ITEM ~IMMCHS~
			ADD_CRE_ITEM ~jai0m49~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m49~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~jas0m49~ #0 ~innate~ (1) // Fear Aura
			ADD_MEMORIZED_SPELL ~jas1m49~ #0 ~innate~ (1) // Death Wail
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=4000
					hp=84
					ac=0
					thac0=13
					apr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=17
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=9
					intelligence=16
					wisdom=11
					dexterity=14
					constitution=9
					charisma=17
					morale=13
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~WRAITH~)
					class=IDS_OF_SYMBOL (~class~ ~SPECTRE~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=12
					enforce=1
			END
			// Assigning jam49
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDBANSH banshe01 f_wailin BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MM2GE DW2MS2BE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2GE DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam49 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BANSHE01"
	"BD302BAN"
	"FIRMON01"
BEGIN
	LAF jam49_patch STR_VAR file END
END