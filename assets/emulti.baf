// **********************************************************************
// *           Segment Name: gs_HotKeyS_Mage_HighLevel.baf
// **********************************************************************

// * HotKey(S) Based Summoning - 5th LEVEL MAGE SPELLS AND ABOVE

// * Set the Timer to 3rnds when the HotKey is pressed
// * (This is here for redundancy, so that if this is the only Summon Snippet included, it still works)
// * Set the 3 round Timer when the HotKey is pressed
IF
  !GlobalTimerNotExpired("gh_SummonTimer","LOCALS")                        // if the counter is at 0
  HotKey(S)                                                                // and the players pressed the B Key
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SummonTimer","LOCALS",18)                           // set the Timer to 3 rounds (gets us 3 buff spells)
END

// * WIZARD_SUMMON_HAKEASHAR {7} [SpWi719 - 2719] (Summons 1 Hakeashar: HAKSU.CRE ~11HD, 8 rnd + 1 rnd/CL, Anti-Mage, Removes Spells)
// * Not on hot key

// * WIZARD_SUMMON_PLANATAR_GOOD {9} [SpWi923 - 2923]
// * ---------------------------------------------------------
// * CS: 5, TGT: ANPWR, RNG: 40', AOE: N/A , DUR: 78-144s
// * ---------------------------------------------------------
// * Summons Planetar [PLANGOOD], 4R+1R/CL, All you need to know is that they are BAMFers
// * PnP Celestials Version
// * Summons Planetar [CA#PLAN], 4R+1R/CL, All you need to know is that they are even more BAMFers
IF
  HaveSpellRES("spwi923")                                                  // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalTimerNotExpired("gh_SummonTimer","LOCALS")                         // if its less than 3rnds since S was pressed
  !GlobalTimerNotExpired("gh_NoSummons","GLOBAL")                          // and there aren't any summon-preventing effects
  NumCreature([GOODCUTOFF.0.SOLAR.0.0.0.0],0)
  NumCreature([GOODCUTOFF.0.ANTISOLAR.0.0.0.0],0)
  NumCreature([GOODCUTOFF.0.PLANATAR.0.0.0.0],0)
  NumCreature([GOODCUTOFF.0.DARKPLANATAR.0.0.0.0],0)
  NumCreatureLT([GOODCUTOFF.0.0.0.0.SUMMONED],5)                           // and the number of summoned helpers is <6
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("spwi923",Myself)
END

// * WIZARD_SUMMON_PLANATAR_EVIL {9} [SpWi924 - 2924] (Summons 1 Planatar: PLANEVIL.CRE ~14HD, 4 rnds + 1 rnd/CL)
// * ---------------------------------------------------------
// * CS: 5, TGT: ANPWR, RNG: 40', AOE: N/A , DUR: 78-144s
// * ---------------------------------------------------------
// * Summons Planetar [PLANEVIL], 4R+1R/CL, All you need to know is that they are BAMFers
IF
  HaveSpellRES("spwi924")                                                  // and we have the spell
  OR(2)
