END

// * HARP_OF_DISCORD [MISC3M, Confusion 3x/day, Save vs. Spells, 30s]
IF
  HasItemEquiped("MISC3M",Myself)                                          // and I have the harp
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 2+
  GlobalLT("EK_UsedMISC3M","LOCALS",3)                                     // if we haven't used the item 3 times today already
  !General(LastSeenBy(Myself),UNDEAD)                                      // and they're not undead
  !Race(LastSeenBy(Myself),SLIME)                                          // and they're not in the slime family
  !Race(LastSeenBy(Myself),DRAGON)                                         // and they're not in the dragon family
  !Race(LastSeenBy(Myself),TROLL)                                          // and they're not in the troll family
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself), GOODCUTOFF)                              // and not an Ally, Familiar, Minion or Simulacrum
  !Range(LastSeenBy(Myself),6)                                             // and they're not within 6 ssq as we would prefer a confused enemy to attack someone else
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >20hp
  !StateCheck(LastSeenBy(Myself),STATE_CONFUSED)                           // and the target isn't already confused
  CheckStatGT(LastSeenBy(Myself),10,SAVEVSSPELL)                           // and our target doesn't have an impossible to beat saving throw
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("MISC3M",LastSeenBy(Myself))                                   // cast the spell
    IncrementGlobal("EK_UsedMISC3M","LOCALS",1)                            // increment the global by 1 each time the item is used in a day
    DisplayStringHead(Myself,38790)                                        // "Harp of Discord"
END

