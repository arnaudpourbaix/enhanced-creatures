// Try to reposition to use ranged attack
IF
	ActionListEmpty()
	CanEquipRanged()
	Range(NearestEnemyOf(Myself),4)
THEN
	RESPONSE #50
		SetInterrupt(FALSE)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
		SetInterrupt(TRUE)
	RESPONSE #50
		Continue()
END

// Attack NoCheck enemy
