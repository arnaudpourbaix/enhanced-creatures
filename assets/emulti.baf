// **********************************************************************
// *           Segment Name: gs_HealOther_Response.baf
// **********************************************************************

// * COOPERATIVE HEALING: Server
// * ---------------------------

// * CHECK FOR HEALER-STATE

// * Do I have any healing spells?
IF
  Global("gh_NoHealingSpells","LOCALS",0)
  !HaveSpell(3101)                                 // INNATE_CURE_LIGHT_WOUNDS
  !HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
  !HaveSpell(CLERIC_CURE_MEDIUM_WOUNDS)
  !HaveSpell(CLERIC_CURE_SERIOUS_WOUNDS)
  !HaveSpell(CLERIC_CURE_CRITICAL_WOUNDS)
  !HaveSpell(CLERIC_HEAL)
THEN
  RESPONSE #100
    SetGlobal("gh_NoHealingSpells","LOCALS",1)
END

// Reset: Do I have any healing spells?
IF
  Global("gh_NoHealingSpells","LOCALS",1)
  OR(6)
     HaveSpell(3101)                               // INNATE_CURE_LIGHT_WOUNDS
     HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
     HaveSpell(CLERIC_CURE_MEDIUM_WOUNDS)
     HaveSpell(CLERIC_CURE_SERIOUS_WOUNDS)
     HaveSpell(CLERIC_CURE_CRITICAL_WOUNDS)
