// Summons are destroyed on death
IF
	Die()
THEN
	RESPONSE #100
		DestroySelf()
END

// Precast Stoneskin
IF
	Global("JA_PRECAST_LONG","LOCALS",0)
	HaveSpellRES("SPWI408")
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPWI408",Myself)
		RemoveSpellRES("SPWI408")
		Continue()
END

// Precast Ironskin
IF
	Global("JA_PRECAST_LONG","LOCALS",0)
	HaveSpellRES("SPPR506")
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPPR506",Myself)
		RemoveSpellRES("SPPR506")
		Continue()
END

IF
	Global("JA_PRECAST_LONG","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("JA_PRECAST_LONG","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,EVILCUTOFF)
	See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,GOODCUTOFF)
	See([EVILCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Shouts every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	!GlobalTimerNotExpired("JA_HELP","LOCALS")
THEN
	RESPONSE #100
		Shout(98)
		SetGlobalTimer("JA_HELP","LOCALS",18)
END

// React to shouts
IF
	Global("JA_COMBAT","LOCALS",0)
	Heard(LastSummonerOf(Myself),98)
	InMyArea(LastSummonerOf(Myself))
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Heard(LastSummonerOf(Myself),98)
	InMyArea(LastSummonerOf(Myself))
	!See([GOODCUTOFF])
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

// Summon follow summoner
IF
	Global("JA_COMBAT","LOCALS",0)
	!StateCheck(Myself,STATE_BLIND)
	ActionListEmpty()
	!See(NearestEnemyOf(Myself))
	!See(LastSummonerOf(Myself))
	HPGT(LastSummonerOf(Myself),0)
	Range(LastSummonerOf(Myself),150)
THEN
	RESPONSE #100
		MoveToObject(LastSummonerOf(Myself))
END

// Do nothing if...
IF
	ActionListEmpty()
	OR(4)
		Global("JA_COMBAT","LOCALS",0)
		!Allegiance(Myself,EVILCUTOFF)
		StateCheck(Myself,STATE_IMMOBILE)
		StateCheck(Myself,STATE_REALLY_DEAD)
THEN
	RESPONSE #100
		NoAction()
END

IF
	ActionListEmpty()
	!InActiveArea(Myself)
	!Range(NearestEnemyOf(Myself),30)
THEN
	RESPONSE #100
		NoAction()
END

// Handle Panic state
IF
	StateCheck(Myself,STATE_PANIC)
	Range(NearestEnemyOf(Myself),10)
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),15)
END

IF
	StateCheck(Myself,STATE_PANIC)
THEN
	RESPONSE #100
		RandomWalkContinuous()
END

// Charge
IF
	ActionListEmpty()
	HaveSpellRES("jas0m44")
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	!General(FarthestEnemyOf(Myself),WEAPON)
	!CheckStatGT(FarthestEnemyOf(Myself),0,SANCTUARY)
	!StateCheck(FarthestEnemyOf(Myself),STATE_REALLY_DEAD)
	See(FarthestEnemyOf(Myself))
	Range(LastSeenBy(Myself),50)
	!Range(LastSeenBy(Myself),20)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jas0m44",LastSeenBy(Myself))
		AttackOneRound(LastSeenBy(Myself))
		SetInterrupt(TRUE)
END

IF
	ActionListEmpty()
	HaveSpellRES("jas0m44")
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	!General(SecondFarthestEnemyOf(Myself),WEAPON)
	!CheckStatGT(SecondFarthestEnemyOf(Myself),0,SANCTUARY)
	!StateCheck(SecondFarthestEnemyOf(Myself),STATE_REALLY_DEAD)
	See(SecondFarthestEnemyOf(Myself))
	Range(LastSeenBy(Myself),50)
	!Range(LastSeenBy(Myself),20)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA_ROUND","LOCALS",6)
