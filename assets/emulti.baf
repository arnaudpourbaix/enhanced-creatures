// **********************************************************************
// *           Segment Name: gs_Buffs_TL4_Mage.baf
// **********************************************************************

// * THREAT LEVEL 4 ENHANCER "BUFF" SPELLS - MAGE

// * WIZARD_IMPROVED_ALACRITY {9} [SpWi921 - 2921] (Removes 6 sec wait between actions)
IF
  HaveSpell(2921)                                                          // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
  !CheckStatGT(Myself,0,AURACLEANSING)                                     // and we aren't already under the effects of the spell
  NumCreatureGT([EVILCUTOFF],4)                                            // and there are 5+ monsters
  !Range(NearestEnemyOf(Myself),4)                                         // and the nearest enemy is >4 distant (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as anitmagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't select a spell action this round (which wastes time)
    DisplayStringHead(Myself,63217)                                        // "Improved Alacrity"
    Spell(Myself,2921)
END

// * WIZARD_IMPROVED_HASTE {6} [SpWi613 - 2613]
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)
IF
  HaveSpell(WIZARD_IMPROVED_HASTE)                                         // and we have the spell
  !StateCheck(LastSeenBy(Myself),STATE_HASTED)                             // and not already hasted
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
  NumInPartyGT(2)                                                          // and theres at least 3 of us
  NumCreatureGT([EVILCUTOFF],4)                                            // and there are 5+ monsters
  OR(4)
     See(Myself)                                                           // target the spell on self
     See(NearestMyGroupOfType([0.0.0.FIGHTER_ALL.0.0.0]))                  // target the spell of any PC Fighter
     See(NearestMyGroupOfType([0.0.0.RANGER_ALL.0.0.0]))                   // target the spell of any PC Ranger
     See(NearestMyGroupOfType([0.0.0.PALADIN_ALL.0.0.0]))                  // target the spell of any PC Paladin
  !HasBounceEffects(LastSeenBy(Myself))                                    // and they're not spell-turning
//  !HasImmunityEffects(LastSeenBy())                                        // and they're not spell-immune
  !StateCheck(LastSeenBy(Myself),STATE_NOT_VISIBLE)                        // and not invisible/impinvis
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_IMPROVED_HASTE)                        // cast Haste on them
END

// **********************************************************************
// *           Segment Name: gs_Buffs_TL4_Priest.baf
// **********************************************************************

// * THREAT LEVEL 4 ENHANCER "BUFF" SPELLS - PRIEST

// * 4: Enhancers/DefendOthers

// * CLERIC_WONDROUS_RECALL [retrieves cast spells - unusable?]
// * Scriptable, see GB-Priest.baf for example
// * Now I just have to figure out how to tie it in with the gSeries

// **********************************************************************
// *           Segment Name: gs_Buffs_TL4_Items.baf
// **********************************************************************

// * THREAT LEVEL 4 ENHANCER "BUFF" SPELLS - ITEMS

// * 4: Enhancers/DefendOthers

// * 4: THIEF::ENHANCING POTIONS/ITEMS

// * ROGUES_POTION_OF_FROST_GIANT_STRENGTH [POTN56] dur: 600s
IF
  HasItemEquiped("POTN56",Myself)                                          // and I have a Potion of Frost Giant Strength
  CheckStatLT(Myself,21,STR)                                               // and PC Strength < 21
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(2)                                                                    // am I an appropriate class to use this item?
     Class(Myself,THIEF_ALL)
     Class(Myself,BARD_ALL)
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // if its a level 4 combat
  OR(2)
     HPGT(NearestEnemyOf(Myself),100)                                      // if nearest foe is >100hp
     NumCreatureGT([EVILCUTOFF],6)                                         // and more than 7 foes
  Range(NearestEnemyOf(Myself),4)                                          // and theres a foe nearby, so Melee is likely
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("POTN56",Myself)                                               // drink the Potion of Frost Giant Strength
    DisplayStringHead(Myself,71145)                                        // say "Rogue's Potion of Frost Giant Strength"
END

// * 4: FIGHTER::ENHANCING POTIONS/ITEMS

// * POTION_OF_HEROISM [POTN09] dur: 600s
IF
  HasItemEquiped("POTN09",Myself)                                          // and I have a Potion of Heroism
  !GlobalTimerNotExpired("GB_PotnHero","LOCALS")                           // and the 10 turn timer has expired
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(3)
     Class(Myself,FIGHTER_ALL)
     Class(Myself,PALADIN_ALL)
     Class(Myself,RANGER_ALL)
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // if its a level 4 combat
  NumCreatureGT([EVILCUTOFF],4)                                            // and more than 5 foes
  Range(NearestEnemyOf(Myself),6)                                          // and theres a foe nearby, so Melee is likely
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     //set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobalTimer("GB_PotnHero","LOCALS",600)                             // set a 10 turn timer so we don't try to drink another Potion of Heroism
    UseItem("POTN09",Myself)                                               // drink the Potion of Heroism
    DisplayStringHead(Myself,6994)                                         // "Potion of Heroism"
END

// * POTION_OF_INVULNERABILITY [POTN11] dur: 300s
IF
  HasItemEquiped("POTN11",Myself)                                          // and I have a Potion of Invulnerability
  !GlobalTimerNotExpired("GB_PotnInvuln","LOCALS")                         // and the 5 turn timer has expired
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(3)
     Class(Myself,FIGHTER_ALL)
     Class(Myself,PALADIN_ALL)
     Class(Myself,RANGER_ALL)
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // if its a level 4 combat
  NumCreatureGT([EVILCUTOFF],4)                                            // and more than 5 foes
  Range(NearestEnemyOf(Myself),4)                                          // and theres a foe nearby, so Melee is likely
  OR(6)
     CheckStatGT(Myself,0,ARMORCLASS)                                      // or my AC >0
     CheckStatGT(Myself,5,SAVEVSDEATH)                                     // or my Save Vs Death >5
     CheckStatGT(Myself,5,SAVEVSWANDS)                                     // or my Save Vs Wands >5
     CheckStatGT(Myself,5,SAVEVSPOLY)                                      // or my Save Vs Polymorph >5
     CheckStatGT(Myself,5,SAVEVSBREATH)                                    // or my Save Vs Breath Weapons >5
     CheckStatGT(Myself,5,SAVEVSSPELL)                                     // or my Save Vs Spells >5
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     //set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobalTimer("GB_PotnInvuln","LOCALS",300)                           // set a 5 turn timer so we don't try to drink another Potion of Heroism
    UseItem("POTN11",Myself)                                               // drink the Potion of Heroism
    DisplayStringHead(Myself,6998)                                         // "Potion of Invulnerability"
END

// * AMULET_OF_CHEETAH_SPEED [AMUL26] Movement Rate +2, Improved Haste 1x/day, dur: 138s
IF
  HasItemEquiped("BRAC16",Myself)                                          // and we have the item equipped
  !StateCheck(Myself,STATE_HASTED)                                         // and not already hasted
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
  Global("EK_UsedAMUL26","LOCALS",0)                                       // if we haven't used the item once today already
  NumCreatureGT([EVILCUTOFF],4)                                            // and there are 5+ monsters
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("BRAC16",Myself)
    SetGlobal("EK_UsedAMUL26","LOCALS",1)                                  // set global to 1 to prevent re-use in a single day
    DisplayStringHead(Myself,64967)                                        // "Amulet of Cheetah Speed"
END

