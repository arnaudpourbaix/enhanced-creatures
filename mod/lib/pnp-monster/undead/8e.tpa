DEFINE_ACTION_FUNCTION jam8e_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ZOMBLO01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring94~
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~b1-8~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~b3-12~
			REMOVE_CRE_ITEM ~ghast1~
			ADD_CRE_ITEM ~jai0m56~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			REPLACE_CRE_ITEM ~jai0m8e~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_MEMORIZED_SPELL ~jas6m8e~ #0 ~innate~ (1) // Odor of Death
			ADD_MEMORIZED_SPELL ~jas7m8e~ #4 ~wizard~ (1) // Animate Dead
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=650
					hp=72
					ac=6
					thac0=15
					apr=2
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=9
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=16
					intelligence=9
					wisdom=6
					dexterity=14
					constitution=9
					charisma=5
					morale=9
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~ZOMBIE~)
					class=IDS_OF_SYMBOL (~class~ ~ZOMBIE_NORMAL~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~)
					movement=5
					enforce=1
			END
			// Assigning jam8e
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam8e END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"ZOMBLO01"
	BEGIN
		LAF jam8e_patch STR_VAR file END
	END
END