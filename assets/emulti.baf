// **********************************************************************
// *           Segment Name: es_Credits_eMulti.baf
// **********************************************************************
// *
// * eMulti.baf
// * -----------
// * AI Script for:             Baldurs Gate II: Shadows of Amn and Throne of Bhaal
// * Written by:                Greg Hodgson
// * Modified by:               Eric Kerr to update gMulti to include TOB Spells, Powers, and Items
// * Version:                   Version 1.8 (13 August 2006)
// * Comments to:               cirerrek@hotmail.com
// * Depends on:                state.ids
//                              shout.ids
//                              spell.ids
//                              specific.ids
//                              action.ids
//                              trigger.ids
//                              stat.ids
//                              kit.ids
//                              shoutids.ids
//
// * Description:
// *
// * A generic Multi_Class script, this is designed for use with any of the combination
// * types in BG2:SOA or TOB. It favours spell use over physical
// * attacks (as do all the gSeries/eSeries) and is a very competent generalist script.

// **********************************************************************
// *           Segment Name: ek_SetWeaponPreference.baf
// **********************************************************************

IF
  HotKey(F)                                          // and I hit the F key
  Global("hlid_UseRangedWeapon","LOCALS",1)          // and the global, hlid_UseRangedWeapon, is set to 1
THEN
  RESPONSE #100
    EquipMostDamagingMelee()
    SetGlobal("hlid_UseRangedWeapon","LOCALS",0)     // set the global, hlid_UseRangedWeapon to 0
    SmallWait(1)
    DisplayStringHead(Myself,15529)                  // say "Melee!"
END

IF
  HotKey(F)                                          // and I hit the F key
  Global("hlid_UseRangedWeapon","LOCALS",0)          // and the global, hlid_UseRangedWeapon, is set to 0
THEN
  RESPONSE #100
    EquipRanged()
    SetGlobal("hlid_UseRangedWeapon","LOCALS",1)     // set the global, hlid_UseRangedWeapon to 1
    SmallWait(1)
    DisplayStringHead(Myself,9403)                   // say "Missile Weapons"
END

// **********************************************************************
// *         Segment Name: gs_UnhideGUI.baf
// **********************************************************************

// * UNHIDE GUI/PAUSE ON PLAYER-DAMAGE OR POISON

// * GUI Manipulation
IF
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(2)
     HPPercentLT(Myself,50)                                                // if I'm less 50% hp
     StateCheck(Myself,STATE_POISONED)                                     // or I'm poisoned
THEN
  RESPONSE #100
    UnhideGUI()
    Continue()
END

// * On near-death of PC
IF
  HPPercentLT(Myself,25)                                                   // or I have less than 20% of total hitpoints
  OR(2)
     !CombatCounter(0)                                                     // and combat is still going
     See(NearestEnemyOf(Myself))                                           // or we can still see an enemy
  Global("gh_HavePaused","LOCALS",0)                                       // and we haven't already stopped here
THEN
  RESPONSE #100
    SetGlobal("gh_HavePaused","LOCALS",1)                                  // set a flag (prevents repeated annoying stops)
    UnhideGUI()                                                            // unhide the GUI bars (if they're hidden)
    DisplayStringHead(Myself,7666)                                         // "Auto-Pause: Scripted" above players head
    ClickLButtonObject(Myself,0)                                           // select the PC
    PauseGame()                                                            // pause the game
END

// * RESETS

// * If a variable has been set, reset it
IF
  ActionListEmpty()                                                        // if we're not doing anything
  !Detect(NearestEnemyOf(Myself))                                          // combat is over
  Global("gh_HavePaused","LOCALS",1)                                       // and we set this players pause-flag
  Delay(30)                                                                // ensures its not reset straight away
THEN
  RESPONSE #100
    SetGlobal("gh_HavePaused","LOCALS",0)
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_AIOffSwitch.baf
// **********************************************************************

// * AI OFF SWITCH ROUTINE

// * If AI is off, check for switching it back on
// * E=Enable AI
IF
  HotKey(E)
  Global("gh_AIOffSwitch","LOCALS",1)
THEN
  RESPONSE #100
    SetGlobal("gh_AIOffSwitch","LOCALS",0)
    SmallWait(1)
    DisplayStringHead(Myself,16469)                                        // "On"
END

// * If AI is on, check for switching if off
// * D=Disable AI
IF
  HotKey(D)
  Global("gh_AIOffSwitch","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("gh_AIOffSwitch","LOCALS",1)
    SmallWait(1)
    DisplayStringHead(Myself,16470)                                        // "Off"
END

// * If AI is off, abort this script
IF
  ActionListEmpty()                                                        // player hasn't given any commands
  Global("gh_AIOffSwitch","LOCALS",1)                                      // AI switch is set to off
THEN
  RESPONSE #100
END

// **********************************************************************
// *           Segment Name: gs_SummonFlags.baf
// **********************************************************************

// * SUMMON-FLAG SETTING, TO PREVENT WASTED SUMMON SPELLS
// * [Sets Global Timer if anti-summon spells are used.]

//** Special DeathFog Handling, for Enemy Casting it.
IF
  SpellCast([ANYONE],WIZARD_DEATH_FOG)
  !GlobalTimerNotExpired("gh_NoSummons","GLOBAL")
THEN
  RESPONSE #100
// DisplayStringHead(Myself,7621)       // "Death Fog!"
    SetGlobalTimer("gh_NoSummons","GLOBAL",50)
//** This snippet restarts the script **//
END

//** Death Spell Handling, Shorter duration since its a "blast" not a "fog"
IF
  SpellCast([ANYONE],WIZARD_DEATH_SPELL)
  !GlobalTimerNotExpired("gh_NoSummons","GLOBAL")
THEN
  RESPONSE #100
// DisplayStringHead(Myself,7917)       // "Death Spell!"
    SetGlobalTimer("gh_NoSummons","GLOBAL",15)                             // 3round Summon-preventing Timer
//** This snippet restarts the script **//
END// **********************************************************************
// *           Segment Name: gs_GlobalResets_Items.baf
// **********************************************************************

// Reset Combat Variables when combat is through
IF
  Global("hp_RESET","LOCALS",0)
  CombatCounterGT(0)                                                       // first, get set up when combat commences
THEN
  RESPONSE #100
    SetGlobal("hp_RESET","LOCALS",1)
END

IF
  Global("hp_RESET","LOCALS",1)
  CombatCounter(0)
  !Detect([EVILCUTOFF])
THEN
  RESPONSE #100
    SetGlobal("hp_RESET","LOCALS",0)
    SetGlobal("gh_MeleeMissileToggle","LOCALS",0)
    SetGlobal("gh_ActionIsInterruptable","LOCALS",0)
    SetGlobal("gh_SpellCastThisRound","LOCALS",0)
    SetGlobal("gh_SummonTimer","LOCALS",0)
    SetGlobal("gh_TurnUndead","LOCALS",0)
    SetGlobal("gh_BuffTimer","LOCALS",0)
    SetGlobal("gh_ThreatLevel","LOCALS",0)
    SetGlobal("EK_BackStab","LOCALS",0)                                    // set ready for backstab flag
END

// * MISC3C, MISC3K, MISC3J, MISC3I, MISC3E, MISC7T, MISC3D, TOME04,
