	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	!ImmuneToSpellLevel(LastSeenBy(Myself),7)
