// Dimension Door
IF
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	ActionListEmpty()
	HaveSpellRES("jas1f8")
	OR(2)
		Range(NearestEnemyOf(Myself),15)
		AttackedBy([ANYONE],DEFAULT)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		CreateCreatureOffscreen("RR#TRAT",0)
		ForceSpellRES("jas1f8","RR#TRAT")
		RemoveSpellRES("jas1f8")
		Wait(1)
		SetInterrupt(TRUE)
END

// Call Woodland Beeings
IF
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	!GlobalTimerNotExpired("Summoning","LOCALS")
	ActionListEmpty()
	HaveSpell(CLERIC_CALL_WOODLAND_BEINGS)
	!HaveSpell(WIZARD_MONSTER_SUMMONING_LEVEL_8)
	!HaveSpell(CLERIC_GATE)
	!HaveSpell(CLERIC_SUMMON_DEATH_KNIGHT)
	!HaveSpell(CLERIC_ANIMAL_SUMMONING_LEVEL_7)
	!HaveSpell(WIZARD_MONSTER_SUMMONING_LEVEL_7)
	!HaveSpell(CLERIC_ANIMATE_SKELETON_WARRIOR)
	!HaveSpellRES("D5P2632")
	!HaveSpell(WIZARD_SHADES)
	!HaveSpellRES("D5PP422")
	!HaveSpell(CLERIC_AERIAL_SERVANT)
	!HaveSpell(CLERIC_ANIMAL_SUMMONING_LEVEL_6)
	!HaveSpell(WIZARD_MONSTER_SUMMONING_LEVEL_6)
	!HaveSpell(CLERIC_ANIMAL_SUMMONING_LEVEL_5)
	!HaveSpell(WIZARD_MONSTER_SUMMONING_LEVEL_5)
	!HaveSpellRES("D5P2527")
	!HaveSpell(WIZARD_SUMMON_SHADOW)
	RandomNumGT(800,240)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpell(LastSeenBy(Myself),CLERIC_CALL_WOODLAND_BEINGS)
		RemoveSpell(CLERIC_CALL_WOODLAND_BEINGS)
		SetGlobalTimer("Summoning","LOCALS",12)
END

// Bless
IF
	!StateCheck(Myself,STATE_SILENCED)
	ActionListEmpty()
	HaveSpell(CLERIC_BLESS)
	RandomNumGT(801,240)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(NearestAllyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!Gender(LastSeenBy(Myself),SUMMONED)
	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
	!ImmuneToSpellLevel(LastSeenBy(Myself),1)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpell(LastSeenBy(Myself),CLERIC_BLESS)
		RemoveSpell(CLERIC_BLESS)
END

