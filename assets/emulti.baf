     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  Range(LastAttackerOf(Myself),4)                                          // attacker <4 steps away, therefore melee
  HPGT(LastAttackerOf(Myself),30)                                          // and attacker has >30hp
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_PROTECTION_FROM_NORMAL_WEAPONS)
END

// * GENERIC

// * WIZARD_MISLEAD {6} [SpWi607 - 2607] (Summons 1 Clone of Caster w/same HP, clone cannot make physical attacks or cast spells but is able to move around, improved invisibility is applied to caster, 1R/CL)
IF
  HaveSpell(WIZARD_MISLEAD)                                                // and we have the spell
  CheckStatLT(Myself,1,PUPPETTYPE)                                      // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // or its threat-level 3
  AttackedBy([ANYONE],DEFAULT)                                           // if attacked
  !StateCheck(Myself,STATE_NOT_VISIBLE)                                    // and I'm invisbel or improved invisible (improved invisible is a side effect of the spell)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_MISLEAD)
END

// **********************************************************************
// *           Segment Name: gs_DefencesGeneric_TL3_Priest.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 3 (PRIEST)

// * ANTI-MELEE/MISSILE

// * CLERIC_BLADE_BARRIER 'ds' {6} [SpPr603 - 1603] (!NPF, 8d8 SLASHING dmg, STvS Negates, 1T)
// * Detectable Spell
// * Requires Mod Stat.IDS File (CLERIC_BLADE_BARRIER)
IF
  HaveSpell(CLERIC_BLADE_BARRIER)                                          // and we have Blade Barrier
  CheckStatLT(Myself,1,CLERIC_BLADE_BARRIER)                               // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // and its threat-level 4+
  NumCreatureGT([EVILCUTOFF],4)                                            // and theres 5+ enemies
  HPGT(LastSeenBy(Myself),50)                                              // and the target has 50+ hp
  OR(2)
     Range(Player1,0)                                                      // either I'm player1
     !Range(Player1,4)                                                     // or player1 is at a safe distance
  OR(2)
     Range(Player2,0)                                                      // either I'm player2
     !Range(Player2,4)                                                     // or player2 is at a safe distance
  OR(2)
     Range(Player3,0)                                                      // either I'm player3
     !Range(Player3,4)                                                     // or player3 is at a safe distance
  OR(2)
     Range(Player4,0)                                                      // either I'm player4
     !Range(Player4,4)                                                     // or player4 is at a safe distance
  OR(2)
     Range(Player5,0)                                                      // either I'm player5
     !Range(Player5,4)                                                     // or player5 is at a safe distance
  OR(2)
     Range(Player6,0)                                                      // either I'm player6
     !Range(Player6,4)                                                     // or player6 is at a safe distance
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !Range(NearestEnemyOf(Myself),4)                                         // and theres an enemy within 8sq
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_BLADE_BARRIER)
END

// * CLERIC_DIVINE_SHELL {6} [CDDSHEL]
// * Requires G3's Divine Remix
// * Requires Mod Stat.IDS File (WIZARD_PROTECTION_FROM_NORMAL_MISSILES)
// * --------------------------------------------
// * CS: 6, TGT: Caster, RNG: 1', AOE: Caster
// * --------------------------------------------
// * Protection from Normal Missiles - 48s
// * +2 AC
// * +2 all STs
// * +10% to FIRE, COLD, ELECTRICITY, & ACID Resistance - 48s
IF
  HaveSpellRES("CDDSHEL")                                                  // and we have the spell
  !CheckStat(Myself,1,WIZARD_PROTECTION_FROM_NORMAL_MISSILES)              // and aren't already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  OR(11)
     !Range(LastAttackerOf(Myself),4)                                      // attacked >4 steps away, therefore ranged
     HasItemEquiped("AROW01",LastAttackerOf(Myself))
     HasItemEquiped("AROW02",LastAttackerOf(Myself))
     HasItemEquiped("AX1H04",LastAttackerOf(Myself))
     HasItemEquiped("BOLT01",LastAttackerOf(Myself))
     HasItemEquiped("BULL01",LastAttackerOf(Myself))
     HasItemEquiped("DAGG05",LastAttackerOf(Myself))
     HasItemEquiped("DART01",LastAttackerOf(Myself))
     HasItemEquiped("DWBOLT03",LastAttackerOf(Myself))
     HasItemEquiped("KUOBOLT",LastAttackerOf(Myself))
     HasItemEquiped("SAHBOLT",LastAttackerOf(Myself))
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("CDDSHEL",LastSeenBy(Myself))                                 // cast the spell
END

