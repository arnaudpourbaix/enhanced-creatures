// **********************************************************************
// *           Segment Name: gs_TargetCleric.baf
// **********************************************************************

// * TARGETING ROUTINE - CLERIC
// * [Targets appropriate Clerics]

// * Requires Mod State.IDS file (STATE_NOT_VISIBLE, STATE_HARMLESS)

// * Cleric as Priority Target-Choice
// * --------------------------------
// * If we a Priest is the nearest enemy, target them instead

IF
  HPGT(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]),5)                        // and have more than 5 hp
  !InParty(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]))                      // and they're not in our party
  !StateCheck(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]),STATE_NOT_VISIBLE) // and not invisible/impinvis
  !StateCheck(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]),STATE_HARMLESS)    // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]),INNOCENT)               // and not an "innocent"
  See(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]))                           // they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_TargetMage.baf
// **********************************************************************

// * TARGETING ROUTINE - MAGE
// * [Targets appropriate Mages]

// * Requires Mod State.IDS file (STATE_NOT_VISIBLE, STATE_HARMLESS)
// * Requires Mod Class.IDS flie (MAGE_ALL)

// * Mage as Priority Target-Choice
// * ------------------------------
// * If we see a mage, target them

IF
  HPGT(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]),5)                        // and have more than 5 hp
  !InParty(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]))                      // and they're not in our party
  !StateCheck(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]),STATE_NOT_VISIBLE) // and not invisible/impinvis
  !StateCheck(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]),STATE_HARMLESS)    // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(NearestEnemyOfType([0.0.0.MAGE_ALL]),INNOCENT)                     // and not an "innocent"
  !Race(LastSeenBy(Myself),WYVERN)                                          // and not a Wyvern
  See(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]))                           // they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_TargetHelpCaller.baf
// **********************************************************************

// * TARGETING ROUTINE - TARGET ALLY WHO CALLED FOR HELP

// * Requires Mod State.IDS file (STATE_NOT_VISIBLE, STATE_HARMLESS)

// * If another PC called for help, target their attacker
IF
  OR(2)
     Heard([PC.0.0.0.0.0.0],HELP)                                          // if a PC needs Help
     Heard([PC.0.0.0.0.0.0],2001)                                          // if a PC needs Help
  !InParty(LastAttackerOf(LastHeardBy(Myself)))                            // and they're not in our party
  !StateCheck(LastAttackerOf(LastHeardBy(Myself)),STATE_NOT_VISIBLE)       // and not invisible/impinvis
  !StateCheck(LastAttackerOf(LastHeardBy(Myself)),STATE_HARMLESS)          // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(LastAttackerOf(LastHeardBy(Myself)),INNOCENT)                     // and not an "innocent"
  See(LastAttackerOf(LastHeardBy(Myself)))                                 // they're our new target
THEN
  RESPONSE #100
//    DisplayStringHead(Myself,45363)                                        // "Cease your screaming! You are not helping my nerves with your shouts!"
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_TargetAttackerOfSelf.baf
// **********************************************************************

// * TARGETING ROUTINE - TARGET ATTACKER OF SELF

// * Requires Mod State.IDS file (STATE_NOT_VISIBLE, STATE_HARMLESS)

// * If we're under attack, use that as the Target instead of all others
IF
  AttackedBy([ANYONE],DEFAULT)                                             // if we are being attacked
  !InParty(LastAttackerOf(Myself))                                         // and they're not in our party
  !StateCheck(LastAttackerOf(Myself),STATE_NOT_VISIBLE)                    // and not invisible/impinvis
  !StateCheck(LastAttackerOf(Myself),STATE_HARMLESS)                       // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(LastAttackerOf(Myself),INNOCENT)                                  // and not an "innocent"
  See(LastAttackerOf(Myself))                                              // they're our new target
THEN
  RESPONSE #100
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_AntiMage_TL4_Mage.baf
// **********************************************************************

// * ANTI-MAGE ATTACK SPELLS - THREAT LEVEL FOUR (Mage)

// * PART ONE - ANTI-MAGE SHIELD

// * 4: Reactions

// * Reverse ordered to use lower level spells first

// * WIZARD_SPELL_THRUST {3} [SpWi321 - 2321] (Anti-Magic Protections - 5th Lvl or Lower)
// * Requires Mod Stat.IDS file (WIZARD_SPELL_SHIELD, WIZARD_SPELL_DEFLECTION, WIZARD_SPELL_TURNING, WIZARD_SPELL_IMMUNITY)

// * Removes
// * Minor Spell Deflection
// * Minor Globe of Invulnerability
// * Minor Spell Turning
// * Spell Immunity
// * Spell Shield
IF
  HaveSpell(WIZARD_SPELL_THRUST)                                           // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(5)
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_SHIELD)                 // enemy has spell shield in place
     CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)                          // enemy has minor or greater globe of invulnerability in place
     CheckStat(LastSeenBy(Myself),1,WIZARD_SPELL_DEFLECTION)               // enemy has minor spell deflection in place
     CheckStat(LastSeenBy(Myself),1,WIZARD_SPELL_TURNING)                  // enemy has minor spell turning in place
     CheckStat(LastSeenBy(Myself),1,WIZARD_SPELL_IMMUNITY)                 // enemy has spell immunity: abjuration in place (protects against dispel/remove magic)
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,75,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_SPELL_THRUST)
    DisplayStringHead(LastSeenBy(Myself),25873)                            // say "Spell Thrust"
END

