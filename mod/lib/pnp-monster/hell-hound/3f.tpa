DEFINE_ACTION_FUNCTION jam3f_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~HELLHO01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OBSFIR05~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~P1-10~
			REMOVE_CRE_ITEM ~HELLHO~
			REMOVE_CRE_ITEM ~SEEINVIS~
			ADD_CRE_ITEM ~jaim3f00~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim3f01~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_MEMORIZED_SPELL ~jasm3f00~ #0 ~innate~ (1) // Breath Fire
			LPF clear_proficiencies END
			LPF planarEssence_trait END
			LPF patchCreature
				INT_VAR
					xpv=420
					hp=32
					ac=4
					thac0=17
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					strength=17
					intelligence=7
					wisdom=13
					dexterity=12
					constitution=14
					charisma=6
					morale=13
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~DOG~)
					class=IDS_OF_SYMBOL (~class~ ~DOG_WAR~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					movement=10
					enforce=1
			END
			// Assigning jabm3f00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN HELHOU01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm3f00 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~HELLHO01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OBSFIR05~) BEGIN 
				WRITE_SHORT 0x24 56 // hp
				WRITE_SHORT 0x26 56 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 7 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~HELLHO01~) BEGIN 
				WRITE_LONG 0x14 1400 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OBSFIR05~) BEGIN 
				WRITE_LONG 0x14 1400 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"HELLHO01"
		"OBSFIR05"
	BEGIN
		LAF jam3f_patch STR_VAR file END
	END
END