// *********************************************************************
// *           Segment Name: gs_ShapeChange.baf
// *********************************************************************

// * SHAPECHANGE ROUTINE - MAGE, THREAT LEVEL 

// * 2: Pre-Melee

// * WIZARD_SHAPECHANGE {9} [SpWi916 - 2916] (wizard is able to assume the form of a mind flayer, iron golem, greater wolfwere, earth elemental, fire elemental, or giant troll)
// * Requires Mod Stat.IDS File (WIZARD_IMPROVED_ALACRITY)
IF
  HaveSpell(2916)                                                          // and we have the spell
  !HaveSpell(3152)                                                         // and we haven't already cast it
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStat(Myself,1,WIZARD_IMPROVED_ALACRITY)                          // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // and its threat-level 3+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  OR(2)
     NumCreatureGT([EVILCUTOFF],3)                                         // and theres 4+ enemies
     HPGT(LastSeenBy(Myself),50)                                           // or the target has >50hp (single target presumption)
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  CheckStatLT(Myself,75,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobalTimer("ek_ShapeChange","LOCALS",300)                          // set a 5 turn timer
    Spell(Myself,2916)                                                     // cast the spell, but don't reset the target/threat
END

// * Polymorph Behaviours here: These are only triggered when the Wizard has cast Shapechange and
// * assumed another form. They work in here, because HaveSpell() will always come false for all spells
// * once the wizard has assumed a polymorphed form

// * each time the Mind Flayer Shape is assumed, a new Mind Blast is gained
IF
  SpellCast(Myself,3152)
THEN
  RESPONSE #10
    SetGlobal("ek_UsedMindBlast","LOCALS",0)
END

// * SHAPECHANGE_FIRE_ELEMENTAL {1} [SpIn156 - 3156]
// * May require Mod Spell.IDS (SHAPECHANGE_FIRE_ELEMENTAL)
// * if enemy is close && threatlevel is 4+, turn into a Fire Elemental
IF
  HaveSpell(3156)                                                          // and we can turn into a Fire Elemental
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // and its threat-level 4+
  !HasItem("FIRERN",Myself)                                                // and we aren't already a Fire Elemental
  HPPercentGT(Myself,50)                                                   // and we still have >50% hp
  Range(LastSeenBy(Myself),10)                                             // and the enemy is closer
  CheckStatLT(LastSeenBy(Myself),1,RESISTCRUSHING)                         // and they aren't completely resistant to this type of damage
  CheckStatLT(LastSeenBy(Myself),1,RESISTFIRE)                             // and they aren't completely resistant to this type of damage
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,3156)                                                     // turn into a Fire Elemental
END

