// * CLERIC_ZONE_OF_SWEET_AIR {3} [SpPr318 - 1318] (reaction to gas clouds)
IF
  HaveSpell(CLERIC_ZONE_OF_SWEET_AIR)                                      // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 2+
  OR(8)
     SpellCastOnMe([EVILCUTOFF],GOLEM_GASCLOUD)
     SpellCastOnMe([EVILCUTOFF],MEPHIT_STINKING_CLOUD)
     SpellCastOnMe([EVILCUTOFF],POISONOUS_CLOUD)
     SpellCastOnMe([ANYONE],TRAP_CLOUDKILL)
     SpellCastOnMe([EVILCUTOFF],WIZARD_STINKING_CLOUD)
     SpellCastOnMe([EVILCUTOFF],WIZARD_INCENDIARY_CLOUD)
     SpellCastOnMe([EVILCUTOFF],WIZARD_DEATH_FOG)
     SpellCastOnMe([EVILCUTOFF],WIZARD_CLOUDKILL)
  SpellCastInnate([EVILCUTOFF],GOLEM_GASCLOUD)
  SpellCastInnate([EVILCUTOFF],MEPHIT_STINKING_CLOUD)
  SpellCastInnate([EVILCUTOFF],POISONOUS_CLOUD)
  SpellCastInnate([ANYONE],TRAP_CLOUDKILL)
  SpellCast([EVILCUTOFF],WIZARD_STINKING_CLOUD)
  SpellCast([EVILCUTOFF],WIZARD_INCENDIARY_CLOUD)
  SpellCast([EVILCUTOFF],WIZARD_DEATH_FOG)
  SpellCast([EVILCUTOFF],WIZARD_CLOUDKILL)
// Horred's Cloud Stuff.  Don't delete
//  OR(4)
//    CheckStat(Myself,11,WIZARD_GREATER_MALISON)
//    CheckStat(Myself,16,WIZARD_GREATER_MALISON)
//    CheckStat(Myself,17,WIZARD_GREATER_MALISON)
//    CheckStat(Myself,20,WIZARD_GREATER_MALISON)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_ZONE_OF_SWEET_AIR)
END

// * CLERIC_INVISIBILITY_PURGE {3} [SpPr309 - 1309]
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)
IF
  HaveSpell(CLERIC_INVISIBILITY_PURGE)                                          // and I have DetectInvis
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                   // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                        // or I am Aura Cleansed so no wait
  OR(2)                                                                         // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                          // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")                 // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                         // and its threat-level 2+
  CheckStatLT(Myself,1,SEEINVISIBLE)                                            // and we're not already seeing invisible
  OR(6)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_NOT_VISIBLE)             // and they're invisible
     SpellCast([EVILCUTOFF],WIZARD_PROJECT_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_MISLEAD)
     SpellCast([EVILCUTOFF],WIZARD_MIRROR_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_IMPROVED_INVISIBILITY)
     SpellCast([EVILCUTOFF],WIZARD_INVISIBILITY)
  Range(NearestEnemyOf(Myself),6)                                               // and they're within the area-of-effect
  !StateCheck(Myself,STATE_SILENCED)                                            // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                     // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                          // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_INVISIBILITY_PURGE)
END

// * 3: Always-On Defences

// * CLERIC_IRONSKIN [SpPr506, Druid Only]
// * Requires Mod Stat.IDS (CLERIC_PHYSICAL_MIRROR)
IF
  HaveSpell(CLERIC_IRONSKIN)                                               // and we have Stoneskin available
  CheckStatLT(Myself,1,STONESKINS)                                         // and its not already been cast.
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  AttackedBy([ANYONE],DEFAULT)                                           // if we're being attacked
  CheckStatLT(Myself,1,CLERIC_PHYSICAL_MIRROR)                             // and we aren't protected by Physical Mirror
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_IRONSKIN)                                          // cast it now!
END

// *********************************************************************
// *           Segment Name: gs_CounterSpells_Inquisitor.baf
// *********************************************************************

// * COUNTERSPELLS SNIPPET - INQUISITOR VERSION

// * 1. Reactions
// * 2. Anti-Spell Spells
// * 3. Always-On Defences

// * 1: REACTIONS - PRIEST SPELLS CAST AS A RESPONSE

// * 2: Anti-Spell Spells

// * INQUIS_TRUE_SIGHT {1} [SpCl232 - 4232]
// * Detectable Spell
// * Requires Modified Spell File for HaveSpell Check to work
// * Requires Mod Stat. IDS file (TRUE_SIGHT)
// * Requires Mod State.IDS file (STATE_ILLUSIONS)

// * Combo-Version : As a result of See-ing the Unseen, or SpellCast()

// * StateCheck Through 5 Enemies, look for Invis or Illusion
IF
  HaveSpell(INQUIS_TRUE_SIGHT)                                                // and I have the Spell
  !CheckStat(Myself,1,TRUE_SIGHT)                                             // and aren't already under the effects of the spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  OR(7)
     SpellCast([EVILCUTOFF],WIZARD_PROJECT_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_MISLEAD)
     SpellCast([EVILCUTOFF],WIZARD_MIRROR_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_IMPROVED_INVISIBILITY)
     SpellCast([EVILCUTOFF],WIZARD_INVISIBILITY)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_ILLUSIONS) // and they're Invisible, Improved Invisible, Mirror Imaged, or Blur'd
     NumCreatureGT([EVILCUTOFF.0.0.0.0.ILLUSIONARY.0],0)                      // or there's an illusory creature around.
  !Range(NearestEnemyOf(Myself),4)                                            // and I have space to cast
THEN
  RESPONSE #10
    SetGlobalTimer("gh_PartyHasTrueSeeing","GLOBAL",66)                       // set a 1 turn+1round timer to prevent re-cast of this or a similar spell
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                        // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,INQUIS_TRUE_SIGHT)
    DisplayStringHead(Myself,25633)                                        // "True Sight"
END

// * INQUIS_DISPEL_MAGIC {1} [SpCl231 - 4231]
// * Very Powerful, acutally cast at twice the level of the inquisitor casting the spell
// * Requires Mod State.IDS File (STATE_ENCHANTED)
IF
  HaveSpell(INQUIS_DISPEL_MAGIC)                                              // if we have the spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  OR(5)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_INVISIBLE) // and theres an invisible enemy
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_ENCHANTED) // Mirror Image, Chant, Haste, Aid, Improved Invisibility
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_BLUR)      // or theres a Blur'd Enemy
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_BLESS)     // or theres a Blessed Enemy
     CheckStatGT(NearestEnemyOfType([EVILCUTOFF]),0,STONESKINS)   // or an Enemy with Stoneskins
  !Range(LastSeenBy(Myself),8)
  Range(Player1,8)
  Range(Player2,8)
  Range(Player3,8)
  Range(Player4,8)
  Range(Player5,8)
  Range(Player6,8)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(),INQUIS_DISPEL_MAGIC)
END

