IF
    !GlobalTimerNotExpired("castspell","LOCALS")
    HaveSpellRES("dw#sq32")  // Spell Sequencer
    !StateCheck(SixthNearest([PC]),STATE_NOT_VISIBLE)
    !CheckSpellState(SixthNearest([PC]),DO_NOT_TARGET_SPELLS)
    !CheckStatGT(Myself,0,WIZARD_IMPROVED_ALACRITY)
    !StateCheck(Myself,RZ_STATE_DISABLED)
    HPGT(Myself,0)
    Global("FIN_TIME_STOP_RUNNING","GLOBAL",0)
    See(SixthNearest([PC]))
    !StateCheck(SixthNearest([PC]),RZ_STATE_DISABLED)
    !CheckStatGT(SixthNearest([PC]),0,HELD)
    OR(2)
        !CheckStatGT(SixthNearest([PC]),50,RESISTMAGIC)
        GlobalTimerNotExpired("targetcompromise","LOCALS")
    !CheckStatGT(SixthNearest([PC]),99,RESISTMAGIC)
    Allegiance(Myself,ENEMY)
    !Allegiance(SixthNearest([PC]),ENEMY)
    !General(SixthNearest([PC]),UNDEAD)
    !Class(SixthNearest([PC]),SKELETON_WARRIOR)
    OR(3)
        TriggerOverride(SixthNearest([PC]),Range(NearestAllyOf(Myself),15))
        NumInParty(1)
        GlobalTimerNotExpired("targetcompromise","LOCALS")
    OR(2)
        !TriggerOverride(SixthNearest([PC]),StateCheck(NearestAllyOf(Myself),RZ_STATE_DISABLED))
        !TriggerOverride(SixthNearest([PC]),StateCheck(SecondNearestAllyOf(Myself),RZ_STATE_DISABLED))
    OR(2)
        !TriggerOverride(SixthNearest([PC]),StateCheck(NearestAllyOf(Myself),RZ_STATE_DISABLED))
        TriggerOverride(SixthNearest([PC]),Range(SecondNearestAllyOf(Myself),15))
    OR(6)
        INI("DMWW_mage_difficulty",0)
        INI("DMWW_mage_difficulty",3)
        INI("DMWW_mage_difficulty",4)
        INI("DMWW_mage_difficulty",5)
        INI("DMWW_mage_difficulty",6)
        INI("DMWW_mage_difficulty",7)
    OR(6)
        DifficultyGT(EASY)
        INI("DMWW_mage_difficulty",3)
        INI("DMWW_mage_difficulty",4)
        INI("DMWW_mage_difficulty",5)
        INI("DMWW_mage_difficulty",6)
        INI("DMWW_mage_difficulty",7)
    CheckStatGT(SixthNearest([PC]),0,SAVEVSSPELL)
THEN
    RESPONSE #100
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
        ReallyForceSpellRES("dw#sq32B",SixthNearest([PC]))  // Spell Sequencer
        ReallyForceSpell(SixthNearest([PC]),WIZARD_EMOTION_HOPELESSNESS)  // SPWI411.SPL (Emotion, Hopelessness)
        SmallWait(1)
        ReallyForceSpell(SixthNearest([PC]),WIZARD_EMOTION_HOPELESSNESS)  // SPWI411.SPL (Emotion, Hopelessness)
        SmallWait(1)
        ReallyForceSpell(SixthNearest([PC]),WIZARD_SPIDER_SPAWN)  // SPWI423.SPL (Monster Summoning IV)
    RESPONSE #100
        Continue()
END

