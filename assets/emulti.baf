     NumCreatureGT([EVILCUTOFF],2)                                         // and there are 3+ monsters
     Range(NearestEnemyOf(Myself),6)                                       // or they're within Melee Range
  CheckStatLT(Myself,4,SCRIPTINGSTATE5)                                    // and I am not already under the effects of the spell
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
