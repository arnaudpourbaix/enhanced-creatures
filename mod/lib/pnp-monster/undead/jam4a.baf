// Unholy Fireball
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	HaveSpellRES("jas2m4a")
	RandomNumGT(805,242)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(FarthestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!Gender(LastSeenBy(Myself),SUMMONED)
	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
	CheckStatLT(LastSeenBy(Myself),50,RESISTFIRE)
	!ImmuneToSpellLevel(LastSeenBy(Myself),3)
	!Range(LastSeenBy(Myself),15)
	OR(4)
		!TriggerOverride(LastSeenBy(Myself),Range(NearestEnemyOf(Myself),15))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(NearestEnemyOf(Myself),99,RESISTFIRE))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(NearestEnemyOf(Myself),74,RESISTMAGIC))
