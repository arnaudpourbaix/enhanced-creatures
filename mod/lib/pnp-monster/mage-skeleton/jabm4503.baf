// Mage Skeleton (Experienced Mage Skeleton)

// Precast contingency "Stoneskin"
IF
	Global("JA_INIT","LOCALS",0)
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	HaveSpellRES("jasc0109")
THEN
	RESPONSE #100
		ApplySpellRES("jasc0109",Myself)
		RemoveSpellRES("jasc0109")
		Continue()
END

// Init
IF
	Global("JA_INIT","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",0)
		SetGlobal("JA_PRECAST_LONG","LOCALS",0)
		SetGlobal("JA_PRECAST_MID","LOCALS",0)
		SetGlobalTimer("JA_REST","LOCALS",2400)
		SetGlobal("JA_INIT","LOCALS",1)
END

// Disable spellcasting in some areas
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	OR(2)
		AreaCheck("AR3004")
		AreaCheck("AR3008")
THEN
	RESPONSE #100
		SetGlobal("JA_DISABLE_SPELLCASTING","LOCALS",1)
END

// Rest (reset everything and heal if applicable)
IF
	Global("JA_INIT","LOCALS",1)
	GlobalTimerExpired("JA_REST","LOCALS")
	!See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_INIT","LOCALS",0)
		Rest()
		ApplySpell(Myself,RESTORE_FULL_HEALTH)
END

// Turn hostile if attacked
IF
	Allegiance(Myself,NEUTRAL)
	OR(4)
		AttackedBy([GOODCUTOFF],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		TookDamage()
		Heard([EVILCUTOFF.0.SKELETON],99)
THEN
	RESPONSE #100
		Enemy()
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,EVILCUTOFF)
	See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,GOODCUTOFF)
	See([EVILCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Shouts every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	!GlobalTimerNotExpired("JA_SHOUT","LOCALS")
THEN
	RESPONSE #100
		Shout(99)
		SetGlobalTimer("JA_SHOUT","LOCALS",18)
END

// React to shouts
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.SKELETON],99)
	InMyArea([EVILCUTOFF.0.SKELETON])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.SKELETON],99)
	InMyArea([EVILCUTOFF.0.SKELETON])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

// Help every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("JA_HELP","LOCALS")
THEN
	RESPONSE #100
		Help()
		SetGlobalTimer("JA_HELP","LOCALS",18)
END

// React to help
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		Help()
		MoveToObject(LastHelp(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHelp(Myself))
END

// Do nothing if...
IF
	OR(4)
		Global("JA_COMBAT","LOCALS",0)
		!Allegiance(Myself,EVILCUTOFF)
		StateCheck(Myself,STATE_IMMOBILE)
		StateCheck(Myself,STATE_REALLY_DEAD)
THEN
	RESPONSE #100
		NoAction()
END

IF
	!InActiveArea(Myself)
	!Range(NearestEnemyOf(Myself),30)
THEN
	RESPONSE #100
		NoAction()
END

// Get out of Storm of Vengeance
IF
	Heard([ANYONE],407)
	Range(LastHeardBy(Myself),20)
	OR(3)
		!CheckStatGT(Myself,99,RESISTACID)
		!CheckStatGT(Myself,99,RESISTFIRE)
		!CheckStatGT(Myself,99,RESISTELECTRICITY)
	OR(2)
		!CheckStatGT(Myself,80,RESISTMAGIC)
		!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(LastHeardBy(Myself),30)
END

// Get out of Incendiary Cloud, Meteor Swarm, Fire Storm
IF
	OR(2)
		Heard([ANYONE],405)
		Heard([ANYONE],409)
	Range(LastHeardBy(Myself),20)
	!CheckStatGT(Myself,99,RESISTFIRE)
	OR(2)
		!CheckStatGT(Myself,59,RESISTFIRE)
		!See(NearestEnemyOf(Myself))
	OR(2)
		!CheckStatGT(Myself,79,RESISTMAGIC)
		!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(LastHeardBy(Myself),30)
END

// Get out of Death Fog
IF
	Heard([ANYONE],408)
	Range(LastHeardBy(Myself),20)
	!CheckStatGT(Myself,99,RESISTACID)
	OR(2)
		!CheckStatGT(Myself,59,RESISTACID)
		!See(NearestEnemyOf(Myself))
	OR(2)
		!CheckStatGT(Myself,80,RESISTMAGIC)
		!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(LastHeardBy(Myself),30)
END

// Get out of Web
IF
	Heard([ANYONE],410)
	Range(LastHeardBy(Myself),15)
	!CheckStatGT(Myself,0,MINORGLOBE)
	!CheckStatGT(Myself,0,CLERIC_FREE_ACTION)
	!CheckSpellState(Myself,HOLD_IMMUNITY)
	OR(2)
		!CheckStatGT(Myself,80,RESISTMAGIC)
		!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(LastHeardBy(Myself),30)
END

// Get out of Ice Storm, Writhing Fog
IF
	Heard([ANYONE],412)
	Range(LastHeardBy(Myself),20)
	!CheckStatGT(Myself,99,RESISTCOLD)
	OR(2)
		!CheckStatGT(Myself,59,RESISTCOLD)
		!See(NearestEnemyOf(Myself))
	OR(2)
		!CheckStatGT(Myself,80,RESISTMAGIC)
		!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(LastHeardBy(Myself),30)
END

// Cloud around, no enemy in sight: stay put rather than walk into it
IF
	!See(NearestEnemyOf(Myself))
	OR(8)
		Heard([ANYONE],404)
		Heard([ANYONE],405)
		Heard([ANYONE],406)
		Heard([ANYONE],407)
		Heard([ANYONE],408)
		Heard([ANYONE],409)
		Heard([ANYONE],410)
		Heard([ANYONE],411)
THEN
	RESPONSE #100
		NoAction()
END

// Stoneskin
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	HaveSpell(WIZARD_STONE_SKIN)
	!CheckStatGT(Myself,0,STONESKINS)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(Myself,WIZARD_STONE_SKIN)
END

// Vocalize
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	HaveSpell(WIZARD_VOCALIZE)
	StateCheck(Myself,STATE_SILENCED)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(Myself,WIZARD_VOCALIZE)
END

// Breach
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	HaveSpell(WIZARD_BREACH)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(NearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!Gender(LastSeenBy(Myself),SUMMONED)
	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
	!CheckStat(LastSeenBy(Myself),1,WIZARD_SPELL_IMMUNITY)
	OR(5)
		CheckStatGT(LastSeenBy(Myself),0,STONESKINS)
		CheckStatGT(LastSeenBy(Myself),0,CLERIC_CHAOTIC_COMMANDS)
		CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)
		CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
		CheckSpellState(LastSeenBy(Myself),DEATH_WARD)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TURNING)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TRAP)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_DEFLECTION)
	!CheckStatGT(LastSeenBy(Myself),0,CLERIC_SHIELD_OF_THE_ARCHONS)
	!CheckStatGT(LastSeenBy(Myself),0,HELD)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_FEEBLEMINDED)
	!StateCheck(LastSeenBy(Myself),STATE_SLEEPING)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(LastSeenBy(Myself),WIZARD_BREACH)
END

