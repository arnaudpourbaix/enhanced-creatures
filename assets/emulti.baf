// **********************************************************************
// *           Segment Name: gs_HotKeyB_Mage.baf
// **********************************************************************

// * HOTKEY(B) BASED SPELL PREP - MAGE SPELLS

// * Set the 3 round Timer when the HotKey is pressed
IF
  !GlobalTimerNotExpired("gh_BuffTimer","LOCALS")                          // if the counter is at 0
  HotKey(B)                                                                // and the players pressed the B Key
THEN
  RESPONSE #100
    SetGlobalTimer("gh_BuffTimer","LOCALS",18)                             // set the Timer to 3 rounds (gets us 3 buff spells)
END

// * WIZARD_PROTECTION_FROM_MAGIC_WEAPONS [Too short a duration for Pre-Combat Cast]
// * WIZARD_PROTECTION_FROM_NORMAL_MISSILES [Too short a duration for Pre-Combat Cast]
// * WIZARD_PROTECTION_FROM_NORMAL_WEAPONS [Too short a duration for Pre-Combat Cast]

// * WIZARD_STONE_SKIN {4} [SpWi408 - 2408] dur: 3600s
IF
  HaveSpell(WIZARD_STONE_SKIN)                                             // and we have Stoneskin available
  CheckStatLT(Myself,1,STONESKINS)                                         // and its not already been cast.
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalTimerNotExpired("gh_BuffTimer","LOCALS")                           // if its less than 3rnds since B was pressed
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_STONE_SKIN)                                        // cast it now!
END

// * WIZARD_ARMOR 'ds' {1} [SpWi102 - 2102] (dur: 2700s, sets AC to 6, cummulative with dex & shield bonus)
IF
  HaveSpell(WIZARD_ARMOR)
  CheckStatLT(Myself,3,SCRIPTINGSTATE5)                                     // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalTimerNotExpired("gh_BuffTimer","LOCALS")                           // if its less than 3rnds since B was pressed
  CheckStatGT(Myself,6,ARMORCLASS)                                         // and my AC is >6 (since this affects base AC)
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_ARMOR)
END

