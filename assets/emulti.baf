// **********************************************************************
// *           Segment Name: gs_Buffs_TL3_Items.baf
// **********************************************************************

// * THREAT LEVEL 3 ENHANCER "BUFF" SPELLS - ITEMS

// * 3: Enhancers/DefendOthers
// * 3: FIGHTER::ENHANCING POTIONS/ITEMS/SPELLS

// * 3: Potion,Potion of Fortitude,POTN28

// * POTION_OF_STONE_GIANT_STRENGTH [POTN12]
IF
  HasItemEquiped("POTN12",Myself)                                          // and I have a Potion of Stone Giant Strength
  CheckStatLT(Myself,20,STR)                                               // and PC Strength < 20
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(3)                                                                    // am I an appropriate class to use this item?
     Class(Myself,FIGHTER_ALL)
     Class(Myself,PALADIN_ALL)
     Class(Myself,RANGER_ALL)
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // if its a level 3+ combat
  OR(2)
     HPGT(NearestEnemyOf(Myself),100)                                      // if nearest foe is >100hp
     NumCreatureGT([EVILCUTOFF],6)                                         // and more than 7 foes
  Range(NearestEnemyOf(Myself),4)                                          // and theres a foe nearby, so Melee is likely
// Bag Check code commented out because several mods add new bags making it impossible to account for all bags
//  OR(2)
//     !HasItem("BAG04",Myself)                                              // Bag of Holding
//     HasItemEquiped("POTN12",Myself)
//  OR(2)
//     !HasItem("BAG06",Myself)                                              // Potion Case
//     HasItemEquiped("POTN12",Myself)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     //set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("POTN12",Myself)                                               // drink the Potion of Stone Giant Strength
//    DisplayStringHead(Myself,7005)                                         // say "Potion of Stone Giant Strength"
END

