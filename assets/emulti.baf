// * WIZARD_SUN_FIRE {5} [SpWi523 - 2523] (centered on caster, AOE 30' radius, 1d6 FIRE dmg/CL, 15d6 Max, save vs spells 1/2)
IF
  HaveSpell(WIZARD_SUN_FIRE)                                               // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // if its threat level 4+
  NumCreatureGT([EVILCUTOFF],2)                                            // and there are at least 3+ opponents
  Range(NearestEnemyOf(Myself),6)                                          // and three targets are within 6sq
  Range(SecondNearestEnemyOf(Myself),6)
  Range(ThirdNearestEnemyOf(Myself),6)
  HPGT(NearestEnemyOf(Myself),15)                                          // and all three targets have >15hp
  HPGT(SecondNearestEnemyOf(Myself),15)
  HPGT(ThirdNearestEnemyOf(Myself),15)
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  OR(3)
     CheckStatLT(NearestEnemyOf(Myself),26,RESISTFIRE)                     // or one of them is going to take at least 75% of 1/2 the damage, even if they make their save
     CheckStatLT(SecondNearestEnemyOf(Myself),26,RESISTFIRE)
     CheckStatLT(ThirdNearestEnemyOf(Myself),26,RESISTFIRE)
  OR(3)
     Range(Player1,0)                                                      // Either I'm Player1
     !Range(Player1,6)                                                     // or Player1 is outside of 20ft
     HPGT(Player1,50)                                                      // or Player1 has enough HP to shrug this off
  OR(3)
     Range(Player2,0)                                                      // Either I'm Player2
     !Range(Player2,6)                                                     // or Player2 is outside of 20ft
     HPGT(Player2,50)                                                      // or Player2 has enough HP to shrug this off
  OR(3)
     Range(Player3,0)                                                      // Either I'm Player3
     !Range(Player3,6)                                                     // or Player3 is outside of 20ft
     HPGT(Player3,50)                                                      // or Player3 has enough HP to shrug this off
  OR(3)
     Range(Player4,0)                                                      // Either I'm Player4
     !Range(Player4,6)                                                     // or Player4 is outside of 20ft
     HPGT(Player4,50)                                                      // or Player4 has enough HP to shrug this off
  OR(3)
     Range(Player5,0)                                                      // Either I'm Player5
     !Range(Player5,6)                                                     // or Player5 is outside of 20ft
     HPGT(Player5,50)                                                      // or Player5 has enough HP to shrug this off
  OR(3)
     Range(Player6,0)                                                      // Either I'm Player6
     !Range(Player6,6)                                                     // or Player6 is outside of 20ft
     HPGT(Player6,50)                                                      // or Player6 has enough HP to shrug this off
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_SUN_FIRE)
END

