// **********************************************************************
// *           Segment Name: gs_Buffs_TL3_Mage.baf
// **********************************************************************

// * THREAT LEVEL 3 ENHANCER "BUFF" SPELLS - MAGE

// * WIZARD_HASTE {3} [SpWi305 - 2305] (multiple)
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)
IF
  HaveSpell(WIZARD_HASTE)                                                  // and we have the spell
  !StateCheck(LastSeenBy(Myself),STATE_HASTED)                             // and not already hasted
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // or its threat-level 3+
  NumInPartyGT(2)                                                          // and theres at least 3 of us
  NumCreatureGT([EVILCUTOFF],4)                                            // and there are 5+ monsters
  OR(4)
     See(Myself)                                                           // target the spell on self
     See(NearestMyGroupOfType([0.0.0.FIGHTER_ALL.0.0.0]))                  // target the spell of any PC Fighter
     See(NearestMyGroupOfType([0.0.0.RANGER_ALL.0.0.0]))                   // target the spell of any PC Ranger
     See(NearestMyGroupOfType([0.0.0.PALADIN_ALL.0.0.0]))                  // target the spell of any PC Paladin
  !HasBounceEffects(LastSeenBy(Myself))                                    // and they're not spell-turning
//  !HasImmunityEffects(LastSeenBy())                                        // and they're not spell-immune
  !StateCheck(LastSeenBy(Myself),STATE_NOT_VISIBLE)                        // and not invisible/impinvis
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_HASTE)                                 // cast Haste on them
END

// **********************************************************************
// *           Segment Name: gs_Buffs_TL3_Priest.baf
// **********************************************************************

// * THREAT LEVEL 3 ENHANCER "BUFF" SPELLS - PRIEST

// * 3: Enhancers/DefendOthers

// * CLERIC_CHAMPIONS_STRENGTH {5} [SpPr507 - 1507] (str18/00, +thaco, 3r/level)
// * Detectable Spell
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE, STATE_OUT_OF_ACTION)
IF
  HaveSpell(CLERIC_CHAMPIONS_STRENGTH)                                     // if I have the spell
  CheckStatLT(Myself,3,SCRIPTINGSTATE6)                                    // and they are not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  NumCreatureGT([EVILCUTOFF], 4)                                           // and there are 5+ monsters
  See(LastAttackerOf(NearestEnemyOf(Myself)))                              // and we can see the frontliner
  !CheckStat(Myself,1,SCRIPTINGSTATE4)                                     // and they are not already under the effects of the spell
  !StateCheck(LastSeenBy(Myself),STATE_NOT_VISIBLE)                        // and not invisible/impinvis
  !StateCheck(LastSeenBy(Myself),STATE_OUT_OF_ACTION)                      // and they're not already Luck-Charmed
  CheckStatLT(LastSeenBy(Myself),18,STR)                                   // and their STRENGTH < 18
  Range(LastSeenBy(Myself),6)                                              // and they're within 6sq
  Range(NearestEnemyOf(LastSeenBy(Myself)),8)                              // and they're foe is within 8sq (therefore melee)
  !Range(NearestEnemyOf(Myself),4)                                         // and we have casting room ourselves
  !AttackedBy([ANYONE],DEFAULT)                                            // and we're not under attack
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_CHAMPIONS_STRENGTH)
END

