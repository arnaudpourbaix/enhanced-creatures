DEFINE_ACTION_FUNCTION jam25_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELCAT~ BEGIN
				LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=65 292 END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BDHELCAT~
			REMOVE_CRE_ITEM ~RINGDEMN~
			REMOVE_CRE_ITEM ~IPSION~
			ADD_CRE_ITEM ~jai0m25~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m25~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai2m25~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=5000
					hp=93
					ac=10
					thac0=13
					apr=2
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=7
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=21
					intelligence=10
					wisdom=14
					dexterity=21
					constitution=19
					charisma=10
					morale=13
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~DEMONIC~)
					class=IDS_OF_SYMBOL (~class~ ~CAT~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					hideShadow=100
					moveSilent=100
					movement=12
					enforce=1
					perfect2weapon=1
			END
			// Assigning jam25
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDHELCAT BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MM2GE DW2MS2BE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2GE DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam25 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BDHELCAT"
BEGIN
	LAF jam25_patch STR_VAR file END
END