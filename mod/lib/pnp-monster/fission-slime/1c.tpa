// Generated file (don't edit)

// Fission Slime
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fission-slime/jabm1c00.baf~

// Fission Slime traits
CREATE ITM "jaim1c00"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10980)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10980)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10287)
COPY_EXISTING ~jaim1c00.itm~ ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=166 target=1 global=1 parameter1=10 parameter2=1 timing=2 probability1=100 END
	LPF lightning_immunity END
	LPF nonMagicalWeapons_immunity END
	LPF magicMissile_immunity END
	LPF coldResistance_resistance END

// Pseudopod
CREATE ITM "jaim1c01"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10006)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10006)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IJELLY~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10981)
	WRITE_LONG 0x60 4
COPY_EXISTING ~jaim1c01.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IJELLY~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 5
		WRITE_BYTE 0x84 4
		WRITE_BYTE 0x88 6
		WRITE_BYTE 0x8a 3
		WRITE_SHORT 0x8e 2
		WRITE_SHORT 0x9c (IDS_OF_SYMBOL (~projectl~ ~ACIDBLMU~)) + 1
	WRITE_SHORT 0xa0 100
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=12 target=2 parameter2=65536 probability1=100 dicesize=6 dicenumber=3 END
	END

DEFINE_ACTION_FUNCTION jam1c_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BPSLFS01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BPSLFS02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JELLSPA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SLIFIS01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SLIFIS02~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~JELLMU2~
			REMOVE_CRE_ITEM ~DW#JELM2~
			ADD_CRE_ITEM ~jaim1c00~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim1c01~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaic000d~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~jask0800~ #0 ~innate~ (1) // Toxic Vapors
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=5000
					hp=206
					ac=4
					thac0=7
					apr=1
					saveDeath=7
					saveWand=9
					savePolymorph=8
					saveBreath=8
					saveSpell=10
					level1=12
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=15
					intelligence=10
					wisdom=10
					dexterity=10
					constitution=21
					charisma=10
					morale=14
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~MUSTARD_JELLY~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=7
					enforce=1
			END
			// Assigning jabm1c00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm1c00 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BPSLFS01"
		"BPSLFS02"
		"JELLSPA"
	BEGIN
		LAF jam1c_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"SLIFIS01"
		"SLIFIS02"
	BEGIN
		LAF jam1c_patch STR_VAR file END
	END
END