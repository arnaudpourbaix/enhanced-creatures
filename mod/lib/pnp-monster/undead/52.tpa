			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9ELSU11~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SAHSKEL~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SKELSU11~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SKELWASU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"C0DESUM4"
	"C0DESUM5"
	"DW#ANGSK"
	"DW#DIASK"
	"DW#SEMSK"
	"SKELSU11"
	"SKELWA"
	"SKELWA01"
	"SKELWA02"
	"SKELWA03"
	"SKELWASU"
BEGIN
	LAF jam52_patch STR_VAR file END
END
