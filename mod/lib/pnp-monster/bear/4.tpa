DEFINE_ACTION_FUNCTION jam4_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ESXBEA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBL01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBLSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9EARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GLBEAR2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PLYBEAR2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RSBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UBDBEAR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VBEARBL~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~B1-6~
			REPLACE_CRE_ITEM ~jai0m4~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai1m4~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=175
					hp=30
					ac=7
					thac0=17
					apr=2
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=3
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=15
					intelligence=4
					wisdom=12
					dexterity=10
					constitution=15
					charisma=7
					morale=9
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~BEAR~)
					class=IDS_OF_SYMBOL (~class~ ~BEAR_BLACK~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=10
					enforce=1
					perfect2weapon=1
			END
			// Assigning jam4
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BEARBLSU PLYBEAR2 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam4 END
			// Assigning jam4su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN BEARBLSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam4su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLYBEAR2~) BEGIN 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBLSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

