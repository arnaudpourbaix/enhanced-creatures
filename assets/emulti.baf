// * RING_OF_THE_RAM [RING33] Single, Dmg Type:5d6 + Wing Buffet 1x day, No Save, Dmg Type:Magic
IF
  HasItemEquiped("RING33",Myself)
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3
  Global("GB_UsedRING26","LOCALS",0)
  Range(NearestEnemyOf(Myself),6)                                          // in melee range
  HPGT(NearestEnemyOf(Myself),15)                                          // and the target has >15hp
  CheckStatLT(NearestEnemyOf(Myself),26,MAGICDAMAGERESISTANCE)
  CheckStatLT(NearestEnemyOf(Myself),76,RESISTMAGIC)                       // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !Allegiance(NearestEnemyOf(Myself),GOODCUTOFF)                           // and not an Ally, Familiar, Minion or Simulacrum
  !HasBounceEffects(NearestEnemyOf(Myself))                                // and the target isn't Spell-Turning
  !HasItemEquiped("RAKRING",NearestEnemyOf(Myself))                        // and they're not a Rakshasa (immune to 8th level spells or less)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobal("GB_UsedRING33","LOCALS",1)
    UseItem("RING33",NearestEnemyOf(Myself))
    DisplayStringHead(Myself,7714)                                         // "Ring of the Ram"
END

