		WRITE_SHORT 0x9c (IDS_OF_SYMBOL (~projectl~ ~ACIDBLMU~)) + 1
	WRITE_SHORT 0xa0 100
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=12 target=2 parameter2=65536 probability1=100 dicesize=8 dicenumber=3 END
	END

COPY ~%MOD_FOLDER%/lib/pnp-monster/black-pudding/assets/jacm1b00.cre~ ~override/jacm1b01.cre~
DEFINE_ACTION_FUNCTION jam1b_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDPUDDBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1B01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~HELMNOAN~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~BDPUDDBL~
			ADD_CRE_ITEM ~jaim1b00~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim1b01~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaic000d~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=2000
					hp=120
					ac=5
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=10
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=16
					intelligence=1
					wisdom=6
					dexterity=5
					constitution=16
					charisma=1
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~GREY_OOZE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					animation=IDS_OF_SYMBOL (~animate~ ~BLACK_PUDDING~)
					movement=5
					enforce=1
			END
			// Assigning jabm1b00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDPUDDBL BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm1b01 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm1b00 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1B01~) BEGIN 
				WRITE_LONG 0x14 1000 // xpv
				WRITE_SHORT 0x24 50 // hp
				WRITE_SHORT 0x26 50 // hp
				REMOVE_MEMORIZED_SPELLS
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"JACM1B01"
BEGIN
	LAF jam1b_patch STR_VAR file END
END
ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BDPUDDBL"
	BEGIN
		LAF jam1b_patch STR_VAR file END
	END
END