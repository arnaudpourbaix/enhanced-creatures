ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BPANKHE1"
		"L#MIMMI"
		"WIANKHE1"
		"ANKHEG"
		"ANKHEGF"
		"ANKHEGG"
		"ANKHEGQ"
		"BDANKH01"
		"BDANKHEG"
		"BDANKHSU"
		"BDNEO"
	BEGIN
		LAF jam01_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
