DEFINE_ACTION_FUNCTION jamb_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ANLION1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CATLIM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMENA4~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~P1-6~
			REPLACE_CRE_ITEM ~jai0mb~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai1mb~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_CRE_ITEM ~jai19~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas0mb~ #0 ~innate~ (1) // Leap
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=270
					hp=25
					ac=7
					thac0=17
					apr=2
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=3
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=17
					intelligence=4
					wisdom=12
					dexterity=15
					constitution=13
					charisma=8
					morale=9
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~CAT~)
					class=IDS_OF_SYMBOL (~class~ ~CAT~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=10
					enforce=1
					perfect2weapon=1
			END
			// Assigning jamb
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jamb END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ANLION1~) BEGIN 
				WRITE_SHORT 0x24 121 // hp
				WRITE_SHORT 0x26 121 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 15 // level1
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ANLION1"
	"CATLIM01"
	"OHBMENA4"
BEGIN
	LAF jamb_patch STR_VAR file END
END