// * CLERIC_SHIELD_OF_THE_ARCHONS 'ds' {7} [SpPr701 - 1701] (caster centered, absorbs spells, will absorb a # of spell levels = 1/2CL, 3R/CL)
// * Requires Mod Stat.IDS file (CLERIC_SHIELD_OF_THE_ARCHONS, WIZARD_SPELL_TRAP)
IF
  HaveSpell(CLERIC_SHIELD_OF_THE_ARCHONS)                                  // and we have the spell
  CheckStatLT(Myself,1,CLERIC_SHIELD_OF_THE_ARCHONS)
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
  CheckStatLT(Myself,1,WIZARD_SPELL_TRAP)                                  // and I'm not already under the effects of spell turning, spell deflection, or spell absorbtion
  CheckStatLT(Myself,1,WIZARD_SPELL_DEFLECTION)
  CheckStatLT(Myself,1,MINORGLOBE)
//  !HasImmunityEffects(Myself)                                              // and not immune to spells
  !HasBounceEffects(Myself)                                                // and not spell-turning
  OR(5)
     Class(LastSeenBy(Myself),BARD_ALL)                                    // or the current target is a bard
     Class(LastSeenBy(Myself),DRUID_ALL)                                   // or the current target is a druid
     Class(LastSeenBy(Myself),CLERIC_ALL)                                  // or the current target is a cleric
     Class(LastSeenBy(Myself),MAGE_ALL)                                    // or the current target is a mage
     Class(LastSeenBy(Myself),SORCERER)                                    // or the current target is a sorcerer
  CheckStatGT(LastSeenBy(Myself),10,LEVEL)                                 // and the enemy spell caster is >10th level
  !Race(LastSeenBy(Myself),WYVERN)                                         // and NOT a Wyvern
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_SHIELD_OF_THE_ARCHONS)
END

// * CLERIC_DEFENSIVE_HARMONY {4} [SpPr406 - 1406] (Mass AC Booster: Caster Centered, AOE 10' radius, +2 AC, 6R)
// * Requires Mod State.IDS file (STATE_NOT_VISIBLE)
IF
  HaveSpell(CLERIC_DEFENSIVE_HARMONY)                                      // and we have the spell
  !GlobalTimerNotExpired("ek_DefensiveHarmony","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
  NumInPartyGT(2)                                                          // and theres at least 3 of us
  !StateCheck(Myself,STATE_NOT_VISIBLE)                                    // and not invisible/impinvis
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("ek_DefensiveHarmony","GLOBAL",36)
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_DEFENSIVE_HARMONY)
END

// * CLERIC_REGENERATE 'ds' {7} [SpPr711 - 1711] (Regeneration: Touch, 1 Target, 3HP/s, 1R/2CL)
// * Requires Mod Stat.IDS file (CLERIC_REGENERATION)
IF
  HaveSpell(CLERIC_REGENERATE)                                             // if I have the spell
  !CheckStat(LastSeenBy(Myself),1,CLERIC_REGENERATION)                     // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // or its threat-level 4
  OR(4)
     See(Myself)                                                           // target the spell on self
     See(NearestMyGroupOfType([0.0.0.FIGHTER_ALL.0.0.0]))                  // target the spell of any PC Fighter
     See(NearestMyGroupOfType([0.0.0.RANGER_ALL.0.0.0]))                   // target the spell of any PC Ranger
     See(NearestMyGroupOfType([0.0.0.PALADIN_ALL.0.0.0]))                  // target the spell of any PC Paladin
  HPPercentLT(LastSeenBy(Myself),75)                                       // and we've lost some hitpoints
  Range(LastSeenBy(Myself),6)
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_REGENERATE)
    DisplayStringHead(LastSeenBy(Myself),11800)                            // say "Regenerate"
END

