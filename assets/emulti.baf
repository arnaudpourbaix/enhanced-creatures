// * MAKE HELP REQUESTS

// * If I am Player1

// * Top-Up Help Request [<75%hp]
IF
  Range(Player1,0)                                                         // If I am Player1
  ActionListEmpty()
  CombatCounter(0)
  HPPercentLT(Myself,75)                                                   // and I have less than 75% hp
  HPPercentGT(Myself,50)                                                   // but more than 50% hp
  !GlobalTimerNotExpired("gh_Player1_HelpRequest_TopUp","GLOBAL")          // and I haven't already asked in the last 10 seconds
  !Global("gh_LastHealed","GLOBAL",1)                                      // and the Last Healed was *not* Player1 (prevents restarting the timer without resetting the token)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_Player1_HelpRequest_TopUp","GLOBAL",10)             // set *my* help-required timer
//DisplayStringHead(Myself,20583)               // "Tis but a scratch..."
    Continue()
END

