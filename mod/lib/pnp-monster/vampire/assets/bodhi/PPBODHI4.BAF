IF
    Detect([PC])
    AreaCheck("ar1514")  // Bodhi's Hunt Level 3 (1st Slayer Change Happens here)
    Global("J#RealBodhi","LOCALS",1)
    NumberOfTimesTalkedTo(0)
THEN
    RESPONSE #100
        SetGlobal("J#BodhiUltimatum","GLOBAL",1)
        StartDialogueNoSet(LastSeenBy(Myself))
END

IF
    Global("J#FirstBodhiFight","GLOBAL",1)
    !Detect([EVILCUTOFF])
    !Global("J#RealBodhi","LOCALS",1)
THEN
    RESPONSE #100
        StartDialogueNoSet(Player1)
END

IF
    HPLT(Myself,25)
    !Global("J#RealBodhi","LOCALS",1)
THEN
    RESPONSE #100
        SetGlobal("J#FirstBodhiFight","GLOBAL",1)
        StartDialogueNoSet(Player1)
END

IF
    !Global("J#RealBodhi","LOCALS",1)
    Global("J#BodhiSpawned","GLOBAL",1)
    Global("D0SpawnCREs","LOCALS",0)
    Global("J#BodhiHunts","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("D0SpawnCREs","LOCALS",1)
        CreateCreatureObject("vammat01",Myself,0,0,0)  // Vampire
        CreateCreatureObject("bodfgt01",Myself,0,0,0)  // Grimwarder
        CreateCreatureObject("bodfgt02",Myself,0,0,0)  // Grimward Archer
        CreateCreatureObject("bodfgt01",Myself,0,0,0)  // Grimwarder
        CreateCreatureObject("bodfgt02",Myself,0,0,0)  // Grimward Archer
        FadeFromColor([40.0],0)
        IncrementGlobal("J#BodhiHunts","GLOBAL",1)
        SetCursorState(FALSE)
        StartDialogueNoSet(Player1)
END

IF
    !Global("J#RealBodhi","LOCALS",1)
    Global("J#BodhiSpawned","GLOBAL",1)
    Global("D0SpawnCREs","LOCALS",0)
    Global("J#BodhiHunts","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("D0SpawnCREs","LOCALS",1)
        CreateCreatureObject("vammat01",Myself,0,0,0)  // Vampire
        CreateCreatureObject("vamold01",Myself,0,0,0)  // Elder Vampire
        CreateCreatureObject("bodfgt02",Myself,0,0,0)  // Grimward Archer
        CreateCreatureObject("bodfgt02",Myself,0,0,0)  // Grimward Archer
        FadeFromColor([40.0],0)
        IncrementGlobal("J#BodhiHunts","GLOBAL",1)
        SetCursorState(FALSE)
        StartDialogueNoSet(Player1)
END

IF
    !Global("J#RealBodhi","LOCALS",1)
    Global("J#BodhiSpawned","GLOBAL",1)
    Global("D0SpawnCREs","LOCALS",0)
    Global("J#BodhiHunts","GLOBAL",2)
THEN
    RESPONSE #100
        SetGlobal("D0SpawnCREs","LOCALS",1)
        CreateCreatureObject("vammat01",Myself,0,0,0)  // Vampire
        CreateCreatureObject("vamemi01",Myself,0,0,0)  // Ancient Vampire
        CreateCreatureObject("bodfgt01",Myself,0,0,0)  // Grimwarder
        CreateCreatureObject("bodfgt02",Myself,0,0,0)  // Grimward Archer
        CreateCreatureObject("bodfgt02",Myself,0,0,0)  // Grimward Archer
        CreateCreatureObject("bodfgt01",Myself,0,0,0)  // Grimwarder
        CreateCreatureObject("bodfgt02",Myself,0,0,0)  // Grimward Archer
        FadeFromColor([40.0],0)
        SetCursorState(FALSE)
        StartDialogueNoSet(Player1)
END

IF
    !Allegiance(Myself,ENEMY)
THEN
    RESPONSE #100
END

IF
    Detect([PC])
    NumberOfTimesTalkedTo(0)
THEN
    RESPONSE #100
        StartDialogueNoSet(LastSeenBy(Myself))
END

IF
    Allegiance(Myself,ENEMY)
    OR(10)
        See(Nearest([GOODCUTOFF]))
        See(SecondNearest([GOODCUTOFF]))
        See(ThirdNearest([GOODCUTOFF]))
        See(FourthNearest([GOODCUTOFF]))
        See(FifthNearest([GOODCUTOFF]))
        See(SixthNearest([GOODCUTOFF]))
        See(SeventhNearest([GOODCUTOFF]))
        See(EighthNearest([GOODCUTOFF]))
        See(NinthNearest([GOODCUTOFF]))
        See(TenthNearest([GOODCUTOFF]))
    Global("Seen","LOCALS",0)
THEN
    RESPONSE #100
        SetGlobal("Seen","LOCALS",1)
        Continue()
END

IF
    OR(2)
        Allegiance(Myself,ENEMY)
        AreaCheck("ar1512")  // Bodhi's Hunt Level 1
    OR(11)
        See(TenthNearestEnemyOf(Myself))
        See(NinthNearestEnemyOf(Myself))
        See(EighthNearestEnemyOf(Myself))
        See(SeventhNearestEnemyOf(Myself))
        See(SixthNearestEnemyOf(Myself))
        See(FifthNearestEnemyOf(Myself))
        See(FourthNearestEnemyOf(Myself))
        See(ThirdNearestEnemyOf(Myself))
        See(SecondNearestEnemyOf(Myself))
        See(NearestEnemyOf(Myself))
        See(LastAttackerOf(Myself))
    False()
THEN
    RESPONSE #100
        Continue()
END

IF
    OR(2)
        Allegiance(Myself,ENEMY)
        AreaCheck("ar1512")  // Bodhi's Hunt Level 1
    !GlobalTimerNotExpired("Cast","LOCALS")
    !GlobalTimerNotExpired("Dominate","LOCALS")
    !HasItemEquiped("clck26",TenthNearestEnemyOf(Myself))  // Cloak of Mirroring
    !CheckStatGT(TenthNearestEnemyOf(Myself),1,WIZARD_SPELL_DEFLECTION)
    !CheckStatGT(TenthNearestEnemyOf(Myself),1,WIZARD_SPELL_TURNING)
    !CheckStatGT(TenthNearestEnemyOf(Myself),0,WIZARD_SPELL_TRAP)
    !CheckStatGT(TenthNearestEnemyOf(Myself),0,CLERIC_SHIELD_OF_THE_ARCHONS)
    !CheckStatGT(TenthNearestEnemyOf(Myself),0,MINORGLOBE)
    !CheckStatGT(TenthNearestEnemyOf(Myself),0,SHIELDGLOBE)
    !CheckStat(TenthNearestEnemyOf(Myself),1,LEVEL_DRAIN_IMMUNITY)
    !CheckSpellState(TenthNearestEnemyOf(Myself),CHAOTIC_COMMANDS)
    !CheckSpellState(TenthNearestEnemyOf(Myself),SI_ENCHANTMENT)
    !StateCheck(TenthNearestEnemyOf(Myself),STATE_BERSERK)
    !Class(TenthNearestEnemyOf(Myself),MONK)
    !Kit(TenthNearestEnemyOf(Myself),INQUISITOR)
    !HasItemEquiped("HELM06",TenthNearestEnemyOf(Myself))  // Helm of Charm Protection
    !HasItemEquiped("NPCHAN",TenthNearestEnemyOf(Myself))  // Corthala Family Armor +3
    !HasItemEquiped("SHLD25",TenthNearestEnemyOf(Myself))  // Shield of Harmony
    !HasItemEquipedReal("REAVER",TenthNearestEnemyOf(Myself))  // Unholy Reaver +5
    !HasItemEquipedReal("SPER07",TenthNearestEnemyOf(Myself))  // Spear of the Unicorn
    !HasItemEquipedReal("STAF11",TenthNearestEnemyOf(Myself))  // Staff of the Magi +5
    !HasItemEquipedReal("SW1H35",TenthNearestEnemyOf(Myself))  // Adjatha the Drinker
    !HasItemEquipedReal("SW1H54",TenthNearestEnemyOf(Myself))  // The Equalizer +4
    !HasItemEquipedReal("SW2H14",TenthNearestEnemyOf(Myself))  // Lilarcor +3
    !HasItemEquipedReal("MISCBC",TenthNearestEnemyOf(Myself))  // Blackrazor
    CheckStatGT(TenthNearestEnemyOf(Myself),2,SAVEVSSPELL)
    CheckStatLT(TenthNearestEnemyOf(Myself),25,RESISTMAGIC)
    !StateCheck(TenthNearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
    !CheckStatGT(TenthNearestEnemyOf(Myself),0,SANCTUARY)
    See(TenthNearestEnemyOf(Myself))
    False()
THEN
    RESPONSE #100
        Continue()
END

