	LPF ADD_EFFECT INT_VAR header=1 opcode=24 target=2 power=1 duration=60 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=36 duration=60 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=1 probability1=100 savingthrow=1 STR_VAR resource="EFF_M07" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=4 duration=60 probability1=100 savingthrow=1 STR_VAR resource="EFF_E07" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=1 duration=60 probability1=100 STR_VAR resource="jas0m52" END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
// Skeleton Warrior traits
CREATE ITM "jai0m52"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@11043)
	WRITE_LONG 0xc RESOLVE_STR_REF(@11043)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11044)
COPY_EXISTING ~jai0m52.itm~ ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=166 target=1 global=1 parameter1=90 parameter2=1 timing=2 probability1=100 END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=278 target=1 global=1 parameter1=3 timing=2 probability1=100 END
	LPF skeletal_trait END
	LPF nonMagicalWeapons_immunity END
	LPF turnUndead_immunity END

DEFINE_ACTION_FUNCTION jam52_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#DT12W~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#W52SK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#W56SK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ANSCELET~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AR18SKEL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSKGR08~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDUNSEN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CBC8CTU3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CBZOMB02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CESKEL01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9ELSU11~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9ELWA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9SKL04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9SKL09~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#ANGSK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#DIASK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#SEMSK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ENDSKE01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ENDSKE02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ENDSKE03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ENDSKE04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~FIRMON02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GOLBON01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GRSKEL1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GRSKEL2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GRTOMB01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~HGSKL04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ICHARY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NEVM2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RIFTCR02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RSKEL02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SAHSKEL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SHBONES~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SKELSU11~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SKELWA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SKELWA01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SKELWA02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SKELWA03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SKELWASU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SUUNDEAD~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~TANSKW1~ BEGIN
				LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=278 END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~ring99~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~helmnoan~
			REMOVE_CRE_ITEM ~undtype~
			ADD_CRE_ITEM ~jai0m52~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~jas0m52~ #0 ~innate~ (1) // Fear Aura
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=4000
					hp=115
					ac=2
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=9
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=18
					exceptionalStrength=40
					intelligence=16
					wisdom=12
					dexterity=14
					constitution=9
					charisma=4
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SKELETON~)
					class=IDS_OF_SYMBOL (~class~ ~SKELETON_WARRIOR~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=5
					enforce=1
			END
			// Assigning jam52
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN C0DESUM4 C0DESUM5 SKELSU11 SKELWASU D9ELSU11 SAHSKEL END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam52 END
			// Assigning jam52su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN C0DESUM4 C0DESUM5 SKELSU11 SKELWASU D9ELSU11 SAHSKEL END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam52su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM4~) BEGIN 
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ICHARY~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~HGSKL04~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~ANSCELET~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM5~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SKELWA03~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~FIRMON02~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~GOLBON01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9SKL04~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9SKL09~) BEGIN 
				WRITE_LONG 0x14 6000 // xpv
				WRITE_SHORT 0x24 168 // hp
				WRITE_SHORT 0x26 168 // hp
				WRITE_BYTE 0x52 7 // thac0
				WRITE_BYTE 0x54 5 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 6 // savePolymorph
				WRITE_BYTE 0x57 5 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 13 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ANSCELET~) BEGIN 
				WRITE_LONG 0x14 6000 // xpv
				WRITE_SHORT 0x24 168 // hp
				WRITE_SHORT 0x26 168 // hp
				WRITE_BYTE 0x52 7 // thac0
				WRITE_BYTE 0x54 5 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 6 // savePolymorph
				WRITE_BYTE 0x57 5 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 13 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
				SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 5
				SET_BG2_PROFICIENCY ~PROFICIENCYFLAILMORNINGSTAR~ 5
				SET_BG2_PROFICIENCY ~PROFICIENCYLONGBOW~ 5
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~GOLBON01~) BEGIN 
				WRITE_LONG 0x14 6000 // xpv
				WRITE_SHORT 0x24 180 // hp
				WRITE_SHORT 0x26 180 // hp
				WRITE_SHORT 0x46 "-3" // ac
				WRITE_SHORT 0x48 "-3" // ac
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 5 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 6 // savePolymorph
				WRITE_BYTE 0x57 5 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 14 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ICHARY~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM5~) BEGIN 
				WRITE_LONG 0x14 6000 // xpv
				WRITE_SHORT 0x24 192 // hp
				WRITE_SHORT 0x26 192 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 15 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
				SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 5
				SET_BG2_PROFICIENCY ~PROFICIENCYFLAILMORNINGSTAR~ 5
				SET_BG2_PROFICIENCY ~PROFICIENCYLONGBOW~ 5
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~HGSKL04~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9SKL04~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9SKL09~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
				WRITE_SHORT 0x24 252 // hp
				WRITE_SHORT 0x26 252 // hp
				WRITE_SHORT 0x46 "-6" // ac
				WRITE_SHORT 0x48 "-6" // ac
				WRITE_BYTE 0x52 "-1" // thac0
				WRITE_BYTE 0x54 3 // saveDeath
				WRITE_BYTE 0x55 5 // saveWand
				WRITE_BYTE 0x56 4 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 6 // saveSpell
				WRITE_BYTE 0x234 20 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
				SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 5
				SET_BG2_PROFICIENCY ~PROFICIENCYFLAILMORNINGSTAR~ 5
				SET_BG2_PROFICIENCY ~PROFICIENCYLONGBOW~ 5
			END
