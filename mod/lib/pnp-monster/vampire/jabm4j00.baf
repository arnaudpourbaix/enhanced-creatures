	!CheckStatGT(NearestEnemyOfType([0.0.0.MAGE]),0,LEVEL_DRAIN_IMMUNITY)
	!CheckSpellState(NearestEnemyOfType([0.0.0.MAGE]),ITEM_LEVELDRAIN)
