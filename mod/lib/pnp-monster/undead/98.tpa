				ADD_MEMORIZED_SPELL ~SPPR531~ #4 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR505~ #4 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR530~ #4 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR619~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR620~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR603~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR612~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR610~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR703~ #6 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR715~ #6 ~priest~ (1) 
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"L#NIMF6"
	BEGIN
		LAF jam98_patch STR_VAR file END
	END
END