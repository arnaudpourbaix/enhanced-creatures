DEFINE_ACTION_FUNCTION jam72_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~RE_MEKRN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ANSIRENE~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNEREID~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDPWATER~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SHOAL~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~WALLPASS~
			REMOVE_CRE_ITEM ~DAGG01~
			ADD_CRE_ITEM ~jai0m72~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai5~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas1m72~ #0 ~innate~ (1) // Beguiling Aura
			ADD_MEMORIZED_SPELL ~jas2m72~ #0 ~innate~ (1) // Drowning Kiss
			ADD_MEMORIZED_SPELL ~jas3m72~ #0 ~innate~ (1) // Venom Spit
			ADD_MEMORIZED_SPELL ~jas4m72~ #0 ~innate~ (1) // Summon Giant Poisonous Snake
			ADD_MEMORIZED_SPELL ~jas5m72~ #0 ~innate~ (1) // Watery Fist
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=975
					hp=24
					ac=10
					thac0=17
					apr=0
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					strength=9
					intelligence=12
					wisdom=12
					dexterity=17
					constitution=12
					charisma=18
					morale=11
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~FAIRY_NEREID~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_NEUTRAL~)
					movement=10
					enforce=1
			END
			// Assigning jam72
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDNEREID ULENE BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam72 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDPWATER~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
				WRITE_SHORT 0x24 54 // hp
				WRITE_SHORT 0x26 54 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 9 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~RE_MEKRN~) BEGIN 
				WRITE_SHORT 0x24 30 // hp
				WRITE_SHORT 0x26 30 // hp
				WRITE_BYTE 0x52 15 // thac0
				WRITE_BYTE 0x54 11 // saveDeath
				WRITE_BYTE 0x55 13 // saveWand
				WRITE_BYTE 0x56 12 // savePolymorph
				WRITE_BYTE 0x57 13 // saveBreath
				WRITE_BYTE 0x58 14 // saveSpell
				WRITE_BYTE 0x234 5 // level1
					WRITE_LONG 0x8 RESOLVE_STR_REF(@10185)
					WRITE_LONG 0xc RESOLVE_STR_REF(@10185)
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"RE_MEKRN"
	"ANSIRENE"
	"BDNEREID"
	"BDPWATER"
	"SHOAL"
BEGIN
	LAF jam72_patch STR_VAR file END
