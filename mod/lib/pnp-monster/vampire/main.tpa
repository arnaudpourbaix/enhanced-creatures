// Wolf Form
CREATE ITM "jaie0700"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10424)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10424)
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10425)
COPY_EXISTING ~jaie0700.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_BYTE 0x7e 1
		WRITE_BYTE 0x84 3
		WRITE_BYTE 0x88 12
		WRITE_BYTE 0x8a 3
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=0 target=1 global=1 parameter1=2 parameter2=16 timing=2 probability1=100 END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=53 target=1 global=1 parameter1=IDS_OF_SYMBOL (~animate~ ~WOLF_VAMPIRIC~) timing=2 probability1=100 END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=328 target=1 global=1 parameter2=(IDS_OF_SYMBOL (~splstate~ ~JA_ANIMALFORM~)) timing=2 probability1=100 special=1 END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=145 target=1 global=1 timing=2 probability1=100 END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=144 target=1 global=1 parameter2=2 timing=2 probability1=100 END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=176 target=1 global=1 parameter1=14 parameter2=1 timing=2 probability1=100 END

