DEFINE_ACTION_FUNCTION jam4d_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~GHOLOR01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDGHASTG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BPGHGR01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GHOGR01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GHOULLOR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RIFTCR01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~LACEDO02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~MALKAL~ BEGIN
				LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=292 END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~ghast1~
			REMOVE_CRE_ITEM ~BDGHASTG~
			REMOVE_CRE_ITEM ~ghoul1~
			ADD_CRE_ITEM ~jai0m4d~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m4d~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai2m4d~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~jas2m4d~ #0 ~innate~ (1) // Aura of Evil
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=72
					ac=7
					thac0=15
					apr=2
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=7
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=18
					intelligence=14
					wisdom=11
					dexterity=17
					constitution=9
					charisma=13
					morale=14
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~GHOUL~)
					class=IDS_OF_SYMBOL (~class~ ~GHOUL_GHAST~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					animation=IDS_OF_SYMBOL (~animate~ ~GHOUL_GREATER~)
					movement=12
					enforce=1
					perfect2weapon=1
			END
			// Assigning jam4d
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN ghoul ghast BDGHASTG gholor01 riftcr01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam4d END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~MALKAL~) BEGIN 
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~GHOUL_REVEANT~) // class
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"GHOLOR01"
	"BDGHASTG"
	"BPGHGR01"
	"GHOGR01"
	"GHOULLOR"
	"RIFTCR01"
	"LACEDO02"
	"MALKAL"
BEGIN
	LAF jam4d_patch STR_VAR file END
END