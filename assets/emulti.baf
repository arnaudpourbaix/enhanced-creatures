// * WIZARD_BREACH {5} [SpWi513 - 2513] (anti-combat protections)
// * Requires Mod Stat.IDS file (WIZARD_PROTECTION_FORM_MAGIC_WEAPONS, WIZARD_PROTECTION_FROM_NORMAL_WEAPONS, WIZARD_SPELL_SHIELD)
// *
// * Removes Chaotic Commands, Resist Fear, Remove Fear, Protection From Fire/Cold, Resist Fire/Cold, Death Ward, Fireshield, Free Action
// * Protection From Acid, Protection From Electricity, Protection From Evil, Protection From Evil 10' Radius, Protection From Lightning
// * Protection From Magic Energy, Protection From the Elements, Protection From Energy, Blade Barrier, Physical Mirror, Shield
// * Protection From Normal Missiles, Protection From Normal Weapons, Protection From Magic Weapons, Barkskin, Stoneskin, Defensive Harmony
// * Armor, Armor Of Faith, Ghost Armor, Spirit Armor, Absolute Immunity, Mantle, Improved Mantle, Spell Shield
// *
IF
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  HaveSpell(WIZARD_BREACH)                                                    // if I have the spell
  OR(11)
     CheckStatGT(LastSeenBy(Myself),0,SHIELDGLOBE)
     CheckStatGT(LastSeenBy(Myself),0,STONESKINS)                             // enemy has stoneskins
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_NORMAL_WEAPONS)  // enemy has magic protections
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_NORMAL_MISSILES) // prot. from normal missiles
     CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE5)                        // Barkskin etc.
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)    // He keeps slippin out on my fireballs
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_THE_ELEMENTS)
//     CheckStatGT(LastSeenBy(Myself),0,WIZARD_RESIST_FEAR)                   // These can be dispelled as well,
//     CheckStatGT(LastSeenBy(Myself),0,PROTECTION_FROM_EVIL)                 // but is it really worth it?
     CheckStatGT(LastSeenBy(Myself),0,CLERIC_CHAOTIC_COMMANDS)
     CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE2)                        // Death Ward
     CheckStatGT(LastSeenBy(Myself),0,CLERIC_PHYSICAL_MIRROR)
  !CheckStat(LastSeenBy(Myself),1,WIZARD_SPELL_SHIELD)                        // and their protections aren't protected by a spell shield
  !InParty(LastSeenBy(Myself))                                                // and their not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                                  // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(Myself,STATE_SILENCED)                                          // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                     // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                               // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                                  // and they aren't immune to spells of 5th level or lower
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                        // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_BREACH)
    DisplayStringHead(LastSeenBy(Myself),5021)                                // say "Breach"
END

// * WIZARD_SPELL_STRIKE {9} [SpWi903 - 2903] (Removes All Protections Combat and Magical)
// * Requires Mod Stat.IDS file (WIZARD_PROTECTION_FROM_MAGIC_WEAPONS, WIZARD_PROTECTION_FROM NORMAL_WEAPONS, WIZARD_SPELL_SHIELD, WIZARD_SPELL_DEFLECTION, WIZARD_SPELL_TURNING, WIZARD_SPELL_IMMUNITY, WIZARD_SPELL_TRAP)
// * Requires Mod Specific.IDS File (NEEDS_BREACH, HAS_SHIELDS)

// * Removes
// * Minor Spell Deflection
// * Minor Globe of Invulnerability
// * Minor Spell Turning
// * Spell Immunity
// * Spell Shield
// * Globe of Invulnerability
// * Spell Deflection
// * Spell Turning
// * Spell Trap
// * Shield of the Archons
IF
  HaveSpell(WIZARD_SPELL_STRIKE)                                              // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  OR(11)
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_SHIELD)                    // enemy has spell shield in place
     CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)                             // enemy has minor or greater globe of invulnerability in place
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_DEFLECTION)                // enemy has spell deflection in place
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TURNING)                   // enemy has spell turning in place
     CheckStat(LastSeenBy(Myself),1,WIZARD_SPELL_IMMUNITY)                    // enemy has spell immunity: abjuration in place (protects against dispel/remove magic)
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TRAP)                      // enemy has spell trap in place
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_NORMAL_MISSILES) // enemy is protected from normal missiles
     CheckStatGT(LastSeenBy(Myself),0,STONESKINS)                             // enemy has stoneskins
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_NORMAL_WEAPONS)  // enemy is protected from normal weapons
     CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)   // enemy is protected from magic weapons
     CheckStatGT(LastSeenBy(Myself),0,CLERIC_SHIELD_OF_THE_ARCHONS)
  !InParty(LastSeenBy(Myself))                                                // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                                  // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(Myself,STATE_SILENCED)                                          // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                     // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                        // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_SPELL_STRIKE)
    DisplayStringHead(LastSeenBy(Myself),26314)                               // say "Spellstrike"
END

// **********************************************************************
// *           Segment Name: gs_AntiMage_TL4_Priest.baf
// **********************************************************************

// ANTI-MAGIC USER ATTACKS - THREAT LEVEL FOUR - (Priest)

// * CLERIC_CREEPING_DOOM {7} [SpPr717 - 1717] (Increases Chance of Spell Casting Failure: Single Target, Ranged, 2pt dmg/2s for duration, 100% spell failure (no save) + fear (save vs spells -2), 3 rnds)
// * Anti-nasty critter version
// * Requries Mod Stat.IDS (CLERIC_INSECT_PLAGUE)
IF
  HaveSpell(CLERIC_CREEPING_DOOM)                                          // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // and its threat-level 3+
  OR(3)
     Race(LastSeenBy(Myself),DEMONIC)                                      // or a demon
     Race(LastSeenBy(Myself),MIND_FLAYER)                                  // or a mind-flayer
     Race(LastSeenBy(Myself),DRAGON)                                       // or a dragon
  CheckStatLT(LastSeenBy(Myself),1,CLERIC_INSECT_PLAGUE)                   // and they're not already affected by a similar spell
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  !StateCheck(LastSeenBy(Myself),STATE_SILENCED)                           // and they're not already silent
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  Range(LastSeenBy(Myself),12)                                             // and they're 12sq away
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant [casting room clause]
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_CREEPING_DOOM)
    Wait(2)
END

