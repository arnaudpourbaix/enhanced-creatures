IF
    Global("invnc","LOCALS",0)
    !HasItem("dw#noinv",Myself)  // Mirror
    HaveSpell(WIZARD_INVISIBILITY)  // SPWI206.SPL (Invisibility)
    !StateCheck(Myself,STATE_BLIND)
    !StateCheck(Myself,RZ_STATE_DISABLED)
    Allegiance(Myself,ENEMY)
    !Race(Myself,OGRE)
    !Detect(NearestEnemyOf(Myself))
    !Detect(Player1)
    !Detect(Player2)
    !Detect(Player3)
    !Detect(Player4)
    !Detect(Player5)
    !Detect(Player6)
THEN
    RESPONSE #200
        SetGlobal("invnc","LOCALS",1)
        ApplySpellRES("dw#silin",Myself)  // Invisibility
        SetGlobalTimer("invimp","LOCALS",1)
        RemoveSpell(WIZARD_INVISIBILITY)  // SPWI206.SPL (Invisibility)
    RESPONSE #100
        SetGlobal("invnc","LOCALS",1)
END

