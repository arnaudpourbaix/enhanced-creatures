DEFINE_ACTION_FUNCTION jam15_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWOLFVA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~P#WOLF04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFVA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#ULCWO~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~WOLFVA1~
			REMOVE_CRE_ITEM ~BDWOLFVA~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~RING95~
			REPLACE_CRE_ITEM ~jai0m15~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai1m15~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON2~ 
			REPLACE_CRE_ITEM ~jai2m15~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON3~ 
			ADD_CRE_ITEM ~jai3m15~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			PATCH_DEFINE_ARRAY notEnforceFiles BEGIN DW#ULCWO END
			LPF patchCreature
				INT_VAR
					xpv=2000
					hp=52
					ac=2
					thac0=13
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=6
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					strength=18
					intelligence=6
					wisdom=12
					dexterity=13
					constitution=9
					charisma=7
					morale=14
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~WOLF~)
					class=IDS_OF_SYMBOL (~class~ ~WOLF_VAMPIRIC~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~)
					movement=19
					enforce=1
				STR_VAR
					notEnforceFiles
			END
			// Assigning jam15
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN VAMPWOLF BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam15 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BDWOLFVA"
	"P#WOLF04"
	"WOLFVA"
	"DW#ULCWO"
BEGIN
	LAF jam15_patch STR_VAR file END
END