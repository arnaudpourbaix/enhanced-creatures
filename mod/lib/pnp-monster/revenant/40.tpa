ACTION_FOR_EACH ~file~ IN
	"UBSVLREV"
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.bcs~ BEGIN
		COPY_EXISTING ~%file%.bcs~ ~override~
			DECOMPILE_AND_PATCH BEGIN
				REPLACE_TEXTUALLY ~True()~ ~!Allegiance(Myself,ENEMY)~
				SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~AttackedBy([ANYONE],DEFAULT)~ 0)
				WHILE (ec_pos >= 0) BEGIN
					SET ec_start = RINDEX_BUFFER (~^IF~ ec_pos)
					SET ec_end = INDEX_BUFFER (~^END~ ec_pos)
					PATCH_IF (ec_start >= 0 AND ec_end > ec_pos) BEGIN
						DELETE_BYTES ec_start (ec_end + 3 - ec_start)
						SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~AttackedBy([ANYONE],DEFAULT)~ ec_start)
					END ELSE BEGIN
						SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~AttackedBy([ANYONE],DEFAULT)~ ec_pos + 1)
					END
				END
				SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~NearestEnemyOf(Myself)~ 0)
				WHILE (ec_pos >= 0) BEGIN
					SET ec_start = RINDEX_BUFFER (~^IF~ ec_pos)
					SET ec_end = INDEX_BUFFER (~^END~ ec_pos)
					PATCH_IF (ec_start >= 0 AND ec_end > ec_pos) BEGIN
						DELETE_BYTES ec_start (ec_end + 3 - ec_start)
						SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~NearestEnemyOf(Myself)~ ec_start)
					END ELSE BEGIN
						SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~NearestEnemyOf(Myself)~ ec_pos + 1)
					END
				END
				SPRINT ec_top ~IF
  GlobalGT("UBSVLAST_ENC","GLOBAL",3)
  HaveSpellRES("jask0c00")
  !GlobalTimerNotExpired("JA_ROUND","LOCALS")
  See("ubsvlast")
  !StateCheck("ubsvlast",STATE_BLIND)
  !CheckStatGT("ubsvlast",0,HELD)
  !CheckStatGT("ubsvlast",0,CLERIC_FREE_ACTION)
  !CheckSpellState("ubsvlast",HOLD_IMMUNITY)
THEN
  RESPONSE #100
    SetGlobalTimer("JA_ROUND","LOCALS",6)
    ForceSpellRES("jask0c00","ubsvlast")
END

~
				INSERT_BYTES 0 STRING_LENGTH ~%ec_top%~
				WRITE_ASCIIE 0 ~%ec_top%~
			END
		BUT_ONLY
	END
END

DEFINE_ACTION_FUNCTION jam40_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BPREVE01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~FIRMON04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GRREVEN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~REVEN01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~REVENT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UBSVLREV~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~FEARM~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~REVENT1~
			REMOVE_CRE_ITEM ~REVENT2~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~UBSVLHLM~
			ADD_CRE_ITEM ~jaik0c00~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim4000~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaim4001~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~jask0c00~ #0 ~innate~ (1) // Paralyzing Gaze
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=96
					ac=10
					thac0=13
					apr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=8
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=18
					intelligence=17
					wisdom=16
					dexterity=14
					constitution=18
					charisma=18
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~GHOUL~)
					class=IDS_OF_SYMBOL (~class~ ~GHOUL_REVEANT~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=7
					enforce=1
			END
			// Assigning jabm4000
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BPSKEL BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4000 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~FIRMON04~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~REVENT~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~UBSVLREV~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~FEARM~) BEGIN 
				WRITE_SHORT 0x24 180 // hp
				WRITE_SHORT 0x26 180 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 15 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BPREVE01~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~FIRMON04~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~GRREVEN~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~REVEN01~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~REVENT~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~UBSVLREV~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~FEARM~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BPREVE01"
		"REVENT"
		"UBSVLREV"
		"FEARM"
	BEGIN
		LAF jam40_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"FIRMON04"
		"GRREVEN"
		"REVEN01"
	BEGIN
		LAF jam40_patch STR_VAR file END
	END
END