				ADD_MEMORIZED_SPELL ~SPPR412~ #3 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR411~ #3 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR414~ #3 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR416~ #3 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR403~ #3 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR431~ #3 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR512~ #4 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR503~ #4 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR511~ #4 ~priest~ (1) 
