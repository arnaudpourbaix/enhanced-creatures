// * Cooperative Healing: Healer

// * TARGET HEAL REQUESTERS

// * Prevent Duplicate Heals by See(Myself)
IF
  ActionListEmpty()
  See(Myself)
  False()
THEN
  RESPONSE #100
    Continue()
END

// * Top-Up Requests (plyr1 - plyr6):

// * If Player1 asked for Top-Up
IF
  ActionListEmpty()
  Global("gh_NoHealingSpells","LOCALS",0)                                  // if I still have healing spells
  !Range(Player1,0)                                                        // If I am *not* Player1
  GlobalTimerNotExpired("gh_Player1_HelpRequest_TopUp","GLOBAL")           // and Player1 asked for help in the last 10 secs
  !Global("gh_LastHealed","GLOBAL",1)                                      // and Player1 was not healing in the last 10 secs
  See(Player1)                                                             // then See Player1
THEN
  RESPONSE #100
    SetGlobal("gh_LastHealed","GLOBAL",1)                                  // Set the LastHealed=Player1
