// * L2:  1d4 MAGIC dmg no save + Pain 1R+4s (-1 AC, THAC0, STR, DEX) STvS +6 neg
// * L3:  1d6 MAGIC dmg no save + Burn (1d8 FIRE dmg) STvS +6 neg
// * L4:  1d6 MAGIC dmg no save + Blindness 10R (-4 AC, -4 THAC0, -4 all STs) STvS +6 neg
// * L5:  1d8 MAGIC dmg no save + Stun 3R STvS +6 neg
// * L6:  1d8 MAGIC dmg no save + Weakness 10R (-4 THAC0) STvS +6 neg
// * L7:  1d10 MAGIC dmg no save + Stun 20R STvS +6 neg
// * L10:  1d12 ACID dmg no save + Petrification STvS +6 neg
// * L12:  2d16 ACID dmg no save + Slay STvS +6 neg
IF
  HaveSpellRES("SpDr101")                                                  // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 2+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  HPGT(LastSeenBy(Myself),25)                                              // and the target has >25hp
  CheckStatGT(LastSeenBy(Myself),11,SAVEVSSPELL)                           // and our target doesn't have an impossible to beat saving throw
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("SpDr101",LastSeenBy(Myself))                                 // cast the spell
END

// **********************************************************************
// *           Segment Name: gs_Disablers_TL2_Warrior.baf
// **********************************************************************

// * DISABLING SPELLS  - THREAT LEVEL 2 - (Warrior)

// * [From Specific to Generic]
// * [A specific target is any target with a qualified condition, such as being NOT immune to fire]

// * 2: Specific Disabling

// * WARRIOR_WAR_CRY {1} [SpCl908 - 4908] (PF, cs 0, caster centered AOE 30' radius, 10R, panic STvS neg)
// * Requires Mod STATE.IDS file (STATE_RANGED_TARGET)
// * Requires Mod STAT.IDS file (WIZARD_RESIST_FEAR)
IF
  HaveSpell(WARRIOR_WAR_CRY)                                               // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and it's threat-level 1+
  !GlobalTimerNotExpired("GB_WarCry","LOCALS")                             // and we haven't cast the spell in the last 3 turns
  NumCreatureVsPartyGT([EVILCUTOFF],2)                                     // and there are 3+ monsters
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion, or Simularcrum
  HPGT(LastSeenBy(Myself),15)                                              // and the target has >15hp
  Range(LastSeenBy(Myself),10)                                             // and range is <10 steps away, therefore semi-safe
  !General(LastSeenBy(Myself),UNDEAD)                                      // and not undead
  !Race(LastSeenBy(Myself),SLIME)                                          // and not a slime
  !Race(LastSeenBy(Myself),DRAGON)                                         // and not a dragon
  !Race(LastSeenBy(Myself),TROLL)                                          // and not a troll
  !Race(LastSeenBy(Myself),BEHOLDER)                                       // and not a beholder
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and not completely resistant to magic
  !StateCheck(LastSeenBy(Myself),STATE_RANGED_TARGET)                      // and not blind, confused, or paniced
  CheckStatLT(LastSeenBy(Myself),1,WIZARD_RESIST_FEAR)                     // and they aren't protected by the spell
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)
    SetGlobalTimer("GB_WarCry","LOCALS",18)
    Spell(Myself,WARRIOR_WAR_CRY)
    DisplayStringHead(Myself,63954)                                        // "War Cry"
END

// **********************************************************************
// *           Segment Name: gs_PreAttack_TL2_Priest.baf
// **********************************************************************

// * PRE-ATTACK SPELLS - THREAT LEVEL TWO (Priest)

// * Pre-Attack: Spells cast that require a physical attack to complete, or are
// * designed to enhance or assist physical attacks.

// * CLERIC_CAUSE_SERIOUS_WOUNDS {4} [SpPr414 - 1414]
// * -----------------------------------------
// * CS: 7, TGT: Caster, RNG: 1', AOE: Caster
// * -----------------------------------------
// * Create Item: SERIOUS (Enchantment: +6, To Hit: +2, Dmg: 17 Unknown - No Save) - 15s
IF
  HaveSpell(CLERIC_CAUSE_SERIOUS_WOUNDS)                                   // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 1+
  !InParty(NearestEnemyOf(Myself))                                         // and they're not in our party (double-check)
  !Allegiance(NearestEnemyOf(Myself),GOODCUTOFF)                           // and not an Ally, Familiar, Minion or Simulacrum
  HPGT(NearestEnemyOf(Myself),10)                                          // and the target has >10hp
//  CheckStatLT(NearestEnemyOf(Myself),26,MAGICDAMAGERESISTANCE)             // and they aren't resistant to MAGIC dmg
  Range(NearestEnemyOf(Myself),6)                                          // and they're within 6sq away (melee)
  !HasItemSlot(Myself,SLOT_MISC19)                                         // more robust check to see if I already have anything in the magically created item slot
//  !HasItem("SERIOUS",Myself)                                             // and I don't already have a Serious Wounds in effect
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(NearestEnemyOf(Myself),76,RESISTMAGIC)                       // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",NearestEnemyOf(Myself))                        // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",NearestEnemyOf(Myself))                           // and they aren't immune to spells of 5th level or lower
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_CAUSE_SERIOUS_WOUNDS)
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

