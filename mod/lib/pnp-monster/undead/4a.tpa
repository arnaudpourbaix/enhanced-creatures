DEFINE_ACTION_FUNCTION jam4a_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~DVDEATHK~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~SHLD06~
			REMOVE_CRE_ITEM ~RINGDEMN~
			REMOVE_CRE_ITEM ~UNDTYPE~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~DVDEATHK~
			ADD_CRE_ITEM ~jai0m4a~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai15~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~SPWI203~ #1 ~wizard~ (20) 
			ADD_MEMORIZED_SPELL ~SPWI326~ #2 ~wizard~ (2) 
			ADD_MEMORIZED_SPELL ~SPWI815~ #7 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~SPWI912~ #8 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~SPWI715~ #6 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~SPWI899~ #7 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~jaspain~ #7 ~wizard~ (1) // Symbol of Pain
			ADD_MEMORIZED_SPELL ~jas0m4a~ #0 ~innate~ (1) // Fear Aura
			ADD_MEMORIZED_SPELL ~jas1m4a~ #3 ~wizard~ (30) // Wall of Ice
			ADD_MEMORIZED_SPELL ~jas2m4a~ #2 ~wizard~ (1) // Unholy Fireball
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=6000
					hp=108
					ac=0
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=9
					level2=20
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=18
					exceptionalStrength=100
					intelligence=18
					wisdom=16
					dexterity=11
					constitution=9
					charisma=10
					morale=17
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SKELETON~)
					class=IDS_OF_SYMBOL (~class~ ~CLERIC_MAGE~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=10
					enforce=1
			END
			// Assigning jam4a
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam4a END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"DVDEATHK"
BEGIN
	LAF jam4a_patch STR_VAR file END
END