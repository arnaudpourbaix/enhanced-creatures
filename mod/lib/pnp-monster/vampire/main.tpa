// Control Undead
CREATE SPL "jase0702"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jase0702.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10422)
	WRITE_LONG 0x18 33570816
	WRITE_SHORT 0x1c 1
	WRITE_BYTE 0x25 7
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 7
	WRITE_ASCII 0x3a ~SPWI720C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10423)
