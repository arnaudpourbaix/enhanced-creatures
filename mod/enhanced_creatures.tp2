/*************************************************************************
 *                        Enhanced Creatures
 ************************************************************************ */
BACKUP ~weidu_external/backup/enhanced_creatures~
AUTHOR "Aigleborgne"
VERSION ~v0.4.0~

ALWAYS
    INCLUDE "%MOD_FOLDER%/lib/common/index.tpa"
    RANDOM_SEED go
END

// README ~%MOD_FOLDER%/docs/index.html~

LANGUAGE ~English~ ~english~ ~%MOD_FOLDER%/languages/english/setup.tra~ ~%MOD_FOLDER%/languages/english/game.tra~ ~%MOD_FOLDER%/languages/english/generated.tra~

