DEFINE_ACTION_FUNCTION jam1_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ANKHEG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ANKHEG01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ANKHEGF~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ANKHEGG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ANKHEGQ~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDANKH01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDANKHEG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDANKHSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNEO~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BPANKHE1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#MIMMI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#NDC2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#XZEANK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#XZEANS~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHDRANKH~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WIANKHE1~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ANKHEG1~
			REMOVE_CRE_ITEM ~ANKHEG2~
			REPLACE_CRE_ITEM ~jai0m1~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai12~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas0m1~ #0 ~innate~ (1) // Stream of acidic enzymes
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=975
					hp=80
					ac=2
					thac0=13
					apr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=8
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=17
					intelligence=1
					wisdom=13
					dexterity=11
					constitution=13
					charisma=6
					morale=9
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~ANKHEG~)
					class=IDS_OF_SYMBOL (~class~ ~ANKHEG~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=5
					enforce=1
			END
			// Assigning jam1 to slot Race
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN ANKHEG ANKHEGB L#XZEANK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BDANKHSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=Race removeScripts skipFiles script=jam1 END
			// Assigning jam1su to slot Race
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN ANKHEG ANKHEGB L#XZEANK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN BDANKHSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=Race files removeScripts script=jam1su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDANKH01~) BEGIN 
				WRITE_SHORT 0x24 100 // hp
				WRITE_SHORT 0x26 100 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 10 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#MIMMI~) BEGIN 
