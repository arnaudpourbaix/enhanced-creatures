// **********************************************************************
// *           Segment Name: gs_HotKeyB_Priest.baf
// **********************************************************************

// * HOTKEY(B) BASED SPELL PREP - PRIEST SPELLS

// * Set the 3 round Timer when the HotKey is pressed
IF
  !GlobalTimerNotExpired("gh_BuffTimer","LOCALS")                          // if the counter is at 0
  HotKey(B)                                                                // and the players pressed the B Key
THEN
  RESPONSE #100
    SetGlobalTimer("gh_BuffTimer","LOCALS",18)                             // set the Timer to 3 rounds (gets us 3 buff spells)
END

