IF
    StateCheck(Myself,STATE_REALLY_DEAD)
THEN
    RESPONSE #100
        CreateVisualEffectObject("SPROTECT",Myself)
        CreateVisualEffectObject("SPDUSTY2",Myself)
        DestroySelf()
END

IF
    OR(2)
        INI("DMWW_ascension_difficulty",0)
        INI("DMWW_ascension_difficulty",5)
    OR(2)
        Difficulty(HARDEST)
        INI("DMWW_ascension_difficulty",5)
    Global("difficulty","LOCALS",0)
THEN
    RESPONSE #100
        SetGlobal("difficulty","LOCALS",1)
        ApplySpellRES("ibodhi7",Myself)  // Deathly Shroud
        Continue()
END

IF
    OR(5)
        INI("DMWW_ascension_difficulty",0)
        INI("DMWW_ascension_difficulty",1)
        INI("DMWW_ascension_difficulty",2)
        INI("DMWW_ascension_difficulty",3)
        INI("DMWW_ascension_difficulty",4)
    OR(2)
        DifficultyLT(HARDEST)
        !INI("DMWW_ascension_difficulty",0)
    Global("difficulty","LOCALS",1)
THEN
    RESPONSE #100
        SetGlobal("difficulty","LOCALS",0)
        ApplySpellRES("dw#hprem",Myself)  // No such index
        Continue()
END

IF
    !GlobalTimerNotExpired("blockproundead","LOCALS")
    See(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        ApplySpellRES("dw#nprun",Player1)  // <NO TEXT>
        ApplySpellRES("dw#nprun",Player2)  // <NO TEXT>
        ApplySpellRES("dw#nprun",Player3)  // <NO TEXT>
        ApplySpellRES("dw#nprun",Player4)  // <NO TEXT>
        ApplySpellRES("dw#nprun",Player5)  // <NO TEXT>
        ApplySpellRES("dw#nprun",Player6)  // <NO TEXT>
        SetGlobalTimer("blockproundead","LOCALS",ONE_HOUR)
        Continue()
END

IF
    !GlobalTimerNotExpired("castspell","LOCALS")
    See([PC.0.0.MAGE_ALL])
    OR(6)
        INI("DMWW_ascension_difficulty",0)
        INI("DMWW_ascension_difficulty",3)
        INI("DMWW_ascension_difficulty",4)
        INI("DMWW_ascension_difficulty",5)
        INI("DMWW_ascension_difficulty",6)
        INI("DMWW_ascension_difficulty",7)
    OR(6)
        DifficultyGT(EASY)
        INI("DMWW_ascension_difficulty",3)
        INI("DMWW_ascension_difficulty",4)
        INI("DMWW_ascension_difficulty",5)
        INI("DMWW_ascension_difficulty",6)
        INI("DMWW_ascension_difficulty",7)
    !GlobalTimerNotExpired("bats","LOCALS")
    !CheckStatGT([PC.0.0.MAGE_ALL],99,RESISTMAGIC)
    Allegiance(Myself,ENEMY)
    !Allegiance([PC.0.0.MAGE_ALL],ENEMY)
    !StateCheck([PC.0.0.MAGE_ALL],D0_STATE_DISABLED)
    !StateCheck([PC.0.0.MAGE_ALL],STATE_FEEBLEMINDED)
    !CheckStatGT([PC.0.0.MAGE_ALL],0,HELD)
THEN
    RESPONSE #100
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
        SetGlobal("batform","LOCALS",0)
        ForceSpellRES("ibodhi1",[PC.0.0.MAGE_ALL])  // Cloud of Bats
        SetGlobalTimer("bats","LOCALS",1000)
    RESPONSE #100
        Continue()
END

