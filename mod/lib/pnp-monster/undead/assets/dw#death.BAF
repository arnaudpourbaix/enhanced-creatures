THEN
    RESPONSE #100
        SetGlobal("rest_state","LOCALS",1)
        Continue()
END

IF
    Global("rest_state","LOCALS",1)
    !Detect(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        SetGlobal("rest_state","LOCALS",2)
        SetGlobalTimer("rest_timer","LOCALS",EIGHT_HOURS)
        Continue()
END

