// Generated file (don't edit)

// Giant Spider
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/giant-spider/jabm1k00.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/giant-spider/jabm1k01.baf~

// Type F poison
CREATE SPL "jasm1k00"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jasm1k00.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@11038)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 fl#Poison
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11039)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=2 parameter2=2 duration=17 probability1=100 dicesize=1 dicenumber=2 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=5 parameter2=2 duration=14 probability1=100 dicesize=3 dicenumber=4 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=8 parameter2=2 duration=13 probability1=100 dicesize=5 dicenumber=6 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=11 parameter2=2 duration=13 probability1=100 dicesize=7 dicenumber=8 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=13 parameter2=2 duration=12 probability1=100 dicesize=9 dicenumber=10 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=14 parameter2=2 duration=13 probability1=100 dicesize=11 dicenumber=15 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=20 parameter2=2 duration=13 probability1=100 dicesize=16 dicenumber=40 savingthrow=4 special=6 END
OUTER_SET $f_AddSecType(jasm1k00.spl) = PoisonSecType

// Jaws
CREATE ITM "jaim1k00"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10000)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10000)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~SPPR416B~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11040)
	WRITE_LONG 0x60 1
COPY_EXISTING ~jaim1k00.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~SPPR416B~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 2
		WRITE_BYTE 0x84 2
		WRITE_BYTE 0x88 8
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=146 target=2 parameter2=1 probability1=100 STR_VAR resource="jasm1k00" END
	END

DEFINE_ACTION_FUNCTION jam1k_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWISTAK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBSPI01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELP01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSPIDGI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BPSPID02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C#SOSPD1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C#SOSPDD~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9IDGI01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9IDGI02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9IDGI03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSPI1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSPI2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSPI3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSPI4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PLYSPID2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RSSPIDGI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDGI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDGI01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDGISU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPSPID05~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID05~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID06~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID07~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDSPID08~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BDSPIDGI~
			REMOVE_CRE_ITEM ~SPIDGI1~
			REMOVE_CRE_ITEM ~SPIDG1~
			REMOVE_CRE_ITEM ~SPIDGISU~
			REMOVE_CRE_ITEM ~ANTIWEB~
			REMOVE_CRE_ITEM ~PLYSPID~
			REMOVE_CRE_ITEM ~VERMTYPE~
			REMOVE_CRE_ITEM ~SPIDHU1~
			REPLACE_CRE_ITEM ~jaim1k00~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaic000g~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=650
					hp=36
					ac=6
					thac0=15
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=14
					intelligence=7
					wisdom=11
					dexterity=16
					constitution=12
					charisma=4
					morale=13
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SPIDER~)
					class=IDS_OF_SYMBOL (~class~ ~SPIDER_GIANT~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					animation=IDS_OF_SYMBOL (~animate~ ~SPIDER_GIANT~)
					movement=2
					enforce=1
			END
			// Assigning jabm1k00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN DW#SPIDG O#LLFIGH BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN SPIDGISU BDHELP01 PLYSPID2 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm1k00 END
			// Assigning jabm1k01
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN DW#SPIDG O#LLFIGH BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN SPIDGISU BDHELP01 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm1k01 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLYSPID2~) BEGIN 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELP01~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDGISU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"PLYSPID2"
	"SPIDGISU"
BEGIN
	LAF jam1k_patch STR_VAR file END
END
