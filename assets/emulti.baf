// PART TWO - ANTI-SPECIFIC THREAT

// * WIZARD_PROTECTION_FROM_THE_ELEMENTS {7} [SpWi702 - 2702] (@Self: 75% resistance to elemental damage)
// * Detectable Spell
// * Requires Mod Stat.IDS File (WIZARD_PROTECTION_FROM_THE_ELEMENTS)
IF
  HaveSpell(WIZARD_PROTECTION_FROM_THE_ELEMENTS)                           // and we have the spell
  !CheckStat(Myself,1,WIZARD_PROTECTION_FROM_THE_ELEMENTS)
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
//  !HasImmunityEffects(Myself)                                              // and not immune to spells
  !HasBounceEffects(Myself)                                                // and not spell-turning
  OR(6)                                                                    // and I see a big fire, cold or electricity using beatie
     See(NearestEnemyOfType([EVILCUTOFF.0.0.ELEMENTAL_FIRE.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.RED_DRAGON.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.GENIE_EFREETI.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.GENIE_NOBLE_EFREETI.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.BEAR_POLAR.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.WOLF_WINTER.0.0.0]))
  OR(5)
     CheckStatLT(Myself,75,RESISTFIRE)                                     // and I'm not already resisting Fire
     CheckStatLT(Myself,75,RESISTMAGICFIRE)                                // and I'm not already resisting Magic Fire
     CheckStatLT(Myself,75,RESISTCOLD)                                     // and I'm not already resisting Cold
     CheckStatLT(Myself,75,RESISTMAGICCOLD)                                // and I'm not already resisting Magic Cold
     CheckStatLT(Myself,75,RESISTELECTRICITY)                              // and I'm not already resisting ELECTRICITY
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant(any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_PROTECTION_FROM_THE_ELEMENTS)
END

// **********************************************************************
// *           Segment Name: gs_DefencesSpecific_TL4_Priest.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 4 (PRIEST)

// * PART ONE - ANTI-MAGE

// * PART TWO - ANTI-SPECIFICS

// * CLERIC_DEATH_WARD 'ds' {4} [SpPr409 - 1409] (prevents death spell-like effects (scriptingstate2))
// * What sort of creatures use death-spells? Beholder, Lich, High Lvl Mages & Priests?
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)
IF
  HaveSpell(CLERIC_DEATH_WARD)                                             // if I have the spell
  !CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE2)                         // and they're not already protected by death-ward
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // or its threat-level 4
  OR(5)
     See(NearestEnemyOfType([EVILCUTOFF.0.0.BEHOLDER.0.0.0]))              // and I see a creature capable of casting instant death spells
     See(NearestEnemyOfType([EVILCUTOFF.0.LICH.0.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.DEMONIC.0.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.MAGE_ALL.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.CLERIC_ALL.0.0.0]))
  See(LastAttackerOf(LastSeenBy(Myself)))                                  // and I see who they're targetting
  !StateCheck(LastSeenBy(Myself),STATE_NOT_VISIBLE)                        // and not invisible/impinvis
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_DEATH_WARD)
END

