// Generated file (don't edit)

// Juggernaut Golem
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/juggernaut-golem/jabm0x00.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/juggernaut-golem/jabm0x01.baf~

// Peak speed
CREATE SPL "jasm0x00"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jasm0x00.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10239)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI305C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10962)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=5 speed=1 STR_VAR icon="SPWI305B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=176 target=2 power=1 parameter1=10 parameter2=1 duration=18 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=111 target=1 power=1 parameter1=1 duration=18 probability1=100 STR_VAR resource="jaim0x01" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=RESOLVE_STR_REF(@10241) timing=4 duration=18 probability1=100 END
	
// Charge
CREATE SPL "jasm0x01"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jasm0x01.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10238)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI305C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10240)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=5 speed=1 STR_VAR icon="SPWI305B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=176 target=2 power=1 parameter1=5 parameter2=1 duration=6 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=176 target=2 power=1 parameter1=7 parameter2=1 timing=3 duration=6 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=146 target=2 power=1 parameter2=1 timing=4 duration=12 probability1=100 STR_VAR resource="jasm0x00" END
	LPF CHANGE_SPELL INT_VAR    renew=6 END
	
// Juggernaut Golem traits
CREATE ITM "jaim0x00"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10961)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10961)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10963)
COPY_EXISTING ~jaim0x00.itm~ ~override~
	LPF magic_immunity END
	LPF fire_immunity END

// Fists
CREATE ITM "jaim0x01"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10003)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10003)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IFIST~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10964)
	WRITE_LONG 0x60 4
COPY_EXISTING ~jaim0x01.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IFIST~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 3
		WRITE_BYTE 0x84 4
		WRITE_BYTE 0x88 10
		WRITE_BYTE 0x8a 10
		WRITE_SHORT 0x8e 2
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

