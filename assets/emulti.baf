// *           Segment Name: gs_PreAttack_TL1_Mage.baf
// **********************************************************************

// * PRE-ATTACK SPELLS - THREAT LEVEL ONE (Mage)

// * Pre-Attack: Spells cast that require a physical attack to complete, or are
// * designed to enhance or assist physical attacks.

// * 1: Pre-Melee

// * WIZARD_SHOCKING_GRASP {1} [SpWi115 - 2115] (cs 1, rng 1, AOE caster, 6S, requires To Hit Roll, 1d8+1/CL ELECRTRICITY dmg, no save)
// * [SGRASP01-SGRASP20.ITM[ Enchantment +6, To Hit +4, No STR bonus
IF
  HaveSpell(WIZARD_SHOCKING_GRASP)                                         // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 1+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  HPGT(LastSeenBy(Myself),10)                                              // and the target has >10hp
  Range(LastSeenBy(Myself),6)                                              // and they're within 6 sq [therefore, melee is unavoidable]
  !HasItemSlot(Myself,SLOT_MISC19)                                         // more robust check to see if I already have anything in the magically created item slot
//  !HasItem("SGRASP01",Myself)                                              // and they haven't already cast Shocking Grasp
//  !HasItem("SGRASP02",Myself)
//  !HasItem("SGRASP03",Myself)
//  !HasItem("SGRASP04",Myself)
//  !HasItem("SGRASP05",Myself)
//  !HasItem("SGRASP06",Myself)
//  !HasItem("SGRASP07",Myself)
//  !HasItem("SGRASP08",Myself)
//  !HasItem("SGRASP09",Myself)
//  !HasItem("SGRASP10",Myself)
//  !HasItem("SGRASP11",Myself)
//  !HasItem("SGRASP12",Myself)
//  !HasItem("SGRASP13",Myself)
//  !HasItem("SGRASP14",Myself)
//  !HasItem("SGRASP15",Myself)
//  !HasItem("SGRASP16",Myself)
//  !HasItem("SGRASP17",Myself)
//  !HasItem("SGRASP18",Myself)
//  !HasItem("SGRASP19",Myself)
//  !HasItem("SGRASP20",Myself)
  CheckStatLT(LastSeenBy(Myself),1,RESISTELECTRICITY)                      // and not resisting electricity
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_SHOCKING_GRASP)
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

