// * ATTACK SPELLS NOT REQUIRING A SPECIFIC TARGET - THREAT LEVEL 3 - (Priest)

// * [A specific target is any target with a qualified condition, such as being NOT immune to fire]

// * CLERIC_UNHOLY_BLIGHT {3} [SpPr314 - 1314] (Mass Damage Good !Affects Party!: ranged, AOE 20'radius, 1d4 MAGIC dmg/CL, save vs spells 1/2 dmg, + -4 to all rolls, 4 rnds, save negates)

// * First Usage: Where whole Party is Evil or Neutral, the Unholy Blight can be cast
// * anywhere and won't adversely affect the party. This is the best way to use it, but less
// * likely due to the alignment restriction :)
IF
  HaveSpell(CLERIC_UNHOLY_BLIGHT)                                          // and I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  Alignment(LastSeenBy(Myself),MASK_GOOD)                                  // and the Target Evil Aligned
  !Alignment(Player1,MASK_GOOD)                                            // and Player1 is EVIL or NEUTRAL
  !Alignment(Player2,MASK_GOOD)                                            // and Player2 is EVIL or NEUTRAL
  !Alignment(Player3,MASK_GOOD)                                            // and Player3 is EVIL or NEUTRAL
  !Alignment(Player4,MASK_GOOD)                                            // and Player4 is EVIL or NEUTRAL
  !Alignment(Player5,MASK_GOOD)                                            // and Player5 is EVIL or NEUTRAL
  !Alignment(Player6,MASK_GOOD)                                            // and Player6 is EVIL or NEUTRAL
  HPGT(LastSeenBy(Myself),15)                                              // and the Target has >15hp
  Range(LastSeenBy(Myself),12)                                             // and the Target is within 12 sq
  NumCreatureGT([EVILCUTOFF],2)                                            // and there are at least 3+ opponents
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(Myself,STATE_SILENCED)
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_UNHOLY_BLIGHT)
END

