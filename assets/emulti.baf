// **********************************************************************
// *           Segment Name: gs_DefencesSpecific_TL3_Items.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 3 (ITEMS)

// * ANTI-MAGE

// * RING_OF_SPELL_TURNING [RING34] (casts Minor Spell Turning, 1x/day)
// * Requires Mod Stat.IDS file (WIZARD_SPELL_DEFLECTION, CLERIC_SHIELD_OF_THE_ARCHONS, WIZARD_SPELL_TRAP)
IF
  HasItemEquiped("RING34",Myself)                                          // and we have the item
  CheckStatLT(Myself,1,WIZARD_SPELL_TURNING)                               // and I'm not already under the effects of spell turning, spell deflection, or spell absorbtion
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // or its threat-level 3+
  GlobalLT("EK_UsedRING34","LOCALS",1)
  CheckStatLT(Myself,1,WIZARD_SPELL_TRAP)                                  // and I'm not already under the effects of spell turning, spell deflection, or spell absorbtion
  CheckStatLT(Myself,1,CLERIC_SHIELD_OF_THE_ARCHONS)
  CheckStatLT(Myself,1,WIZARD_SPELL_DEFLECTION)
  CheckStatLT(Myself,1,MINORGLOBE)
  !HasBounceEffects(Myself)                                                // and not spell-turning
  CheckStatLT(Myself,1,WIZARD_SPELL_DEFLECTION)                            // and I am not already under the effects of a similar spell
  OR(5)                                                                    // and we see a spellcaster
     See(TenthNearest([EVILCUTOFF.0.0.BARD_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.DRUID_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.CLERIC_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.MAGE_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.SORCERER.0.0.0]))
  !Race(LastSeenBy(Myself),WYVERN)                                         // and NOT a Wyvern
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("RING34",Myself)
    SetGlobal("EK_UsedRING34","LOCALS",1)
    DisplayStringHead(Myself,1791)                                         // "Ring of Spell Turning"
END

// * ANTI-SPECIFIC

// * POTION_OF_FIRE_RESISTANCE [POTN02] (50% Fire Resistance, stacks with any Fire Resistance that is aleady in place, 10T)
// * If a resistance is in excess of 100, then that type of attack will actually heal the target
IF
  HasItemEquiped("POTN02",Myself)                                          // and I have a Potion of Fire Resistance
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // if its a level 3+ combat
  OR(4)
     See(NearestEnemyOfType([EVILCUTOFF.0.0.ELEMENTAL_FIRE.0.0.0]))        // and I see a big fire beatie
     See(NearestEnemyOfType([EVILCUTOFF.0.0.GENIE_EFREETI.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.GENIE_NOBLE_EFREETI.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.RED_DRAGON.0.0.0]))
  CheckStatLT(Myself,101,RESISTFIRE)                                       // and I'm not already resisting Fire
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     //set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("POTN02",Myself)                                               // drink the Potion of FireResist
//    DisplayStringHead(Myself,6977)                                         // say "Potion of Fire Resistance"
END

// * POTION_OF_COLD_RESISTANCE [POTN22]

// * POTION_OF_INVISIBILITY [POTN10]
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)
IF
  HasItemEquiped("POTN10",Myself)                                          // and I have a Potion of Invisibility
  !StateCheck(Myself,STATE_NOT_VISIBLE)                                    // and not invisible/improved invisible
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // if its a level 3+ combat
  NumCreatureGT([EVILCUTOFF],2)                                            // and more than 3 foes
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     //set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("POTN10",Myself)                                               // drink the Potion of Invisibility
//    DisplayStringHead(Myself,6993)                                         // say "Potion of Invisibility"
END

