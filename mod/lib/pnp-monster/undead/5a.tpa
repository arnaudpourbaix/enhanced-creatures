	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=1 power=1 timing=9 probability1=100 STR_VAR resource="EFF_M08" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=222 target=1 power=1 parameter1=100 timing=4 duration=6 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=141 target=1 power=1 parameter2=6 timing=4 duration=6 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=1 power=1 timing=4 duration=6 probability1=100 STR_VAR resource="EFF_M08" END
