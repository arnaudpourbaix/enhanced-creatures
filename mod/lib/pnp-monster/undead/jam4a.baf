// Wall of Ice
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("WallOfIce","LOCALS")
	HaveSpellRES("jas1m4a")
	RandomNumGT(808,242)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(FarthestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!Gender(LastSeenBy(Myself),SUMMONED)
	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
	CheckStatLT(LastSeenBy(Myself),50,RESISTCOLD)
	!ImmuneToSpellLevel(LastSeenBy(Myself),4)
	!Range(LastSeenBy(Myself),15)
	OR(4)
		!TriggerOverride(LastSeenBy(Myself),Range(NearestEnemyOf(Myself),15))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(NearestEnemyOf(Myself),99,RESISTCOLD))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(NearestEnemyOf(Myself),74,RESISTMAGIC))
		TriggerOverride(LastSeenBy(Myself),ImmuneToSpellLevel(NearestEnemyOf(Myself),4))
	OR(4)
		!TriggerOverride(LastSeenBy(Myself),Range(SecondNearestEnemyOf(Myself),15))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(SecondNearestEnemyOf(Myself),99,RESISTCOLD))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(SecondNearestEnemyOf(Myself),74,RESISTMAGIC))
		TriggerOverride(LastSeenBy(Myself),ImmuneToSpellLevel(SecondNearestEnemyOf(Myself),4))
	OR(4)
		!TriggerOverride(LastSeenBy(Myself),Range(ThirdNearestEnemyOf(Myself),15))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(ThirdNearestEnemyOf(Myself),99,RESISTCOLD))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(ThirdNearestEnemyOf(Myself),74,RESISTMAGIC))
		TriggerOverride(LastSeenBy(Myself),ImmuneToSpellLevel(ThirdNearestEnemyOf(Myself),4))
	!TriggerOverride(LastSeenBy(Myself),Range(FourthNearestEnemyOf(Myself),15))
	TriggerOverride(LastSeenBy(Myself),Range(NearestAllyOf(Myself),15))
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		SetGlobalTimer("WallOfIce","LOCALS",18)
		SpellNoDecRES("jas1m4a",LastSeenBy(Myself))
		RunAwayFromNoInterruptNoLeaveArea(LastSeenBy(Myself),10)
END

