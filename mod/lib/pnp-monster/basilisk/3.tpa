// Generated file (don't edit)

// Greater Basilisk
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/jam3.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/jam3su.baf~

// Type K poison
CREATE SPL "jas0m3"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m3.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10650)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 fl#Poison
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10651)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=5 parameter2=3 duration=25 probability1=100 savingthrow=4 savebonus="4" special=6 END
OUTER_SET $f_AddSecType(jas0m3.spl) = PoisonSecType

// Foul Breath
COPY_EXISTING "dvstink.pro" ~override/jas1m3.pro~
	READ_SHORT 0x08 type
	PATCH_IF (%type% = 1) BEGIN
		INSERT_BYTES 0x100 0x100
	END
	WRITE_SHORT 0x28 5
	WRITE_LONG 0x200 64
	WRITE_SHORT 0x204 64
	WRITE_SHORT 0x206 64
	WRITE_SHORT 0x210 12
	WRITE_BYTE 0x216 6
ADD_PROJECTILE ~override/jas1m3.pro~ ~Basilisk foul breath~

CREATE SPL "jas1m3"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas1m3.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10130)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 10
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10131)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=4 target=4 range=5 projectile=(IDS_OF_SYMBOL (~projectl~ ~jas1m3~)) + 1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=55 target=2 power=1 parameter1=IDS_OF_SYMBOL (~EA~ ~ANYONE~) parameter2=2 timing=1 probability1=100 savingthrow=4 savebonus="2" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=1 probability1=100 savingthrow=4 savebonus="2" STR_VAR resource="EFF_P88" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 timing=1 probability1=100 savingthrow=4 savebonus="2" STR_VAR resource="SPFINGER" END
	
