DEFINE_ACTION_FUNCTION jam0x_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~D9LJUG01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GOLJUG01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~TOMEGOL4~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~IRONGOL~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~IMMUNE2~
			REMOVE_CRE_ITEM ~GOLTOME4~
			ADD_CRE_ITEM ~jaim0x00~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim0x02~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaic0002~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~jasm0x01~ #0 ~innate~ (1) // Charge
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=11000
					hp=300
					ac=2
					thac0=3
					apr=2
					saveDeath=3
					saveWand=5
					savePolymorph=4
					saveBreath=4
					saveSpell=6
					level1=18
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=22
					intelligence=3
					wisdom=11
					dexterity=9
					constitution=20
					charisma=1
					morale=16
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_STONE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					animation=IDS_OF_SYMBOL (~animate~ ~GOLEM_IRON~)
					movement=2
					enforce=1
			END
			// Assigning jabm0x00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 GOLIRO01 TOMEGOL4 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN TOMEGOL4 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm0x00 END
			// Assigning jabm0x01
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 GOLIRO01 TOMEGOL4 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN TOMEGOL4 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm0x01 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~TOMEGOL4~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"TOMEGOL4"
BEGIN
	LAF jam0x_patch STR_VAR file END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"D9LJUG01"
		"GOLJUG01"
	BEGIN
		LAF jam0x_patch STR_VAR file END
	END
END