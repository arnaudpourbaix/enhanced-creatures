  CheckStatLT(LastSeenBy(Myself),1,RESISTCRUSHING)                         // and they aren't completely resistant to this type of damage
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,3153)                                                     // turn into an Iron Golem
END

// * SHAPECHANGE_GIANT_TROLL {1} [SpIn154 - 3154]
// * May require Mod Spell.IDS (SHAPECHANGE_GIANT_TROLL)
// * if enemy is close && threatlevel is 3+, turn into a Giant Troll
IF
  HaveSpell(3154)                                                          // and we can turn into a Giant Troll
