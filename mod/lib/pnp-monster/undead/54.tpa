// Generated file (don't edit)

// Wight
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/undead/jam54.baf~

// Wight's Touch
CREATE SPL "jas0m54"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m54.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10386)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10387)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=5 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=216 target=2 power=1 parameter1=1 timing=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=25802 timing=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=141 target=2 power=1 parameter2=1 timing=1 probability1=100 END
	
// Claws
CREATE ITM "jai0m54"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10370)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10370)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IGHOUL~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11057)
	WRITE_LONG 0x60 1
COPY_EXISTING ~jai0m54.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IGHOUL~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 2
		WRITE_BYTE 0x84 5
		WRITE_BYTE 0x88 4
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 3
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=146 target=2 parameter2=1 probability1=100 STR_VAR resource="jas0m54" END
	END

// Wight traits
CREATE ITM "jai1m54"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@11056)
	WRITE_LONG 0xc RESOLVE_STR_REF(@11056)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11058)
COPY_EXISTING ~jai1m54.itm~ ~override~
	LPF cold_immunity END
	LPF nonSilverNonMagicalWeapons_immunity END

DEFINE_ACTION_FUNCTION jam54_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHT1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHTJ~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDYMORI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NEVM1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHDD~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHT2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHT3~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~wight~
			REMOVE_CRE_ITEM ~bdwight~
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~immune1~
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHT3~) BEGIN 
				REPLACE_CRE_ITEM ~jai0m54~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			END
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHT3~) BEGIN 
				ADD_CRE_ITEM ~jai1m54~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			END
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=1400
					hp=51
					ac=5
					thac0=15
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=15
					intelligence=9
					wisdom=13
					dexterity=14
					constitution=9
					charisma=15
					morale=14
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~ZOMBIE~)
					class=IDS_OF_SYMBOL (~class~ ~WIGHT~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					movement=10
					enforce=1
			END
			// Assigning jam54
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam54 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDWIGHT3~) BEGIN 
				WRITE_SHORT 0x24 87 // hp
				WRITE_SHORT 0x26 87 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 7 // level1
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BDWIGHT"
		"BDWIGHT1"
		"BDWIGHTJ"
		"BDYMORI"
		"BDWIGHDD"
		"BDWIGHT2"
		"BDWIGHT3"
	BEGIN
		LAF jam54_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"NEVM1"
	BEGIN
		LAF jam54_patch STR_VAR file END
	END
END