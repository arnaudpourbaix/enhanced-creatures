			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam22su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JAGUARSU~) BEGIN 
				WRITE_SHORT 0x24 41 // hp
				WRITE_SHORT 0x26 41 // hp
				WRITE_BYTE 0x52 15 // thac0
				WRITE_BYTE 0x54 11 // saveDeath
				WRITE_BYTE 0x55 13 // saveWand
				WRITE_BYTE 0x56 12 // savePolymorph
				WRITE_BYTE 0x57 13 // saveBreath
