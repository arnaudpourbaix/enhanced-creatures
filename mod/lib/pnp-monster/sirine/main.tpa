LAM load_secondary_types
ACTION_IF FILE_EXISTS_IN_GAME ~AC#DTSI2.BCS~ BEGIN
	COMPILE ~%MOD_FOLDER%/lib/pnp-monster/sirine/assets/AC#DTSI2.BAF~
END
ACTION_IF FILE_EXISTS_IN_GAME ~AC#DTSIR.BCS~ BEGIN
	COMPILE ~%MOD_FOLDER%/lib/pnp-monster/sirine/assets/AC#DTSIR.BAF~
END
// Charm Song
CREATE EFF "jase1600"
	WRITE_LONG 0x10 206
	WRITE_LONG 0x14 2
	WRITE_LONG 0x24 1
	WRITE_SHORT 0x2c 100
	WRITE_ASCII 0x30 ~jase1600~ #8

CREATE SPL "jase1600"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jase1600.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10203)
	WRITE_ASCII 0x10 ~SIRIN05~ #8
	WRITE_LONG 0x18 512
	WRITE_SHORT 0x1c 4
	WRITE_SHORT 0x22 11
	WRITE_BYTE 0x25 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI316C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11002)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=30 speed=1 STR_VAR icon="SPWI316B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=177 target=2 power=1 parameter1=IDS_OF_SYMBOL (~RACE~ ~ELF~) parameter2=4 duration=1 probability1=90 STR_VAR resource="jase1600" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=177 target=2 power=1 parameter1=IDS_OF_SYMBOL (~RACE~ ~HALF_ELF~) parameter2=4 duration=1 probability1=30 STR_VAR resource="jase1600" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=5 target=2 power=1 parameter1=IDS_OF_SYMBOL (~GENERAL~ ~HUMANOID~) parameter2=2 resist_dispel=1 duration=180 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=ja_strref_dire_charmed timing=1 resist_dispel=1 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=1 parameter1="-1819214080" parameter2=1966080 resist_dispel=1 duration=1 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 resist_dispel=1 duration=3 probability1=100 savingthrow=1 STR_VAR resource="SPNWCHRM" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=3 resist_dispel=1 duration=180 probability1=100 savingthrow=1 STR_VAR resource="EFF_E07" END
	
// Charm Song
CREATE EFF "jase1601"
	WRITE_LONG 0x10 146
	WRITE_LONG 0x14 2
	WRITE_LONG 0x1c 0
	WRITE_LONG 0x24 1
	WRITE_LONG 0x20 1
	WRITE_SHORT 0x2c 100
	WRITE_ASCII 0x30 ~jase1600~ #8

CREATE SPL "jase1601"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jase1601.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10203)
	WRITE_ASCII 0x10 ~SIRIN05~ #8
	WRITE_LONG 0x18 16896
	WRITE_SHORT 0x1c 4
	WRITE_SHORT 0x22 11
	WRITE_BYTE 0x25 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI316C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10204)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=30 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~japc0000~)) + 1 STR_VAR icon="SPWI316B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=177 target=2 power=1 parameter1=IDS_OF_SYMBOL (~GENERAL~ ~HUMANOID~) parameter2=3 probability1=100 STR_VAR resource="jase1601" END
	LPF CHANGE_SPELL INT_VAR   rinvs=1  END
	
// Fog Cloud
CREATE SPL "jase1602"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jase1602.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10205)
	WRITE_ASCII 0x10 ~CAS_M08~ #8
	WRITE_SHORT 0x1c 4
	WRITE_SHORT 0x22 10
	WRITE_BYTE 0x25 8
	WRITE_BYTE 0x27 9
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI204C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10206)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=4 target=4 range=30 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~CLOUD~)) + 1 STR_VAR icon="SPWI204B" END
	INNER_ACTION BEGIN
		LAF get_colorSpray_resources RET_ARRAY colorSpray_resources=resources END
	END
	PATCH_PHP_EACH colorSpray_resources AS _ => resource BEGIN
		LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=1 resist_dispel=1 duration=7 probability1=100 STR_VAR resource=EVALUATE_BUFFER "%resource%" END
	END
	LPF ADD_EFFECT INT_VAR header=1 opcode=74 target=2 power=1 resist_dispel=1 duration=7 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=8 resist_dispel=1 duration=7 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=ja_strref_blinded timing=1 resist_dispel=1 probability1=100 END
	LPF CHANGE_SPELL INT_VAR   rinvs=1  END
	
// Touch of Tranquility
CREATE SPL "jase1603"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jase1603.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10207)
	WRITE_ASCII 0x10 ~EFF_P11~ #8
	WRITE_LONG 0x18 17408
	WRITE_SHORT 0x1c 4
	WRITE_SHORT 0x22 10
	WRITE_BYTE 0x25 8
	WRITE_BYTE 0x27 9
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI509C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10208)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 STR_VAR icon="SPWI509B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=324 target=2 power=1 parameter1=IDS_OF_SYMBOL (~splstate~ ~CHAOTIC_COMMANDS~) parameter2=76 duration=1 probability1=100 STR_VAR resource="jase1603" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=76 target=2 power=1 duration=300 probability1=100 savingthrow=4 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=48 duration=300 probability1=100 savingthrow=4 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 duration=2 probability1=100 savingthrow=4 STR_VAR resource="SPMINDAT" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=1 parameter1=4812032 parameter2=1310720 duration=1 probability1=100 savingthrow=4 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=ja_strref_feebleminded timing=1 duration=300 probability1=100 savingthrow=4 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=1 duration=300 probability1=100 savingthrow=4 STR_VAR resource="jase1603" END
	
INCLUDE "%MOD_FOLDER%/lib/pnp-monster/sirine/17.tpa" // Sirine
