	!GlobalTimerNotExpired("BeguilingAura","LOCALS")
	HaveSpellRES("jas1m72")
	!StateCheck(ThirdNearestEnemyOf(Myself),STATE_INVISIBLE)
	See(ThirdNearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
THEN
	RESPONSE #100
		SetGlobalTimer("BeguilingAura","LOCALS",6)
		ReallyForceSpellRES("jas1m72",Myself)
END

// Summon Giant Poisonous Snake
IF
	HaveSpellRES("jas4m72")
	See(NearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
THEN
	RESPONSE #100
		ForceSpellRES("jas4m72",Myself)
		RemoveSpellRES("jas4m72")
END

