// * SHIELD_AMULET [AMUL15, Base AC:4, 5 Turns]
IF
  HasItemEquiped("AMUL15",Myself)
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 1+
  !GlobalTimerNotExpired("ek_UsedAMUL15","LOCALS")
  See(NearestEnemyOf(Myself))
  OR(2)
     NumCreatureGT([EVILCUTOFF], 2)                                        // and there are 3+ monsters
     AttackedBy([ANYONE],DEFAULT)
  CheckStatGT(Myself,4,ARMORCLASS)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobalTimer("ek_UsedAMUL15","LOCALS",300)                           // set a 5 turn timer
    UseItem("AMUL15",Myself)
    DisplayStringHead(Myself,6917)                                         // "Shield Amulet"
END

// **********************************************************************
// *           Segment Name: gs_TargetFurthestFirst.baf
// **********************************************************************

// * TARGETING ROUTINE - FURTHEST TO NEAREST
// * [Mage/Spell/Ranged Style]
// * -------------------------

// * Requires Mod State.IDS file (STATE_NOT_VISIBLE, STATE_HARMLESS)

// * Start by "clearing" the LastSeenBy()
IF
  See(Myself)
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there is at least 1 target, determine if we can target the nearest
IF
  !InParty(NearestEnemyOf(Myself))                                         // and they're not in our party
  HPGT(NearestEnemyOf(Myself),5)                                           // and have more than 5 hp
  !StateCheck(NearestEnemyOf(Myself),STATE_NOT_VISIBLE)                    // and not invisible/impinvis
  !StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)                       // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(NearestEnemyOf(Myself),INNOCENT)                                  // and not an "innocent"
  See(NearestEnemyOf(Myself))                                              // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 2+ Targets, determine if we can target the 2nd
IF
  NumCreatureGT([EVILCUTOFF],1)                                            // if there is at least 2 monsters
  !InParty(SecondNearestEnemyOf(Myself))                                   // and they're not in our party
  HPGT(SecondNearestEnemyOf(Myself),5)                                     // and have more than 5 hp
  !StateCheck(SecondNearestEnemyOf(Myself),STATE_NOT_VISIBLE)              // and not invisible/impinvis
  !StateCheck(SecondNearestEnemyOf(Myself),STATE_HARMLESS)                 // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(SecondNearestEnemyOf(Myself),INNOCENT)                            // and not an "innocent"
  See(SecondNearestEnemyOf(Myself))                                        // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 3+ Targets, determine if we can target the 3rd
IF
  NumCreatureGT([EVILCUTOFF],2)                                            // if there is at least 3 monsters
  !InParty(ThirdNearestEnemyOf(Myself))                                    // and they're not in our party
  HPGT(ThirdNearestEnemyOf(Myself),5)                                      // and have more than 5 hp
  !StateCheck(ThirdNearestEnemyOf(Myself),STATE_NOT_VISIBLE)               // and not invisible/impinvis
  !StateCheck(ThirdNearestEnemyOf(Myself),STATE_HARMLESS)                  // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(ThirdNearestEnemyOf(Myself),INNOCENT)                             // and not an "innocent"
  See(ThirdNearestEnemyOf(Myself))                                         // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 4+ Targets, determine if we can target the 4th
IF
  NumCreatureGT([EVILCUTOFF],3)                                            // if there is at least 4 monsters
  !InParty(FourthNearestEnemyOf(Myself))                                   // and they're not in our party
  HPGT(FourthNearestEnemyOf(Myself),5)                                     // and have more than 5 hp
  !StateCheck(FourthNearestEnemyOf(Myself),STATE_NOT_VISIBLE)              // and not invisible/impinvis
  !StateCheck(FourthNearestEnemyOf(Myself),STATE_HARMLESS)                 // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(FourthNearestEnemyOf(Myself),INNOCENT)                            // and not an "innocent"
  See(FourthNearestEnemyOf(Myself))                                        // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 5+ Targets, determine if we can target the 5th
IF
  NumCreatureGT([EVILCUTOFF],4)                                            // if there is at least 5 monsters
  !InParty(FifthNearestEnemyOf(Myself))                                    // and they're not in our party
  HPGT(FifthNearestEnemyOf(Myself),5)                                      // and have more than 5 hp
  !StateCheck(FifthNearestEnemyOf(Myself),STATE_NOT_VISIBLE)               // and not invisible/impinvis
  !StateCheck(FifthNearestEnemyOf(Myself),STATE_HARMLESS)                  // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(FifthNearestEnemyOf(Myself),INNOCENT)                             // and not an "innocent"
  See(FifthNearestEnemyOf(Myself))                                         // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 6+ Targets, determine if we can target the 6th
IF
  NumCreatureGT([EVILCUTOFF],5)                                            // if there is at least 6 monsters
