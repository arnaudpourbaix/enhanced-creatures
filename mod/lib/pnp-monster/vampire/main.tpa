	LPF ADD_EFFECT INT_VAR header=1 opcode=126 target=2 power=2 parameter1=50 parameter2=2 duration=7 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=2 duration=6 probability1=100 STR_VAR resource="jase0701" END
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=2 target=4 range=30 required_level=10 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~jape0701~)) + 1 STR_VAR icon="SPCL621B" END
