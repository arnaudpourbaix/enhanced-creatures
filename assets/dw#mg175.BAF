        Class(Myself,MAGE_THIEF)
    OR(3)
        !See(Player1)
        StateCheck(Player1,D0_STATE_DISABLED)
        CheckStatGT(Player1,0,HELD)
    OR(3)
        !See(Player2)
        StateCheck(Player2,D0_STATE_DISABLED)
        CheckStatGT(Player2,0,HELD)
    OR(3)
        !See(Player3)
        StateCheck(Player3,D0_STATE_DISABLED)
        CheckStatGT(Player3,0,HELD)
    OR(3)
        !See(Player4)
        StateCheck(Player4,D0_STATE_DISABLED)
        CheckStatGT(Player4,0,HELD)
    OR(3)
        !See(Player5)
        StateCheck(Player5,D0_STATE_DISABLED)
        CheckStatGT(Player5,0,HELD)
    OR(3)
        !See(Player6)
        StateCheck(Player6,D0_STATE_DISABLED)
        CheckStatGT(Player6,0,HELD)
THEN
    RESPONSE #100
        AttackReevaluate(NearestEnemyOf(Myself),15)
END

