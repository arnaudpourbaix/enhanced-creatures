	!CheckSpellState(Myself,JA_ANIMALFORM)
	!CheckSpellState(Myself,JA_GASEOUSFORM)
	StateCheck(LastSeenBy(Myself),STATE_SLOWED)
	!CheckStatGT(LastSeenBy(Myself),0,LEVEL_DRAIN_IMMUNITY)
	!CheckSpellState(LastSeenBy(Myself),ITEM_LEVELDRAIN)
	!General(LastSeenBy(Myself),WEAPON)
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	See(LastSeenBy(Myself))
	WeaponEffectiveVs(LastSeenBy(Myself),MAINHAND)
	WeaponCanDamage(LastSeenBy(Myself),MAINHAND)
	Range(LastSeenBy(Myself),10)
	OR(3)
		!Allegiance(Myself,EVILCUTOFF)
		!Allegiance(LastSeenBy(Myself),EVILCUTOFF)
		StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	OR(3)
		!Allegiance(Myself,GOODCUTOFF)
		!Allegiance(LastSeenBy(Myself),GOODCUTOFF)
		StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	OR(3)
