    OR(2)
        CheckStatGT(Myself,19,LEVEL)
        !GlobalGT("Chapter","GLOBAL",6)
    OR(2)
        CheckStatGT(Myself,24,LEVEL)
        !GlobalGT("Chapter","GLOBAL",7)
    OR(2)
        CheckStatGT(Myself,29,LEVEL)
        !GlobalGT("Chapter","GLOBAL",8)
    See(LastSeenBy(Myself))
THEN
    RESPONSE #100
        ApplySpellRES("dw#mgsee",Myself)  // Armor
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
        Spell(LastSeenBy(Myself),WIZARD_REMOVE_MAGIC)  // SPWI302.SPL (Dispel Magic)
        SetGlobalTimer("firstdispel","LOCALS",1000)
        SetGlobalTimer("DMWW_dispel","LOCALS",THREE_ROUNDS)
    RESPONSE #50
        SetGlobalTimer("firstdispel","LOCALS",1000)
        Continue()
END

