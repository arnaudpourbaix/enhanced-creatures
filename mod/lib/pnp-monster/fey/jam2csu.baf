	ActionListEmpty()
	HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
	HPPercentLT(Myself,75)
	RandomNumGT(808,242)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
