// Ju-ju Zombie
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/undead/jam57.baf~

// Ju-ju Zombie traits
CREATE ITM "jai0m57"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@11081)
	WRITE_LONG 0xc RESOLVE_STR_REF(@11081)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11082)
COPY_EXISTING ~jai0m57.itm~ ~override~
	LPF cold_immunity END
	LPF nonMagicalWeapons_immunity END
	LPF crushingDamageResistance_resistance END
	LPF piercingDamageResistance_resistance END
	LPF missileDamageResistance_resistance END
	LPF fireResistance_resistance END
	LPF lightning_immunity END
	LPF magicMissile_immunity END

// Claws
CREATE ITM "jai1m57"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10373)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10373)
	WRITE_ASCII 0x3a ~IGHOUL~ #8
