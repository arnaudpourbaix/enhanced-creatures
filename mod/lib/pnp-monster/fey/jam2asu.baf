// Summons are destroyed on death
IF
	Die()
THEN
	RESPONSE #100
		DestroySelf()
END

// Initiate dialog
IF
	Global("JA_DIALOG","LOCALS",0)
	Name("VAELASA",Myself)
	NumTimesTalkedTo(0)
	See([PC])
THEN
	RESPONSE #100
		SetGlobal("JA_DIALOG","LOCALS",1)
		FaceObject([PC])
		StartDialogueNoSet([PC])
END

// Can use dimension door and detect traps
IF
	Global("ja_wilderness","LOCALS",0)
	AreaType(OUTDOOR)
	!AreaType(CITY)
	!AreaType(DUNGEON)
THEN
	RESPONSE #100
		SetGlobal("ja_wilderness","LOCALS",1)
END

IF
	Global("ja_wilderness","LOCALS",0)
	OR(2)
		HaveSpellRES("jas0f8")
		HaveSpellRES("jas6f8")
THEN
	RESPONSE #100
		RemoveSpellRES("jas0f8")
		RemoveSpellRES("jas6f8")
		SetGlobal("ja_wilderness","LOCALS",2)
END

// Vaelasa, the Fairy Queen
IF
	Name("VAELASA",Myself)
	AreaCheck("AR1200")
	Global("SummonDryads","AR1200",1)
THEN
	RESPONSE #100
		SetGlobal("SummonDryads","AR1200",2)
		StartCutSceneMode()
		StartCutScene("Cut23a")
END

IF
	Name("VAELASA",Myself)
	AreaCheck("AR0602")
	AttackedBy([GOODCUTOFF],DEFAULT)
	Global("VaelasaHostile","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("VaelasaHostile","GLOBAL",1)
		Enemy()
END

// Cloakwood Hamadryad
IF
	Global("rr#chama","MYAREA",1)
	Global("rr#hamat","LOCALS",0)
	See([PC])
THEN
	RESPONSE #100
		SetGlobal("rr#hamat","LOCALS",1)
		FaceObject([PC])
		DisplayStringHead(Myself,5184)
END

// Precast Stoneskin
IF
	Global("JA_PRECAST_LONG","LOCALS",0)
	HaveSpellRES("SPWI408")
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPWI408",Myself)
		RemoveSpellRES("SPWI408")
		Continue()
END

// Precast Ironskin
IF
	Global("JA_PRECAST_LONG","LOCALS",0)
	HaveSpellRES("SPPR506")
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPPR506",Myself)
		RemoveSpellRES("SPPR506")
		Continue()
END

IF
	Global("JA_PRECAST_LONG","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("JA_PRECAST_LONG","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,EVILCUTOFF)
	See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,GOODCUTOFF)
	See([EVILCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Shouts every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	!GlobalTimerNotExpired("JA_HELP","LOCALS")
THEN
	RESPONSE #100
		Shout(98)
		SetGlobalTimer("JA_HELP","LOCALS",18)
END

// React to shouts
IF
	Global("JA_COMBAT","LOCALS",0)
	Heard(LastSummonerOf(Myself),98)
	InMyArea(LastSummonerOf(Myself))
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Heard(LastSummonerOf(Myself),98)
	InMyArea(LastSummonerOf(Myself))
	!See([GOODCUTOFF])
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

// Summon follow summoner
IF
	Global("JA_COMBAT","LOCALS",0)
	!StateCheck(Myself,STATE_BLIND)
	ActionListEmpty()
	!See(NearestEnemyOf(Myself))
	!See(LastSummonerOf(Myself))
	HPGT(LastSummonerOf(Myself),0)
	Range(LastSummonerOf(Myself),150)
THEN
	RESPONSE #100
		MoveToObject(LastSummonerOf(Myself))
END

// Do nothing if...
IF
	ActionListEmpty()
	OR(4)
		Global("JA_COMBAT","LOCALS",0)
		!Allegiance(Myself,EVILCUTOFF)
		StateCheck(Myself,STATE_IMMOBILE)
		StateCheck(Myself,STATE_REALLY_DEAD)
THEN
	RESPONSE #100
		NoAction()
END

IF
	ActionListEmpty()
	!InActiveArea(Myself)
	!Range(NearestEnemyOf(Myself),30)
THEN
	RESPONSE #100
		NoAction()
END

// Handle Panic state
IF
	StateCheck(Myself,STATE_PANIC)
	Range(NearestEnemyOf(Myself),10)
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),15)
END

IF
	StateCheck(Myself,STATE_PANIC)
THEN
	RESPONSE #100
		RandomWalkContinuous()
END

// Dimension Door
IF
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	ActionListEmpty()
	HaveSpellRES("jas0f8")
	OR(2)
		Range(NearestEnemyOf(Myself),15)
		AttackedBy([ANYONE],DEFAULT)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		CreateCreatureOffscreen("RR#TRAT",0)
		ForceSpellRES("jas0f8","RR#TRAT")
		RemoveSpellRES("jas0f8")
		Wait(1)
		SetInterrupt(TRUE)
END

// Speak With Plants
IF
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	!GlobalTimerNotExpired("speakWithPlants","LOCALS")
	ActionListEmpty()
	HaveSpellRES("jas3f8")
	CheckStatGT(Myself,0,ENTANGLE)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jas3f8",LastSeenBy(Myself))
		SetGlobalTimer("speakWithPlants","LOCALS",60)
		SetInterrupt(TRUE)
END

// Entangle
IF
	!StateCheck(Myself,STATE_SILENCED)
	ActionListEmpty()
	HaveSpellRES("jas4f8")
	RandomNumGT(800,240)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(NearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!CheckStatGT(LastSeenBy(Myself),0,ENTANGLE)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckStatGT(LastSeenBy(Myself),0,HELD)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_FEEBLEMINDED)
	!StateCheck(LastSeenBy(Myself),STATE_SLEEPING)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!CheckStatGT(LastSeenBy(Myself),0,HELD)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_FEEBLEMINDED)
	!StateCheck(LastSeenBy(Myself),STATE_SLEEPING)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jas4f8",LastSeenBy(Myself))
		RemoveSpellRES("jas4f8")
		SetInterrupt(TRUE)
END

