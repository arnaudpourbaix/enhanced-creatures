// Domination Gaze
CREATE EFF "jase0700"
	WRITE_LONG 0x10 206
	WRITE_LONG 0x14 2
	WRITE_LONG 0x24 1
	WRITE_SHORT 0x2c 100
	WRITE_ASCII 0x30 ~jase0700~ #8

CREATE SPL "jase0700"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jase0700.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10408)
	WRITE_LONG 0x18 33570816
	WRITE_SHORT 0x1c 1
	WRITE_BYTE 0x25 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 5
	WRITE_ASCII 0x3a ~SPWI506C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10411)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=2 target=1 range=30 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~GAZE~)) + 1 STR_VAR icon="SPWI506B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=177 target=2 power=5 parameter1=IDS_OF_SYMBOL (~RACE~ ~ELF~) parameter2=4 duration=1 probability1=90 STR_VAR resource="jase0700" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=177 target=2 power=5 parameter1=IDS_OF_SYMBOL (~RACE~ ~HALF_ELF~) parameter2=4 duration=1 probability1=30 STR_VAR resource="jase0700" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=5 target=2 power=5 parameter1=IDS_OF_SYMBOL (~GENERAL~ ~HUMANOID~) parameter2=1003 resist_dispel=1 duration=48 probability1=100 savingthrow=1 savebonus="-2" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=5 parameter1=ja_strref_charmed timing=1 resist_dispel=1 probability1=100 savingthrow=1 savebonus="-2" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=5 parameter1="-1819214080" parameter2=1966080 resist_dispel=1 duration=1 probability1=100 savingthrow=1 savebonus="-2" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=5 parameter2=1 resist_dispel=1 duration=3 probability1=100 savingthrow=1 savebonus="-2" STR_VAR resource="SPNWCHRM" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=5 timing=3 resist_dispel=1 duration=48 probability1=100 savingthrow=1 savebonus="-2" STR_VAR resource="EFF_E07" END
	
// Bat Swarm
CREATE SPL "jase0701"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jase0701.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10420)
	WRITE_ASCII 0x10 ~CAS_P03~ #8
	WRITE_LONG 0x18 33570816
	WRITE_SHORT 0x1c 1
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 2
	WRITE_ASCII 0x3a ~SPCL621C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10421)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=2 target=4 range=30 required_level=8 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~jape0700~)) + 1 STR_VAR icon="SPCL621B" END
	INNER_ACTION BEGIN
		LAF get_colorSpray_resources RET_ARRAY colorSpray_resources=resources END
	END
	PATCH_PHP_EACH colorSpray_resources AS _ => resource BEGIN
		LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=2 duration=7 probability1=100 STR_VAR resource=EVALUATE_BUFFER "%resource%" END
	END
	LPF ADD_EFFECT INT_VAR header=1 opcode=74 target=2 power=2 duration=7 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=2 parameter2=8 duration=7 probability1=100 END
