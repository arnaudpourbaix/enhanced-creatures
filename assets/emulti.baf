// * DEFENCE SPELLS - THREAT LEVEL 1 (MAGE)

// * PART ONE - ANTI-MAGE

// * PART TWO - ANTI-SPECIFICS

// * 1: Anti-SpecificThreat

// * WIZARD_PROTECTION_FROM_EVIL {1} [SpWi113 - 2113] (Evil doers suffer -2 to hit and any STs caused by such attacks are made by the protected creature with a +2 bonus)
// * Detectable Spell
// * Requires Mod Stat.IDS File (PROTECTION_FROM_EVIL}
IF
  HaveSpell(WIZARD_PROTECTION_FROM_EVIL)
  !CheckStat(Myself,1,PROTECTION_FROM_EVIL)                                // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // or its threat-level 1+
  OR(4)                                                                    // and we see a specific creature type
     See(NearestEnemyOfType([EVILCUTOFF.0.DEMONIC.0.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.RAKSHASA.0.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.GITHYANKI.0.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.GENIE.0.0.0.0]))
  !GlobalTimerNotExpired("gh_ProtectionFromEvil","GLOBAL")                 // and we or anyone else hasn't already cast the whole-party-version
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_PROTECTION_FROM_EVIL)
END

