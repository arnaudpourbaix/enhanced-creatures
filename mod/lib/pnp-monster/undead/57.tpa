DEFINE_ACTION_FUNCTION jam57_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BHGHOUL5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NEVM5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MBJU01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RZOMB01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ZOMBJU01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring94~
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~b1-8~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~b3-12~
			REMOVE_CRE_ITEM ~ghast1~
			ADD_CRE_ITEM ~jai0m57~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m57~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=975
					hp=48
					ac=8
					thac0=15
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=7
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=20
					intelligence=6
					wisdom=6
					dexterity=16
					constitution=9
					charisma=5
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~ZOMBIE~)
					class=IDS_OF_SYMBOL (~class~ ~ZOMBIE_NORMAL~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~)
					movement=7
					enforce=1
			END
			// Assigning jam57
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam57 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ZOMBJU01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~NEVM5~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~BHGHOUL5~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MBJU01~) BEGIN 
					WRITE_LONG 0x8 RESOLVE_STR_REF(@10368)
					WRITE_LONG 0xc RESOLVE_STR_REF(@10368)
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ZOMBJU01"
BEGIN
	LAF jam57_patch STR_VAR file END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BHGHOUL5"
		"NEVM5"
		"D9MBJU01"
		"RZOMB01"
	BEGIN
		LAF jam57_patch STR_VAR file END
	END
END