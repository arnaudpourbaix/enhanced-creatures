			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=65
					hp=24
					ac=8
					thac0=19
					apr=1
					saveDeath=14
					saveWand=16
					savePolymorph=15
					saveBreath=17
					saveSpell=17
					level1=2
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=13
					intelligence=1
					wisdom=6
					dexterity=6
					constitution=9
					charisma=5
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~ZOMBIE~)
					class=IDS_OF_SYMBOL (~class~ ~ZOMBIE_NORMAL~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=5
					enforce=1
			END
			// Assigning jabm2e00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN AC#FP2ZO END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm2e00 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm2e00 END
			// Assigning jabm2e01
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN AC#FP2ZO END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm2e00 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm2e01 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#DEERZO~) BEGIN 
				WRITE_BYTE 0x53 2 // apr
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~AC#FP2ZO~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

