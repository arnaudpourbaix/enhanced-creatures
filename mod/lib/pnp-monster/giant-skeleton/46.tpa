// Generated file (don't edit)

// Giant Skeleton
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/giant-skeleton/jabm4600.baf~

// Giant Skeleton traits
CREATE ITM "jaim4600"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@11374)
	WRITE_LONG 0xc RESOLVE_STR_REF(@11374)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11375)
COPY_EXISTING ~jaim4600.itm~ ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=89 target=1 global=1 parameter1=90 parameter2=1 timing=2 probability1=100 END
	LPF skeletal_trait END
	LPF fire_immunity END

// Claws
CREATE ITM "jaim4601"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10001)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10001)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IWOLF~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11376)
	WRITE_LONG 0x60 1
COPY_EXISTING ~jaim4601.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IWOLF~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 3
		WRITE_BYTE 0x84 5
		WRITE_BYTE 0x88 12
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 2
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

DEFINE_ACTION_FUNCTION jam46_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSKGR03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDTEAM61~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~ring99~
			REMOVE_CRE_ITEM ~undtype~
			REMOVE_CRE_ITEM ~IMMCHS~
			REMOVE_CRE_ITEM ~HELMNOAN~
			REMOVE_CRE_ITEM ~s1-12m2~
			REMOVE_CRE_ITEM ~ring95~
			ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_CRE_ITEM ~jaim4600~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim4601~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_MEMORIZED_SPELL ~SPWI304~ #2 ~wizard~ (1) 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=650
					hp=52
					ac=4
					thac0=15
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=5
					level2=8
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=10
					intelligence=1
					wisdom=8
					dexterity=14
					constitution=9
					charisma=5
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SKELETON~)
					class=IDS_OF_SYMBOL (~class~ ~CLERIC_MAGE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					metalColor=20
					minorColor=67
					majorColor=66
					skinColor=105
					leatherColor=14
					armorColor=20
					hairColor=0
					movement=10
					enforce=1
			END
			// Assigning jabm4600
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN L#HAUSK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4600 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDSKGR03~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDTEAM61~) BEGIN 
				WRITE_SHORT 0x24 112 // hp
				WRITE_SHORT 0x26 112 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 10 // level1
					WRITE_LONG 0x8 RESOLVE_STR_REF(@10390)
					WRITE_LONG 0xc RESOLVE_STR_REF(@10390)
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDSKGR03~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDTEAM61~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BDSKGR03"
		"BDTEAM61"
	BEGIN
		LAF jam46_patch STR_VAR file END
	END
END