// Control Undead
IF
	HaveSpellRES("jase0702")
	!CheckSpellState(Myself,JA_ANIMALFORM)
	!CheckSpellState(Myself,JA_GASEOUSFORM)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(NearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	General(LastSeenBy(Myself),UNDEAD)
	LevelLT(LastSeenBy(Myself),13)
	OR(2)
		LevelLT(LastSeenBy(Myself),5)
		LevelGT(Myself,9)
	OR(2)
		LevelLT(LastSeenBy(Myself),6)
		LevelGT(Myself,11)
	OR(2)
		LevelLT(LastSeenBy(Myself),7)
		LevelGT(Myself,13)
	OR(2)
		LevelLT(LastSeenBy(Myself),8)
		LevelGT(Myself,15)
	OR(2)
		LevelLT(LastSeenBy(Myself),9)
		LevelGT(Myself,17)
	OR(2)
		LevelLT(LastSeenBy(Myself),10)
		LevelGT(Myself,19)
	OR(2)
		LevelLT(LastSeenBy(Myself),11)
		LevelGT(Myself,21)
	OR(2)
		LevelLT(LastSeenBy(Myself),12)
		LevelGT(Myself,23)
	!ImmuneToSpellLevel(LastSeenBy(Myself),7)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TURNING)
