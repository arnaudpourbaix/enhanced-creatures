// Generated file (don't edit)

// Giant Spider
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/spider/jam38.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/spider/jam38su.baf~

// Type F poison
CREATE SPL "jas0m38"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m38.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10808)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 fl#Poison
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10809)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=2 parameter2=2 duration=17 probability1=100 dicesize=1 dicenumber=2 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=5 parameter2=2 duration=14 probability1=100 dicesize=3 dicenumber=4 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=8 parameter2=2 duration=13 probability1=100 dicesize=5 dicenumber=6 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=11 parameter2=2 duration=13 probability1=100 dicesize=7 dicenumber=8 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=13 parameter2=2 duration=12 probability1=100 dicesize=9 dicenumber=10 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=14 parameter2=2 duration=13 probability1=100 dicesize=11 dicenumber=15 savingthrow=4 special=6 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=20 parameter2=2 duration=13 probability1=100 dicesize=16 dicenumber=40 savingthrow=4 special=6 END
OUTER_SET $f_AddSecType(jas0m38.spl) = PoisonSecType

// Jaws
CREATE ITM "jai0m38"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10289)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10289)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~SPPR416B~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10810)
	WRITE_LONG 0x60 1
COPY_EXISTING ~jai0m38.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~SPPR416B~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 2
		WRITE_BYTE 0x84 2
		WRITE_BYTE 0x88 8
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=146 target=2 parameter2=1 probability1=100 STR_VAR resource="jas0m38" END
	END

DEFINE_ACTION_FUNCTION jam38_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELP01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSPIDGI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BPSPID02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PLYSPID2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RSSPIDGI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDGI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDGISU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDFGSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWISTAK~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BDSPIDGI~
			REMOVE_CRE_ITEM ~SPIDG1~
			REMOVE_CRE_ITEM ~ANTIWEB~
			REMOVE_CRE_ITEM ~PLYSPID~
			REPLACE_CRE_ITEM ~jai0m38~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai16~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=650
					hp=36
					ac=6
					thac0=15
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=14
					intelligence=7
					wisdom=11
					dexterity=16
					constitution=12
					charisma=4
					morale=13
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SPIDER~)
					class=IDS_OF_SYMBOL (~class~ ~SPIDER_GIANT~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=2
					enforce=1
			END
			// Assigning jam38
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN DW#SPIDG SPIDFGSU BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BDHELP01 SPIDGISU SPIDFGSU PLYSPID2 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam38 END
			// Assigning jam38su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN DW#SPIDG SPIDFGSU BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN BDHELP01 SPIDGISU SPIDFGSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam38su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLYSPID2~) BEGIN 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELP01~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDGISU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDFGSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BDHELP01"
	"BDSPIDGI"
	"BPSPID02"
	"PLYSPID2"
	"RSSPIDGI"
	"SPIDGI"
	"SPIDGISU"
	"SPIDFGSU"
	"BDWISTAK"
BEGIN
	LAF jam38_patch STR_VAR file = ~%file%~ END
END