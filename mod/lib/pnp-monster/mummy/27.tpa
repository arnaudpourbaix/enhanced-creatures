				ADD_MEMORIZED_SPELL ~SPPR613~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR603~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR612~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR610~ #5 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR703~ #6 ~priest~ (1) 
				ADD_MEMORIZED_SPELL ~SPPR715~ #6 ~priest~ (1) 
			END
			ADD_MEMORIZED_SPELL ~jasm2702~ #0 ~innate~ (1) // Fear Aura
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=16000
					hp=147
					ac=0
					thac0=7
					apr=1
					saveDeath=6
					saveWand=10
					savePolymorph=9
					saveBreath=12
					saveSpell=11
					level1=20
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=15
					intelligence=18
					wisdom=22
					dexterity=16
					constitution=9
					charisma=20
					morale=18
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~GHOUL~)
					class=IDS_OF_SYMBOL (~class~ ~CLERIC~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					animation=IDS_OF_SYMBOL (~animate~ ~MUMMY~)
					movement=7
					enforce=1
			END
			// Assigning jabm2700
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN bdmumm01 d0mummy mummy01 ohhgmum dx#mummc BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm2700 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHHKUNG~) BEGIN 
				WRITE_BYTE 0x238 20 // strength
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"DX#MUMMY"
		"OHHKUNG"
		"D9MGRE01"
		"MUMGRE01"
		"OHHGMUM"
		"OHHMUMMY"
		"RIFTCR03"
	BEGIN
		LAF jam27_patch STR_VAR file END
	END
END