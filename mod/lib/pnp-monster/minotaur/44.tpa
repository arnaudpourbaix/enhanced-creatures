// Minotaur
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/minotaur/jam44.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/minotaur/jam44su.baf~

// Charge
CREATE SPL "jas0m44"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m44.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10326)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI305C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10327)
