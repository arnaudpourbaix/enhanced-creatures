// * CLERIC_INSECT_PLAGUE {5} [SpPr517 - 1517] (Increases Chance of Spell Casting Failure: Single Target, Ranged, 1pt dmg/2s for duration, 100% spell failure (no save) + fear (save vs breath), 6 rnds)
// * Anti-mage version
// * Requires Mod Stat.IDS file (CLERIC_INSECT_PLAGUE)
IF
  HaveSpell(CLERIC_INSECT_PLAGUE)                                          // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 2+
  OR(3)
     Class(LastSeenBy(Myself),BARD_ALL)                                    // or the current target is a bard
     Class(LastSeenBy(Myself),MAGE_ALL)                                    // or the current target is a mage
     Class(LastSeenBy(Myself),SORCERER)                                    // or the current target is a sorcerer
  !CheckStatGT(LastSeenBy(Myself),0,CLERIC_INSECT_PLAGUE)                  // and they're not already affected by a similar spell
  CheckStatLT(LastSeenBy(Myself),100,SPELLFAILUREMAGE)                     // and they're not already affected by a similar spell
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  !StateCheck(LastSeenBy(Myself),STATE_SILENCED)                           // and they're not already silent
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
