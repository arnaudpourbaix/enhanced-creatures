// Blinding Beauty
CREATE SPL "jasf0807"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jasf0807.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10200)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPPR704C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10898)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=5 STR_VAR icon="SPPR704B" END
	INNER_ACTION BEGIN
		LAF get_colorSpray_resources RET_ARRAY colorSpray_resources=resources END
	END
	PATCH_PHP_EACH colorSpray_resources AS _ => resource BEGIN
		LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=1 resist_dispel=3 duration=7200 probability1=100 STR_VAR resource=EVALUATE_BUFFER "%resource%" END
	END
	LPF ADD_EFFECT INT_VAR header=1 opcode=74 target=2 power=1 resist_dispel=3 duration=7200 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=8 resist_dispel=3 duration=7200 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=14674 timing=1 resist_dispel=3 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=1 resist_dispel=3 duration=7200 probability1=100 savingthrow=1 STR_VAR resource="EFF_P71B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 resist_dispel=3 duration=3 probability1=100 savingthrow=1 STR_VAR resource="SPH1HI01" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=1 resist_dispel=3 duration=7200 probability1=100 savingthrow=1 STR_VAR resource="jasf0807" END
	
