// Bat form: fly over the enemies to a victim to drain
IF
	CheckSpellState(Myself,JA_ANIMALFORM)
	CheckSpellState(Myself,JA_FLYING)
	!HPPercentLT(Myself,65)
	See(WorstAC)
	!CheckStatGT(WorstAC,0,LEVEL_DRAIN_IMMUNITY)
	!CheckSpellState(WorstAC,ITEM_LEVELDRAIN)
	!Range(WorstAC,4)
	Allegiance(Myself,EVILCUTOFF)
	!StateCheck(WorstAC,STATE_CHARMED)
THEN
	RESPONSE #100
		MoveToObject(WorstAC)
END

