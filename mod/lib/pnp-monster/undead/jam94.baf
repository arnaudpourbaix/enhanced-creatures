// Archer Skeleton

// Init
IF
	Global("JA_INIT","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",0)
		SetGlobal("JA_PRECAST_LONG","LOCALS",0)
		SetGlobal("JA_PRECAST_MID","LOCALS",0)
		SetGlobalTimer("JA_REST","LOCALS",2400)
		SetGlobal("JA_INIT","LOCALS",1)
END

// Disable spellcasting in some areas
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	OR(2)
		AreaCheck("AR3004")
		AreaCheck("AR3008")
THEN
	RESPONSE #100
		SetGlobal("JA_DISABLE_SPELLCASTING","LOCALS",1)
END

// Rest (reset everything and heal if applicable)
IF
	Global("JA_INIT","LOCALS",1)
	GlobalTimerExpired("JA_REST","LOCALS")
	!See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_INIT","LOCALS",0)
		Rest()
		ApplySpell(Myself,RESTORE_FULL_HEALTH)
END

// Turn hostile if attacked
IF
	Allegiance(Myself,NEUTRAL)
	OR(4)
		AttackedBy([GOODCUTOFF],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		TookDamage()
		Heard([EVILCUTOFF.0.SKELETON],99)
THEN
	RESPONSE #100
		Enemy()
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,EVILCUTOFF)
	See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,GOODCUTOFF)
	See([EVILCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Shouts every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	!GlobalTimerNotExpired("JA_SHOUT","LOCALS")
THEN
	RESPONSE #100
		Shout(99)
		SetGlobalTimer("JA_SHOUT","LOCALS",18)
END

// React to shouts
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.SKELETON],99)
	InMyArea([EVILCUTOFF.0.SKELETON])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.SKELETON],99)
	InMyArea([EVILCUTOFF.0.SKELETON])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

// Help every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("JA_HELP","LOCALS")
THEN
	RESPONSE #100
		Help()
		SetGlobalTimer("JA_HELP","LOCALS",18)
END

// React to help
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		Help()
		MoveToObject(LastHelp(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHelp(Myself))
END

// Do nothing if...
IF
	OR(4)
		Global("JA_COMBAT","LOCALS",0)
		!Allegiance(Myself,EVILCUTOFF)
		StateCheck(Myself,STATE_IMMOBILE)
		StateCheck(Myself,STATE_REALLY_DEAD)
THEN
	RESPONSE #100
		NoAction()
END

IF
	!InActiveArea(Myself)
	!Range(NearestEnemyOf(Myself),30)
THEN
	RESPONSE #100
		NoAction()
END

// Stoneskin
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	HaveSpell(WIZARD_STONE_SKIN)
	!CheckStatGT(Myself,0,STONESKINS)
	RandomNumGT(800,240)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(LastSeenBy(Myself),WIZARD_STONE_SKIN)
END

// Minor Globe Of Invulnerability
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	HaveSpell(WIZARD_MINOR_GLOBE_OF_INVULNERABILITY)
	RandomNumGT(801,240)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(Myself,WIZARD_MINOR_GLOBE_OF_INVULNERABILITY)
END

// Haste
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	HaveSpell(WIZARD_HASTE)
	!StateCheck(Myself,STATE_HASTED)
	RandomNumGT(802,241)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	!CheckStatGT(Myself,0,SANCTUARY)
	!StateCheck(Myself,STATE_REALLY_DEAD)
	!StateCheck(Myself,STATE_IMPROVEDINVISIBILITY)
	!General(Myself,WEAPON)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(Myself,WIZARD_HASTE)
END

IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	HaveSpell(WIZARD_HASTE)
	!StateCheck(NearestAllyOf(Myself),STATE_HASTED)
	RandomNumGT(802,241)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(NearestAllyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!Gender(LastSeenBy(Myself),SUMMONED)
	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(LastSeenBy(Myself),WIZARD_HASTE)
END

