// Revenant traits
CREATE ITM "jaik0c00"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@11041)
	WRITE_LONG 0xc RESOLVE_STR_REF(@11041)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11042)
COPY_EXISTING ~jaik0c00.itm~ ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=98 target=1 global=1 parameter1=2 parameter2=3 timing=2 probability1=100 special=42 END
	LPF acid_immunity END
	LPF cloudSpells_immunity END
	LPF turnUndead_immunity END

