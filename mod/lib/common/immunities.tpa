	LPF sleep_immunity INT_VAR resist_dispel duration END
	LPF hold_immunity INT_VAR resist_dispel duration END
	LPF bleeding_immunity INT_VAR resist_dispel duration END
	LPF stun_immunity INT_VAR resist_dispel duration END
	LPF disease_immunity INT_VAR resist_dispel duration END
	LPF deathEffects_immunity INT_VAR resist_dispel duration END
	LPF necromancyEffects_immunity INT_VAR resist_dispel duration END
	LPF mindSpells_immunity INT_VAR resist_dispel duration END
	LPF backstab_immunity INT_VAR resist_dispel duration END
	LPF criticalHit_immunity INT_VAR resist_dispel duration END
	LPF abilityDrain_immunity INT_VAR resist_dispel duration END
	LPF energyDrain_immunity INT_VAR resist_dispel duration END
	LPF fatigue_immunity INT_VAR resist_dispel duration END
	LPF petrification_immunity INT_VAR resist_dispel duration END
	LPF insectSpells_immunity INT_VAR resist_dispel duration END
	LPF infravision_trait INT_VAR resist_dispel duration END
END

DEFINE_PATCH_FUNCTION vermin_trait
INT_VAR
	resist_dispel=0
	duration=0
BEGIN
	LPF infravision_trait INT_VAR resist_dispel duration END
	LPF mindSpells_immunity INT_VAR resist_dispel duration END
END

DEFINE_PATCH_FUNCTION vorpal_immunity
INT_VAR
	resist_dispel=0
	duration=0
BEGIN
	LPF ADD_IMMUNITY_CRE_ITM_SPL INT_VAR resist_dispel duration  STR_VAR effects="13 55" strings="14026" END
END

DEFINE_PATCH_FUNCTION web_immunity
INT_VAR
	resist_dispel=0
	duration=0
BEGIN
	INNER_ACTION BEGIN
		LAF get_web_resources RET_ARRAY spells=resources END
	END
	LPF ADD_IMMUNITY_CRE_ITM_SPL INT_VAR resist_dispel duration  displaySpellIneffective=1 STR_VAR effects="157" prevent_icons="129" spells END
	LPF ADD_EFFECT_CRE_ITM_SPL INT_VAR resist_dispel duration opcode=83 parameter2=319 END
END
