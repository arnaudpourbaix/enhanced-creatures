// **********************************************************************
// *           Segment Name: gs_DefencesSpecific_TL2_Warrior.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 2 (Warrior)

// * PART ONE - ANTI-MAGE

// * STALKER_MINOR_SPELL_DEFLECTION {3} [SpRa302] (Spell Absorption:  Up to 4 Spell Lvls, Affecs Up to 7th Lvl Spells, 3R/CL)
// * Detectable Spell
// * SpRaxxx only works with HaveSpellRES() Check
// * Requires Mod Stat.IDS file (WIZARD_SPELL_DEFLECTION, CLERIC_SHIELD_OF_THE_ARCHONS, WIZARD_SPELL_TRAP)
IF
  HaveSpellRES("SpRa302")                                                  // and we have the spell
  CheckStatLT(Myself,1,WIZARD_SPELL_DEFLECTION)
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // or its threat-level 2+
  CheckStatLT(Myself,1,WIZARD_SPELL_TRAP)                                  // and I'm not already under the effects of spell turning, spell deflection, or spell absorbtion
  CheckStatLT(Myself,1,CLERIC_SHIELD_OF_THE_ARCHONS)
  CheckStatLT(Myself,1,MINORGLOBE)
//  !HasImmunityEffects(Myself)                                            // and not immune to spells
  !HasBounceEffects(Myself)                                                // and not spell-turning
  OR(5)                                                                    // and we see a spellcaster
     See(NearestEnemyOfType([0.0.0.BARD_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.DRUID_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.SORCERER.0.0.0]))
  !Race(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]),WYVERN)                 // and NOT a Wyvern
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("SpRa302",Myself)
END

// **********************************************************************
// *           Segment Name: gs_DefencesGeneric_TL2_Mage.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 2 (MAGE)

// * ANTI-MELEE/MISSILE

// * GENERIC

// * WIZARD_SPIRIT_ARMOR {4} [SpWi414 - 2414] (sets AC to 1, Saving Throws vs. Spells +2, cummulative with dex & shield bonus)
// * Detectable Spell
IF
  HaveSpell(WIZARD_SPIRIT_ARMOR)
  CheckStatGT(Myself,1,ARMORCLASS)                                         // and our AC is >0
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // or its threat-level 2+
  See(NearestEnemyOf(Myself))                                              // and see an enemy
  NumCreatureGT([EVILCUTOFF],2)                                            // and he's got 2+ friends
  !Range(NearestEnemyOf(Myself),4)                                         // and enemy is > 4 distant [room to cast]
  CheckStatLT(Myself,5,SCRIPTINGSTATE5)                                    // and I am not already under the effects of the spell
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_SPIRIT_ARMOR)
END

