// Black Pudding
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ooze/jam2f.baf~

// Slime Split
CREATE SPL "jas0m2f"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m2f.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10271)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI212C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10272)
	LPF ADD_SPELL_HEADER INT_VAR type=3 location=4 target=5 STR_VAR icon="SPWI212B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 timing=1 probability1=100 STR_VAR resource="BDGOOYAA" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=67 target=2 power=1 parameter2=3 timing=1 probability1=100 STR_VAR resource="jablpud" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=67 target=2 power=1 parameter2=3 timing=1 probability1=100 STR_VAR resource="jablpud" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=168 target=2 power=1 timing=1 probability1=100 END
	
// Black Pudding traits
