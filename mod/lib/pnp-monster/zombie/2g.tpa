	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=20 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~japc0000~)) + 1 STR_VAR icon="SPPR329B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=7 duration=30 probability1=100 savingthrow=4 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=278 target=2 power=1 parameter1="-1" duration=30 probability1=100 savingthrow=4 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=0 target=2 power=1 parameter1="-1" duration=30 probability1=100 savingthrow=4 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=1 duration=30 probability1=100 STR_VAR resource="jasm2g01" END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
