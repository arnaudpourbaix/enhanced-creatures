// Generated file (don't edit)

// Doom Guard
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/construct/jam10.baf~

// Doom Guard traits
CREATE ITM "jai0m10"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10703)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10703)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10704)
COPY_EXISTING ~jai0m10.itm~ ~override~
	LPF fireResistance_resistance END
	LPF coldResistance_resistance END

DEFINE_ACTION_FUNCTION jam10_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~DOOMGU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DOOMDUR~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~HELM13~
			REMOVE_CRE_ITEM ~PLAT07~
			REMOVE_CRE_ITEM ~SW1H11~
			REMOVE_CRE_ITEM ~RING95~
			ADD_CRE_ITEM ~jai0m10~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1f6~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai2f6~ #0 #0 #0 ~UNDROPPABLE~ ~ARMOR~ 
			REPLACE_CRE_ITEM ~jai3f6~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_CRE_ITEM ~jai2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYLONGSWORD~ 2
			LPF patchCreature
				INT_VAR
					xpv=2000
					hp=70
					ac=2
					thac0=15
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=5
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=20
					intelligence=7
					wisdom=11
					dexterity=10
					constitution=9
					charisma=1
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~FIGHTER~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=10
					enforce=1
			END
			// Assigning jam10
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam10 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~DOOMDUR~) BEGIN 
				WRITE_SHORT 0x24 100 // hp
				WRITE_SHORT 0x26 100 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 8 // level1
				SET_BG2_PROFICIENCY ~PROFICIENCYLONGSWORD~ 3
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"DOOMGU"
	"DOOMDUR"
BEGIN
	LAF jam10_patch STR_VAR file END
END