// Unholy Word
IF
	!StateCheck(Myself,STATE_SILENCED)
	HaveSpell(CLERIC_UNHOLY_WORD)
	!StateCheck(Player1,STATE_SLOWED)
	!StateCheck(Player1,STATE_DISABLED)
	RandomNumGT(823,247)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(Player1)
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!CheckSpellState(LastSeenBy(Myself),DEATH_WARD)
	!CheckSpellState(LastSeenBy(Myself),CHAOTIC_COMMANDS)
	!ImmuneToSpellLevel(LastSeenBy(Myself),7)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(LastSeenBy(Myself),CLERIC_UNHOLY_WORD)
END

