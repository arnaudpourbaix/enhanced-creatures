	!General(LastSeenBy(Myself),WEAPON)
	Range(LastSeenBy(Myself),30)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		ForceSpellRES("jas5m72",LastSeenBy(Myself))
		RemoveSpellRES("jas5m72")
END

