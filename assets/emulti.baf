// **********************************************************************
// *           Segment Name: gs_GoodBerries.baf
// **********************************************************************

// * GOODBERRIES ROUTINE - CASTS AND CONSUMES
// * [Rangers, Druids]

// * CLERIC_GOOD_BERRIES {2} [SpPr207 - 1207]
// * ----------------------------------------------------
// * CS: 9, TGT: Caster, RNG: 1', AOE: N/A
// * ----------------------------------------------------
// * Create Item: (5) GBERRY (Each berry heals the imbiber 1HP permanently)
// * Enchanced Goodberries from Ding0Tweak modifies GBERRY so that each berry heals 1HP+2HP/CL, 13 MAX @CL21
IF
  ActionListEmpty()
  CombatCounter(0)                                                         // if combat is over
  Delay(10)                                                                // once every 10 seconds
  OR(16)                                                                   // if we have ANY slots free in Inventory
     !HasItemSlot(Myself,SLOT_MISC3)
     !HasItemSlot(Myself,SLOT_MISC4)
     !HasItemSlot(Myself,SLOT_MISC5)
     !HasItemSlot(Myself,SLOT_MISC6)
     !HasItemSlot(Myself,SLOT_MISC7)
     !HasItemSlot(Myself,SLOT_MISC8)
     !HasItemSlot(Myself,SLOT_MISC9)
     !HasItemSlot(Myself,SLOT_MISC10)
     !HasItemSlot(Myself,SLOT_MISC11)
     !HasItemSlot(Myself,SLOT_MISC12)
     !HasItemSlot(Myself,SLOT_MISC13)
     !HasItemSlot(Myself,SLOT_MISC14)
     !HasItemSlot(Myself,SLOT_MISC15)
     !HasItemSlot(Myself,SLOT_MISC16)
     !HasItemSlot(Myself,SLOT_MISC17)
     !HasItemSlot(Myself,SLOT_MISC18)
  !HasItem("GBERRY",Myself)                                                // and we don't already have a goodberry
  HaveSpell(CLERIC_GOOD_BERRIES)                                           // but we do have the spell
  CheckStatLT(Myself,26,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_GOOD_BERRIES)
    Wait(2)                                                                // prevents immediate re-cast
END

// * CLERIC_GOOD_BERRIES (after creation) [GBERRY, &self]
IF
  ActionListEmpty()
  CombatCounter(0)                                                         // if combat is over
  HasItem("GBERRY",Myself)                                                 // and I have a goodberry in my bag
  HPPercentLT(Myself,100)                                                  // and I've lost some Hitpoints
  HPPercentGT(Myself,75)                                                   // but not so hurt that I've asked others for help
THEN
  RESPONSE #100
    UseItem("GBERRY",Myself)
    DisplayStringHead(Myself,12106)                                        // say "Good Berries"
END

// **********************************************************************
// *           Segment Name: gs_DruidRevert.baf
// **********************************************************************

// * DRUID REVERT TO NATURAL FORM

// * AVENGER_SHAPESHIFT_NATURAL_FORM {1} [SpIn122 - 3122] (Fire Salamander, Baby Wyvern, Sword Spider, Wolf)
// * DRUID_SHAPESHIFT_FROM_BLACKBEAR {1} [SpIn123 - 3123] (Black Bear)
// * SHAPESHIFTER_SHAPESHIFT_NATURAL_FORM {1} [SpIn124 - 3124] (Werewolf, Greater Werewolf, Brown Bear)
// * SPINHUM (Druid High Lvl Ability:  Fire Elemental, Earth Elemental)
// * If there aren't any more enemies, turn back into Myself
IF
  ActionListEmpty()
  CombatCounter(0)
  !See(NearestEnemyOf(Myself))
  Delay(10)
  OR(4)
     HaveSpellRES("SpIn123")  // DRUID_SHAPESHIFT_FROM_BLACKBEAR
     HaveSpellRES("SpIn122")  // AVENGER_SHAPESHIFT_NATURAL_FORM
     HaveSpellRES("SpIn124")  // SHAPESHIFTER_SHAPESHIFT_NATURAL_FORM
     HaveSpellRES("SpInHUM")
THEN
  RESPONSE #100
    SpellRES("SpIn123",Myself)  // DRUID_SHAPESHIFT_FROM_BLACKBEAR
    SpellRES("SpIn122",Myself)  // AVENGER_SHAPESHIFT_NATURAL_FORM
    SpellRES("SpIn124",Myself)  // SHAPESHIFTER_SHAPESHIFT_NATURAL_FORM)
    SpellRES("SpInHUM",Myself)
END

// **********************************************************************
// *           Segment Name: gs_HideAndDetect.baf
// **********************************************************************

// * HIDE AND DETECT TRICK
// * [Allows a Thief character to be BOTH hidden and detecting Traps 90% of the time]
// * [Only done when >75%HP to avoid not getting healed by gs_HealOther]

// * If not already detecting traps, and hidden, detect traps and start the timer
IF
  ActionListEmpty()
  CombatCounter(0)                                                         // and combat is over
  OR(2)
     Class(Myself,THIEF_ALL)
     Class(Myself,MONK)
  !ModalState(DETECTTRAPS)
  ModalState(STEALTH)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_Thief","LOCALS",18)
    FindTraps()
END

// * If timer expired, and I'm not damaged -> hide!
IF
  ActionListEmpty()
  CombatCounter(0)                                                         // and combat is over
  GlobalTimerExpired("gh_Thief","LOCALS")
  HPPercentGT(Myself,75)
  CheckStatGT(Myself,50,HIDEINSHADOWS)                                     // and I have a decent chance of success
THEN
  RESPONSE #100
    Hide()
END

// * If not already hidden, and I'm not damaged -> hide!
IF
  ActionListEmpty()
  CombatCounter(0)                                                         // and combat is over
  OR(2)
     Class(Myself,THIEF_ALL)
     Class(Myself,MONK)
  !StateCheck(Myself,STATE_NOT_VISIBLE)                                    // and not invisible/impinvis/hiding
  HPPercentGT(Myself,75)
  CheckStatGT(Myself,50,HIDEINSHADOWS)                                     // and I have a decent chance of success
THEN
  RESPONSE #100
    Hide()
END

// **********************************************************************
// *           Segment Name: gs_SetTrap.baf
// **********************************************************************

// * HotKey(L) - LAY TRAPS SNIPPET:
// * Lays a Trap at Thieves Feet when L is pressed.
// * Set the Timer to 3rnds when the HotKey is pressed
// * Doesn't try a HaveSpell() or HaveSpellRES() as this doesn't work unless you are using modified spell files

IF
  !GlobalTimerNotExpired("gh_SetTrap","LOCALS")                            // if the counter is at 0
  HotKey(L)                                                                // and the players pressed the L Key
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SetTrap","LOCALS",18)                               // set the Timer to 3 rounds (gets us 3 traps set)
END

// * ROGUE_SET_TIME_TRAP {1} [SpCl912 - 4912]
// * Requires Mod .spl File for HaveSpell() Have SpellRES() to work without causing crashes
IF
  HaveSpellRES("SpCl912")                                                  // ROGUE_SET_TIME_TRAP
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalTimerNotExpired("gh_SetTrap","LOCALS")                             // if its less than 3rnds since L was pressed
  CheckStatGT(Myself,25,SETTRAPS)
  Class(Myself,THIEF_ALL)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("SpCl912",Myself)                                             // ROGUE_SET_TIME_TRAP
END

