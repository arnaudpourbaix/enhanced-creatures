	!StateCheck(LastSeenBy(Myself),STATE_SLEEPING)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		ForceSpellRES("ja#s2f8",LastSeenBy(Myself))
		RemoveSpellRES("ja#s2f8")
		SetInterrupt(TRUE)
END

