// * [WA2HELM, MISC3C, MISC3K, MISC3J, MISC3I, MISC3E, MISC7T, MISC3D, TOME04, TOME01, TOME02, TOME01]

// * HotKey(S) Based Summoning - Items

// * Set the Timer to 3 when the HotKey is pressed
// * (This is here for redundancy, so that if this is the only Summon Snippet included, it still works)

// * Set the 3 round Timer when the HotKey is pressed
IF
  !GlobalTimerNotExpired("gh_SummonTimer","LOCALS")                        // if the counter is at 0
  HotKey(S)                                                                // and the players pressed the B Key
THEN
