// Generated file (don't edit)

// Sirine
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fey/ja#m2b.baf~

// Sirine traits
CREATE ITM "ja#i0m2b"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10654)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10654)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10655)
COPY_EXISTING ~ja#i0m2b.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
	END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=166 target=1 global=1 parameter1=20 parameter2=1 timing=2 probability1=100 END
	LPF cloudSpells_immunity END

// Sirine Touch
CREATE ITM "ja#i1m2b"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10171)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10171)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IFIST~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10656)
	WRITE_LONG 0x60 1
COPY_EXISTING ~ja#i1m2b.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IFIST~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 1
		WRITE_BYTE 0x84 2
		WRITE_BYTE 0x88 3
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 2
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=146 target=2 parameter1=1 parameter2=1 timing=1 probability1=100 STR_VAR resource="ja#scf8" END
	END

ACTION_FOR_EACH ~file~ IN
	"ISLSIR"
	"J#SIRIN1"
	"J#SIRIN2"
	"L#NDC1"
	"LARRIA"
	"MEIALA"
	"NTSILUA"
	"NTSIRIN2"
	"NTSIRIN4"
	"NTSIRINE"
	"SIL"
	"SIRINE"
	"SIRINE02"
	"SIRINE_A"
	"SIRINE_B"
	"QSEROMOD"
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ISLSIR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~J#SIRIN1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~J#SIRIN2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#NDC1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~LARRIA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~MEIALA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTSILUA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTSIRIN2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTSIRIN4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTSIRINE~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SIL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SIRINE~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SIRINE02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SIRINE_A~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SIRINE_B~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~QSEROMOD~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~COMPB05~
			REMOVE_CRE_ITEM ~BOW01~
			REMOVE_CRE_ITEM ~BOW05~
			REMOVE_CRE_ITEM ~SIRINE1~
			REMOVE_CRE_ITEM ~AROW01~
			REMOVE_CRE_ITEM ~AROW05~
			REPLACE_CRE_ITEM ~BOW05~ #0 #0 #0 ~NONE~ ~WEAPON2~ EQUIP
			REPLACE_CRE_ITEM ~AROW10~ #10 #0 #0 ~UNSTEALABLE~ ~QUIVER1~ 
			REPLACE_CRE_ITEM ~AROW01~ #40 #0 #0 ~UNSTEALABLE~ ~QUIVER2~ 
			REPLACE_CRE_ITEM ~AROW01~ #40 #0 #0 ~UNSTEALABLE~ ~QUIVER3~ 
			ADD_CRE_ITEM ~ja#i0m2b~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i1m2b~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ 
			ADD_CRE_ITEM ~ja#i5~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~ja#saf8~ #0 ~innate~ (1) // Charm Song
			ADD_MEMORIZED_SPELL ~ja#sbf8~ #0 ~innate~ (1) // Fog Cloud
			ADD_MEMORIZED_SPELL ~SPWI416~ #3 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~SPWI405~ #3 ~wizard~ (1) 
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYDAGGER~ 2
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=30
					ac=7
					thac0=15
					apr=1
					saveDeath=9
					saveWand=7
					savePolymorph=9
					saveBreath=11
					saveSpell=8
					level1=11
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					strength=10
					intelligence=13
					wisdom=16
					dexterity=18
					constitution=11
					charisma=17
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~FAIRY_SIRINE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=10
					enforce=1
			END
			// Assigning ja#m2b to slot Race
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN SIRSPELL SIL BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BPWTSIGT BPWTRSGT BPWDRSGT BPWDASGT BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW2RS0MO DW#PRSHT DW1RANGE DW2MC3MO dw1ranmo DW2MC1GE dw1melmo DW2MS1GE DW2MC0MO DW2MC1MO DW2RC0MO DW2MS0MO DW2MC0GE DW2MC0GW DW2MC2GE DW2MP2GW DW2MM0GE DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MS0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT SUMSHT02 TUTU_SCR WTASIGHT WDASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=Race removeScripts script=ja#m2b END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SIL~) BEGIN 
				WRITE_SHORT 0x24 42 // hp
				WRITE_SHORT 0x26 42 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 9 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 11 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 7 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ISLSIR~) BEGIN 
				WRITE_SHORT 0x24 66 // hp
				WRITE_SHORT 0x26 66 // hp
				WRITE_BYTE 0x52 9 // thac0
				WRITE_BYTE 0x54 9 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 11 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 11 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~MEIALA~) BEGIN 
				WRITE_SHORT 0x24 66 // hp
				WRITE_SHORT 0x26 66 // hp
				WRITE_BYTE 0x52 9 // thac0
				WRITE_BYTE 0x54 9 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 11 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 11 // level1
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END