IF
    !AreaCheck("ar3004")
    !GlobalTimerNotExpired("castspell","LOCALS")
    HaveSpell(WIZARD_NPC_SYMBOL_FEAR)  // SPWI899.SPL (Symbol, Fear)
    !CheckSpellState(SixthNearestEnemyOf(Myself),DO_NOT_TARGET_SPELLS)
    !Gender(SixthNearestEnemyOf(Myself),SUMMONED)
    !Kit(SixthNearestEnemyOf(Myself),CAVALIER)
    !CheckSpellState(SixthNearestEnemyOf(Myself),RESIST_FEAR)
    !General(SixthNearestEnemyOf(Myself),UNDEAD)
    !Kit(SixthNearestEnemyOf(Myself),Blackguard)
    !CheckSpellState(SixthNearestEnemyOf(Myself),EXALTATION)
    OR(2)
        !CheckSpellState(SixthNearestEnemyOf(Myself),PANIC_IMMUNITY_SEEN)
        !CheckSpellState(SixthNearestEnemyOf(Myself),PANIC_IMMUNITY)
    !CheckStatGT(SixthNearestEnemyOf(Myself),99,RESISTMAGIC)
    Allegiance(Myself,ENEMY)
    !Allegiance(SixthNearestEnemyOf(Myself),ENEMY)
    !StateCheck(SixthNearestEnemyOf(Myself),STATE_IMMOBILE)
    !StateCheck(SixthNearestEnemyOf(Myself),STATE_FEEBLEMINDED)
    !CheckStatGT(SixthNearestEnemyOf(Myself),0,HELD)
    !StateCheck(SixthNearestEnemyOf(Myself),STATE_HELPLESS)
    OR(3)
        TriggerOverride(SixthNearestEnemyOf(Myself),Range(NearestAllyOf(Myself),15))
        NumInParty(1)
        GlobalTimerNotExpired("targetcompromise","LOCALS")
    OR(2)
        !TriggerOverride(SixthNearestEnemyOf(Myself),StateCheck(NearestAllyOf(Myself),STATE_HELPLESS))
        !TriggerOverride(SixthNearestEnemyOf(Myself),StateCheck(SecondNearestAllyOf(Myself),STATE_HELPLESS))
    OR(2)
        !TriggerOverride(SixthNearestEnemyOf(Myself),StateCheck(NearestAllyOf(Myself),STATE_HELPLESS))
        TriggerOverride(SixthNearestEnemyOf(Myself),Range(SecondNearestAllyOf(Myself),15))
    See(SixthNearestEnemyOf(Myself))
    False()
THEN
    RESPONSE #100
        Continue()
END

