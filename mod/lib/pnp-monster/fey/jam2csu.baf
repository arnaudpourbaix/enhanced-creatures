	!HaveSpell(CLERIC_INSECT_PLAGUE)
	RandomNumGT(804,241)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(NearestEnemyOfType(0.0.0.MAGE_ALL))
