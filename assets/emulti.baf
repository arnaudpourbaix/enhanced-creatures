// * BOON_OF_LATHANDER "ds" {1} [SpCl741 - 4741] (Innate Priest of Lathander)
// * Requires Mod .spl File for HaveSpell() or HaveSpellRES() checks to work without crashing the game
// * -----------------------------------------
// * CS: 3, TGT: Caster, RNG: 1', AOE: Caster
// * -----------------------------------------
// * +1 THAC0, +1 to Dmg, +1 to all STs, +1 Attack/Round, Immunity to Level Drain - 60s + 6s/CL
IF
  HaveSpell(4741)                                                          // if I have the spell
  CheckStatLT(Myself,1,SCRIPTINGSTATE3)                                    // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 1+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  OR(11)
     HPGT(LastSeenBy(Myself),50)                                           // and the target has >20hp==changed to 50, cause almost every opponent on list has >20 HP ;)
     HasItemEquiped("WRAITH1",LastSeenBy(Myself))
     HasItemEquiped("WIGHT",LastSeenBy(Myself))
     HasItemEquiped("VAMP",LastSeenBy(Myself))
     HasItemEquiped("VAMP1",LastSeenBy(Myself))
     HasItemEquiped("VAMP2",LastSeenBy(Myself))
     HasItemEquiped("VAMP3",LastSeenBy(Myself))
     HasItemEquiped("SPECTR",LastSeenBy(Myself))
     HasItemEquiped("TROLLSP",LastSeenBy(Myself))
     HasItemEquiped("MISTVA",LastSeenBy(Myself))
     HasItemEquiped("MISTVA2",LastSeenBy(Myself))
  Range(LastSeenBy(Myself),6)                                              // and they're within 6sq away (melee)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,4741)
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(LastSeenBy(Myself))                                             // Attack()
END

// * CLERIC_MOON_BLADE {3} [CDMNBLD]
// * Requires G3's Divine Remix
// * -----------------------------------------
// * CS: 5, TGT: Caster, RNG: 1', AOE: Caster
// * -----------------------------------------
// * Create Item: CDMNBLD (Enchantment: +4, To Hit: +0, Dmg: 1d12+4 MAGIC + 1d12 MAGIC vs Undead) - 140s
// * Sets targets spellfailure to 100% for 7s

IF
  HaveSpellRES("CDMNBLD")                                                  // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 1+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >10hp
  OR(5)
     Class(LastSeenBy(Myself),BARD_ALL)                                    // or the current target is a bard
     Class(LastSeenBy(Myself),DRUID_ALL)                                   // or the current target is a druid
     Class(LastSeenBy(Myself),CLERIC_ALL)                                  // or the current target is a cleric
     Class(LastSeenBy(Myself),MAGE_ALL)                                    // or the current target is a mage
     Class(LastSeenBy(Myself),SORCERER)                                    // or the current target is a sorcerer     
  Range(LastSeenBy(Myself),6)                                              // and they're within 6sq away (melee)
  !HasItemSlot(Myself,SLOT_MISC19)                                         // more robust check to see if I already have anything in the magically created item slot
//  !HasItem("CDMNBLD",Myself)                                             // and I don't already have a Serious Wounds in effect
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("CDMNBLD",Myself)                                             // cast the spell
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(LastSeenBy(Myself))                                             // Attack()
END

