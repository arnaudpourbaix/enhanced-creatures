// Generated file (don't edit)

// Huge Spider
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/spider/jam37.baf~

// Type A poison
CREATE SPL "jas0m37"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m37.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10838)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 fl#Poison
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10839)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=25 target=2 power=1 parameter1=6 parameter2=3 duration=100 probability1=100 savingthrow=4 savebonus="1" special=6 END
OUTER_SET $f_AddSecType(jas0m37.spl) = PoisonSecType

// Jaws
CREATE ITM "jai0m37"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10294)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10294)
	WRITE_ASCII 0x3a ~SPPR416B~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10840)
COPY_EXISTING ~jai0m37.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~SPPR416B~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 1
		WRITE_BYTE 0x84 2
		WRITE_BYTE 0x88 6
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=146 target=2 parameter2=1 probability1=100 STR_VAR resource="jas0m37" END
	END

DEFINE_ACTION_FUNCTION jam37_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSPIDHU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDHU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDLAND~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BDSPIDHU~
			REMOVE_CRE_ITEM ~SPIDHU1~
			REMOVE_CRE_ITEM ~ANTIWEB~
			REMOVE_CRE_ITEM ~D5SMSPID~
			REPLACE_CRE_ITEM ~jai0m37~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai16~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=270
					hp=18
					ac=8
					thac0=19
					apr=1
					saveDeath=14
					saveWand=16
					savePolymorph=15
					saveBreath=17
					saveSpell=17
					level1=2
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=14
					intelligence=7
					wisdom=11
					dexterity=16
					constitution=12
					charisma=4
					morale=8
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SPIDER~)
					class=IDS_OF_SYMBOL (~class~ ~SPIDER_HUGE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=14
					enforce=1
			END
			// Assigning jam37
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN DW#SPIDS BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam37 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BDSPIDHU"
	"SPIDHU"
	"SPIDLAND"
BEGIN
	LAF jam37_patch STR_VAR file END
END