// * CLERIC_DRAW_UPON_HOLY_MIGHT {2} [SpPr214 - 1214] (raises str/dex/con)
// * Detectable Spell
IF
  HaveSpell(CLERIC_DRAW_UPON_HOLY_MIGHT)                                   // and I have the ability
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 1+
  !AttackedBy([ANYONE],DEFAULT)                                            // and we're under attack
  !StateCheck(Myself,STATE_DRAWUPONHOLYMIGHT)                              // and I haven't ALREADY cast it
  NumCreatureGT([EVILCUTOFF],1)                                            // and there are 2+ monsters
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  Range(LastSeenBy(Myself),8)                                              // and the target is close to melee range
  HPGT(LastSeenBy(Myself),25)                                              // and the target has >25 hp
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_DRAW_UPON_HOLY_MIGHT)                              // then beef myself up
END

// **********************************************************************
// *           Segment Name: gs_DruidShapeshift.baf
// **********************************************************************

// * DRUID SHAPESHIFTING POWERS -
// * Usually considered a Threatlevel 2 or 3 "PreAttack" Power.

// * CLERIC_ELEMENTAL_TRANSFORMATION_FIRE {1} [SpPr731 - 1731] (Immunity to Normal Weapons, AC Bonus, THAC0 Bonus)
// * SpInHUM.spl reverts

// * DRUFIR01.CRE [AC:-5]

// * Hand to Hand, Attack, DRUFIR [Echanted Weapon +4, 1D10 Crushing + 1D10 Fire]
IF
  HaveSpell(CLERIC_ELEMENTAL_TRANSFORMATION_FIRE)
  RandomNumLT(10,7)                                                        // 70% chance
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)
  !InParty(LastSeenBy(Myself))
  OR(2)
     NumCreatureGT([EVILCUTOFF],4)                                         // If there are 5+ monsters
     HPGT(LastSeenBy(Myself),50)
  CheckStatLT(LastSeenBy(Myself),50,RESISTFIRE)
  Range(LastSeenBy(Myself),6)
//  CheckStatGT(Myself,-8,ARMORCLASS)                                        // and AC >-8 otherwise, don't bother
  !HasItem("DRUFIR",Myself)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_ELEMENTAL_TRANSFORMATION_FIRE)
    DisplayStringHead(Myself,2873)                                         // "Fire Elemental"
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

