  CheckStatLT(NearestEnemyOf(Myself),26,RESISTSLASHING)                    // and they are not resistanct to SLASHING dmg
  CheckStatLT(NearestEnemyOf(Myself),26,RESISTFIRE)                        // and they are not resistanct to FIRE dmg
//  !HasItem("FBLADE",Myself)                                              // and I don't already have a Flame Blade
//  !HasItem("SHAMMR",Myself)                                              // and I don't already have a Spiritual Hammer
//  !HasItem("SHAMMR2",Myself)                                             // and I don't already have a Spiritual Hammer(+2 version)
//  !HasItem("SHAMMR3",Myself)                                             // and I don't already have a Spiritual Hammer(+3 version)
