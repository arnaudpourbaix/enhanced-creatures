// Generated file (don't edit)

// Winter Wolf
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/wolf/jam14.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/wolf/jam14su.baf~

// Stream of frost
COPY_EXISTING "CONECOLD.pro" ~override/jas0m14.pro~
	READ_SHORT 0x08 type
	PATCH_IF (%type% = 1) BEGIN
		INSERT_BYTES 0x100 0x100
	END
	WRITE_LONG 0x200 80
	WRITE_SHORT 0x204 180
	WRITE_SHORT 0x206 180
ADD_PROJECTILE ~override/jas0m14.pro~ ~Stream of frost~

CREATE SPL "jas0m14"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m14.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10313)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 10
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10314)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=4 target=4 projectile=(IDS_OF_SYMBOL (~projectl~ ~jas0m14~)) + 1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=12 target=2 power=1 parameter2=131072 timing=1 probability1=100 dicesize=4 dicenumber=6 savingthrow=2 special=256 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=1 parameter1="-2786560" parameter2=1310720 probability1=100 END
	LPF CHANGE_SPELL INT_VAR    renew=10 END
	
// Winter Wolf traits
CREATE ITM "jai0m14"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10853)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10853)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10854)
COPY_EXISTING ~jai0m14.itm~ ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=30 target=1 global=1 parameter1="-10" parameter2=1 timing=2 probability1=100 END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=84 target=1 global=1 parameter1="-10" parameter2=1 timing=2 probability1=100 END
	LPF cold_immunity END

// Jaws
CREATE ITM "jai1m14"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10309)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10309)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~SPPR416B~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10855)
	WRITE_LONG 0x60 1
COPY_EXISTING ~jai1m14.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~SPPR416B~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 2
		WRITE_BYTE 0x84 3
		WRITE_BYTE 0x88 4
		WRITE_BYTE 0x8a 2
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

DEFINE_ACTION_FUNCTION jam14_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~L#WOLST~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~P#WOLF01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFWI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFWISU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFWWSU~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~WOLFWI1~
			REMOVE_CRE_ITEM ~WOLFWI2~
			ADD_CRE_ITEM ~jai0m14~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m14~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai12~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas0m14~ #0 ~innate~ (1) // Stream of frost
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=975
					hp=60
					ac=5
					thac0=15
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=6
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					strength=18
					intelligence=9
					wisdom=12
					dexterity=13
					constitution=14
					charisma=8
					morale=13
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~WOLF~)
					class=IDS_OF_SYMBOL (~class~ ~WOLF_WINTER~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~)
					movement=14
					enforce=1
			END
			// Assigning jam14
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN WNTRWOLF BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN WOLFWISU WOLFWWSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam14 END
			// Assigning jam14su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN WNTRWOLF BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN WOLFWISU WOLFWWSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam14su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFWISU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFWWSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"L#WOLST"
	"P#WOLF01"
	"WOLFWI"
	"WOLFWISU"
	"WOLFWWSU"
BEGIN
	LAF jam14_patch STR_VAR file = ~%file%~ END
END