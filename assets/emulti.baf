// * 1: Anti-Invisibility

// * WIZARD_TRUE_SIGHT {6} [SpWi609 - 2609]
// * Detectable Spell
// * Requires Mod Stat.IDS File (TRUE_SIGHT)
// * Requires Mod State.IDS File (STATE_ILLUSIONS)

// * (now in two versions)

// * Combo-Version : As a result of See-ing the Unseen

// * StateCheck Through 10 Enemies, look for Invis or Illusion
IF
  HaveSpell(WIZARD_TRUE_SIGHT)                                                // and I have the Spell
  !CheckStat(Myself,1,TRUE_SIGHT)                                             // and aren't already under the effects of the spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  OR(7)
     SpellCast([EVILCUTOFF],WIZARD_PROJECT_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_MISLEAD)
     SpellCast([EVILCUTOFF],WIZARD_MIRROR_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_IMPROVED_INVISIBILITY)
     SpellCast([EVILCUTOFF],WIZARD_INVISIBILITY)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_ILLUSIONS) // and they're Invisible, Improved Invisible, Mirror Imaged, or Blur'd
     NumCreatureGT([EVILCUTOFF.0.0.0.0.ILLUSIONARY.0],0)                      // or there's an illusory creature around.
  !Range(NearestEnemyOf(Myself),4)                                            // and I have space to cast
  !StateCheck(Myself,STATE_SILENCED)                                          // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                     // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_PartyHasTrueSeeing","GLOBAL",66)                       // set a 1 turn+1round timer to prevent re-cast of this or a similar spell
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                        // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_TRUE_SIGHT)
    DisplayStringHead(Myself,25633)                                           // "True Sight"
END

// * WIZARD_DETECT_INVISIBILITY {2} [SpWi203 - 2203] (aoe, both)
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)

// * Combo-Version : As a result of Invisible State, or SpellCast()

// * StateCheck Through 5 Enemies, look for Invis
IF
  HaveSpell(WIZARD_DETECT_INVISIBILITY)                                         // and I have the Spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                   // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                        // or I am Aura Cleansed so no wait
  OR(2)                                                                         // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                          // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")                 // or we're doing an interruptible action
  OR(6)
     SpellCast([EVILCUTOFF],WIZARD_PROJECT_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_MISLEAD)
     SpellCast([EVILCUTOFF],WIZARD_MIRROR_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_IMPROVED_INVISIBILITY)
     SpellCast([EVILCUTOFF],WIZARD_INVISIBILITY)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_NOT_VISIBLE) // and they're invisible
  !Range(NearestEnemyOf(Myself),4)                                              // and I have space to cast
  !StateCheck(Myself,STATE_SILENCED)                                            // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                       // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_PartyHasTrueSeeing","GLOBAL",12)                         // set a 2 round timer to prevent re-cast of this or a similar spell
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                          // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_DETECT_INVISIBILITY)
END

