				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 16 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#XZEANS~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
				WRITE_SHORT 0x24 150 // hp
				WRITE_SHORT 0x26 150 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 15 // level1
				ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
				REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#XZEANK~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
				WRITE_SHORT 0x24 150 // hp
				WRITE_SHORT 0x26 150 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 15 // level1
				ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
				REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDANKHSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ANKHEG"
	"ANKHEG01"
	"ANKHEGF"
	"ANKHEGG"
	"ANKHEGQ"
	"BDANKH01"
	"BDANKHEG"
	"BDANKHSU"
