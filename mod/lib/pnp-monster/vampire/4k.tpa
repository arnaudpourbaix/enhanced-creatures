DEFINE_ACTION_FUNCTION jam4k_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMVER01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~immune2~
			REMOVE_CRE_ITEM ~immune3~
			REMOVE_CRE_ITEM ~vamp~
			REMOVE_CRE_ITEM ~vamp1~
			REMOVE_CRE_ITEM ~vamp2~
			REMOVE_CRE_ITEM ~vamp3~
			REMOVE_CRE_ITEM ~vampreg~
			REMOVE_CRE_ITEM ~vampreg1~
			REMOVE_CRE_ITEM ~vampreg2~
			REPLACE_CRE_ITEM ~jaim4k00~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaim4k01~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~jasm4k00~ #0 ~innate~ (1) // Dominating Voice
			ADD_MEMORIZED_SPELL ~jasm4k01~ #0 ~innate~ (1) // Bat Swarm
			ADD_MEMORIZED_SPELL ~jasm4k02~ #0 ~innate~ (1) // Control Undead
			ADD_MEMORIZED_SPELL ~jasm4k03~ #0 ~innate~ (1) // Wolf Form
			ADD_MEMORIZED_SPELL ~jasm4k04~ #0 ~innate~ (1) // Bat Form
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=14000
					hp=192
					ac=5
					thac0=9
					apr=1
					saveDeath=7
					saveWand=9
					savePolymorph=8
					saveBreath=8
					saveSpell=10
					level1=12
					strength=19
					intelligence=18
					wisdom=15
					dexterity=18
					constitution=18
					charisma=18
					morale=16
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~VAMPIRE~)
					class=IDS_OF_SYMBOL (~class~ ~VAMPIRE~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					moveSilent=100
					movement=14
					enforce=1
			END
			// Assigning jabm4k00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN vampir01 ppvampir BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4k00 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"VAMVER01"
	BEGIN
		LAF jam4k_patch STR_VAR file END
	END
END