// Generated file (don't edit)

// Half Ogre
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ogre/jam1d.baf~

DEFINE_ACTION_FUNCTION jam1d_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ARGHAI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#CHOP~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#CRU11~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#CHIEN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GORF~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GORF03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREBJOR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA_A~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA_B~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA_C~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA_D~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA_E~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OGREHA5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDOGRE04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK2~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			ADD_CRE_ITEM ~jai9~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYBASTARDSWORD~ 2
			SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 2
			LPF patchCreature
				INT_VAR
					xpv=175
					hp=22
					ac=5
					thac0=17
					apr=1
					saveDeath=14
					saveWand=16
					savePolymorph=15
					saveBreath=17
					saveSpell=17
					level1=2
					strength=17
					intelligence=9
					wisdom=9
					dexterity=10
					constitution=14
					charisma=10
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~OGRE~)
					class=IDS_OF_SYMBOL (~class~ ~OGRE_HALFOGRE~)
					kit=IDS_OF_SYMBOL (~kit~ ~TRUECLASS~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=10
					enforce=1
			END
			// Assigning jam1d
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN HALFOGRE BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam1d END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDOGRE04~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~ARGHAI~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CHOP~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CRU11~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~GORF~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~GORF03~) BEGIN 
				WRITE_LONG 0x14 520 // xpv
				WRITE_SHORT 0x24 43 // hp
				WRITE_SHORT 0x26 43 // hp
				WRITE_SHORT 0x46 3 // ac
				WRITE_SHORT 0x48 3 // ac
				WRITE_BYTE 0x52 15 // thac0
				WRITE_BYTE 0x54 11 // saveDeath
				WRITE_BYTE 0x55 13 // saveWand
				WRITE_BYTE 0x56 12 // savePolymorph
				WRITE_BYTE 0x57 13 // saveBreath
				WRITE_BYTE 0x58 14 // saveSpell
				WRITE_BYTE 0x234 5 // level1
				WRITE_BYTE 0x238 18 // strength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~GORF~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~GORF03~) BEGIN 
				WRITE_BYTE 0x239 50 // exceptionalStrength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~GORF03~) BEGIN 
				WRITE_SHORT 0x24 70 // hp
				WRITE_SHORT 0x26 70 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 8 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ARGHAI~) BEGIN 
				WRITE_BYTE 0x239 100 // exceptionalStrength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDOGRE04~) BEGIN 
				WRITE_BYTE 0x239 83 // exceptionalStrength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CHOP~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CRU11~) BEGIN 
				WRITE_BYTE 0x238 19 // strength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK2~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#CHIEN~) BEGIN 
				WRITE_LONG 0x14 4000 // xpv
				WRITE_SHORT 0x24 78 // hp
				WRITE_SHORT 0x26 78 // hp
				WRITE_SHORT 0x46 10 // ac
				WRITE_SHORT 0x48 10 // ac
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 9 // level1
				WRITE_BYTE 0x238 18 // strength
				WRITE_BYTE 0x23f 20 // morale
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK2~) BEGIN 
				WRITE_SHORT 0x246 IDS_OF_SYMBOL (~kit~ ~BERSERKER~) // kit
				ADD_MEMORIZED_SPELL ~SPCL321~ #0 ~innate~ (3) 
				SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 5
			END
			PATCH_IF GAME_IS ~bg2ee~ BEGIN 
				PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK~) BEGIN 
					WRITE_LONG 0x14 8000 // xpv
					WRITE_SHORT 0x24 158 // hp
					WRITE_SHORT 0x26 158 // hp
					WRITE_BYTE 0x52 1 // thac0
					WRITE_BYTE 0x54 3 // saveDeath
					WRITE_BYTE 0x55 5 // saveWand
					WRITE_BYTE 0x56 4 // savePolymorph
					WRITE_BYTE 0x57 4 // saveBreath
					WRITE_BYTE 0x58 6 // saveSpell
					WRITE_BYTE 0x234 19 // level1
					ADD_MEMORIZED_SPELL ~SPCL321~ #0 ~innate~ (2) 
				END
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~TAZOK2~) BEGIN 
				WRITE_SHORT 0x24 94 // hp
				WRITE_SHORT 0x26 94 // hp
				WRITE_BYTE 0x52 9 // thac0
				WRITE_BYTE 0x54 7 // saveDeath
				WRITE_BYTE 0x55 9 // saveWand
				WRITE_BYTE 0x56 8 // savePolymorph
				WRITE_BYTE 0x57 8 // saveBreath
				WRITE_BYTE 0x58 10 // saveSpell
				WRITE_BYTE 0x234 11 // level1
				ADD_CRE_ITEM ~POTN02~ #1 #0 #0 ~UNDROPPABLE~ ~QITEM1 QITEM2 QITEM3~ 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#CHIEN~) BEGIN 
				LPF fireResistance_resistance END
				LPF coldResistance_resistance END
				LPF missileDamage_immunity END
				SET_BG2_PROFICIENCY ~PROFICIENCYLONGSWORD~ 5
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ARGHAI"
	"X#CHOP"
	"X#CRU11"
	"L#CHIEN"
	"GORF03"
	"OGREBJOR"
	"OGREHA"
	"OGREHA_A"
	"OGREHA_B"
	"OGREHA_C"
	"OGREHA_D"
	"OGREHA_E"
	"OGREHA1"
	"OGREHA2"
	"OGREHA3"
	"OGREHA4"
	"OGREHA5"
	"BDOGRE04"
	"TAZOK"
	"TAZOK2"
BEGIN
	LAF jam1d_patch STR_VAR file END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"GORF"
	BEGIN
		LAF jam1d_patch STR_VAR file END
	END
END