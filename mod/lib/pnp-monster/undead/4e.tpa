DEFINE_ACTION_FUNCTION jam4e_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#FPMMY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDMUMMY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDMUMM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~MUMMY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~MUMMY01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU6~ BEGIN
				LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=292 END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~bdmumm01~
			REMOVE_CRE_ITEM ~mummyw~
			ADD_CRE_ITEM ~jai0m4e~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m4e~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~jas2m4e~ #0 ~innate~ (1) // Fear Aura
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=75
					ac=3
					thac0=13
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=6
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=16
					intelligence=7
					wisdom=10
					dexterity=8
					constitution=9
					charisma=12
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~GHOUL~)
					class=IDS_OF_SYMBOL (~class~ ~GHOUL_REVEANT~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					animation=IDS_OF_SYMBOL (~animate~ ~MUMMY~)
					movement=5
					enforce=1
			END
			// Assigning jam4e
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN bdmumm01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam4e END
