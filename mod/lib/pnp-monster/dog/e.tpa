// Generated file (don't edit)

// Blink Dog
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/dog/jame.baf~

// Blink
CREATE SPL "jas0me"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0me.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10177)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI402C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10709)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=30 STR_VAR icon="SPWI402B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=124 target=1 power=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=278 target=1 power=1 parameter1=2 duration=6 probability1=75 END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
// Jaws
CREATE ITM "jai0me"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10176)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10176)
	WRITE_ASCII 0x3a ~SPPR416B~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10710)
COPY_EXISTING ~jai0me.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~SPPR416B~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 1
		WRITE_BYTE 0x84 3
		WRITE_BYTE 0x88 6
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

DEFINE_ACTION_FUNCTION jame_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~DOGBLINK~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~P1-6~
			REPLACE_CRE_ITEM ~jai0me~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai12~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas0me~ #0 ~innate~ (1) // Blink
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=270
					hp=44
					ac=8
					thac0=17
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					strength=12
					intelligence=9
					wisdom=13
					dexterity=17
					constitution=15
					charisma=11
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~DOG~)
					class=IDS_OF_SYMBOL (~class~ ~DOG_WILD~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=10
					enforce=1
			END
			// Assigning jame
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN PSPIDER BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jame END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"DOGBLINK"
BEGIN
	LAF jame_patch STR_VAR file END
END