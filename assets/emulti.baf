  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // and its threat-level 4
  !InParty(NearestEnemyOf(Myself))                                         // and they're not in our party (double-check)
  !Allegiance(NearestEnemyOf(Myself),GOODCUTOFF)                           // and not an Ally, Familiar, Minion or Simulacrum
  General(NearestEnemyOf(Myself),HUMANOID)                                 // and they're humanoid
  !General(NearestEnemyOf(Myself),UNDEAD)                                  // and they're not undead
