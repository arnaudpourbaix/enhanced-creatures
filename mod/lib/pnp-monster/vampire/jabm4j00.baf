// Very Old Vampire

// Gaseous form: get away from enemies
IF
	CheckSpellState(Myself,JA_GASEOUSFORM)
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),90)
END

// Bat form: get away from enemies while hurt
IF
	CheckSpellState(Myself,JA_ANIMALFORM)
	CheckSpellState(Myself,JA_FLYING)
	HPPercentLT(Myself,65)
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),90)
END

// Init
IF
	Global("JA_INIT","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",0)
		SetGlobal("JA_PRECAST_LONG","LOCALS",0)
		SetGlobal("JA_PRECAST_MID","LOCALS",0)
		SetGlobalTimer("JA_REST","LOCALS",2400)
		SetGlobal("JA_INIT","LOCALS",1)
END

// Out of the sun: withstanding it starts over
IF
	Global("JA_SUNLIGHT","LOCALS",1)
	OR(3)
		!AreaType(OUTDOOR)
		!TimeGT(5)
		!TimeLT(22)
THEN
	RESPONSE #100
		SetGlobal("JA_SUNLIGHT","LOCALS",0)
		Continue()
END

// Disable spellcasting in some areas
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	OR(2)
		AreaCheck("AR3004")
		AreaCheck("AR3008")
THEN
	RESPONSE #100
		SetGlobal("JA_DISABLE_SPELLCASTING","LOCALS",1)
END

// Rest (reset everything and heal if applicable)
IF
	Global("JA_INIT","LOCALS",1)
	GlobalTimerExpired("JA_REST","LOCALS")
	!See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_INIT","LOCALS",0)
		Rest()
		ApplySpell(Myself,RESTORE_FULL_HEALTH)
END

// Turn hostile if attacked
IF
	Allegiance(Myself,NEUTRAL)
	OR(4)
		AttackedBy([GOODCUTOFF],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		TookDamage()
		Heard([EVILCUTOFF.0.VAMPIRE],99)
THEN
	RESPONSE #100
		Enemy()
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,EVILCUTOFF)
	See([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Detect combat
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,GOODCUTOFF)
	See([EVILCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
END

// Shouts every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	!GlobalTimerNotExpired("JA_SHOUT","LOCALS")
THEN
	RESPONSE #100
		Shout(99)
		SetGlobalTimer("JA_SHOUT","LOCALS",18)
END

// React to shouts
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.VAMPIRE],99)
	InMyArea([EVILCUTOFF.0.VAMPIRE])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Heard([EVILCUTOFF.0.VAMPIRE],99)
	InMyArea([EVILCUTOFF.0.VAMPIRE])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

// Help every 3 rounds
IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("JA_HELP","LOCALS")
THEN
	RESPONSE #100
		Help()
		SetGlobalTimer("JA_HELP","LOCALS",18)
END

// React to help
IF
	Global("JA_COMBAT","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
THEN
	RESPONSE #100
		SetGlobal("JA_COMBAT","LOCALS",1)
		Help()
		MoveToObject(LastHelp(Myself))
END

IF
	Global("JA_COMBAT","LOCALS",1)
	Allegiance(Myself,ENEMY)
	Help([ENEMY])
	InMyArea([ENEMY])
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHelp(Myself))
END

// Do nothing if...
IF
	OR(4)
		Global("JA_COMBAT","LOCALS",0)
		!Allegiance(Myself,EVILCUTOFF)
		StateCheck(Myself,STATE_IMMOBILE)
		StateCheck(Myself,STATE_REALLY_DEAD)
THEN
	RESPONSE #100
		NoAction()
END

IF
	!InActiveArea(Myself)
	!Range(NearestEnemyOf(Myself),30)
THEN
	RESPONSE #100
		NoAction()
END

// Sunlight: starts withstanding it
IF
	Allegiance(Myself,EVILCUTOFF)
	Global("JA_SUNLIGHT","LOCALS",0)
	AreaType(OUTDOOR)
	TimeGT(5)
	TimeLT(22)
THEN
	RESPONSE #100
		SetGlobal("JA_SUNLIGHT","LOCALS",1)
		SetGlobalTimer("JA_SUNLIGHT_TIMER","LOCALS",60)
		Continue()
END

// Sunlight: can't withstand it any longer
IF
	Allegiance(Myself,EVILCUTOFF)
	Global("JA_SUNLIGHT","LOCALS",1)
	AreaType(OUTDOOR)
	TimeGT(5)
	TimeLT(22)
	!GlobalTimerNotExpired("JA_SUNLIGHT_TIMER","LOCALS")
THEN
	RESPONSE #100
		ReallyForceSpellDead(Myself,VAMPIRE_BAT_FORM_CHANGE)
END

// Get out of Storm of Vengeance
IF
	Heard([ANYONE],407)
	Range(LastHeardBy(Myself),20)
	OR(3)
		!CheckStatGT(Myself,99,RESISTACID)
		!CheckStatGT(Myself,99,RESISTFIRE)
		!CheckStatGT(Myself,99,RESISTELECTRICITY)
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(LastHeardBy(Myself),30)
END

// Get out of Storm of Vengeance: close in on the enemies
IF
	Heard([ANYONE],407)
	Range(LastHeardBy(Myself),20)
	OR(3)
		!CheckStatGT(Myself,99,RESISTACID)
		!CheckStatGT(Myself,99,RESISTFIRE)
		!CheckStatGT(Myself,99,RESISTELECTRICITY)
	OR(2)
		!CheckStatGT(Myself,80,RESISTMAGIC)
		!See(NearestEnemyOf(Myself))
	See(NearestEnemyOf(Myself))
	!Range(NearestEnemyOf(Myself),8)
THEN
	RESPONSE #100
		MoveToObject(NearestEnemyOf(Myself))
END

// Get out of Incendiary Cloud, Meteor Swarm, Fire Storm
IF
	OR(2)
		Heard([ANYONE],405)
		Heard([ANYONE],409)
	Range(LastHeardBy(Myself),20)
	!CheckStatGT(Myself,99,RESISTFIRE)
	OR(2)
		!CheckStatGT(Myself,59,RESISTFIRE)
		!See(NearestEnemyOf(Myself))
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(LastHeardBy(Myself),30)
END

// Get out of Incendiary Cloud, Meteor Swarm, Fire Storm: close in on the enemies
IF
	OR(2)
		Heard([ANYONE],405)
		Heard([ANYONE],409)
	Range(LastHeardBy(Myself),20)
	!CheckStatGT(Myself,99,RESISTFIRE)
	OR(2)
		!CheckStatGT(Myself,59,RESISTFIRE)
		!See(NearestEnemyOf(Myself))
	OR(2)
		!CheckStatGT(Myself,79,RESISTMAGIC)
		!See(NearestEnemyOf(Myself))
	See(NearestEnemyOf(Myself))
	!Range(NearestEnemyOf(Myself),8)
THEN
	RESPONSE #100
		MoveToObject(NearestEnemyOf(Myself))
END

