// * WIZARD_CONJURE_FIRE_ELEMENTAL {6} [SpWi620 - 2620] (Summons 1 Fire Elemental: 60% ELFIRSU2.CRE 12 HD, 35% ELFIRSU3.CRE 16HD, 5% ELFIRSU4.CRE 24HD, 1 turn/CL, 15% Change of Failure)
IF
  HaveSpell(WIZARD_CONJURE_FIRE_ELEMENTAL)                                 // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !AttackedBy([ANYONE],DEFAULT)                                            // if we're NOT being attacked
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // or its threat-level 3+
  !GlobalTimerNotExpired("gh_NoSummons","GLOBAL")                          // and there aren't any summon-preventing effects
  NumCreatureLT([GOODCUTOFF.0.0.0.0.SUMMONED.0],1)                         // and the number of summoned helpers = 0
  OR(2)
     NumCreatureGT([EVILCUTOFF],4)                                         // and there are at least 5 enemies
     HPGT(NearestEnemyOf(Myself),50)                                       // or one monster has >50hp
  CheckStatLT(NearestEnemyOf(Myself),1,RESISTFIRE)                         // and the enemy is not resist to Fire
  CheckStatLT(NearestEnemyOf(Myself),1,RESISTMAGICFIRE)                    // and the enemy is not resist to Magic Fire
  !Range(NearestEnemyOf(Myself),8)                                         // and nearest enemy is > 8 distant (since it takes 3 rnds to cast, I need the distance)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(NearestEnemyOf(Myself),WIZARD_CONJURE_FIRE_ELEMENTAL)
END

