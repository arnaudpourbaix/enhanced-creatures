// **********************************************************************
// *           Segment Name: gs_Disablers_TL3_Mage.baf
// **********************************************************************
// * DISABLING SPELLS  - THREAT LEVEL 3 - (Mage)

// * [From Specific to Generic]

// * [A specific target is any target with a qualified condition, such as being NOT immune to fire]

// * WIZARD_GREATER_MALISON {4} [SpWi412 - 2412] (cs 4, rng 50, AOE 60' cube, 2R/CL, -4 to all STs no save)
// * Detectable Spell
// * Requires Mod STAT.IDS file (WIZARD_GREATER_MALISON)
IF
  HaveSpell(WIZARD_GREATER_MALISON)                                        // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  !CheckStat(LastSeenBy(Myself),1,WIZARD_GREATER_MALISON)                  // and they aren't already under the effects of the spell
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >20hp
  NumCreatureGT([EVILCUTOFF],4)                                            // and theres 5+ enemies
  Range(LastSeenBy(Myself),12)                                             // and range is <12 steps away
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_GREATER_MALISON)
END

// * WIZARD_CHAOS {5} [SpWi508 - 2508] (PF, cs 4, rng 35, AOE 60' cube, 5R+1R/6CL, confusion no save if <5L STvS -4 if >4L)
// * Requires Mod STATE.IDS file (STATE_RANGED_TARGET)
IF
  HaveSpell(WIZARD_CHAOS)                                                  // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >20hp
  NumCreatureGT([EVILCUTOFF],4)                                            // and theres 5+ enemies
  !General(LastSeenBy(Myself),UNDEAD)                                      // and they're not undead
  !Range(LastSeenBy(Myself),15)                                            // and range is >12 steps away, therefore semi-safe
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(LastSeenBy(Myself),STATE_RANGED_TARGET)                      // and not already confused
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  CheckStatGT(LastSeenBy(Myself),1,SAVEVSSPELL)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_CHAOS)
END

// * WIZARD_EMOTION_HOPELESSNESS {4} [SpWi411 - 2411] (PF, cs 4, rng 50, AOE 60' cube, 2R+1R/CL, sleep STvS neg + remove fear/protection from fear on caster]
// * Requires Mod STATE.IDS file (STATE_HARMLESS)
IF
  HaveSpell(WIZARD_EMOTION_HOPELESSNESS)                                   // and we have the spell
