// * WIZARD_OTILUKES_RESILIENT_SPHERE {4} [SpWi413 - 2413] (cs 4, rng 40, 1 CRE, 10R, traps target in impenetrable sphere STvS neg)
// * Otilukes resilient sphere can be removed by Dispel Magic
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE, STATE_HARMLESS)
IF
  HaveSpellRES("SpWi413")                                                  // and I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(2)
     Class(LastSeenBy(Myself),CLERIC_ALL)                                  // and the last enemy I saw was a Cleric
     Class(LastSeenBy(Myself),MAGE_ALL)                                    // or a Mage
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !Race(LastSeenBy(Myself),BEHOLDER)                                       // and they are not of the Beholder Race
  !Race(LastSeenBy(Myself),WYVERN)                                         // and they are not of the Wyvern Race
  !Race(LastSeenBy(Myself),KUO-TOA)                                        // and they are not of the Kuo-Toa Race
  !General(LastSeenBy(Myself),UNDEAD)                                      // and they are undead
  !Race(LastSeenBy(Myself),SLIME)                                          // and they are not of the Slime Race
  !Race(LastSeenBy(Myself),DRAGON)                                         // and they are not of the Dragon Race
  !Race(LastSeenBy(Myself),TROLL)                                          // and they are not of the Troll Race
  !Race(LastSeenBy(Myself),RAKSHASA)                                       // and they are not of the Rakshasa Race
  !Race(LastSeenBy(Myself),DEMONIC)                                        // and they are not of the Demonic Race
  !HasBounceEffects(LastSeenBy(Myself))                                    // and they aren't bouncing spells
  !StateCheck(LastSeenBy(Myself),STATE_NOT_VISIBLE)                        // and they aren't invisible
  !StateCheck(LastSeenBy(Myself),STATE_HARMLESS)                           // and they aren't Feebleminded, Charmed, Sleeping, or Stunned
  HPPercentGT(LastSeenBy(Myself),50)                                       // and they still have a decent number of hitponts
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  !CheckStatGT(Myself,76,SPELLFAILUREMAGE)                                 // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatGT(LastSeenBy(Myself),5,SAVEVSSPELL)                            // and our target doesn't have an impossible to beat saving throw
  !CheckStatGT(LastSeenBy(Myself),76,RESISTMAGIC)                          // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they aren't immune to spells of 8th level or lower
  !HasItemEquiped("IMMCHS",LastSeenBy(Myself))                             // and they don't have the game-item that gives immunity to charms, holds and sleep
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("SpWi413",LastSeenBy(Myself))
END

