// Generated file (don't edit)

// Skeleton Monster
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/skeleton-monster/jabm4800.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/skeleton-monster/jabm4801.baf~

DEFINE_ACTION_FUNCTION jam48_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSKGR02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSKGR01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDTEAM62~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~ring99~
			REMOVE_CRE_ITEM ~undtype~
			REMOVE_CRE_ITEM ~IMMCHS~
			REMOVE_CRE_ITEM ~HELMNOAN~
			ADD_CRE_ITEM ~jaim2900~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=650
					hp=72
					ac=6
					thac0=15
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=6
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=17
					intelligence=1
					wisdom=8
					dexterity=14
					constitution=9
					charisma=5
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SKELETON~)
					class=IDS_OF_SYMBOL (~class~ ~SKELETON~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					animation=IDS_OF_SYMBOL (~animate~ ~SKELETON_MONSTER~)
					metalColor=20
					minorColor=67
					majorColor=66
					skinColor=105
					leatherColor=14
					armorColor=20
					hairColor=0
					movement=10
					enforce=1
			END
			// Assigning jabm4800
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN L#HAUSK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN C0DESUM3 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4800 END
			// Assigning jabm4801
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN L#HAUSK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN C0DESUM3 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4801 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM3~) BEGIN 
				WRITE_SHORT 0x24 84 // hp
				WRITE_SHORT 0x26 84 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 7 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
					WRITE_LONG 0x8 RESOLVE_STR_REF(@10391)
					WRITE_LONG 0xc RESOLVE_STR_REF(@10391)
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0DESUM3~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"C0DESUM3"
BEGIN
	LAF jam48_patch STR_VAR file END
END
ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BDSKGR02"
		"BDSKGR01"
		"BDTEAM62"
	BEGIN
		LAF jam48_patch STR_VAR file END
	END
END