// Generated file (don't edit)

// Spectre
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/undead/jam53.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/undead/jam53su.baf~

// Specter's Touch
CREATE SPL "jas0m53"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m53.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10384)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10385)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=5 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=216 target=2 power=1 parameter1=2 timing=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=25803 timing=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=141 target=2 power=1 parameter2=1 timing=1 probability1=100 END
	
// Spectre traits
CREATE ITM "jai0m53"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@11037)
	WRITE_LONG 0xc RESOLVE_STR_REF(@11037)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11038)
COPY_EXISTING ~jai0m53.itm~ ~override~
	LPF cold_immunity END
	LPF incorporeal_trait END

// Claws
CREATE ITM "jai1m53"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10370)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10370)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IGHOUL~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@11039)
	WRITE_LONG 0x60 2
COPY_EXISTING ~jai1m53.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IGHOUL~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 2
		WRITE_BYTE 0x84 5
		WRITE_BYTE 0x88 8
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 3
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=146 target=2 parameter2=1 probability1=100 STR_VAR resource="jas0m53" END
	END

DEFINE_ACTION_FUNCTION jam53_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSPIRIT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L0MERCH~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SPECTR01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SARSPIR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L0SUMM5~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~SPECTR~
			REMOVE_CRE_ITEM ~bdspirit~
			REMOVE_CRE_ITEM ~GHOST~
			ADD_CRE_ITEM ~jai0m53~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m53~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=87
					ac=2
					thac0=13
					apr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=7
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=1
					intelligence=14
					wisdom=10
					dexterity=14
					constitution=9
					charisma=11
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SPECTRE~)
					class=IDS_OF_SYMBOL (~class~ ~SPECTRE~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					movement=24
					enforce=1
			END
			// Assigning jam53
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN DAO01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN L0SUMM5 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam53 END
			// Assigning jam53su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN DAO01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN L0SUMM5 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam53su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SARSPIR~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~L0MERCH~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~L0SUMM5~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SPECTR01~) BEGIN 
				WRITE_SHORT 0x24 123 // hp
				WRITE_SHORT 0x26 123 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 10 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L0SUMM5~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BDSPIRIT"
	BEGIN
		LAF jam53_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"L0MERCH"
		"SPECTR01"
		"SARSPIR"
		"L0SUMM5"
	BEGIN
		LAF jam53_patch STR_VAR file END
	END
END