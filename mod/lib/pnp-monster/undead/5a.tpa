DEFINE_ACTION_FUNCTION jam5a_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSKGR03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDTEAM61~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~ring99~
			ADD_CRE_ITEM ~jai0m5a~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~SPWI112~ #0 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~jas0m5a~ #0 ~innate~ (1) // Blink
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=975
					hp=108
					ac=7
					thac0=19
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=9
					level2=3
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=16
					intelligence=1
					wisdom=8
					dexterity=11
					constitution=9
					charisma=5
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SKELETON~)
					class=IDS_OF_SYMBOL (~class~ ~FIGHTER_MAGE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~)
					metalColor=20
					minorColor=67
					majorColor=66
					skinColor=105
					leatherColor=14
					armorColor=20
					hairColor=0
					movement=10
					enforce=1
			END
			// Assigning jam5a
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam5a END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BDSKGR03"
	"BDTEAM61"
BEGIN
	LAF jam5a_patch STR_VAR file END
END