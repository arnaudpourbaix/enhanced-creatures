DEFINE_ACTION_FUNCTION jam3_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ANBASIL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#BASGR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BASGRT01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BASILG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BASILGSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BASILMUT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BASILNAD~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BD302BAS~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BPBASG01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#NSBAS1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#NSSULJ~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BASILG1~
			REMOVE_CRE_ITEM ~BASILG2~
			REMOVE_CRE_ITEM ~BASILG3~
			REPLACE_CRE_ITEM ~jai0m3~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai1m3~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_CRE_ITEM ~jai12~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas0f2~ #0 ~innate~ (1) // Petrifying Gaze
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=7000
					hp=150
					ac=2
					thac0=11
					apr=2
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=10
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=20
					intelligence=7
					wisdom=12
					dexterity=8
					constitution=19
					charisma=11
					morale=16
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~BASILISK~)
					class=IDS_OF_SYMBOL (~class~ ~BASILISK_GREATER~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=5
					enforce=1
					perfect2weapon=1
			END
			// Assigning jam3 to slot Race
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GBASILSK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MM2GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2GE DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BASILGSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=Race removeScripts skipFiles script=jam3 END
			// Assigning jam3su to slot Race
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GBASILSK BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MM2GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2GE DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN BASILGSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=Race files removeScripts script=jam3su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#NSSULJ~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
				WRITE_SHORT 0x24 225 // hp
				WRITE_SHORT 0x26 225 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 15 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BASILGSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ANBASIL"
	"AC#BASGR"
	"BASGRT01"
	"BASILG"
	"BASILGSU"
	"BASILMUT"
	"BASILNAD"
	"BD302BAS"
	"BPBASG01"
	"L#NSBAS1"
	"L#NSSULJ"
BEGIN
	LAF jam3_patch STR_VAR file END
END