// * HARP_OF_PANDEMONIUM [WA2HARP, Confusion + Wing Buffet 3x day, Save vs. Spells]
IF
  HasItemEquiped("WA2HARP",Myself)                                         // and I have the item equipped
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  GlobalLT("EK_UsedWA2HARP","LOCALS",1)                                    // and we haven't already used the item 3x today
  NumCreatureGT([EVILCUTOFF], 2)                                           // If there are 3+ monsters
  Range(NearestEnemyOf(Myself),10)                                         // and there are number of enemies way to close to me
  !General(NearestEnemyOf(Myself),UNDEAD)                                  // and they're not undead
  !InParty(NearestEnemyOf(Myself))                                         // and they're not in our party (double-check)
  !Allegiance(NearestEnemyOf(Myself),GOODCUTOFF)                           // and not an Ally, Familiar, Minion or Simulacrum
  HPGT(NearestEnemyOf(Myself),20)                                          // and the target has >20hp
  !StateCheck(NearestEnemyOf(Myself),STATE_CONFUSED)                       // and the target isn't already confused
  CheckStatGT(NearestEnemyOf(Myself),5,SAVEVSSPELL)                        // and our target doesn't have an impossible to beat saving throw
  CheckStatLT(NearestEnemyOf(Myself),76,RESISTMAGIC)                       // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",NearestEnemyOf(Myself))                        // and they're not a Rakshasa (immune to 8th level spells or less)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("WA2HARP",NearestEnemyOf(Myself))
    IncrementGlobal("EK_UsedWA2HARP","LOCALS",1)
    DisplayStringHead(Myself,61573)                                        // "Harp of Pandemonium"
END

// * HELM_OF_THE_ROCK [HELM32, Cast Aura of Command 3/Day]
// * Aura of Command equivalent to Cloak of Fear
IF
  HasItemEquiped("HELM32",Myself)                                          // if we have the item equipped
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  GlobalLT("GB_UsedHELM32","LOCALS",3)                                     // if we haven't used the item 3 times today already
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !Race(LastSeenBy(Myself),BEHOLDER)                                       // and they're not a beholder
  !Race(LastSeenBy(Myself),WYVERN)                                         // and they're not a wyvern
  !Race(LastSeenBy(Myself),KUO-TOA)                                        // and they're not a kuo-toan
  !General(LastSeenBy(Myself),UNDEAD)                                      // and they're not undead
  !Race(LastSeenBy(Myself),SLIME)                                          // and they're not a slime
  !Race(LastSeenBy(Myself),DRAGON)                                         // and they're not a dragon
  !Race(LastSeenBy(Myself),TROLL)                                          // and they're not a troll
  !Race(LastSeenBy(Myself),DEMONIC)                                        // and they're not a demon
  Range(LastSeenBy(Myself),10)                                             // and they're within 10sq
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >20hp
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  !StateCheck(LastSeenBy(Myself),STATE_PANIC)                              // and they're not already afraid
  CheckStatGT(LastSeenBy(Myself),5,SAVEVSSPELL)                            // and our target doesn't have an impossible to beat saving throw
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("HELM32",LastSeenBy(Myself))                                   // use the item
    IncrementGlobal("GB_UsedHELM32","LOCALS",1)                            // increment the global by 1 each time the item is used in a day
    DisplayStringHead(Myself,66445)                                        // "Helm of the Rock"
END

