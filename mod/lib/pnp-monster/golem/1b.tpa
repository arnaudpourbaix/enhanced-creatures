DEFINE_ACTION_FUNCTION jam1b_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ICBONE01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTGOLBON~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOLB1~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~S3-8M3~
			REMOVE_CRE_ITEM ~GOLCLA~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~IMMUNE2~
			REMOVE_CRE_ITEM ~HELMNOAN~
			ADD_CRE_ITEM ~jai0m1b~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m1b~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai15~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~jas0m1b~ #0 ~innate~ (1) // Hideous Laugh
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=18000
					hp=188
					ac=0
					thac0=7
					apr=1
					saveDeath=5
					saveWand=7
					savePolymorph=6
					saveBreath=5
					saveSpell=8
					level1=14
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=17
					intelligence=3
					wisdom=8
					dexterity=13
					constitution=16
					charisma=1
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_STONE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=10
					enforce=1
			END
			// Assigning jam1b
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam1b END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOLB1~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_SHORT 0x24 320 // hp
				WRITE_SHORT 0x26 320 // hp
				WRITE_BYTE 0x52 "-5" // thac0
				WRITE_BYTE 0x54 3 // saveDeath
				WRITE_BYTE 0x55 5 // saveWand
				WRITE_BYTE 0x56 4 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 6 // saveSpell
				WRITE_BYTE 0x234 25 // level1
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ICBONE01"
	"NTGOLBON"
	"OHBGOLB1"
BEGIN
	LAF jam1b_patch STR_VAR file END
END