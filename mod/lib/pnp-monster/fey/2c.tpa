COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fey/jam2csu.baf~

// Nymph traits
CREATE ITM "jai0m2c"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10713)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10713)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10714)
COPY_EXISTING ~jai0m2c.itm~ ~override~
	LPF magicResistance_resistance END

DEFINE_ACTION_FUNCTION jam2c_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ABELA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DVNYMPH~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~HGNYMPH~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHDNYMPH~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WQXNYM~ BEGIN
				LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=206 END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~DAGG01~
			REMOVE_CRE_ITEM ~B1-6~
			REMOVE_CRE_ITEM ~DVNYMPH~
			ADD_CRE_ITEM ~jai0m2c~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai5~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas1f8~ #0 ~priest~ (1) // Dimension Door
			ADD_MEMORIZED_SPELL ~jas5f8~ #0 ~innate~ (1) // Animal Friendship
			ADD_MEMORIZED_SPELL ~jas8f8~ #0 ~innate~ (1) // Blinding Beauty
			ADD_MEMORIZED_SPELL ~SPPR103~ #0 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR101~ #0 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR105~ #0 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR202~ #1 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR204~ #1 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR302~ #2 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR319~ #2 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR410~ #3 ~priest~ (1) // Call Woodland Beeings
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=1400
					hp=18
					ac=10
					thac0=17
					apr=0
					saveDeath=10
					saveWand=14
					savePolymorph=13
					saveBreath=16
					saveSpell=15
					level1=7
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					strength=10
					intelligence=16
					wisdom=12
					dexterity=17
					constitution=12
					charisma=19
					morale=7
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~DRUID~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_GOOD~)
					movement=10
					enforce=1
			END
			// Assigning jam2c
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDNYMP01 NYMPH DVNYMPH BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN DVNYMPH NYMPHSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam2c END
			// Assigning jam2csu
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDNYMP01 NYMPH DVNYMPH BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN DVNYMPH NYMPHSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam2csu END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP02~) BEGIN 
				WRITE_BYTE 0x27b IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~) // alignment
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ABELA~) BEGIN 
				REMOVE_MEMORIZED_SPELLS
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~DVNYMPH~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ABELA"
	"BDNYMP02"
	"BDNYMP01"
	"DVNYMPH"
	"HGNYMPH"
	"NYMPHSU"
	"OHDNYMPH"
	"WQXNYM"
BEGIN
	LAF jam2c_patch STR_VAR file END
END