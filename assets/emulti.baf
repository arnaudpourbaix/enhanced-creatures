// * SHAPECHANGE_GREATER_WOLFWERE {1} [SpIn155 - 3155]
// * May require Mod Spell.IDS (SHAPECHANGE_GREATER_WOLFWERE)
// * If the enemy is close, and I'm wounded, turn into a Greater Wolfwere (Massive Regenerative Ability) and run away
IF
  HaveSpell(3155)                                                          // and we can turn into a greater wolfwere
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  !HasItem("WOLFGR",Myself)                                                // and we're not already a greater wolfwere
  HPPercentLT(Myself,40)                                                   // and our hp fall below 40%
  Range(LastSeenBy(Myself),10)                                                   // and the enemy is in melee range
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,3155)                                                     // turn into a greater wolfwere
    Shout(HELP)                                                            // trigger "assists" from other PC's
// DisplayStringHead(Myself,3786)            // scream for help visibly
    RunAwayFrom(LastAttackerOf(Myself),75)                                 // run away
END

// * MIND_FLAYER_PSIONIC_BLAST {1} [SpIn974 - 3974] (Single, 20' radius, Cast Time: 1, Stun Save vs Spells Dur:60s]
// * If the enemy is near and I am a Mind Flayer, then zap them with a Mind Blast
// * ****Need to Check and See if Magic Resistance Plays a role here***
IF
  HasItem("MINDFLAY",Myself)                                               // and I am a Mind Flayer
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 2+
  GlobalLT("ek_UsedMindBlast","LOCALS",1)                                  // and I haven't mind blasted anyone, yet
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(LastSeenBy(Myself),STATE_HELPLESS)                           // and not sleeping or stunned
  !Range(LastSeenBy(Myself),10)                                            // and the enemy is not in melee range
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >20hp
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  CheckStatGT(LastSeenBy(Myself),5,SAVEVSSPELL)                            // and they don't have an unbeatable saving throw
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),3974)
    SetGlobal("ek_UsedMindBlast","LOCALS",1)
END

// * Attack
// * If the enemy is close, and I'm NOT wounded, and I'm a Mind Flayer, Iron Golem, Giant Troll
// * Greater Wolfwere, Fire Elemental, or an Earth Elemental, HIT THEM
IF
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(6)
     HasItem("MINDFLAY",Myself)                                            // or we're shapechanged into a mindflayer
     HasItem("GOLIRO",Myself)                                              // or we're shapechanged into an iron golem
     HasItem("TROLLALL",Myself)                                            // or we're shapechanged into a giant troll
     HasItem("WOLFGR",Myself)                                              // or we're shapechanged into a greater wolfwere
     HasItem("FIRERN",Myself)                                              // or we're shapechanged into a fire elemental
     HasItem("EARTHRN",Myself)                                             // or we're shapechanged into a earth elemental
  Range(LastSeenBy(Myself),10)                                             // and the enemy is in melee range
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

// * Revert to Natural Form
// * If there aren't any more enemies, turn back into Myself
// * ****Does Shape Changed Count as Polymorphed?***
// * Initial testing seems to point to Polymorphed not counting for Shapechanged
// * Need to figure out why there are two of these spells, my intial research did not clarify this

// * SHAPECHANGE_NATURAL_FORM_1 {1} [SpIn150 - 3150]
IF
  HaveSpell(3150)                                                          // and we have the spell
  ActionListEmpty()                                                        // if we're doing nothing
  CombatCounter(0)
  !See(NearestEnemyOf(Myself))
//  CheckStatGT(Myself,0,POLYMORPHED)
  GlobalTimerNotExpired("ek_ShapeChange","LOCALS")
THEN
  RESPONSE #10
    Spell(Myself,3150)
END

// * SHAPECHANGE_NATURAL_FORM_2 {1} [SpIn151 - 3151]
IF
  HaveSpell(3151)                                                          // and we have the spell
  ActionListEmpty()                                                        // if we're doing nothing
  CombatCounter(0)
  !See(NearestEnemyOf(Myself))
//  CheckStatGT(Myself,0,POLYMORPHED)
  GlobalTimerNotExpired("ek_ShapeChange","LOCALS")
THEN
  RESPONSE #10
    Spell(Myself,3151)
END

