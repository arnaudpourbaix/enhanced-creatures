DEFINE_ACTION_FUNCTION jam4n_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMPYF01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMPYM01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~vampreg~
			REMOVE_CRE_ITEM ~immune2~
			REMOVE_CRE_ITEM ~vampreg~
			REMOVE_CRE_ITEM ~vamp1~
			REMOVE_CRE_ITEM ~dw#bldd1~
			REMOVE_CRE_ITEM ~dw#vmvol~
			REMOVE_CRE_ITEM ~dw#vmbat~
			REPLACE_CRE_ITEM ~jaim4n00~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jaim4n01~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=2000
					hp=67
					ac=6
					thac0=11
					apr=2
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=8
					strength=15
					intelligence=16
					wisdom=14
					dexterity=16
					constitution=13
					charisma=18
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~VAMPYRE~)
					class=IDS_OF_SYMBOL (~class~ ~VAMPYRE~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=10
					enforce=1
					perfect2weapon=1
			END
			// Assigning jabm4n00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN vampir01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4n00 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"VAMPYF01"
		"VAMPYM01"
	BEGIN
		LAF jam4n_patch STR_VAR file END
	END
END