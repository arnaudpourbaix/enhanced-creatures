// Generated file (don't edit)

// Stone Golem
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/jam19.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/jam19su.baf~

// Stone Golem traits
CREATE ITM "jai0m19"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10755)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10755)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10756)
COPY_EXISTING ~jai0m19.itm~ ~override~
	LPF magic_immunity END
	LPF plusOneWeapons_immunity END

// Fists
CREATE ITM "jai1m19"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10231)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10231)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IFIST~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10757)
	WRITE_LONG 0x60 4
COPY_EXISTING ~jai1m19.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IFIST~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 2
		WRITE_BYTE 0x84 4
		WRITE_BYTE 0x88 8
		WRITE_BYTE 0x8a 3
		WRITE_SHORT 0x8e 2
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

DEFINE_ACTION_FUNCTION jam19_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDGOLSTO~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDMENGO~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9LSTO01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DSTONE1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#DRCTG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GOLSTO01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JUGJUG01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~KPGOL03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~KPGOL05~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTGOLSTO~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~STGOL01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~TOMEGOL3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDDOOR07~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WISTOGOL~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~GOLFLE~
			REMOVE_CRE_ITEM ~GOLSTO~
			REMOVE_CRE_ITEM ~GOLSTONE~
			REMOVE_CRE_ITEM ~IMMUNE2~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~HELMNOAN~
			REMOVE_CRE_ITEM ~B3-24~
			ADD_CRE_ITEM ~jai0m19~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m19~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~SPWI312~ #2 ~wizard~ (1) 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=8000
					hp=240
					ac=5
					thac0=7
					apr=1
					saveDeath=5
					saveWand=7
					savePolymorph=6
					saveBreath=5
					saveSpell=8
					level1=14
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=22
					intelligence=3
					wisdom=11
					dexterity=9
					constitution=20
					charisma=1
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_STONE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=5
					enforce=1
			END
			// Assigning jam19
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 OHBNONIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BDMENGO TOMEGOL3 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam19 END
			// Assigning jam19su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 OHBNONIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN BDMENGO TOMEGOL3 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam19su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDMENGO~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~TOMEGOL3~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BDGOLSTO"
	"BDMENGO"
	"D9LSTO01"
	"DSTONE1"
	"DW#DRCTG"
	"GOLSTO01"
	"JUGJUG01"
	"KPGOL03"
	"KPGOL05"
	"NTGOLSTO"
	"STGOL01"
	"TOMEGOL3"
	"UDDOOR07"
	"WISTOGOL"
BEGIN
	LAF jam19_patch STR_VAR file END
END