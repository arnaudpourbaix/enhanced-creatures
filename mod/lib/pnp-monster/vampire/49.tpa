ACTION_FOR_EACH ~file~ IN
	"RH#ISVMP"
	"rh#advmp"
	"L#RVVAMP"
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.bcs~ BEGIN
		COPY_EXISTING ~%file%.bcs~ ~override~
			DECOMPILE_AND_PATCH BEGIN
				SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~VAMPIRE_DOMINATION~ 0)
				WHILE (ec_pos >= 0) BEGIN
					SET ec_start = RINDEX_BUFFER (~^IF~ ec_pos)
					SET ec_end = INDEX_BUFFER (~^END~ ec_pos)
					PATCH_IF (ec_start >= 0 AND ec_end > ec_pos) BEGIN
						DELETE_BYTES ec_start (ec_end + 3 - ec_start)
						SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~VAMPIRE_DOMINATION~ ec_start)
					END ELSE BEGIN
						SET ec_pos = INDEX_BUFFER (EXACT_MATCH ~VAMPIRE_DOMINATION~ ec_pos + 1)
					END
				END
			END
		BUT_ONLY
	END
END

DEFINE_ACTION_FUNCTION jam49_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~RH#ADVMP~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~YSCHVAM~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~COHNTA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#NDVAM~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#2EDVAM~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C6VAMP01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C6VFLM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9GGGGG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MF444~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLF01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLM03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLMRF~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFVFV~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFVVV~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMFLF01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMFLM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RH#ISVMP~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#LASSA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GONCE~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~LAUNE~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D0VAMSIM~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDTSOLAK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#ULVAR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ULVARYL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMPIRE1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#VALEN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CBGRVAMP~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RR#VAM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SARVAM02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SARVAM03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDVADEAD~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UDVAMP01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMPIF01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VAMPIM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C0PMVM1F~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~C0PMVM1M~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~immune2~
			REMOVE_CRE_ITEM ~immune3~
			REMOVE_CRE_ITEM ~immchs~
			REMOVE_CRE_ITEM ~vamp~
			REMOVE_CRE_ITEM ~vamp1~
			REMOVE_CRE_ITEM ~vamp2~
			REMOVE_CRE_ITEM ~vamp3~
			REMOVE_CRE_ITEM ~vampreg~
			REMOVE_CRE_ITEM ~vampreg1~
			REMOVE_CRE_ITEM ~vampreg2~
			REMOVE_CRE_ITEM ~dw#bldd~
			REMOVE_CRE_ITEM ~dw#bldd1~
			REMOVE_CRE_ITEM ~dw#vmwol~
			REMOVE_CRE_ITEM ~dw#vmbat~
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~L#2EDVAM~) BEGIN 
				REPLACE_CRE_ITEM ~jaim4900~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			END
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~L#2EDVAM~) BEGIN 
				ADD_CRE_ITEM ~jaim4901~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			END
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~L#2EDVAM~) BEGIN 
				ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			END
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~L#2EDVAM~) BEGIN 
					REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
				END
			END
			ADD_MEMORIZED_SPELL ~jase0700~ #4 ~wizard~ (90) // Domination Gaze
			ADD_MEMORIZED_SPELL ~jase0701~ #1 ~wizard~ (1) // Bat Swarm
			ADD_MEMORIZED_SPELL ~jase0702~ #6 ~wizard~ (90) // Control Undead
			ADD_MEMORIZED_SPELL ~jase0703~ #0 ~innate~ (1) // Wolf Form
			ADD_MEMORIZED_SPELL ~jase0704~ #0 ~innate~ (1) // Bat Form
			ADD_MEMORIZED_SPELL ~jasm4900~ #0 ~innate~ (1) // Gaseous Form
			ADD_MEMORIZED_SPELL ~jasm4901~ #0 ~innate~ (1) // Vampire Form
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=8000
					hp=131
					ac=3
					thac0=11
					apr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=9
					strength=18
					exceptionalStrength=76
					intelligence=16
					wisdom=15
					dexterity=16
					constitution=18
					charisma=14
					morale=16
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~VAMPIRE~)
					class=IDS_OF_SYMBOL (~class~ ~VAMPIRE~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					moveSilent=100
					movement=10
					enforce=1
			END
			// Assigning jabm4900
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN vampir01 vampir02 ppvampir d0qpvafl sarvam02 bdvamp01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN C0PMVM1F C0PMVM1M YSCHVAM END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4900 END
			// Assigning jabm4901
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN vampir01 vampir02 ppvampir d0qpvafl sarvam02 bdvamp01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN C0PMVM1F C0PMVM1M END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4901 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~C6VAMP01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~C6VFLM01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9GGGGG~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MF444~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLF01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLM01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLM03~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFLMRF~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFVFV~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~D9MFVVV~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~VAMFLF01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~VAMFLM01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~CBGRVAMP~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~RR#VAM01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SARVAM02~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SARVAM03~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~UDVADEAD~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~UDVAMP01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~VAMPIF01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~VAMPIM01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0PMVM1F~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0PMVM1M~) BEGIN 
					WRITE_LONG 0x8 RESOLVE_STR_REF(@10356)
					WRITE_LONG 0xc RESOLVE_STR_REF(@10356)
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~YSCHVAM~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
				WRITE_SHORT 0x24 99 // hp
				WRITE_SHORT 0x26 99 // hp
				WRITE_BYTE 0x52 15 // thac0
				WRITE_BYTE 0x54 11 // saveDeath
				WRITE_BYTE 0x55 13 // saveWand
				WRITE_BYTE 0x56 12 // savePolymorph
				WRITE_BYTE 0x57 13 // saveBreath
				WRITE_BYTE 0x58 14 // saveSpell
				WRITE_BYTE 0x234 9 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#2EDVAM~) BEGIN 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA1~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA2~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA3~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#CUTVA4~) BEGIN 
				REMOVE_MEMORIZED_SPELLS
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0PMVM1F~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~C0PMVM1M~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"VAMFLF01"
	"VAMFLM01"
	"RR#VAM01"
	"C0PMVM1F"
	"C0PMVM1M"
BEGIN
	LAF jam49_patch STR_VAR file END
END
