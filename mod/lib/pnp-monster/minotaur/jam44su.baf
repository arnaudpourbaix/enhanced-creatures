// Barbarian Rage
IF
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	ActionListEmpty()
	HaveSpell(BARBARIAN_RAGE)
	See(NearestEnemyOf(Myself))
	!CheckSpellState(Myself,BARBARIAN_RAGE)
	RandomNumGT(800,80)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(Myself,BARBARIAN_RAGE)
END

// Potion of superior healing (40hp)
IF
	ActionListEmpty()
	HasItem("POTN55",Myself)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	!General(Myself,UNDEAD)
	HPPercentLT(Myself,30)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@10113)
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		UseItem("POTN55",Myself)
END

