// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)

// * Two Versions

// * 1) Dispel Enemy Protections
IF
  HaveSpell(2326)                                                             // if we have the spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
