// * WIZARD_SPELL_SHIELD {5} [SpWi519 - 2519] (protects against Anti-Protection Spells)
// * Detectable Spell
// * Requires Mod Stat.IDS file (WIZARD_SPELL_DEFLECTION, CLERIC_SHIELD_OF_THE_ARCHONS, WIZARD_SPELL_TRAP, WIZARD_SPELL_SHIELD)
IF
  HaveSpell(WIZARD_SPELL_SHIELD)                                           // and we have the spell
  CheckStatLT(Myself,1,WIZARD_SPELL_SHIELD)                                // and we aren't already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
//!HasImmunityEffects(Myself)                                   // and we don't have Generic_Immunity (which this spell conveys)
  OR(5)                                                                    // or I want to protect the protection effect that I'm under
     CheckStatGT(Myself,0,WIZARD_SPELL_TRAP)
     CheckStatGT(Myself,0,CLERIC_SHIELD_OF_THE_ARCHONS)
     CheckStatGT(Myself,0,WIZARD_SPELL_DEFLECTION)                         // and I am not already under the effects of the spell
     CheckStatGT(Myself,0,MINORGLOBE)
     HasBounceEffects(Myself)                                              // but we've got a spell-turning up
  See(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]))                          // and we see a Mage
  CheckStatGT(LastSeenBy(Myself),15,LEVEL)                                 // and the enemy spell caster is >15th level
  !Race(LastSeenBy(Myself),WYVERN)                                         // and NOT a Wyvern
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant(any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_SPELL_SHIELD)
END

