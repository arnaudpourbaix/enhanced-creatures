COPY_EXISTING ~jaim0l02.itm~ ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=232 target=1 global=1 parameter2=16 timing=2 probability1=100 special=2 STR_VAR resource="jasm0l04" END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=232 target=1 global=1 parameter2=12 timing=2 probability1=100 STR_VAR resource="jasm0l06" END
	LPF undead_trait END
	LPF nonSilverNonMagicalWeapons_immunity END

DEFINE_ACTION_FUNCTION jam0l_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#ULCWO~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~CD41WOL1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDWOLFVA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMENA1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~P#WOLF04~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFVA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFVA01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~WOLFVA1~
			REMOVE_CRE_ITEM ~BDWOLFVA~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~RING95~
			REPLACE_CRE_ITEM ~jaim0l00~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jaim0l01~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON2~ 
			ADD_CRE_ITEM ~jaim0l02~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			PATCH_DEFINE_ARRAY notEnforceFiles BEGIN DW#ULCWO END
			LPF patchCreature
				INT_VAR
					xpv=2000
					hp=76
					ac=2
					thac0=13
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=7
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					strength=18
					intelligence=6
					wisdom=12
					dexterity=13
					constitution=9
					charisma=7
					morale=14
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~WOLF~)
					class=IDS_OF_SYMBOL (~class~ ~WOLF_VAMPIRIC~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~)
					movement=19
					enforce=1
				STR_VAR
					notEnforceFiles
			END
			// Assigning jabm0l00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN VAMPWOLF BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm0l00 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~DW#ULCWO~) BEGIN 
				WRITE_SHORT 0x24 184 // hp
				WRITE_SHORT 0x26 184 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 6 // saveWand
				WRITE_BYTE 0x56 5 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 7 // saveSpell
				WRITE_BYTE 0x234 16 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~DW#ULCWO~) BEGIN 
				WRITE_LONG 0x14 9000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~CD41WOL1~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDWOLFVA~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMENA1~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~P#WOLF04~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFVA~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WOLFVA01~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"DW#ULCWO"
		"CD41WOL1"
		"BDWOLFVA"
		"P#WOLF04"
		"WOLFVA"
	BEGIN
		LAF jam0l_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"OHBMENA1"
		"WOLFVA01"
	BEGIN
		LAF jam0l_patch STR_VAR file END
	END
END