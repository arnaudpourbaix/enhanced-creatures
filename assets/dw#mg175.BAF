    !CheckStatGT(ThirdNearestEnemyOf(Myself),50,RESISTCOLD)
    CheckStatGT(ThirdNearestEnemyOf(Myself),6,SAVEVSSPELL)
THEN
    RESPONSE #150
        SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
