// Skeleton Monster
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/undead/jam98.baf~

DEFINE_ACTION_FUNCTION jam98_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~L#NIMF6~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
