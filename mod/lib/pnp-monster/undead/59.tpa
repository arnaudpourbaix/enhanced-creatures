// Generated file (don't edit)

// Greater Shadow
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/undead/jam59.baf~

DEFINE_ACTION_FUNCTION jam59_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSHADGR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSHADOW~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SDSHADOW~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~undtype~
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~shadowwp~
			REMOVE_CRE_ITEM ~s1-8~
			REMOVE_CRE_ITEM ~s1-12m2~
			REMOVE_CRE_ITEM ~ac#fpmds~
			REMOVE_CRE_ITEM ~shadowsu~
			REMOVE_CRE_ITEM ~BDSHADGR~
			REMOVE_CRE_ITEM ~BDSPECTQ~
			REMOVE_CRE_ITEM ~BDSHADGA~
			ADD_CRE_ITEM ~jai0m50~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m50~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_CRE_ITEM ~MAGE01~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=104
					ac=7
					thac0=11
					apr=4
					doubleApr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=8
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=6
					intelligence=7
					wisdom=10
					dexterity=14
					constitution=9
					charisma=8
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SHADOW~)
					class=IDS_OF_SYMBOL (~class~ ~SHADOW~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=5
					enforce=1
			END
			// Assigning jam59
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN SEWSHA03 attack BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jam59 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"BDSHADGR"
		"BDSHADOW"
	BEGIN
		LAF jam59_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"SDSHADOW"
	BEGIN
		LAF jam59_patch STR_VAR file END
	END
END