        DifficultyGT(EASIEST)
        !INI("DMWW_durlag_difficulty",0)
    GlobalTimerNotExpired("chasetimer","LOCALS")
    Global("chasePC","LOCALS",1)
    Global("inafight","LOCALS",1)
    Allegiance(Myself,ENEMY)
    InMyArea(Player1)
    !AreaCheck("ar3004")
    !AreaCheck("ar2202")
    !CheckStatGT(Player1,0,SANCTUARY)
