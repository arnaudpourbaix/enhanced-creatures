    SpellRES("A#SHA14",LastSeenBy(Myself))                                 // cast the spell
END

// * CLERIC_SYMBOL_FEAR {7} [SpPr706 - 1706] (NPF?, cs 9, rng 30, AOE 30' radius, 2R+2R/3CL, Panic STvS -4)
// * Modified STATE.IDS file (STATE_RANGED_TARGET)
// * Modified STAT.IDS file (WIZARD_RESIST_FEAR)
IF
  HaveSpell(CLERIC_SYMBOL_FEAR)                                            // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",3)                                    // and its threat-level 4
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !General(LastSeenBy(Myself),UNDEAD)                                      // and our target isn't undead
  !Race(LastSeenBy(Myself),BEHOLDER)
  !Race(LastSeenBy(Myself),WYVERN)
  !Race(LastSeenBy(Myself),KUO-TOA)
  !Race(LastSeenBy(Myself),SLIME)
  !Race(LastSeenBy(Myself),DRAGON)
  !Race(LastSeenBy(Myself),TROLL)
  !Race(LastSeenBy(Myself),RAKSHASA)
  !Race(LastSeenBy(Myself),DEMONIC)
  !Range(LastSeenBy(Myself),12)                                            // and they're quite far away
  Range(Player1,8)                                                         // and the party is all within 8 squares
  Range(Player2,8)
  Range(Player3,8)
  Range(Player4,8)
  Range(Player5,8)
  Range(Player6,8)
  HPGT(LastSeenBy(Myself),45)                                              // and the target has >45hp
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  CheckStatGT(LastSeenBy(Myself),1,SAVEVSSPELL)                            // and our target doesn't have an impossible to beat saving throw
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  !StateCheck(LastSeenBy(Myself),STATE_RANGED_TARGET)                      // and they aren't already blinded, confused, or paniced
  CheckStatLT(LastSeenBy(Myself),1,WIZARD_RESIST_FEAR)                     // and they aren't protected by the spell
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_SYMBOL_FEAR)
END

// * CLERIC_NATURE_BEAUTY {7} [SpPr704 - 1704] (PF, cs 6, tgt caster, AOE 5' radius, slay humanoid STvS +3, Save vs Spells +3 or die, blindness no save)
