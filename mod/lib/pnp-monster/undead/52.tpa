// Fear Aura
CREATE SPL "jas0m52"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m52.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10115)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPPR416C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10373)
