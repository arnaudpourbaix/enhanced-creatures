// * 4: AlwaysOn Defences:

// * GARGOYLE_BOOTS [BOOT12, Immune to Backstab, 2 Stonekskins 2/Day]
// * Requires Mod Stat.IDS file (CLERIC_PHYSICAL_MIRROR)
IF
  HasItemEquiped("BOOT12",Myself)                                          // and we have the item equipped
  CheckStatLT(Myself,1,STONESKINS)                                         // and its not already been cast.
  !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalLT("GB_UsedBOOT12","LOCALS",2)                                     // if we haven't used the item 2 times today already
  !CheckStat(Myself,1,CLERIC_PHYSICAL_MIRROR)                              // and we haven't cast Physical Mirror either in the last 24 seconds
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    UseItem("BOOT12",Myself)                                               // use the item
    IncrementGlobal("GB_UsedBOOT12","LOCALS",1)                            // increment the global by 1 each time the item is used in a day
    DisplayStringHead(Myself,65054)                                        // "Gargoyle Boots"
END

// **********************************************************************
// *           Segment Name: gs_TurnUndead.baf
// **********************************************************************

// * TURN UNDEAD
// * [Queries Turning Level, due to being set to TL0, only tries once]

// * 0: TURN_UNDEAD

// * Nearest
// * If Undead within Range 10 is *not* Panic'd/Turn'd, Turn() for 1 full round
// * Note - the ALE() is commented out - this action should take-over as soon as appropriate undead are spotted.
IF
//OR(2)                                                                                 // Xyx's Cast&Attack/GB's self-interrupting Attack
//ActionListEmpty()                                                               // if we're doing nothing
//GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")                      // or we're doing an interruptible action
  CheckStatGT(Myself,3,TURNUNDEADLEVEL)                                    // only turn if you're at least 3rd level turning
  Class(Myself,CLERIC_ALL)                                                 // and I'm a Cleric
  !Class(Myself,DRUID_ALL)                                                 // and NOT a Druid (since Druids CANNOT Turn)
  NumCreatureLT([GOODCUTOFF.UNDEAD.0.0.0.0.0],1)                           // and there are no ALLY Undead
  !ModalState(TURNUNDEAD)                                                  // and not already turning
  See(NearestEnemyOfType([EVILCUTOFF.UNDEAD.0.0.0.0.0]))                   // if we see an Undead
  !Class(LastSeenBy(Myself),ELEMENTAL_FIRE)                                // and they're not one of those pesky defined as General(UNDEAD) salamanders
  CheckStat(LastSeenBy(Myself),0,HELD)                                     // and they're not held
//!StateCheck(NearestEnemyOfType([EVILCUTOFF.UNDEAD]),STATE_PANIC)                      // and not Turn'd already
  OR(2)
     !GlobalTimerNotExpired("gh_TurnUndead","LOCALS")                      // and I have not just tried to Turn
     Range(NearestEnemyOfType([EVILCUTOFF.UNDEAD.0.0.0.0.0]),8)            // or the nearest is so close we want to try again anyway
THEN
  RESPONSE #100
    SetGlobalTimer("gh_TurnUndead","LOCALS",18)                            // set a three round, no repeat Timer
    SetInterrupt(FALSE)
    DisplayStringHead(Myself,4974)                                         // "Turn Undead"
    Turn()
    Wait(5)
    SetInterrupt(TRUE)
END

// **********************************************************************
// *           Segment Name: gs_DefencesSpecific_TL4_Mage.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 4 (MAGE)

// * PART ONE - ANTI-MAGE

// * WIZARD_SPELL_TRAP 'ds' {9} [SpWi902 - 2902] (Caster, Spell Absorption: Up to 30 Spell Lvls, Absorbs Spells of Any Lvl, 18R)
// * Requires Mod Stat.IDS File (WIZARD_SPELL_TRAP, WIZARD_SPELL_DEFLECTION, CLERIC_SHIELD_OF_THE_ARCHONS)
IF
  HaveSpell(WIZARD_SPELL_TRAP)                                             // and we have the spell
  CheckStatLT(Myself,1,WIZARD_SPELL_TRAP)                                  // and I'm not already under the effects of spell turning, spell deflection, or spell absorbtion
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Global("gh_ThreatLevel","LOCALS",4)                                      // and its threat-level 4
  CheckStatLT(Myself,1,CLERIC_SHIELD_OF_THE_ARCHONS)
  CheckStatLT(Myself,1,WIZARD_SPELL_DEFLECTION)
  CheckStatLT(Myself,1,MINORGLOBE)
  !HasBounceEffects(Myself)                                                // and not already spell-turning
  OR(4)                                                                    // and we see a spellcaster
     See(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.BARD_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.DRUID_ALL.0.0.0]))
  !Race(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]),WYVERN)                 // and NOT a Wyvern
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant(any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    DisplayStringHead(Myself,26304)                                        // "Spell Trap"
    Spell(Myself,WIZARD_SPELL_TRAP)
END

