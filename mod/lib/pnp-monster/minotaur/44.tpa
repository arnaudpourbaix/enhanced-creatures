DEFINE_ACTION_FUNCTION jam44_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~SLANDOR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#W#MI1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#W4CM1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#W4CM2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#W4CM3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#W4CM4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GAROCK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHNGHALL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~HLMAFER~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#MCMIN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VA#MINOT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#SPHMI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ICMIN01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMIN01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMINSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AMMINOT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UHOGRE03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GROMMIN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ROCK~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#NWOERX~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D0QPSY09~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			PATCH_IF NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~GROMMIN~ BEGIN
				REMOVE_MEMORIZED_SPELLS
			END
			REMOVE_CRE_ITEM ~AX1H01~
			REMOVE_CRE_ITEM ~HELMNOAN~
			REMOVE_CRE_ITEM ~HALB01~
			REMOVE_CRE_ITEM ~OHBFIG01~
			REMOVE_CRE_ITEM ~LEAT10~
			REMOVE_CRE_ITEM ~OHLEAT50~
			REMOVE_CRE_ITEM ~HALB02~
			REMOVE_CRE_ITEM ~UMBER01~
			REMOVE_CRE_ITEM ~CHAN04~
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~GAROCK~) AND (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~ROCK~) BEGIN 
				ADD_CRE_ITEM ~jai0m44~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			END
			PATCH_IF (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~GAROCK~) AND (NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~ROCK~) BEGIN 
				REPLACE_CRE_ITEM ~jai1m44~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			END
			ADD_MEMORIZED_SPELL ~jas0m44~ #0 ~innate~ (1) // Charge
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYHALBERD~ 2
			LPF patchCreature
				INT_VAR
					xpv=1400
					hp=63
					ac=6
					thac0=13
					apr=2
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=6
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					strength=18
					intelligence=6
					wisdom=16
					dexterity=11
					constitution=16
					charisma=9
					morale=13
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~MINOTAUR~)
					class=IDS_OF_SYMBOL (~class~ ~OGRE~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=10
					enforce=1
			END
			// Assigning jam44
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN OHBFIG01 VA#CRE01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MM2GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2GE DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN OHBMINSU GROMMIN OHBMINSU AMMINOT SLANDOR END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam44 END
			// Assigning jam44su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN OHBFIG01 VA#CRE01 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MM2GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2BA DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2GE DW2RM2MO DW2RS0MO dw3ms2ge GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN OHBMINSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam44su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~GAROCK~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~HLMAFER~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMIN01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMINSU~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHNGHALL~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SLANDOR~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
				WRITE_SHORT 0x24 84 // hp
				WRITE_SHORT 0x26 84 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 8 // level1
				WRITE_BYTE 0x239 50 // exceptionalStrength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMIN01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMINSU~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHNGHALL~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~HLMAFER~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~GAROCK~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~ROCK~) BEGIN 
				LPF set_movement_speed INT_VAR value=12 END
				WRITE_BYTE 0x53 1 // apr
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~) // class
				WRITE_SHORT 0x246 IDS_OF_SYMBOL (~kit~ ~BARBARIAN~) // kit
				LPF backstab_immunity END
				ADD_MEMORIZED_SPELL ~SPCL152~ #0 ~innate~ (2) 
				SET_BG2_PROFICIENCY ~PROFICIENCYHALBERD~ 5
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMIN01~) BEGIN 
				WRITE_LONG 0x14 4000 // xpv
				WRITE_SHORT 0x24 113 // hp
				WRITE_SHORT 0x26 113 // hp
				WRITE_BYTE 0x52 9 // thac0
				WRITE_BYTE 0x54 7 // saveDeath
				WRITE_BYTE 0x55 9 // saveWand
				WRITE_BYTE 0x56 8 // savePolymorph
				WRITE_BYTE 0x57 8 // saveBreath
				WRITE_BYTE 0x58 10 // saveSpell
				WRITE_BYTE 0x234 11 // level1
				LPF backstab_immunity END
				ADD_MEMORIZED_SPELL ~SPCL152~ #0 ~innate~ (1) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMINSU~) BEGIN 
				WRITE_SHORT 0x24 133 // hp
				WRITE_SHORT 0x26 133 // hp
				WRITE_BYTE 0x52 7 // thac0
				WRITE_BYTE 0x54 5 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 6 // savePolymorph
				WRITE_BYTE 0x57 5 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 13 // level1
				LPF backstab_immunity END
				ADD_MEMORIZED_SPELL ~SPCL152~ #0 ~innate~ (2) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHNGHALL~) BEGIN 
				WRITE_LONG 0x14 5000 // xpv
				WRITE_SHORT 0x24 143 // hp
				WRITE_SHORT 0x26 143 // hp
				WRITE_BYTE 0x52 7 // thac0
				WRITE_BYTE 0x54 5 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 6 // savePolymorph
				WRITE_BYTE 0x57 5 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 14 // level1
				LPF backstab_immunity END
				ADD_MEMORIZED_SPELL ~SPCL152~ #0 ~innate~ (2) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~GROMMIN~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
				WRITE_SHORT 0x24 131 // hp
				WRITE_SHORT 0x26 131 // hp
				WRITE_BYTE 0x52 5 // thac0
				WRITE_BYTE 0x54 4 // saveDeath
				WRITE_BYTE 0x55 8 // saveWand
				WRITE_BYTE 0x56 7 // savePolymorph
				WRITE_BYTE 0x57 10 // saveBreath
				WRITE_BYTE 0x58 9 // saveSpell
				WRITE_BYTE 0x234 16 // level1
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~CLERIC~) // class
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~HLMAFER~) BEGIN 
				WRITE_LONG 0x14 6000 // xpv
				WRITE_SHORT 0x24 173 // hp
				WRITE_SHORT 0x26 173 // hp
				WRITE_BYTE 0x52 3 // thac0
				WRITE_BYTE 0x54 3 // saveDeath
				WRITE_BYTE 0x55 5 // saveWand
				WRITE_BYTE 0x56 4 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 6 // saveSpell
				WRITE_BYTE 0x234 17 // level1
				LPF backstab_immunity END
				ADD_MEMORIZED_SPELL ~SPCL152~ #0 ~innate~ (3) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~GAROCK~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~ROCK~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
				WRITE_SHORT 0x24 203 // hp
				WRITE_SHORT 0x26 203 // hp
				WRITE_BYTE 0x52 1 // thac0
				WRITE_BYTE 0x54 3 // saveDeath
				WRITE_BYTE 0x55 5 // saveWand
				WRITE_BYTE 0x56 4 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 6 // saveSpell
				WRITE_BYTE 0x234 20 // level1
				WRITE_BYTE 0x239 100 // exceptionalStrength
				LPF backstab_immunity END
				ADD_MEMORIZED_SPELL ~SPCL152~ #0 ~innate~ (3) 
				SET_BG2_PROFICIENCY ~PROFICIENCYAXE~ 5
				SET_BG2_PROFICIENCY ~PROFICIENCY2WEAPON~ 3
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SLANDOR~) BEGIN 
				WRITE_LONG 0x14 10000 // xpv
				WRITE_SHORT 0x24 203 // hp
				WRITE_SHORT 0x26 203 // hp
				WRITE_BYTE 0x52 1 // thac0
				WRITE_BYTE 0x54 3 // saveDeath
				WRITE_BYTE 0x55 5 // saveWand
				WRITE_BYTE 0x56 4 // savePolymorph
				WRITE_BYTE 0x57 4 // saveBreath
				WRITE_BYTE 0x58 6 // saveSpell
				WRITE_BYTE 0x234 20 // level1
				WRITE_BYTE 0x239 100 // exceptionalStrength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMINSU~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~AMMINOT~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SLANDOR~) BEGIN 
				LPF backstab_immunity END
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHBMINSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				LPF backstab_immunity END
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"SLANDOR"
	"AC#W#MI1"
	"AC#W4CM1"
	"AC#W4CM2"
	"AC#W4CM3"
	"AC#W4CM4"
	"GAROCK"
	"OHNGHALL"
	"HLMAFER"
	"L#MCMIN"
	"VA#MINOT"
	"DW#SPHMI"
	"ICMIN01"
	"OHBMIN01"
	"OHBMINSU"
	"AMMINOT"
	"UHOGRE03"
	"GROMMIN"
	"ROCK"
	"L#NWOERX"
	"D0QPSY09"
BEGIN
	LAF jam44_patch STR_VAR file END
END