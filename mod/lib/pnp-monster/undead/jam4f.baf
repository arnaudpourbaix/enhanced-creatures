// HolySmite
IF
	Global("JA_DISABLE_SPELLCASTING","LOCALS",0)
	!StateCheck(Myself,STATE_SILENCED)
	HaveSpell(CLERIC_HOLY_SMITE)
	RandomNumGT(837,251)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See(FarthestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!Gender(LastSeenBy(Myself),SUMMONED)
	!Gender(LastSeenBy(Myself),SUMMONED_DEMON)
	!Gender(LastSeenBy(Myself),ILLUSIONARY)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)
	!ImmuneToSpellLevel(LastSeenBy(Myself),3)
	!Range(LastSeenBy(Myself),10)
	OR(4)
		!TriggerOverride(LastSeenBy(Myself),Range(NearestEnemyOf(Myself),10))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(NearestEnemyOf(Myself),99,MAGICDAMAGERESISTANCE))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(NearestEnemyOf(Myself),74,RESISTMAGIC))
		TriggerOverride(LastSeenBy(Myself),ImmuneToSpellLevel(NearestEnemyOf(Myself),3))
	OR(4)
		!TriggerOverride(LastSeenBy(Myself),Range(SecondNearestEnemyOf(Myself),10))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(SecondNearestEnemyOf(Myself),99,MAGICDAMAGERESISTANCE))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(SecondNearestEnemyOf(Myself),74,RESISTMAGIC))
		TriggerOverride(LastSeenBy(Myself),ImmuneToSpellLevel(SecondNearestEnemyOf(Myself),3))
	OR(4)
		!TriggerOverride(LastSeenBy(Myself),Range(ThirdNearestEnemyOf(Myself),10))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(ThirdNearestEnemyOf(Myself),99,MAGICDAMAGERESISTANCE))
		TriggerOverride(LastSeenBy(Myself),CheckStatGT(ThirdNearestEnemyOf(Myself),74,RESISTMAGIC))
		TriggerOverride(LastSeenBy(Myself),ImmuneToSpellLevel(ThirdNearestEnemyOf(Myself),3))
	!TriggerOverride(LastSeenBy(Myself),Range(FourthNearestEnemyOf(Myself),10))
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		Spell(LastSeenBy(Myself),CLERIC_HOLY_SMITE)
		RunAwayFromNoInterruptNoLeaveArea(LastSeenBy(Myself),10)
END

