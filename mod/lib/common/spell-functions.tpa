DEFINE_ACTION_FUNCTION create_spell_dimensionDoor BEGIN
	// Dimension Door
	CREATE SPL "SPWI402"
		WRITE_LONG 0x64 0x72
	COPY_EXISTING ~SPWI402.SPL~  ~override~
		WRITE_LONG 0x8 RESOLVE_STR_REF(@10414)
		WRITE_ASCII 0x10 ~CAS_M08~ #8
		WRITE_LONG 0x18 2048
		WRITE_SHORT 0x1c 1
		WRITE_LONG 0x1e 64
		WRITE_SHORT 0x22 10
		WRITE_BYTE 0x25 8
		WRITE_BYTE 0x27 13
		WRITE_LONG 0x34 4
		WRITE_ASCII 0x3a ~SPWI402C~ #8
		WRITE_LONG 0x50 RESOLVE_STR_REF(@10415)
		LPF ADD_SPELL_HEADER INT_VAR type=1 location=2 target=4 range=900 speed=1 STR_VAR icon="SPWI402B" END
		LPF ADD_EFFECT INT_VAR header=1 opcode=141 target=1 power=4 parameter2=38 timing=1 resist_dispel=1 probability1=100 END
		LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=1 power=4 timing=1 resist_dispel=1 probability1=100 STR_VAR resource="EFF_M09" END
		LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=1 power=4 parameter2=2 resist_dispel=1 duration=1 probability1=100 STR_VAR resource="SPDIMNDR" END
		LPF ADD_EFFECT INT_VAR header=1 opcode=124 target=1 power=4 timing=4 resist_dispel=1 duration=1 probability1=100 END
		LPF ADD_EFFECT INT_VAR header=1 opcode=20 target=1 power=4 resist_dispel=1 duration=1 probability1=100 END
		LPF CHANGE_SPELL INT_VAR     END
END
