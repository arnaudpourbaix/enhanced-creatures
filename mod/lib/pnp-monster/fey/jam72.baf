// Drowning Kiss
IF
	HaveSpellRES("jas2m72")
	StateCheck([EVILCUTOFF.HUMANOID.0.0.0.MALE],STATE_CHARMED)
	!StateCheck([EVILCUTOFF.HUMANOID.0.0.0.MALE],STATE_HELPLESS)
	RandomNumGT(801,200)
	!GlobalTimerNotExpired("JA_ROUND","LOCALS")
	See([EVILCUTOFF.HUMANOID.0.0.0.MALE])
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!General(LastSeenBy(Myself),WEAPON)
THEN
	RESPONSE #100
		SetGlobalTimer("JA_ROUND","LOCALS",6)
		MoveToObjectNoInterrupt(LastSeenBy(Myself))
		FaceObject(LastSeenBy(Myself))
		ActionOverride(LastSeenBy(Myself),FaceObject([EVILCUTOFF.0.FAIRY.FAIRY_NEREID.0.FEMALE.CHAOTIC_NEUTRAL]))
		ForceSpellRES("jas2m72",LastSeenBy(Myself))
		RemoveSpellRES("jas2m72")
END

