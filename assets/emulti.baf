// * 4: AlwaysOn Defences:

// * WIZARD_STONE_SKIN {4} [SpWi408 - 2408]
// * Requires Mod Stat.IDS file (CLERIC_PHYSICAL_MIRROR)
IF
  HaveSpell(WIZARD_STONE_SKIN)                                             // and we have Stoneskin available
  CheckStatLT(Myself,1,STONESKINS)                                         // and its not already been cast.
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  AttackedBy([ANYONE],DEFAULT)                                             // if we're being attacked
  CheckStatLT(Myself,1,CLERIC_PHYSICAL_MIRROR)                             // and we haven't cast Physical Mirror either in the last 24 seconds
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_STONE_SKIN)                                        // cast it now!
END

// *********************************************************************
// *           Segment Name: gs_CounterSpells_Priest.baf
// *********************************************************************

// * COUNTERSPELLS SNIPPET - PRIEST VERSION

// * 1. Reactions
// * 2. Anti-Spell Spells
// * 3. Always-On Defences

// * 1: REACTIONS - PRIEST SPELLS CAST AS A RESPONSE

// * (self) CLERIC_NEGATIVE_PLANE_PROTECTION {4} [SpPr413 - 1413] (@self, anti high level undead)
// * Note- no threat level check, this should *always* cast as its v.high priority
// * SELF Version
// * Detectable Spell
// * Requires Mod State.IDS file (STATE_NOT_VISIBLE)
IF
  HaveSpell(CLERIC_NEGATIVE_PLANE_PROTECTION)                              // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(3)
     See(NearestEnemyOfType([EVILCUTOFF.0.0.VAMPIRE.0.0.0]))               // and I see a level draining undead
     See(NearestEnemyOfType([EVILCUTOFF.0.0.SPECTRE.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.WRAITH.0.0.0]))
  AttackedBy(LastSeenBy(Myself),DEFAULT)                                   // and this level draining undead is attacking me
  !CheckStat(Myself,1,SCRIPTINGSTATE3)                                     // and I'm not already protected by neg-plane-prot
  !StateCheck(Myself,STATE_NOT_VISIBLE)                                    // and not invisible/impinvis
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_NEGATIVE_PLANE_PROTECTION)
END

// * (other) CLERIC_NEGATIVE_PLANE_PROTECTION {4} [SpPr413 - 1413] (@other, anti high level undead)
// * OTHER PARTY MEMBER Version
// * Detectable Spell
// * Requires Mod State.IDS file (State STATE_NOT_VISIBLE)
IF
  HaveSpell(CLERIC_NEGATIVE_PLANE_PROTECTION)                              // if I have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(3)
     See(NearestEnemyOfType([EVILCUTOFF.0.0.VAMPIRE.0.0.0]))               // and I see a level draining undead
     See(NearestEnemyOfType([EVILCUTOFF.0.0.SPECTRE.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.0.WRAITH.0.0.0]))
  See(LastAttackerOf(LastSeenBy(Myself)))                                  // and I see who they're targetting
  !CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE3)                         // and they're not already protected by neg-plane-prot
  !StateCheck(Myself,STATE_NOT_VISIBLE)                                    // and not invisible/impinvis
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(),CLERIC_NEGATIVE_PLANE_PROTECTION)
END

// * 2: Anti-Spell Spells

// * HELM_TRUE_SIGHT {1} [SpCl732 - 4732]
// * Detectable Spell
// * Requires Mod .spl File for HaveSpell() HaveSpellRES() check to work without causing crashes
// * Requires Mod Stat. IDS file (TRUE_SIGHT)
// * Requires Mod State.IDS file (STATE_ILLUSIONS)

// * (now in two versions)

// * Combo-Version : As a result of See-ing the Unseen

// * StateCheck Through 10 Enemies, look for Invis or Illusion
IF
  HaveSpell(4732)                                                             // and I have the Spell
  !CheckStat(Myself,1,TRUE_SIGHT)                                             // and aren't already under the effects of the spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  OR(7)
     SpellCast([EVILCUTOFF],WIZARD_PROJECT_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_MISLEAD)
     SpellCast([EVILCUTOFF],WIZARD_MIRROR_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_IMPROVED_INVISIBILITY)
     SpellCast([EVILCUTOFF],WIZARD_INVISIBILITY)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_ILLUSIONS) // and they're Invisible, Improved Invisible, Mirror Imaged, or Blur'd
     NumCreatureGT([EVILCUTOFF.0.0.0.0.ILLUSIONARY.0],0)                      // or there's an illusory creature around.
  !Range(NearestEnemyOf(Myself),4)                                            // and I have space to cast
THEN
  RESPONSE #10
    SetGlobalTimer("gh_PartyHasTrueSeeing","GLOBAL",66)                       // set a 1 turn+1round timer to prevent re-cast of this or a similar spell
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                        // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,4732)
    DisplayStringHead(Myself,25633)                                           // "True Sight"
END

// * CLERIC_TRUE_SIGHT {5} [SpPr505 - 1505]
// * Detectable Spell
// * Requires Mod Stat. IDS file (TRUE_SIGHT)
// * Requires Mod State.IDS file (STATE_ILLUSIONS)
IF
  HaveSpell(CLERIC_TRUE_SIGHT)                                                // and I have the Spell
  !CheckStat(Myself,1,TRUE_SIGHT)                                             // and aren't already under the effects of the spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  OR(7)
     SpellCast([EVILCUTOFF],WIZARD_PROJECT_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_MISLEAD)
     SpellCast([EVILCUTOFF],WIZARD_MIRROR_IMAGE)
     SpellCast([EVILCUTOFF],WIZARD_IMPROVED_INVISIBILITY)
     SpellCast([EVILCUTOFF],WIZARD_INVISIBILITY)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_ILLUSIONS) // and they're Invisible, Improved Invisible, Mirror Imaged, or Blur'd
     NumCreatureGT([EVILCUTOFF.0.0.0.0.ILLUSIONARY.0],0)                      // or there's an illusory creature around.
  !Range(NearestEnemyOf(Myself),4)                                            // and I have space to cast
  !StateCheck(Myself,STATE_SILENCED)                                          // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                   // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_PartyHasTrueSeeing","GLOBAL",66)                       // set a 1 turn+1round timer to prevent re-cast of this or a similar spell
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                        // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_TRUE_SIGHT)
    DisplayStringHead(Myself,25633)                                           // "True Sight"
END

// * CLERIC_DISPEL_MAGIC {3} [SpPr303 - 1303]
// * Requires Mod State.IDS File (STATE_ENCHANTED)
IF
  HaveSpell(CLERIC_DISPEL_MAGIC)                                              // if we have the spell
  !GlobalTimerNotExpired("gh_PartyHasTrueSeeing","GLOBAL")
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")                 // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                      // or I am Aura Cleansed so no wait
  OR(2)                                                                       // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                        // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")               // or we're doing an interruptible action
  OR(5)
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_INVISIBLE) // and theres an invisible enemy
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_ENCHANTED) // Mirror Image, Chant, Haste, Aid, Improved Invisibility
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_BLUR)      // or theres a Blur'd Enemy
     StateCheck(NearestEnemyOfType([EVILCUTOFF]),STATE_BLESS)     // or theres a Blessed Enemy
     CheckStatGT(NearestEnemyOfType([EVILCUTOFF]),0,STONESKINS)   // or an Enemy with Stoneskins
  !Range(LastSeenBy(Myself),8)
  Range(Player1,8)
  Range(Player2,8)
  Range(Player3,8)
  Range(Player4,8)
  Range(Player5,8)
  Range(Player6,8)
  !StateCheck(Myself,STATE_SILENCED)                                          // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                   // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #10
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                        // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_DISPEL_MAGIC)
END

