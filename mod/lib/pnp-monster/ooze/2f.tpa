COPY_EXISTING ~BDPUDDBL.cre~ ~override/jablpud.cre~
ACTION_FOR_EACH ~file~ IN
	"BDPUDDBL"
	"JABLPUD"
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDPUDDBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JABLPUD~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~HELMNOAN~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~BDPUDDBL~
			ADD_CRE_ITEM ~jai0m2f~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m2f~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai13~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=2000
					hp=120
					ac=5
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=10
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=16
					intelligence=1
					wisdom=6
					dexterity=5
					constitution=16
					charisma=1
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~GREY_OOZE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					animation=IDS_OF_SYMBOL (~animate~ ~BLACK_PUDDING~)
					movement=5
					enforce=1
			END
			// Assigning jam2f to slot General
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDPUDDBL BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=General removeScripts script=jam2f END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JABLPUD~) BEGIN 
				WRITE_LONG 0x14 1000 // xpv
				WRITE_SHORT 0x24 50 // hp
				WRITE_SHORT 0x26 50 // hp
				REMOVE_MEMORIZED_SPELLS
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END