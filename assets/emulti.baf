//    DisplayStringHead(Myself,7103)                                         // say "Potion of Strength"
END

// **********************************************************************
// *           Segment Name: gs_DefencesSpecific_TL2_Mage.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 2 (MAGE)

// * PART ONE - ANTI-MAGE

// * WIZARD_MINOR_SPELL_DEFLECTION {6} [SpWi618 - 2618]
// * Detectable Spell
// * Requires Mod Stat.IDS File (WIZARD_SPELL_DEFLECTION)
IF
  HaveSpell(WIZARD_MINOR_SPELL_DEFLECTION)                                 // and we have the spell
  CheckStatLT(Myself,1,WIZARD_SPELL_DEFLECTION)                            // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // or its threat-level 2+
//  !HasImmunityEffects(Myself)                                            // and not immune to spells
  !HasBounceEffects(Myself)                                                // and not spell-turning
  OR(5)                                                                    // and we see a spellcaster
     See(NearestEnemyOfType([0.0.0.BARD_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.DRUID_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.CLERIC_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.SORCERER.0.0.0]))
  !Race(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]),WYVERN)                 // and NOT a Wyvern
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant  (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_MINOR_SPELL_DEFLECTION)
END

// * PART TWO - ANTI-SPECIFICS

// * WIZARD_PROTECTION_FROM_PETRIFICATION {1} [SpWi108 - 2108]
// * Detectable Spell
// * Requires Mod Stat.IDS File (WIZARD_PROTECTION_FROM_PETRIFICATION)

// * must test, and expand to cast on Other PC's, once I can detect if its on or not
IF
  HaveSpell(WIZARD_PROTECTION_FROM_PETRIFICATION)                          // and we have the spell
  CheckStatLT(Myself,1,WIZARD_PROTECTION_FROM_PETRIFICATION)               // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // or its threat-level 2 +
//  !HasImmunityEffects(Myself)                                              // and not immune to spells
  !HasBounceEffects(Myself)                                                // and not spell-turning
  OR(7)
     See(NearestEnemyOfType([EVILCUTOFF.0.0.BASILISK_GREATER.0.0.0]))      // and I see a Basilisk
     See(NearestEnemyOfType([EVILCUTOFF.0.0.BASILISK.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.BEHOLDER.0.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.DRAGON.0.0.0.0]))
     See(NearestEnemyOfType([EVILCUTOFF.0.LICH.0.0.0.0]))
     See(NearestEnemyOfType([0.0.0.BARD_ALL.0.0.0]))
     See(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]))
  !Race(NearestEnemyOfType([0.0.0.MAGE_ALL.0.0.0]),WYVERN)                 // and NOT a Wyvern
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_PROTECTION_FROM_PETRIFICATION)
END

// **********************************************************************
// *           Segment Name: gs_DefencesSpecific_TL2_Priest.baf
// **********************************************************************

// * DEFENCE SPELLS - THREAT LEVEL 3 (PRIEST)

// * PART ONE - ANTI-MAGE

// * PART TWO - ANTI-SPECIFICS

// * CLERIC_PROTECTION_FROM_EVIL_10_FOOT {4} [SpPr408 - 1408] (affords all cre within 10' protection from evil)
// * Need to be careful here, do items like the Sensate Amulet count as Protected From Evil? Testing required!
// * Detectable Spell
// * Requires Mod Stat.IDS File (PROTECTION_FROM_EVIL)
IF
  HaveSpell(CLERIC_PROTECTION_FROM_EVIL_10_FOOT)
  CheckStatLT(Myself,1,PROTECTION_FROM_EVIL)                               // and I am not already under the effects of this/similar spell
  !GlobalTimerNotExpired("gh_ProtectionFromEvil","GLOBAL")                 // and we or anyone else hasn't already cast it
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // or its threat-level 2+
  OR(5)                                                                    // and we see a specific creature type
     SpellCast([ANYONE],WIZARD_CACOFIEND)
     SpellCast([ANYONE],WIZARD_SUMMON_FIEND)
     SpellCast([ANYONE],WIZARD_GATE)
     SpellCastPriest([ANYONE],CLERIC_GATE)
     See(NearestEnemyOfType([EVILCUTOFF.0.DEMONIC.0.0.0.0]))
  OR(4)
     See(Myself)                                                           // target the spell on self
     See(NearestMyGroupOfType([0.0.0.FIGHTER_ALL.0.0.0]))                  // target the spell of any PC Fighter
     See(NearestMyGroupOfType([0.0.0.RANGER_ALL.0.0.0]))                   // target the spell of any PC Ranger
     See(NearestMyGroupOfType([0.0.0.PALADIN_ALL.0.0.0]))                  // target the spell of any PC Paladin
  Range(LastSeenBy(Myself),8)                                              // and the target is within reasonable (no walking) casting range
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobalTimer("gh_ProtectionFromEvil","GLOBAL",1200)                  // 20th level caster
    Spell(LastSeenBy(Myself),CLERIC_PROTECTION_FROM_EVIL_10_FOOT)
END

// * CLERIC_PROTECTION_FROM_EVIL_10_FOOT {4} [SpPr408 - 1408] (affords all cre within 10' protection from evil)
// * Need to be careful here, do items like the Sensate Amulet count as Protected From Evil? Testing required!
// * Detectable Spell
