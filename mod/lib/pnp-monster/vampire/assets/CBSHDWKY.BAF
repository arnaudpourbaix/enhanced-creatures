IF
    Global("CbParisaHelpsNPCs","AR0300",1)  // The Docks
    Global("CbSpawnParisa","GLOBAL",2)
    See([GOODCUTOFF])
THEN
    RESPONSE #100
        Wait(2)
        MoveToObject(LastSeenBy(Myself))
        StartDialogueNoSet(LastSeenBy(Myself))
END

IF
    HPLT(Myself,10)
THEN
    RESPONSE #100
        ReallyForceSpellDead(Myself,VAMPIRE_BAT_FORM_CHANGE)  // SPIN963.SPL (No such index)
END
