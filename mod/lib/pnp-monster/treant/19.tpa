DEFINE_ACTION_FUNCTION jam19_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDTREANT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WITREANT~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1903~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1902~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1901~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1900~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BDTREANT~
			REMOVE_CRE_ITEM ~BDPLANT~
			REMOVE_CRE_ITEM ~IPSION~
			REPLACE_CRE_ITEM ~jaim1900~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaim1904~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jaic000e~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=6000
					hp=154
					ac=0
					thac0=9
					apr=2
					saveDeath=7
					saveWand=9
					savePolymorph=8
					saveBreath=8
					saveSpell=10
					level1=11
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=23
					intelligence=12
					wisdom=16
					dexterity=8
					constitution=21
					charisma=12
					morale=16
					general=IDS_OF_SYMBOL (~general~ ~PLANT~)
					race=IDS_OF_SYMBOL (~race~ ~TREANT~)
					class=IDS_OF_SYMBOL (~class~ ~NO_CLASS~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_GOOD~)
					movement=10
					enforce=1
			END
			// Assigning jabm1900
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN JACM1903 JACM1902 JACM1901 JACM1900 END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm1903 jacm1902 jacm1901 jacm1900 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm1900 END
			// Assigning jabm1901
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN JACM1903 JACM1902 JACM1901 JACM1900 END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm1903 jacm1902 jacm1901 jacm1900 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm1901 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1903~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1902~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1901~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1900~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1902~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDTREANT~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~WITREANT~) BEGIN 
				WRITE_LONG 0x14 4000 // xpv
				WRITE_SHORT 0x24 117 // hp
				WRITE_SHORT 0x26 117 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 9 // level1
				WRITE_BYTE 0x238 21 // strength
				WRITE_BYTE 0x23d 20 // constitution
				REPLACE_CRE_ITEM ~jaim1901~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1901~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
				WRITE_SHORT 0x24 91 // hp
				WRITE_SHORT 0x26 91 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 7 // level1
				WRITE_BYTE 0x238 20 // strength
				WRITE_BYTE 0x23d 20 // constitution
				REPLACE_CRE_ITEM ~jaim1902~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM1900~) BEGIN 
				WRITE_LONG 0x14 1400 // xpv
				WRITE_SHORT 0x24 65 // hp
				WRITE_SHORT 0x26 65 // hp
				WRITE_BYTE 0x52 15 // thac0
				WRITE_BYTE 0x54 11 // saveDeath
				WRITE_BYTE 0x55 13 // saveWand
				WRITE_BYTE 0x56 12 // savePolymorph
				WRITE_BYTE 0x57 13 // saveBreath
				WRITE_BYTE 0x58 14 // saveSpell
				WRITE_BYTE 0x234 5 // level1
				WRITE_BYTE 0x238 19 // strength
				WRITE_BYTE 0x23d 19 // constitution
				REPLACE_CRE_ITEM ~jaim1903~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"JACM1903"
	"JACM1902"
	"JACM1901"
	"JACM1900"
BEGIN
	LAF jam19_patch STR_VAR file END
END
