DEFINE_ACTION_FUNCTION jam4_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ESXBEA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBL01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBLSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~D9EARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GLBEAR2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PLYBEAR2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RSBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UBDBEAR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VBEARBL~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~B1-6~
			REPLACE_CRE_ITEM ~jai0m4~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai1m4~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=175
					hp=30
					ac=7
					thac0=17
					apr=2
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=3
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=15
					intelligence=4
					wisdom=12
					dexterity=10
					constitution=15
					charisma=7
					morale=9
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~BEAR~)
					class=IDS_OF_SYMBOL (~class~ ~BEAR_BLACK~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=10
					enforce=1
					perfect2weapon=1
			END
			// Assigning jam4
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BEARBLSU PLYBEAR2 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam4 END
			// Assigning jam4su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN BEARBLSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam4su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLYBEAR2~) BEGIN 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBLSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ESXBEA"
	"BDBEARBL"
	"BEARBL"
	"BEARBL01"
	"BEARBLSU"
	"D9EARBL"
	"GLBEAR2"
	"NBEARBL"
	"PLYBEAR2"
	"RSBEARBL"
	"UBDBEAR"
	"VBEARBL"
BEGIN
	LAF jam4_patch STR_VAR file END
END