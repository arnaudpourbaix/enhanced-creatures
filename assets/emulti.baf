// **********************************************************************
// *           Segment Name: gs_PreAttack_TL2_Warrior.baf
// **********************************************************************

// * PRE-ATTACK SPELLS - THREAT LEVEL TWO (Warrior)

// * Pre-Attack: Spells cast that require a physical attack to complete, or are
// * designed to enhance or assist physical attacks.

// * 2: Pre-Melee

// * WARRIOR_POWER_ATTACK {1} [SpCl906 - 4906]
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE, STATE_HARMLESS)
IF
  HaveSpell(WARRIOR_POWER_ATTACK)                                          // if I have the spell
  CheckStatLT(Myself,2,SCRIPTINGSTATE4)                                    // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and it's threat-level 3+
  NumCreatureGT([EVILCUTOFF],4)                                            // and there are 5+ monsters
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion, or Simularcrum
  HPGT(NearestEnemyOf(Myself),10)                                          // and the nearest has >20hp
  !HasBounceEffects(LastSeenBy(Myself))
  !CheckStatGT(LastSeenBy(Myself),50,RESISTMAGIC)
  !StateCheck(LastSeenBy(Myself),STATE_NOT_VISIBLE)
  !StateCheck(LastSeenBy(Myself),STATE_HARMLESS)
  !General(LastSeenBy(Myself),UNDEAD)
  !Race(LastSeenBy(Myself),SLIME)
  !Race(LastSeenBy(Myself),DRAGON)
  !Race(LastSeenBy(Myself),TROLL)
  !Race(LastSeenBy(Myself),BEHOLDER)
  Range(NearestEnemyOf(Myself),6)                                          // and they're within 4sq
  AttackedBy([ANYONE],DEFAULT)                                             // and we're under attack
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WARRIOR_POWER_ATTACK)
    DisplayStringHead(Myself,63941)                                        // "Power Attack"
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

// * WARRIOR_DEATHBLOW {1} [SpCl902 - 4902]
IF
  HaveSpell(WARRIOR_DEATHBLOW)                                             // if I have the spell
  CheckStatLT(Myself,2,SCRIPTINGSTATE4)                                     // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and it's threat-level 2+
  NumCreatureGT([EVILCUTOFF],4)                                            // and there are 5+ monsters
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion, or Simularcrum
  HPGT(NearestEnemyOf(Myself),10)                                          // and the nearest has >20hp
  !CheckStatGT(NearestEnemyOf(Myself),8,LEVEL)                             // and they are less than 8th level
  Range(NearestEnemyOf(Myself),6)                                          // and they're within 4sq
  AttackedBy([ANYONE],DEFAULT)                                             // and we're under attack
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WARRIOR_DEATHBLOW)
    DisplayStringHead(Myself,63922)                                        // "Deathblow"
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

// **********************************************************************
// *           Segment Name: gs_PolymorphSelf.baf
// **********************************************************************

// * POLYMORPH SELF ROUTINE - MAGE, THREAT LEVEL 2

// * 2: Pre-Melee

// * WIZARD_POLYMORPH_SELF {4} [SpWi416 - 2416] (multiple round close)
IF
  HaveSpell(WIZARD_POLYMORPH_SELF)                                         // and we have the spell
  !HaveSpell(2493)                                                         // and we haven't already cast it
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 2+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  OR(2)
     NumCreatureGT([EVILCUTOFF],3)                                         // and theres 4+ enemies
     HPGT(LastSeenBy(Myself),50)                                           // or the target has >50hp (single target presumption)
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  !StateCheck(Myself,STATE_SILENCED)
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_POLYMORPH_SELF)                                    // cast the spell, but don't reset the target/threat
END

// * Polymorph Behaviours here: These are only triggered when the Wizard has cast a Polymorph self and
// * assumed another form. The work in here, because HaveSPell() will always come false for all spells
// * once the wizard has assumed a polymorphed form.

// * 2: Use Polymorph to Turn into a Wolf and Run Into Melee Range

// * WIZARD_POLYMORPH_WOLF {1} [SpWi499 - 2499]
// * if they're far away, turn into a wolf, continue
IF
  HaveSpell(2499)                                                          // and I can BE a wolf
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  HPPercentGT(Myself,50)                                                   // and I have hitpoints > 50%
  !HasItem("PLYWOLF1",Myself)                                              // and I'm not already a wolf
  !Range(LastSeenBy(Myself),10)                                            // and the target is >10 steps away
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,2499)                                                     // turn into a wolf
END

// * if I'm a Wolf AND they're far away, run at them
IF
  HasItem("PLYWOLF1",Myself)                                               // and I'm a wolf
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  HPPercentGT(Myself,50)                                                   // and I have hp>50%
  !Range(LastSeenBy(Myself),10)                                            // and the target is >10 steps away
THEN
  RESPONSE #100
    MoveToObject(LastSeenBy(Myself))                                       // run at the enemy in wolf form
    Continue()
END

// * WIZARD_POLYMORPH_FLIND {1} [SpWi493 - 2493]
// * if enemy is close && threat level 2+, turn into a flind
IF
  HaveSpell(2493)                                                          // and I can turn into a flind
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 3+
  !HasItem("PLYFLIND",Myself)                                              // and I'm not already a flind
  HPPercentGT(Myself,40)                                                   // and I have greater than 50% hp
  Range(LastSeenBy(Myself),10)                                             // and the enemy is in reachable range
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,2493)                                                     // turn into a flind
END

// * WIZARD_POLYMORPH_SPIDER {1} [SpWi495 - 2495]
// * if enemy is close && threatlevel is 1, turn into a spider
IF
  HaveSpell(2495)                                                          // and we can turn into a Sword-Spider
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 3+
  !HasItem("PLYSPID",Myself)                                               // and we aren't already a Sword-Spider
  !HasItem("PLYFLIND",Myself)                                              // and we aren't already a flind
  HPPercentGT(Myself,40)                                                   // and we still have >50% hp
  Range(LastSeenBy(Myself),10)                                             // and the enemy is closer
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,2495)                                                     // turn into a spider
END

// * WIZARD_POLYMORPH_WOLF {1} [SpWi499 - 2499]
// * If the enemy is close, and I'm wounded, turn into a Wolf and run away
IF
  HaveSpell(2499)                                                          // and we can turn into a wolf
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  !HasItem("PLYWOLF1",Myself)                                              // and we're not already a wolf
  HPPercentLT(Myself,40)                                                   // and our hp fall below 40%
  Range(LastSeenBy(Myself),10)                                             // and the enemy is in melee range
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,2499)                                                     // turn into a wolf
    Shout(HELP)                                                            // trigger "assists" from other PC's
//    DisplayStringHead(Myself,3786)                                         // scream for help visibly
    RunAwayFrom(LastAttackerOf(Myself),75)                                 // run away
END

// * Attack!
// * If the enemy is close, and I'm NOT wounded, and I'm a Spider OR a Flind, HIT THEM!
IF
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  OR(2)
     HasItem("PLYFLIND",Myself)                                            // and we're polymorphed into either a spider or a flind
     HasItem("PLYSPID",Myself)
  Range(LastSeenBy(Myself),10)                                             // and the enemy is in melee range
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

// * WIZARD_POLYMORPH_NATURAL_FORM {1} [SpWi490 - 2490]
// * Revert to Normal Form!
// * If there aren't any more enemies, turn back into Myself
IF
  HaveSpell(2490)
  ActionListEmpty()                                                        // if we're doing nothing
  CombatCounter(0)
  !See(NearestEnemyOf(Myself))
  CheckStatGT(Myself,0,POLYMORPHED)
//  OR(3)
//     HaveSpell(POLYMORPH_NATURAL_FORM2)
//     HaveSpell(POLYMORPH_NATURAL_FORM3)
THEN
  RESPONSE #100
    Spell(Myself,2490)
//    Spell(Myself,POLYMORPH_NATURAL_FORM2)
//    Spell(Myself,POLYMORPH_NATURAL_FORM3)
END

// **********************************************************************
// *           Segment Name: gs_Charms_TL1_Mage.baf
// **********************************************************************

// * CHARM SPELLS - THREAT LEVEL ONE (Mage)

// * 1: Charms

// * WIZARD_CHARM_PERSON {1} [SpWi104 - 2104] (Charm Humanoid, Save vs. Spells +3 neg)
// * Requires Mod Stat.IDS File (WIZARD_IMPROVED_ALACRITY)
IF
  HaveSpell(WIZARD_CHARM_PERSON)                                           // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 1+
  NumCreatureGT([EVILCUTOFF],2)                                            // and theres 3+ enemies
  CheckStatGT(LastSeenBy(Myself),8,SAVEVSSPELL)                            // and our target doesn't have an impossible to beat saving throw
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >20hp
  General(LastSeenBy(Myself),HUMANOID)                                     // and they're HUMANOID
  Range(LastSeenBy(Myself),12)                                             // and range is <12 steps away
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
  !HasItemEquiped("IMMCHS",LastSeenBy(Myself))                             // and they don't have the game-item that gives immunity to charms, holds and sleep
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_CHARM_PERSON)
END

