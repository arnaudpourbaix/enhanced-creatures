  CheckStatGT(Myself,14,LEVEL)                                             // and I'm greater than 14th level
  !GlobalTimerNotExpired("gh_NoSummons","GLOBAL")                          // and there aren't any summon-preventing effects
  NumCreatureLT([GOODCUTOFF.0.0.0.0.SUMMONED.0],5)                         // and the number of summoned helpers is <6
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_ANIMATE_DEAD)
END

