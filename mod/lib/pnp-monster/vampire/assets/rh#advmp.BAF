IF
    Global("C6BodhiFight","AR0809",1)  // Bodhi's Lair (Abduction Plot, getting Imoen's soul)
    Allegiance(Myself,NEUTRAL)
THEN
    RESPONSE #100
        Enemy()
END

IF
    Die()
THEN
    RESPONSE #100
        SetGlobal("rh#AdrianVampire","GLOBAL",3)
        DropInventory()
        DestroySelf()
END
