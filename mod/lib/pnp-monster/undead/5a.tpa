// Baneguard traits
CREATE ITM "jai0m5a"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10922)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10922)
