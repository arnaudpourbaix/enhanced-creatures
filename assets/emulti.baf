// **********************************************************************
// *           Segment Name: gs_Attacks_Innate.baf
// **********************************************************************

// * INNATE SPELLS USED AS AN ATTAC - Bhall Powers, Class/Race Abilities

// * INNATE_VAMPIRIC_TOUCH {1} [SpIn106 - 3106] (Bhaalspawn Innate: single, touch, 1d6 MAGIC/2 caster levels, max 6-36, no save)
IF
  HaveSpell(3106)                                                          // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 2+
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  Range(LastSeenBy(Myself),8)                                              // and they're within 8 sq [therefore, melee]
  HPGT(LastSeenBy(Myself),20)                                              // and the target has >20hp
  HPPercentLT(Myself,75)                                                   // and I've lost some hitpoints
  CheckStatLT(LastSeenBy(Myself),51,MAGICDAMAGERESISTANCE)                 // and they are not overly resistant to magical damage
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),3106)
END

// * INNATE_HORROR {1} [SpIn105 - 3105] (Bhaalspawn Innate: AOE 30' cube, break morale + panic, save vs spells +2)
IF
  HaveSpell(3105)                                                          // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // and its threat-level 2+
  HPGT(LastSeenBy(Myself),15)                                              // and the target has >25hp
  CheckStatGT(LastSeenBy(Myself),7,SAVEVSSPELL)                            // and our target doesn't have an impossible to beat saving throw
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  !General(LastSeenBy(Myself),UNDEAD)                                      // and they're not Undead
  Range(LastSeenBy(Myself),12)                                             // and range is <12 steps away, therefore semi-safe
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),3105)
END

// * INNATE_LARLOCHS_MINOR_DRAIN {1} [SpIn104 - 3104] [Bhaalspawn Innate: 1d4 vampiric-touch, no save]
IF
  HaveSpell(3104)                                                          // and we have the spell memorised
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 1+
  NumCreatureGT([EVILCUTOFF],1)                                            // and there are 2+ monsters
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  HPGT(LastSeenBy(Myself),5)                                               // and the target has >5hp
  Range(LastSeenBy(Myself),10)                                             // and the target is within 10 sq
  !HasBounceEffects(LastSeenBy(Myself))                                    // and the target isn't Spell-Turning
  CheckStatLT(LastSeenBy(Myself),1,MAGICDAMAGERESISTANCE)                  // and they're not resistant to magical damage
  CheckStatLT(LastSeenBy(Myself),76,RESISTMAGIC)                           // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",LastSeenBy(Myself))                            // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",LastSeenBy(Myself))                               // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),3104)
END

// * INNATE_DRAW_UPON_HOLY_MIGHT {1} [SpIn103 - 3103] (Bhaalspawn Innate: +1 to STR, DEX, & CON /3CL, 1 turn]
IF
  HaveSpell(3103)                                                          // and I have the ability
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 1+
  NumCreatureGT([EVILCUTOFF],3)                                            // and there are 4+ enemies
  !StateCheck(Myself,STATE_DRAWUPONHOLYMIGHT)                              // and I haven't ALREADY cast it
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  Range(LastSeenBy(Myself),8)                                              // and the target is in melee range
  HPGT(LastSeenBy(Myself),25)                                              // and the target has >25 hp
  !Range(NearestEnemyOf(Myself),4)                                         // and I have space to cast
  !AttackedBy([ANYONE],DEFAULT)                                            // if we're NOT being attacked, because this spell takes forever to cast
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,3103)                                                     // then beef myself up
END

// **********************************************************************
// *           Segment Name: gs_TargetNearestFirst.baf
// **********************************************************************

// * TARGETING ROUTINE - NEAREST TO FURTHEST
// * [Fighter/Melee Style]

// * Requires Mod State.IDS file (STATE_HARMLESS)

// * Melee/Missile Target-Choice
// * ---------------------------

// * Start by "clearing" the LastSeenBy()
IF
  See(Myself)
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 10+ Targets, determine if we can target the 10th
IF
  NumCreatureGT([EVILCUTOFF],9)                                            // if there is at least 10 monsters
  !InParty(TenthNearestEnemyOf(Myself))                                    // and they're not in our party
  HPGT(TenthNearestEnemyOf(Myself),5)                                      // and have more than 5 hp
  !StateCheck(TenthNearestEnemyOf(Myself),STATE_HARMLESS)                  // and not charmed, helpless,sleeping,feebleminded or stunned
  See(TenthNearestEnemyOf(Myself))                                         // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 9+ Targets, determine if we can target the 9th
IF
  NumCreatureGT([EVILCUTOFF],8)                                            // if there is at least 9 monsters
  !InParty(NinthNearestEnemyOf(Myself))                                    // and they're not in our party
  HPGT(NinthNearestEnemyOf(Myself),5)                                      // and have more than 5 hp
  !StateCheck(NinthNearestEnemyOf(Myself),STATE_HARMLESS)                  // and not charmed, helpless,sleeping,feebleminded or stunned
  See(NinthNearestEnemyOf(Myself))                                         // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 8+ Targets, determine if we can target the 8th
IF
  NumCreatureGT([EVILCUTOFF],7)                                            // if there is at least 8 monsters
  !InParty(EighthNearestEnemyOf(Myself))                                   // and they're not in our party
  HPGT(EighthNearestEnemyOf(Myself),5)                                     // and have more than 5 hp
  !StateCheck(EighthNearestEnemyOf(Myself),STATE_HARMLESS)                 // and not charmed, helpless,sleeping,feebleminded or stunned
  See(EighthNearestEnemyOf(Myself))                                        // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 7+ Targets, determine if we can target the 7th
IF
  NumCreatureGT([EVILCUTOFF],6)                                            // if there is at least 7 monsters
  !InParty(SeventhNearestEnemyOf(Myself))                                  // and they're not in our party
  HPGT(SeventhNearestEnemyOf(Myself),5)                                    // and have more than 5 hp
  !StateCheck(SeventhNearestEnemyOf(Myself),STATE_HARMLESS)                // and not charmed, helpless,sleeping,feebleminded or stunned
  See(SeventhNearestEnemyOf(Myself))                                       // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 6+ Targets, determine if we can target the 6th
IF
  NumCreatureGT([EVILCUTOFF],5)                                            // if there is at least 6 monsters
  !InParty(SixthNearestEnemyOf(Myself))                                    // and they're not in our party
  HPGT(SixthNearestEnemyOf(Myself),5)                                      // and have more than 5 hp
  !StateCheck(SixthNearestEnemyOf(Myself),STATE_HARMLESS)                  // and not charmed, helpless,sleeping,feebleminded or stunned
  See(SixthNearestEnemyOf(Myself))                                         // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 5+ Targets, determine if we can target the 5th
IF
  NumCreatureGT([EVILCUTOFF],4)                                            // if there is at least 5 monsters
  !InParty(FifthNearestEnemyOf(Myself))                                    // and they're not in our party
  HPGT(FifthNearestEnemyOf(Myself),5)                                      // and have more than 5 hp
  !StateCheck(FifthNearestEnemyOf(Myself),STATE_HARMLESS)                  // and not charmed, helpless,sleeping,feebleminded or stunned
  See(FifthNearestEnemyOf(Myself))                                         // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 4+ Targets, determine if we can target the 4th
IF
  NumCreatureGT([EVILCUTOFF],3)                                            // if there is at least 4 monsters
  !InParty(FourthNearestEnemyOf(Myself))                                   // and they're not in our party
  HPGT(FourthNearestEnemyOf(Myself),5)                                     // and have more than 5 hp
  !StateCheck(FourthNearestEnemyOf(Myself),STATE_HARMLESS)                 // and not charmed, helpless,sleeping,feebleminded or stunned
  See(FourthNearestEnemyOf(Myself))                                        // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 3+ Targets, determine if we can target the 3rd
IF
  NumCreatureGT([EVILCUTOFF],2)                                            // if there is at least 3 monsters
  !InParty(ThirdNearestEnemyOf(Myself))                                    // and they're not in our party
  HPGT(ThirdNearestEnemyOf(Myself),5)                                      // and have more than 5 hp
  !StateCheck(ThirdNearestEnemyOf(Myself),STATE_HARMLESS)                  // and not charmed, helpless,sleeping,feebleminded or stunned
  See(ThirdNearestEnemyOf(Myself))                                         // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there are 2+ Targets, determine if we can target the 2nd
IF
  NumCreatureGT([EVILCUTOFF],1)                                            // if there is at least 2 monsters
  !InParty(SecondNearestEnemyOf(Myself))                                   // and they're not in our party
  HPGT(SecondNearestEnemyOf(Myself),5)                                     // and have more than 5 hp
  !StateCheck(SecondNearestEnemyOf(Myself),STATE_HARMLESS)                 // and not charmed, helpless,sleeping,feebleminded or stunned
  See(SecondNearestEnemyOf(Myself))                                        // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// * If there is at least 1 target, determine if we can target the nearest
IF
  NumCreatureGT([EVILCUTOFF],0)                                            // if there is at least 1 monsters
  !InParty(NearestEnemyOf(Myself))                                         // and they're not in our party
  HPGT(NearestEnemyOf(Myself),5)                                           // and have more than 5 hp
  !StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)                       // and not charmed, helpless,sleeping,feebleminded or stunned
  See(NearestEnemyOf(Myself))                                              // then they're our new target
  False()
THEN
  RESPONSE #100
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_TargetHelpCaller.baf
// **********************************************************************

// * TARGETING ROUTINE - TARGET ALLY WHO CALLED FOR HELP

// * Requires Mod State.IDS file (STATE_NOT_VISIBLE, STATE_HARMLESS)

// * If another PC called for help, target their attacker
IF
  OR(2)
     Heard([PC.0.0.0.0.0.0],HELP)                                          // if a PC needs Help
     Heard([PC.0.0.0.0.0.0],2001)                                          // if a PC needs Help
  !InParty(LastAttackerOf(LastHeardBy(Myself)))                            // and they're not in our party
  !StateCheck(LastAttackerOf(LastHeardBy(Myself)),STATE_NOT_VISIBLE)       // and not invisible/impinvis
  !StateCheck(LastAttackerOf(LastHeardBy(Myself)),STATE_HARMLESS)          // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(LastAttackerOf(LastHeardBy(Myself)),INNOCENT)                     // and not an "innocent"
  See(LastAttackerOf(LastHeardBy(Myself)))                                 // they're our new target
THEN
  RESPONSE #100
//    DisplayStringHead(Myself,45363)                                        // "Cease your screaming! You are not helping my nerves with your shouts!"
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_TargetAttackerOfSelf.baf
// **********************************************************************

// * TARGETING ROUTINE - TARGET ATTACKER OF SELF

// * Requires Mod State.IDS file (STATE_NOT_VISIBLE, STATE_HARMLESS)

// * If we're under attack, use that as the Target instead of all others
IF
  AttackedBy([ANYONE],DEFAULT)                                             // if we are being attacked
  !InParty(LastAttackerOf(Myself))                                         // and they're not in our party
  !StateCheck(LastAttackerOf(Myself),STATE_NOT_VISIBLE)                    // and not invisible/impinvis
  !StateCheck(LastAttackerOf(Myself),STATE_HARMLESS)                       // and not charmed, helpless,sleeping,feebleminded or stunned
  !Class(LastAttackerOf(Myself),INNOCENT)                                  // and not an "innocent"
  See(LastAttackerOf(Myself))                                              // they're our new target
THEN
  RESPONSE #100
    Continue()
END

// **********************************************************************
// *           Segment Name: gs_PreMissile.baf
// **********************************************************************

// * Pre-Missile Attack Activity, re-equip ammo, etc

// * 0: Pre-Missile

// * WIZARD_MELF_METEOR {3} [SpWi325 - 2325]
// * Works for Melfs Minute Meteors because they have a very long duration
IF
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  HaveSpell(WIZARD_MELF_METEOR)                                            // if we have the spell
  !HasItemSlot(Myself,SLOT_MISC19)                                         // more robust check to see if I already have anything in the magically created item slot
//  !HasItem("MELFMET",Myself)                                               // but we have no Melf's Minute Meteors in our hands
//  !HasItem("ENEBLADE",Myself)                                              // but we have no Energy Blades in our hands
  !Range(NearestEnemyOf(Myself),4)                                         // and we have casting room
  !CombatCounter(0)                                                        // and combat is *not* over
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_MELF_METEOR)
END

// **********************************************************************
// *           Segment Name: gs_BackStab.baf
// **********************************************************************

// * [March 24, 2003] Made a slight change to the first segment and removed ! from in
// * front of CombatCounter(0) to reflect Len's example.  Also added a bunch of
// * display head strings to see how this thing is actually working since Imoen doesn't
// * seem to want to switch weapons....eThief seems to be okay because Yoshimo never
// * exhibited a problem that I recall.  So maybe it is something to do with eMage or
// * eMulti.

// * 0: Aquire Target and Follow

// * STEALTH ATTACK
// * Requires Mod Kit.IDS file
IF
  ActionListEmpty()
  OR(2)
     Class(Myself,THIEF_ALL)                                               // if I'm a Thief or Multiclass Thief
     Kit(Myself,STALKER)                                                   // if I'm a Stalker
  CheckStatGT(Myself,1,BACKSTABDAMAGEMULTIPLIER)                           // if I have enough thief levels that I can do some serious damage
  !CombatCounter(0)                                                        // if combat has started (thus I'm not out scouting on my own)
  StateCheck(Myself,STATE_NOT_VISIBLE)                                     // and I'm invisible or improved invisible
  Global("EK_BackStab","LOCALS",0)                                         // and no flag has been set
  !InParty(LastSeenBy(Myself))                                             // target is not in party
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !General(LastSeenBy(Myself),UNDEAD)                                      // and the target is not undead because they are immune to backstabs
  !Race(LastSeenBy(Myself),DRAGON)                                         // and the target is not a dragon because they are immune to backstabs
  !Race(LastSeenBy(Myself),GOLEM)                                          // and the target is not a golem because they are immune to backstabs
  OR(2)
     !Kit(LastSeenBy(Myself),BARBARIAN)                                    // or the target is not a barbarian because they are immune to backstabs
     Class(LastSeenBy(Myself),SORCERER)                                    // or the target is a sorcerer, because they have the same Kit ID as a Barbarian, but they aren't immune to backstab
//!HasItemEquiped("BOOT12",LastSeenBy())                                   // and the target does not have the item equipped because it provides immunity to backstab
  Range(LastSeenBy(Myself),8)                                              // and the target is reachable range, and no area effects are likely
THEN
  RESPONSE #100
    EquipMostDamagingMelee()                                               // equip melee weapon
    SetGlobal("EK_BackStab","LOCALS",1)                                    // set ready for backstab flag
    FollowObjectFormation(LastSeenBy(Myself),1,3)                          // get behind them
    DisplayStringHead(Myself,835)                                          // "Follow mode on"
END

// * 1: Attack Selected Target When In Melee Range

// * STEALTH ATTACK
// * Requires Mod Kit.IDS file
// * Requires Mod State.IDS file (STATE_NOT_VISIBLE)
IF
  OR(2)
     Class(Myself,THIEF_ALL)                                               // if I'm a Thief or Multiclass Thief
     Kit(Myself,STALKER)                                                   // or I'm a Stalker
  CheckStatGT(Myself,1,BACKSTABDAMAGEMULTIPLIER)                           // and I am high enough level to receive a bonus for backstabbing
  !CombatCounter(0)                                                        // and combat has started (thus I'm not out scouting on my own)
  StateCheck(Myself,STATE_NOT_VISIBLE)                                     // and I'm invisible or improved invisible
  Global("EK_Backstab","LOCALS",1)                                         // and the ready for backstab flag has been set
  !InParty(LastSeenBy(Myself))                                             // and the target is not in  our party
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  !General(LastSeenBy(Myself),UNDEAD)                                      // and the target is not undead because they are immune to backstabs
  !Race(LastSeenBy(Myself),DRAGON)                                         // and the target is not a dragon because they are immune to backstabs
  !Race(LastSeenBy(Myself),GOLEM)                                          // and the target is not a golem because they are immune to backstabs
  OR(2)
     !Kit(LastSeenBy(Myself),BARBARIAN)                                    // or the target is not a barbarian because they are immune to backstabs
     Class(LastSeenBy(Myself),SORCERER)                                    // or the target is a sorcerer, because they have the same Kit ID as a Barbarian, but they aren't immune to backstab
//!HasItemEquiped("BOOT12",LastSeenBy())                                   // and the target does not have the item equipped because it provides immunity to backstab
  Range(LastSeenBy(Myself),1)                                              // and target is within the striking range of a non-2handed melee weapon
THEN
  RESPONSE #100
    DisplayStringHead(Myself,8549)                                         // "Die you bastard!"
    SetGlobal("EK_BackStab","LOCALS",0)                                    // reset ready for backstab flag
    AttackOneRound(LastSeenBy(Myself))                                     // whack them hard
    MoveToObject(StrongestOf(Myself))                                      // and run away back towards party
END

// * 2: Reset ready for backstab flag, if the block above does not execute
IF
  !CombatCounter(0)                                                        // if combat has started
  Global("EK_BackStab","LOCALS",1)                                         // and we *were* ready to backstab
THEN
  RESPONSE #100
    DisplayStringHead(Myself,30747)                                        // "Next time."
    SetGlobal("EK_BackStab","LOCALS",0)                                    // reset ready flag
    Continue()                                                             // continue with script
END

// **********************************************************************
// *           Segment Name: gs_BattleSong_Bard.baf
// **********************************************************************

// * The segment is designed to be interruptable, so that if a more important task
// * liking Breaching an enemy spell casters spell protections comes along, the bard will 
// * stop singing and attempt to handle the situation.

// * Bard - Battle Song
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)
IF
//  OR(2)
//    !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")               // and I am ready to cast.
//     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  Class(Myself,BARD_ALL)                                                   // and I am a bard
  !ModalState(BATTLESONG)                                                  // and I am not already singing my battlesong
  !StateCheck(Myself,STATE_SILENCED)                                       // and I have not been silenced
  !StateCheck(Myself,STATE_NOT_VISIBLE)
  OR(3)
     Range(Player1,8)
     Range(Player3,8)
     Range(Player6,8)
  OR(3)
     Range(Player2,8)
     Range(Player4,8)
     Range(Player5,8)
  !AttackedBy([ANYONE],DEFAULT)                                            // if we are not under attack
THEN
  RESPONSE #100
    DisplayStringHead(Myself,50705)                                        // "Singing Battlesong"
//    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    BattleSong()                                                           // Begin singing Battlesong
    Wait(2)                                                                // Wait a bit for the Battlesong to take effect
END

// **********************************************************************
// *           Segment Name: gs_SelectRangedThenMelee_ItemList.baf
// **********************************************************************

// * Notes:  TargetUnreachable seems to happen more often that one might think.  I believe if
// *         the character cannot reach LastSeenBy(), such as in the case of when they are
// *         surrounded by other NPCs, then that counts as TargetUnreachable()

// * SELECT RANGED_WEAPON, if you have one in a quickslot


IF
  !GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")              // if we're still on our timer, & attacking--no need to add more time
  OR(2)
    Global("hlid_UseRangedWeapon","LOCALS",1)                              // or the global, hlid_UseRangedWeapon, is set to 1
    Global("gh_MeleeMissileToggle","LOCALS",0)                             // 1=Fire a Missile, we checked clean against them last block
  !HasItemSlot(Myself,SLOT_SHIELD)                                         // engine limitation--cannot EquipRanged() with shield equipped
  !Range(LastSeenBy(Myself),4)                                             // range is >4 steps away, therefore ranged
  !InWeaponRange(LastSeenBy(Myself))                                       // and my current wepaon won't reach there
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !CombatCounter(0)                                                        // and combat is *not* over
  THEN
  RESPONSE #100
    SetGlobal("gh_MeleeMissileToggle","LOCALS",1)                          // 1=Missile
    EquipRanged()                                                          // Equip ranged weapon
    SmallWait(3)
    Continue()                                                             // and Continue to ranged weapons check block
END


// * SELECT MELEE ATTACK
IF
  !GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")              // if we're still on our timer, & attacking--no need to add more time
  OR(2)
    Global("hlid_UseRangedWeapon","LOCALS",0)                              // or the global, hlid_UseRangedWeapon, is set to 1
    Range(LastSeenBy(Myself),4)                                            // range is closer than 4 steps, therefore melee
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Class(Myself,MONK)                                                      // and we're not a monk
THEN
  RESPONSE #100
    SetGlobal("gh_MeleeMissileToggle","LOCALS",0)                          // 0=Melee
    EquipMostDamagingMelee()                                               // equip nasty Weapon
    SmallWait(3)
    Continue()                                                             // and Continue() to Attack() routine
END

IF
  !GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")              // if we're still on our timer, & attacking--no need to add more time
  Global("gh_MeleeMissileToggle","LOCALS",1)                               // 1=Fire a Missile, we checked clean against them last block
  Range(LastSeenBy(Myself),20)                                             // & we can still see them, and within dart range (minimum ranged weapon reach)
  !Range(LastSeenBy(Myself),4)                                             // range is >4 steps away, definitely for ranged attack
  OR(2)
    Global("hlid_UseRangedWeapon","LOCALS",0)                              // either the global, hlid_UseRangedWeapon, is set to 0
    !InWeaponRange(LastSeenBy(Myself))                                     // or they're not in range = we have no ranged weapon
  !CombatCounter(0)                                                        // and combat is *not* over
  THEN
  RESPONSE #100
    SetGlobal("gh_MeleeMissileToggle","LOCALS",0)                          // 1=Missile
    EquipMostDamagingMelee()                                               // Equip melee weapon instead                                                      // "Missile Weapons"
    SmallWait(3)
    Continue()                                                             // and Continue to Attack() routine
END

IF
  !GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")              // if we're still on our timer, & attacking--no need to add more time
  !Range(LastSeenBy(Myself),20)                                            // we're outside of dart range
  !InWeaponRange(LastSeenBy(Myself))                                       // and our weapon isn't "long" enough
  See(NearestEnemyOf(Myself))                                              // and we can see our nearest opponent
THEN
  RESPONSE #100
    Continue()                                                              //take whatever is in hand, and head to the attack block
END

// **********************************************************************
// *           Segment Name: gs_Attack_Stand_Ground.baf
// **********************************************************************

// * ATTACK CLAUSE

// * "Force" Reevaluation Clause of Attack()
// * ----------------------------------------
// * Thanks to Gebhard Blucher & Jochem for the source and inspiration for these bits :)

// * Attack if RangedWeapon Equipped *OR* At Melee Range
IF
  ActionListEmpty()                                                        // not doing a thing...
  !GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")              // if we're still on our timer, & attacking--no need to add more time
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and they're not in our party (double-check)
  Detect([EVILCUTOFF])
THEN
  RESPONSE #100
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",6)                  // set a 18-sec timer to indicate action is interruptable
    AttackOneRound(LastSeenBy(Myself))                                     // Attack()--if time expires, we reevaluate
END

// * Minimum Catch-All Attack
// * This is invoked if targetting produced no valid targets, and thus the LastSeenBy() is empty
// * but Combat is still going. This is usually when there are only targets left that
// * qualify as "helpless". I'm not so bothered about losing the attacks here, so I continue
// * to use AttackOneRound()

// * MINIMUM ATTACK
IF
  ActionListEmpty()
  See(NearestEnemyOf(Myself))                                              // but we can still see AN enemy
  !InParty(LastSeenBy(Myself))                                             // and they're not in our party (double-check)
  !Allegiance(LastSeenBy(Myself),GOODCUTOFF)                               // and not an Ally, Familiar, Minion or Simulacrum
  OR(2)
     Range(LastSeenBy(Myself),6)                                           // and they're at <6 Range
     Global("gh_MeleeMissileToggle","LOCALS",1)                            // or we've a Missile Weapon Equipped
THEN
  RESPONSE #100
    AttackOneRound(NearestEnemyOf(Myself))                                 // and attack
END

