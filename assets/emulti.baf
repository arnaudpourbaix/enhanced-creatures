// * DEFENCE SPELLS - THREAT LEVEL 3 (MAGE)

// * PART ONE - ANTI-MAGE

// * 3: Anti-Mage Defences

// * WIZARD_PROTECTION_FROM_ENERGY 'ds' {8} [SpWi803 - 2803] (Touch, 1 CRE, 75% Resistance to Elemental and MAGIC dmg, 1R/CL)
// * Requires Mod Stat.IDS File (WIZARD_PROTECTION_FROM_ENERGY)
IF
  HaveSpell(WIZARD_PROTECTION_FROM_ENERGY)                                 // and we have the spell
  CheckStatLT(Myself,1,WIZARD_PROTECTION_FROM_ENERGY)                      // and I am not already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // or its threat-level 3+
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  OR(11)                                                                   // and I see a big fire, cold or electricity using beatie
     See(TenthNearest([EVILCUTOFF.0.0.BARD_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.DRUID_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.CLERIC_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.MAGE_ALL.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.ELEMENTAL_FIRE.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.GENIE_EFREETI.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.0.GENIE_NOBLE_EFREETI.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.DRAGON.0.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.BEHOLDER.0.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.LICH.0.0.0.0]))
     See(TenthNearest([EVILCUTOFF.0.DEMILICH.0.0.0.0]))
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_PROTECTION_FROM_ENERGY)
END

