DEFINE_ACTION_FUNCTION jam5d_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDGHOSTM~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DAITEL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDLITLA~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~bdringgh~
			REMOVE_CRE_ITEM ~bdghost~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~ring94~
			REMOVE_CRE_ITEM ~ghost~
			REMOVE_CRE_ITEM ~helm15~
			ADD_CRE_ITEM ~jai0m5d~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m5d~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~jas0m5d~ #0 ~innate~ (1) // Fear Aura
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=7000
					hp=120
					ac=0
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=10
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=7
					intelligence=14
					wisdom=12
					dexterity=13
					constitution=9
					charisma=17
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SPECTRE~)
					class=IDS_OF_SYMBOL (~class~ ~SPECTRE~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					movement=7
					enforce=1
			END
			// Assigning jam5d
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN bdghost shoutdl2 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=jam5d END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDLITLA~) BEGIN 
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"BDGHOSTM"
	"DAITEL"
	"BDLITLA"
BEGIN
	LAF jam5d_patch STR_VAR file END
END