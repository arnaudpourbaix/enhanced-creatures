// Generated file (don't edit)

// Doom Sayer
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/construct/jam42.baf~

DEFINE_ACTION_FUNCTION jam42_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~DOOMSA~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~HELM08~
			REMOVE_CRE_ITEM ~HELM01~
			REMOVE_CRE_ITEM ~SHLD18~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~RING98~
			REMOVE_CRE_ITEM ~BLUN08~
			REMOVE_CRE_ITEM ~FBLADE~
			REMOVE_CRE_ITEM ~PLAT07~
			REMOVE_CRE_ITEM ~HELM13~
			REMOVE_CRE_ITEM ~SW1H11~
			ADD_CRE_ITEM ~jai0mf~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai0f6~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jai2f6~ #0 #0 #0 ~UNDROPPABLE~ ~ARMOR~ 
			REPLACE_CRE_ITEM ~jai3f6~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_CRE_ITEM ~jai2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jai11~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~SPWI112~ #0 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~SPWI402~ #3 ~wizard~ (1) // Dimension Door
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 2
			LPF patchCreature
				INT_VAR
					xpv=4000
					hp=100
					ac=2
					thac0=11
					apr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=8
					level2=3
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=20
					intelligence=14
					wisdom=10
					dexterity=13
					constitution=9
					charisma=10
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~FIGHTER_MAGE~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					animation=IDS_OF_SYMBOL (~animate~ ~FIGHTER_MALE_HUMAN~)
					metalColor=63
					minorColor=63
					majorColor=63
					skinColor=63
					leatherColor=63
					armorColor=63
					hairColor=63
					movement=10
					enforce=1
			END
			// Assigning jam42
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp=~DW#GP.+|DW#MG.+|DW1.+|DW2.+|DW3.+~ script=jam42 END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"DOOMSA"
BEGIN
	LAF jam42_patch STR_VAR file END
END