			ADD_MEMORIZED_SPELL ~SPWI402~ #3 ~wizard~ (1) // Dimension Door
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 2
			LPF patchCreature
				INT_VAR
					xpv=4000
					hp=100
					ac=2
					thac0=11
					apr=1
					saveDeath=10
					saveWand=12
					savePolymorph=11
