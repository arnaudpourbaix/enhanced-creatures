DEFINE_ACTION_FUNCTION jam36_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~SHOAL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNEREID~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDPWATER~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ANSIRENE~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RE_MEKRN~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~WALLPASS~
			REMOVE_CRE_ITEM ~DAGG01~
			ADD_CRE_ITEM ~jaim3600~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~jaic0005~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jasm3601~ #0 ~innate~ (1) // Beguiling Aura
			ADD_MEMORIZED_SPELL ~jasm3602~ #0 ~innate~ (1) // Drowning Kiss
			ADD_MEMORIZED_SPELL ~jasm3603~ #0 ~innate~ (1) // Venom Spit
			ADD_MEMORIZED_SPELL ~jasm3604~ #0 ~innate~ (1) // Summon Giant Poisonous Snake
			ADD_MEMORIZED_SPELL ~jasm3605~ #0 ~innate~ (1) // Watery Fist
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=975
					hp=24
					ac=10
					thac0=17
					apr=0
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					level1=4
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					strength=9
					intelligence=12
					wisdom=12
					dexterity=17
					constitution=12
					charisma=18
					morale=11
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~FAIRY_NEREID~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_NEUTRAL~)
					movement=10
					enforce=1
			END
			// Assigning jabm3600
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDNEREID ULENE BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm3600 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDPWATER~) BEGIN 
				WRITE_LONG 0x14 3000 // xpv
				WRITE_SHORT 0x24 54 // hp
				WRITE_SHORT 0x26 54 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 9 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~RE_MEKRN~) BEGIN 
				WRITE_SHORT 0x24 30 // hp
				WRITE_SHORT 0x26 30 // hp
				WRITE_BYTE 0x52 15 // thac0
				WRITE_BYTE 0x54 11 // saveDeath
				WRITE_BYTE 0x55 13 // saveWand
				WRITE_BYTE 0x56 12 // savePolymorph
				WRITE_BYTE 0x57 13 // saveBreath
				WRITE_BYTE 0x58 14 // saveSpell
				WRITE_BYTE 0x234 5 // level1
					WRITE_LONG 0x8 RESOLVE_STR_REF(@10189)
					WRITE_LONG 0xc RESOLVE_STR_REF(@10189)
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"SHOAL"
		"BDNEREID"
		"BDPWATER"
	BEGIN
		LAF jam36_patch STR_VAR file END
	END
END
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"ANSIRENE"
		"RE_MEKRN"
	BEGIN
