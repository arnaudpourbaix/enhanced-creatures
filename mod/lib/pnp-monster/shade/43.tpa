COPY_EXISTING ~WIBHSHA1.cre~ ~override/jacm4300.cre~
COPY_EXISTING ~WIBHSHA2.cre~ ~override/jacm4301.cre~
DEFINE_ACTION_FUNCTION jam43_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~WIBHSHA1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WIBHSHA2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JACM4300~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JACM4301~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~s1-8~
			ADD_CRE_ITEM ~jaim4300~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim4301~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~jasm4300~ #0 ~innate~ (1) // Shadow Images
			ADD_MEMORIZED_SPELL ~jasm4301~ #0 ~innate~ (1) // Invisibility
			ADD_MEMORIZED_SPELL ~jasm4302~ #0 ~innate~ (1) // Shadow Blink
			ADD_MEMORIZED_SPELL ~jasm4303~ #0 ~innate~ (1) // Quasi-Real Images
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=11000
					hp=150
					ac=10
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=10
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=6
					intelligence=15
					wisdom=10
					dexterity=14
					constitution=13
					charisma=8
					morale=14
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SHADOW~)
					class=IDS_OF_SYMBOL (~class~ ~SHADOW~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=14
					enforce=1
			END
			// Assigning jabm4300
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN JACM4300 JACM4301 WIBHSHA1 WIBHSHA2 END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm4300 jacm4301 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4300 END
			// Assigning jabm4301
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN WIBHSHA1 SHDWKILL BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN JACM4300 JACM4301 END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm4300 jacm4301 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4301 END
			// Assigning jabm4303
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN WIBHSHA1 BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN WIBHSHA1 END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm4300 jacm4301 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4303 END
			// Assigning jabm4305
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN WIBHSHA2 END
			CLEAR_ARRAY forceFiles
			PATCH_DEFINE_ARRAY forceFiles BEGIN jacm4300 jacm4301 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts forceFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4305 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIBHSHA1~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIBHSHA2~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIBHSHA1~) BEGIN 
				WRITE_BYTE 0x5b 100 // resistElectricity
				ADD_MEMORIZED_SPELL ~SPWI508~ #4 ~wizard~ (1) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIBHSHA2~) BEGIN 
				WRITE_BYTE 0x53 2 // apr
				WRITE_BYTE 0x5b 100 // resistElectricity
				REMOVE_MEMORIZED_SPELL ~jasm4303~
				ADD_MEMORIZED_SPELL ~jasm4304~ #0 ~innate~ (1) // Quasi-Real Images
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM4300~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_SHORT 0x24 (SHORT_AT 0x26 * 40 / 100) // currentHpPercent
				REPLACE_CRE_ITEM ~jaim4302~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
				REMOVE_MEMORIZED_SPELLS
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JACM4301~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x53 2 // apr
				WRITE_SHORT 0x24 (SHORT_AT 0x26 * 40 / 100) // currentHpPercent
				REPLACE_CRE_ITEM ~jaim4302~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
				REMOVE_MEMORIZED_SPELLS
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"JACM4300"
	"JACM4301"
BEGIN
	LAF jam43_patch STR_VAR file END
END
ACTION_IF GAME_IS ~bgee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"WIBHSHA1"
		"WIBHSHA2"
	BEGIN
		LAF jam43_patch STR_VAR file END
	END
END