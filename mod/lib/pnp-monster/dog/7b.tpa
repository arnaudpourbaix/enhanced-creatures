			ADD_MEMORIZED_SPELL ~jas0m7b~ #0 ~innate~ (1) // Breath Fire
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=420
					hp=32
					ac=4
					thac0=17
					apr=1
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
