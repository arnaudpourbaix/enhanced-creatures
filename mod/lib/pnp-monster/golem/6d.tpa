// Lesser Clay Golem
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/jam6d.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/jam6dsu.baf~

// Lesser Clay Golem traits
CREATE ITM "jai0m6d"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10750)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10750)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10751)
COPY_EXISTING ~jai0m6d.itm~ ~override~
	LPF magic_immunity END
	LPF nonMagicalWeapons_immunity END
	LPF slashingDamageResistance_resistance END
	LPF piercingDamageResistance_resistance END
	LPF missileDamageResistance_resistance END

DEFINE_ACTION_FUNCTION jam6d_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#FPCLY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHBGOL03~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~GOLCLA~
			REMOVE_CRE_ITEM ~GOLFLE~
			REMOVE_CRE_ITEM ~GOLIRO~
			REMOVE_CRE_ITEM ~OHBGOL01~
			REMOVE_CRE_ITEM ~B3-30~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~IMMUNE2~
			REMOVE_CRE_ITEM ~IMMUNE3~
			REMOVE_CRE_ITEM ~IRONGOL~
			REMOVE_CRE_ITEM ~D5CLGOL~
			REMOVE_CRE_ITEM ~HELMNOAN~
			REPLACE_CRE_ITEM ~jai1m18~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_CRE_ITEM ~jai0m6d~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~jas0m18~ #0 ~innate~ (1) // Haste
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=156
					ac=7
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=9
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=19
					intelligence=3
					wisdom=8
					dexterity=9
					constitution=18
					charisma=1
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_CLAY~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=6
					enforce=1
			END
			// Assigning jam6d
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLCLY01 BPFHT OHBNONIN O#BrynFi BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN AC#FPCLY END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam6d END
			// Assigning jam6dsu
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLCLY01 BPFHT OHBNONIN O#BrynFi BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG86 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2MS2GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN AC#FPCLY END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam6dsu END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~AC#FPCLY~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"AC#FPCLY"
	"OHBGOL03"
BEGIN
	LAF jam6d_patch STR_VAR file END
END