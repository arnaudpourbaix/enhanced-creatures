DEFINE_ACTION_FUNCTION jam2g_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~SAHZOMB~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ZOMBSE01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SAHZOM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOM02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOM03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOMGL~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring94~
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~b1-8~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~b3-12~
			REMOVE_CRE_ITEM ~ghast1~
			REMOVE_CRE_ITEM ~zomsea~
			REMOVE_CRE_ITEM ~SAHZOM01~
			ADD_CRE_ITEM ~jaic000h~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_CRE_ITEM ~jaim2g00~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim2g01~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_MEMORIZED_SPELL ~jasm2g01~ #0 ~innate~ (1) // Stench Of Decay
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=420
					hp=60
					ac=7
					thac0=15
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=5
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=14
					intelligence=6
					wisdom=6
					dexterity=6
					constitution=9
					charisma=5
					morale=19
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~ZOMBIE~)
					class=IDS_OF_SYMBOL (~class~ ~ZOMBIE_NORMAL~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					movement=5
					enforce=1
			END
			// Assigning jabm2g00
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN SAHZOMB END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm2g00 END
			// Assigning jabm2g01
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN SAHZOMB END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm2g01 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SAHZOM01~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
				WRITE_SHORT 0x24 144 // hp
				WRITE_SHORT 0x26 144 // hp
				WRITE_SHORT 0x46 "-3" // ac
				WRITE_SHORT 0x48 "-3" // ac
				WRITE_BYTE 0x52 9 // thac0
				WRITE_BYTE 0x53 3 // apr
				WRITE_BYTE 0x54 7 // saveDeath
				WRITE_BYTE 0x55 9 // saveWand
				WRITE_BYTE 0x56 8 // savePolymorph
				WRITE_BYTE 0x57 8 // saveBreath
				WRITE_BYTE 0x58 10 // saveSpell
				WRITE_BYTE 0x234 12 // level1
				WRITE_BYTE 0x23a 9 // intelligence
				ADD_MEMORIZED_SPELL ~jasm3y07~ #4 ~wizard~ (1) // Animate Dead
				ADD_MEMORIZED_SPELL ~jasm3y06~ #0 ~innate~ (1) // Odor of Death
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOM01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOM02~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOM03~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~VA#ZOMGL~) BEGIN 
				WRITE_SHORT 0x24 84 // hp
				WRITE_SHORT 0x26 84 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 7 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SAHZOMB~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"SAHZOMB"
		"ZOMBSE01"
		"SAHZOM01"
		"VA#ZOM01"
		"VA#ZOM02"
		"VA#ZOM03"
		"VA#ZOMGL"
	BEGIN
		LAF jam2g_patch STR_VAR file END
	END
END