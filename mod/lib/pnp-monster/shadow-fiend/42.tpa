DEFINE_ACTION_FUNCTION jam42_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA6~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHHSHFI1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHFIE~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SDSHADFI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SEWSHA01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SEWSHA02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~SHADFI01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#WSHA2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#WSHAF~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~ghoul1~
			REMOVE_CRE_ITEM ~s1-6~
			ADD_CRE_ITEM ~jaim4200~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jaim4201~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~jaim4202~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_CRE_ITEM ~jaic000b~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF GET_CRE_ITEM_IN_SLOT INT_VAR slot = 0 RET item END
			PATCH_IF "%item%" STRING_EQUAL_CASE "" BEGIN
				REPLACE_CRE_ITEM ~jaic0003~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			END
			ADD_MEMORIZED_SPELL ~SPWI228~ #1 ~wizard~ (1) 
			ADD_MEMORIZED_SPELL ~jasm4200~ #0 ~innate~ (1) // Leap
			ADD_MEMORIZED_SPELL ~jasm4202~ #4 ~wizard~ (1) // Magic Jar
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=8000
					hp=59
					ac=1
					thac0=13
					apr=2
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					level1=12
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=13
					intelligence=11
					wisdom=12
					dexterity=14
					constitution=12
					charisma=8
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~SHADOW~)
					class=IDS_OF_SYMBOL (~class~ ~SHADOW~)
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					hideShadow=90
					moveSilent=90
					movement=10
					enforce=1
					perfect2weapon=1
			END
			// Assigning jabm4200
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN ohrshad1 O#LLEnem BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN OHRSHAD1 OHRSHAD2 OHRSHAD3 AC#WSHA2 AC#WSHAF OHRSHFIE END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4200 END
			// Assigning jabm4202
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN ohrshad1 O#LLEnem BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN OHRSHAD1 OHRSHAD2 OHRSHAD3 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4202 END
			// Assigning jabm4203
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN ohrshad1 O#LLEnem BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN AC#WSHA2 AC#WSHAF END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4203 END
			// Assigning jabm4205
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN ohrshad1 O#LLEnem BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDMAGE01 BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE GENSHT01 SHOUT WDASIGHT WDRUNSGT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN OHRSHFIE END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts removeScriptsRegexp="^DW#GP.+\|DW#MG.+\|DW#PR.+\|DW1.+\|DW2.+\|DW3.+$" script=jabm4205 END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SDSHADFI~) BEGIN 
				WRITE_SHORT 0x24 99 // hp
				WRITE_SHORT 0x26 99 // hp
				WRITE_BYTE 0x52 9 // thac0
				WRITE_BYTE 0x54 7 // saveDeath
				WRITE_BYTE 0x55 9 // saveWand
				WRITE_BYTE 0x56 8 // savePolymorph
				WRITE_BYTE 0x57 8 // saveBreath
				WRITE_BYTE 0x58 10 // saveSpell
				WRITE_BYTE 0x234 13 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD1~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD2~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD3~) BEGIN 
				WRITE_SHORT 0x24 115 // hp
				WRITE_SHORT 0x26 115 // hp
				WRITE_SHORT 0x46 0 // ac
				WRITE_SHORT 0x48 0 // ac
				WRITE_BYTE 0x52 7 // thac0
				WRITE_BYTE 0x53 3 // apr
				WRITE_BYTE 0x54 5 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 6 // savePolymorph
				WRITE_BYTE 0x57 5 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 15 // level1
				WRITE_BYTE 0x238 16 // strength
				WRITE_BYTE 0x23f 18 // morale
				REMOVE_CRE_ITEM ~immune2~
				REMOVE_CRE_ITEM ~wraith1~
				REPLACE_CRE_ITEM ~jaim4204~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
				ADD_CRE_ITEM ~jaim4205~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
				ADD_MEMORIZED_SPELL ~OHRDEMI~ #0 ~innate~ (1) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~AC#WSHA2~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~AC#WSHAF~) BEGIN 
				WRITE_SHORT 0x24 67 // hp
				WRITE_SHORT 0x26 67 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x5c 100 // resistAcid
				WRITE_BYTE 0x234 12 // level1
				ADD_MEMORIZED_SPELL ~jask0d00~ #0 ~innate~ (1) // Shadow Images
				ADD_MEMORIZED_SPELL ~jask0d01~ #0 ~innate~ (1) // Shadow Door
				ADD_MEMORIZED_SPELL ~SPWI112~ #0 ~wizard~ (5) 
				ADD_MEMORIZED_SPELL ~SPWI304~ #2 ~wizard~ (2) 
				ADD_MEMORIZED_SPELL ~SPWI306~ #2 ~wizard~ (1) 
				ADD_MEMORIZED_SPELL ~SPWI308~ #2 ~wizard~ (2) 
				ADD_MEMORIZED_SPELL ~SPWI415~ #3 ~wizard~ (2) 
				ADD_MEMORIZED_SPELL ~SPWI501~ #4 ~wizard~ (1) 
				ADD_MEMORIZED_SPELL ~SPWI502~ #4 ~wizard~ (1) 
				ADD_MEMORIZED_SPELL ~SPWI504~ #4 ~wizard~ (1) 
				ADD_MEMORIZED_SPELL ~SPWI508~ #4 ~wizard~ (1) 
				ADD_MEMORIZED_SPELL ~SPWI601~ #5 ~wizard~ (1) 
				ADD_MEMORIZED_SPELL ~SPWI602~ #5 ~wizard~ (1) 
				ADD_MEMORIZED_SPELL ~SPWI604~ #5 ~wizard~ (1) 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHFIE~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_SHORT 0x24 (SHORT_AT 0x26 * 40 / 100) // currentHpPercent
				REPLACE_CRE_ITEM ~jaim4207~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
				REPLACE_CRE_ITEM ~jaim4208~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
				REMOVE_MEMORIZED_SPELL ~SPWI228~ ~jasm4202~ ~jasm4200~
				ADD_MEMORIZED_SPELL ~jasm4204~ #0 ~innate~ (1) // Leap
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA1~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA2~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA3~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA4~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA5~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLSHA6~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHHSHFI1~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SDSHADFI~) BEGIN 
				WRITE_LONG 0x14 12000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SEWSHA01~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SEWSHA02~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~SHADFI01~) BEGIN 
				WRITE_LONG 0x14 8000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD1~) BEGIN 
				WRITE_LONG 0x14 18000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD2~) BEGIN 
				WRITE_LONG 0x14 18000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~OHRSHAD3~) BEGIN 
				WRITE_LONG 0x14 18000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~AC#WSHA2~) BEGIN 
				WRITE_LONG 0x14 9000 // xpv
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~AC#WSHAF~) BEGIN 
				WRITE_LONG 0x14 9000 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
	ACTION_FOR_EACH ~file~ IN
		"O#LLSHA1"
		"O#LLSHA2"
		"O#LLSHA3"
		"O#LLSHA4"
		"O#LLSHA5"
		"O#LLSHA6"
		"OHHSHFI1"
		"OHRSHFIE"
		"SDSHADFI"
		"SEWSHA01"
		"SEWSHA02"
		"SHADFI01"
		"OHRSHAD1"
		"OHRSHAD2"
		"OHRSHAD3"
		"AC#WSHA2"
		"AC#WSHAF"
	BEGIN
		LAF jam42_patch STR_VAR file END
	END
END