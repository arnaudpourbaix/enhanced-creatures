	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jas0m1b.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10234)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPPR416C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10761)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=4 target=4 range=30 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~jasight~)) + 1 STR_VAR icon="SPPR416B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=24 target=2 power=1 duration=42 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=36 duration=42 probability1=100 savingthrow=1 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=1 probability1=100 savingthrow=1 STR_VAR resource="EFF_M07" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=4 duration=42 probability1=100 savingthrow=1 STR_VAR resource="EFF_E07" END
	LPF CHANGE_SPELL INT_VAR    renew=3 END
	
