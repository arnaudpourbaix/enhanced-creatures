// Generated file (don't edit)

// Lesser Stone Golem
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/jam6f.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/jam6fsu.baf~

ACTION_FOR_EACH ~file~ IN
	"bdpetsg"
	"bdpetsgs"
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.bcs~ BEGIN
		COPY_EXISTING ~%file%.bcs~ ~override~
			DECOMPILE_AND_PATCH BEGIN
				REPLACE_TEXTUALLY ~ReallyForceSpell(Myself,GOLEM_SLOW)~ ~~
			END
		BUT_ONLY
	END
END

DEFINE_ACTION_FUNCTION jam6f_patch
STR_VAR file = ~~
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~ARGHH~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDPETSG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDPETSG2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDPETSGS~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UGHH~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~GOLFLE~
			REMOVE_CRE_ITEM ~GOLSTO~
			REMOVE_CRE_ITEM ~GOLSTONE~
			REMOVE_CRE_ITEM ~IMMUNE2~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~HELMNOAN~
			REMOVE_CRE_ITEM ~B3-24~
			ADD_CRE_ITEM ~jai0m19~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai1m19~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~jai2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~jai3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~SPWI312~ #2 ~wizard~ (1) 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=4000
					hp=180
					ac=5
					thac0=11
					apr=1
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					level1=10
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=20
					intelligence=3
					wisdom=11
					dexterity=9
					constitution=20
					charisma=1
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_STONE~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=5
					enforce=1
			END
			// Assigning jam6f
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 OHBNONIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN BDPETSGS END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=jam6f END
			// Assigning jam6fsu
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 OHBNONIN BDANIMN BDARCHNI BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT BPWDASGT BPWDRSGT BPWTRSGT BPWTSIGT DVMELEE DW#GPSHM DW#GPSHT DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#MG29 DW#MG47 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#PRSHT dw1melbe DW1MELGE dw1melmo dw1melmw DW1RANGE dw1ranmo DW2MC0GE DW2MC0GW DW2MC0MO DW2MC1GE DW2MC1MO DW2MC2MO DW2MC2GE DW2MC3MO DW2MM0GE DW2MP2MO DW2MP0GE DW2MP0GW DW2MP1GE DW2MP2GE DW2MP2GW DW2MP2TH DW2MS0GE DW2MS0MO DW2MS1GE DW2RC0MO DW2RC2MO DW2RM2MO DW2RS0MO GENSHT01 SHOUT TUTU_SCR WDASIGHT WTASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN BDPETSGS END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=jam6fsu END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ARGHH~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~UGHH~) BEGIN 
				WRITE_LONG 0x14 6000 // xpv
				WRITE_SHORT 0x24 240 // hp
				WRITE_SHORT 0x26 240 // hp
				WRITE_BYTE 0x52 7 // thac0
				WRITE_BYTE 0x54 5 // saveDeath
				WRITE_BYTE 0x55 7 // saveWand
				WRITE_BYTE 0x56 6 // savePolymorph
				WRITE_BYTE 0x57 5 // saveBreath
				WRITE_BYTE 0x58 8 // saveSpell
				WRITE_BYTE 0x234 14 // level1
				WRITE_BYTE 0x238 22 // strength
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDPETSGS~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END

ACTION_FOR_EACH ~file~ IN
	"ARGHH"
	"BDPETSG"
	"BDPETSG2"
	"BDPETSGS"
	"UGHH"
BEGIN
	LAF jam6f_patch STR_VAR file END
END