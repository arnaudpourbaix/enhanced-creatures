// Disease
CREATE SPL "jasm2g00"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jasm2g00.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10418)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 fl#Disease
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10419)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=5 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=1 parameter1=5188352 duration=2 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=RESOLVE_STR_REF(@10420) timing=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=7 duration=7200 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=0 target=2 power=1 parameter1="-2" duration=7200 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=278 target=2 power=1 parameter1="-2" duration=7200 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=206 target=2 power=1 duration=7200 probability1=100 STR_VAR resource="jasm2g00" END
OUTER_SET $f_AddSecType(jasm2g00.spl) = DiseaseSecType

