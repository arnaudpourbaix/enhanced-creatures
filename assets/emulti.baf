// **********************************************************************
// *           Segment Name: gs_Buffs_TL2_Mage.baf
// **********************************************************************

// * THREAT LEVEL 2 ENHANCER "BUFF" SPELLS - MAGE


// * WIZARD_INVISIBILITY_10_FOOT {3} [SpWi307 - 2307]  [Group]
// * Requires Mod State.IDS File (STATE_NOT_VISIBLE)
IF
  HaveSpell(WIZARD_INVISIBILITY_10_FOOT)                                   // and we have the spell
  !StateCheck(Myself,STATE_NOT_VISIBLE)                                    // and not invisible/impinvis
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",1)                                    // or its threat-level 2+
  AttackedBy([ANYONE],DEFAULT)                                             // if we're being attacked
  NumInPartyGT(2)                                                          // and theres at least 3 of us
  !StateCheck(Myself,STATE_BLUR)                                           // and we haven't already cast BLUR
  !StateCheck(Myself,STATE_MIRRORIMAGE)                                    // and we haven't already cast MIRRORIMAGE
  NumCreatureGT([EVILCUTOFF],4)                                            // and there are 5+ monsters
  OR(4)
     See(Myself)                                                           // target the spell on self
     See(NearestMyGroupOfType([0.0.0.FIGHTER_ALL.0.0.0]))                  // target the spell of any PC Fighter
     See(NearestMyGroupOfType([0.0.0.RANGER_ALL.0.0.0]))                   // target the spell of any PC Ranger
     See(NearestMyGroupOfType([0.0.0.PALADIN_ALL.0.0.0]))                  // target the spell of any PC Paladin
  !StateCheck(LastSeenBy(Myself),STATE_NOT_VISIBLE)                        // and not invisible/impinvis
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant [casting room clause]
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(NearestEnemyOf,1,SEEINVISIBLE)                               // and our enemies are not already seeing invisible
  CheckStatLT(SecondNearestEnemyOf,1,SEEINVISIBLE)                         // and our enemies are not already seeing invisible
  CheckStatLT(ThirdNearestEnemyOf,1,SEEINVISIBLE)                          // and our enemies are not already seeing invisible
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),WIZARD_INVISIBILITY_10_FOOT)
END

