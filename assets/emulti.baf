    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

// **********************************************************************
// *           Segment Name: gs_PreAttack_TL1_Priest.baf
// **********************************************************************

// * PRE-ATTACK SPELLS - THREAT LEVEL ONE (Priest)

// * Pre-Attack: Spells cast that require a physical attack to complete, or are
// * designed to enhance or assist physical attacks.

// * 1: Pre-Missile

// * CLERIC_CAUSE_MEDIUM_WOUNDS {3} [CDCAUSMW]
// * Requires G3's Divine Remix
// * -----------------------------------------
// * CS: 5, TGT: Caster, RNG: 1', AOE: Caster
// * -----------------------------------------
// * Create Item: CDCAUSMW (Enchantment: +6, To Hit: +2, Dmg: 14 MAGIC - No Save) - 15s
IF
  HaveSpellRES("CDCAUSMW")                                                 // and we have the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",0)                                    // and its threat-level 1+
  !InParty(NearestEnemyOf(Myself))                                         // and they're not in our party (double-check)
  !Allegiance(NearestEnemyOf(Myself),GOODCUTOFF)                           // and not an Ally, Familiar, Minion or Simulacrum
  HPGT(NearestEnemyOf(Myself),10)                                          // and the target has >10hp
  CheckStatLT(NearestEnemyOf(Myself),26,MAGICDAMAGERESISTANCE)             // and they aren't resistant to MAGIC dmg
  Range(NearestEnemyOf(Myself),6)                                          // and they're within 6sq away (melee)
  !HasItemSlot(Myself,SLOT_MISC19)                                         // more robust check to see if I already have anything in the magically created item slot
//  !HasItem("CDCAUSLW",Myself)                                              // and I don't already have a Serious Wounds in effect
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  CheckStatLT(NearestEnemyOf(Myself),76,RESISTMAGIC)                       // and they are less than 76% magic resistant (so we have at least 25% chance of success)
  !HasItemEquiped("RAKRING",NearestEnemyOf(Myself))                        // and they're not a Rakshasa (immune to 8th level spells or less)
  !HasItemEquiped("LICH",NearestEnemyOf(Myself))                           // and they aren't immune to spells of 5th level or lower
  !HasItemEquiped("MAGEAMUL",LastSeenBy(Myself))                           // and they're not carrying an item that conveys immunity to 1st-3rd level spells
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    SpellRES("CDCAUSMW",Myself)                                            // cast the spell
    SetGlobalTimer("gh_ActionIsInterruptable","LOCALS",1)                  // set a 1-sec timer to indicate action is interruptable
    Attack(NearestEnemyOf(Myself))                                         // Attack()
END

