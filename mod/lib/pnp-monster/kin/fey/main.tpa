LAM load_secondary_types
INCLUDE "%MOD_FOLDER%/lib/pnp-monster/kin/fey/common.tpa"
// Dimension Door
CREATE SPL "jask0500"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jask0500.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10460)
	WRITE_ASCII 0x10 ~CAS_M08~ #8
	WRITE_LONG 0x18 2048
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x1e 64
	WRITE_SHORT 0x22 10
	WRITE_BYTE 0x25 8
	WRITE_BYTE 0x27 13
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI402C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10461)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=4 range=900 speed=1 STR_VAR icon="SPWI402B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=141 target=1 power=1 parameter2=38 timing=1 resist_dispel=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=1 power=1 timing=1 resist_dispel=1 probability1=100 STR_VAR resource="EFF_M09" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=1 power=1 parameter2=2 resist_dispel=1 duration=1 probability1=100 STR_VAR resource="SPDIMNDR" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=124 target=1 power=1 timing=4 resist_dispel=1 duration=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=20 target=1 power=1 resist_dispel=1 duration=1 probability1=100 END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
// Dryad Charm
CREATE EFF "jask0501"
	WRITE_LONG 0x10 206
	WRITE_LONG 0x14 2
	WRITE_LONG 0x24 1
	WRITE_SHORT 0x2c 100
	WRITE_ASCII 0x30 ~jask0501~ #8

CREATE SPL "jask0501"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jask0501.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10192)
	WRITE_ASCII 0x10 ~CAS_M05~ #8
	WRITE_LONG 0x18 512
	WRITE_SHORT 0x1c 4
	WRITE_SHORT 0x22 11
	WRITE_BYTE 0x25 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI316C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10794)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=30 speed=1 projectile=(IDS_OF_SYMBOL (~projectl~ ~SPARKLGO~)) + 1 STR_VAR icon="SPWI316B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=177 target=2 power=1 parameter1=IDS_OF_SYMBOL (~RACE~ ~ELF~) parameter2=4 duration=1 probability1=90 STR_VAR resource="jask0501" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=177 target=2 power=1 parameter1=IDS_OF_SYMBOL (~RACE~ ~HALF_ELF~) parameter2=4 duration=1 probability1=30 STR_VAR resource="jask0501" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=5 target=2 power=1 parameter1=IDS_OF_SYMBOL (~GENERAL~ ~HUMANOID~) parameter2=2 resist_dispel=1 duration=180 probability1=100 savingthrow=1 savebonus="-3" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=14780 timing=1 resist_dispel=1 probability1=100 savingthrow=1 savebonus="-3" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=1 parameter1="-1819214080" parameter2=1966080 resist_dispel=1 duration=1 probability1=100 savingthrow=1 savebonus="-3" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 resist_dispel=1 duration=3 probability1=100 savingthrow=1 savebonus="-3" STR_VAR resource="SPNWCHRM" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=3 resist_dispel=1 duration=180 probability1=100 savingthrow=1 savebonus="-3" STR_VAR resource="EFF_E07" END
	
// Speak With Plants
CREATE SPL "jask0502"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~jask0502.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10195)
	WRITE_ASCII 0x10 ~CAS_P02~ #8
	WRITE_SHORT 0x1c 4
	WRITE_SHORT 0x22 10
	WRITE_BYTE 0x25 8
	WRITE_BYTE 0x27 13
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~jaak0501~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10196)
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=5 range=30 speed=1 STR_VAR icon="jaak0501" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=143 target=2 power=1 parameter1=IDS_OF_SYMBOL (~slots~ ~SLOT_AMULET~) resist_dispel=3 duration=60 probability1=100 STR_VAR resource="jaic0004" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=1 parameter1=1727219712 parameter2=1966080 resist_dispel=3 duration=1 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 resist_dispel=3 duration=2 probability1=100 STR_VAR resource="SPRMCURS" END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
