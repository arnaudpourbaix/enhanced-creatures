// * Requires Mod Stat.IDS File (WIZARD_RESIST_FEAR)
IF
  HaveSpell(WIZARD_RESIST_FEAR)                                            // and we have the spell
  CheckStatLT(Myself,1,WIZARD_RESIST_FEAR)                                 // and I am not already under the effects of the spell
