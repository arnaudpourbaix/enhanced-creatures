// * ANTI-MELEE/MISSILE

// * WIZARD_PROTECTION_FROM_NORMAL_MISSILES 'ds' {3} [SpWi311 - 2311] (@self, immune to normal missiles, 5T)
// * Requires Mod Stat.IDS File (WIZARD_PROTECTION_FROM_NORMAL_MISSILES)
IF
  HaveSpell(WIZARD_PROTECTION_FROM_NORMAL_MISSILES)                        // and we have the spell ProtNormMissiles
  !CheckStat(Myself,1,WIZARD_PROTECTION_FROM_NORMAL_MISSILES)              // and aren't already under the effects of the spell
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  GlobalGT("gh_ThreatLevel","LOCALS",2)                                    // and its threat-level 3+
  !Range(NearestEnemyOf(Myself),4)                                         // and nearest enemy is > 4 distant (any closer and we haven't got breathing room to cast)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREMAGE)                                  // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
  OR(11)
     !Range(LastAttackerOf(Myself),4)                                      // attacked >4 steps away, therefore ranged
     HasItemEquiped("AROW01",LastAttackerOf(Myself))
     HasItemEquiped("AROW02",LastAttackerOf(Myself))
     HasItemEquiped("AX1H04",LastAttackerOf(Myself))
     HasItemEquiped("BOLT01",LastAttackerOf(Myself))
     HasItemEquiped("BULL01",LastAttackerOf(Myself))
     HasItemEquiped("DAGG05",LastAttackerOf(Myself))
     HasItemEquiped("DART01",LastAttackerOf(Myself))
     HasItemEquiped("DWBOLT03",LastAttackerOf(Myself))
     HasItemEquiped("KUOBOLT",LastAttackerOf(Myself))
     HasItemEquiped("SAHBOLT",LastAttackerOf(Myself))
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,WIZARD_PROTECTION_FROM_NORMAL_MISSILES)
END

