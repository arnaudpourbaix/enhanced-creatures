// **********************************************************************
// *           Segment Name: gs_MassCure.baf
// **********************************************************************

// * MASS CURE ALGORITHM
// * Two Implementations:

// * CLERIC_MASS_CURE {5} [SpPr514 - 1514]
// * -----------------------------------------
// * CS: 5, TGT: Caster, RNG: Caster, AOE: 20' of Caster
// * -----------------------------------------
// * Restores 1d8+1 HP/CL

// * 1. Mass Cure on Near Death of Caster
// * [if the caster is about to die and still has this in memory, she might as well cast it, eh?]
IF
  HaveSpell(CLERIC_MASS_CURE)
  HPPercentLT(Myself,25)                                                   // if the Caster is about to die anyway
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  !CheckStat(Myself,100,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_MASS_CURE)
END

// * CLERIC_MASS_CURE {5} [SpPr514 - 1514]
// * ----------------------------------------------------
// * CS: 5, TGT: Caster, RNG: Caster, AOE: 20' of Caster
// * ----------------------------------------------------
// * Restores 1d8+1 HP/CL

// * Date Modified:  8 December 2005
// * Status:  Untested
// * Spell was set to cast at MostDamagedOf(), but the spell is actually caster centered
// * This methodology is not going to ensure that anyone is in range of the spell, but it
// * may work regardless since the range is pretty high at 20'

// * 2. Mass Cure Algorithm, Non-gSeries Way
// * [Responding to two wounded PC's using HPPercentLT checks]
IF
  HaveSpell(CLERIC_MASS_CURE)
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
// if anyone besides player 6 is hurt
  OR(5)
     HPPercentLT(Player1,50)
     HPPercentLT(Player2,50)
     HPPercentLT(Player3,50)
     HPPercentLT(Player4,50)
     HPPercentLT(Player5,50)
// if anyone besides player 5 is hurt
  OR(5)
     HPPercentLT(Player1,50)
     HPPercentLT(Player2,50)
     HPPercentLT(Player3,50)
     HPPercentLT(Player4,50)
     HPPercentLT(Player6,50)
// if anyone besides player 4 is hurt
  OR(5)
     HPPercentLT(Player1,50)
     HPPercentLT(Player2,50)
     HPPercentLT(Player3,50)
     HPPercentLT(Player5,50)
     HPPercentLT(Player6,50)
// if anyone besides player 3 is hurt
  OR(5)
     HPPercentLT(Player1,50)
     HPPercentLT(Player2,50)
     HPPercentLT(Player4,50)
     HPPercentLT(Player5,50)
     HPPercentLT(Player6,50)
// if anyone besides player 2 is hurt
  OR(5)
     HPPercentLT(Player1,50)
     HPPercentLT(Player3,50)
     HPPercentLT(Player4,50)
     HPPercentLT(Player5,50)
     HPPercentLT(Player6,50)
// if anyone besides player 1 is hurt
  OR(5)
     HPPercentLT(Player2,50)
     HPPercentLT(Player3,50)
     HPPercentLT(Player4,50)
     HPPercentLT(Player5,50)
     HPPercentLT(Player6,50)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     //set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(Myself,CLERIC_MASS_CURE)
END

// **********************************************************************
// *           Segment Name: gs_HealOther_1st_4th.baf
// **********************************************************************

// * HEAL OTHER ROUTINE: 1st-4th LEVEL SPELLS
// *
// * RESPOND TO HEAL REQUESTS
// * EFFECTS, then RAW HEAL

// * CLERIC_NEUTRALIZE_POISON {4} [SpPr404 - 1404]
IF
  HaveSpell(CLERIC_NEUTRALIZE_POISON)                                      // and I have Neutralise Poison
  StateCheck(LastSeenBy(Myself),STATE_POISONED)                            // and they're poisoned
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !Range(LastSeenBy(Myself),0)                                             // if its not *me*
  InParty(LastSeenBy(Myself))                                              // and it is a PC
  HPPercentLT(LastSeenBy(Myself),75)                                       // and they have <50% hp
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_NEUTRALIZE_POISON)
END

// * CLERIC_REMOVE_PARALYSIS {3} [SpPr308 - 1308]
// * Requires Mod Stat.IDS File (WIZARD_MISLEAD)
IF
  HaveSpell(CLERIC_REMOVE_PARALYSIS)                                       // and I have a remove paralysis
  CheckStatGT(LastSeenBy(Myself),0,HELD)                                   // and the help-requestor is Held
  OR(2)
     !GlobalTimerNotExpired("gh_SpellCastThisRound","LOCALS")              // and I am ready to cast.
     CheckStatGT(Myself,0,AURACLEANSING)                                   // or I am Aura Cleansed so no wait
  OR(2)                                                                    // Xyx's Cast&Attack/GB's self-interrupting Attack
     ActionListEmpty()                                                     // if we're doing nothing
     GlobalTimerNotExpired("gh_ActionIsInterruptable","LOCALS")            // or we're doing an interruptible action
  !CombatCounter(0)                                                        // if combat is not over
  InParty(LastSeenBy(Myself))                                              // and it is a PC
  !CheckStat(LastSeenBy(Myself),2,PUPPETTYPE)                          // Prevent dispelling of Caster Hold Effect (PI)
  !StateCheck(Myself,STATE_SILENCED)                                       // and I'm not silenced
  CheckStatLT(Myself,76,SPELLFAILUREPRIEST)                                // and we haven't been hit with a spellfailure effect (such as antimagic_ray, insect_swarm etc)
THEN
  RESPONSE #100
    SetGlobalTimer("gh_SpellCastThisRound","LOCALS",6)                     // set a 6 second timer to ensure we don't reselect a spell action this round (which wastes time)
    Spell(LastSeenBy(Myself),CLERIC_REMOVE_PARALYSIS)                      // cast it on them
END

